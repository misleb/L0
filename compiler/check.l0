; check.l0 -- name resolution and type checking.
;
; The checker only validates; it produces no annotated tree. That is possible
; because every L0 value is an i64 in the emitted IR (spec section 10.1), so
; the emitter needs no type information at all. Even match needs none: an arm
; names its constructor directly, so the emitter can find the tag from the
; same constructor table built here.
;
; Checking reports at most one error per declaration and then moves to the
; next, matching the stage-0 interpreter, so one run surfaces many problems.
;
; The one pass here that produces a tree is mono_program, at the end, which
; the emitter runs on a program that has already checked: it replaces each
; function with type parameters by its copies (spec 10.2), and needs the
; checker's types to choose which copy each call reaches.

(data Bind
  (B (list int) Ty))                    ; name, type

(data Sig
  (S (name (list int)) (tparams (list (list int))) (params (list Ty)) (ret Ty)))

; A declared data type, with the width of its widest constructor. Blocks are
; sized to that width, per spec section 10.1.
(data DataDef
  (DD (name (list int)) (params (list (list int))) (ctors (list Ctor))
      (width int)))                     ; width: the widest constructor's fields

; A constructor carries its type's parameters, so that its fields' types can
; be found for a value of that type from the value's type alone, and its
; field names, empty when the fields are not named (spec 4).
(data CtorInfo
  (CI (name (list int)) (type_name (list int)) (tag int)
      (params (list (list int))) (field_names (list (list int)))
      (fields (list Ty))))

; Everything global that checking an expression needs, and the type
; parameters of the function being checked, which are types in its body.
; The fourth field is every builtin's name, split once when the context is
; built, since a call to any function has to be told apart from a builtin.
(data Ctx
  (Cx (sigs (list Sig)) (ctors (list CtorInfo)) (datas (list DataDef))
      (builtins (list (list int))) (tparams (list (list int)))))

; What checking found, or the first error in it, as an offset and a message:
; the type of an expression, the types of a list of them, or what a data
; type's parameters stand for so far. Not a Result, whose Err holds one value,
; since then every error would be wrapped in a Diag here and taken apart
; again by a match of its own, patterns being one level deep.
(data (Checked T)
  (COk T)
  (CErr int (list int)))

; A context's parts are read by name, (.sigs c) and the rest, and the
; context inside a function with type parameters fps is (.tparams c fps).

(def is_builtin_in ((n (list int)) (c Ctx)) bool
  (any_eq n (.builtins c)))

; ---------------------------------------------------------------- lookups

(def find_bind ((n (list int)) (env (list Bind))) (Option Ty)
  (if (is_empty env)
      ((None Ty))
      (match (head env)
        ((B bn bt)
          (if (eq n bn) (Some bt) (find_bind n (tail env)))))))

(def find_sig ((n (list int)) (sigs (list Sig))) (Option Sig)
  (if (is_empty sigs)
      ((None Sig))
      (match (head sigs)
        ((S sn tps sp sr)
          (if (eq n sn)
              (Some (head sigs))
              (find_sig n (tail sigs)))))))

(def find_ctor ((n (list int)) (cs (list CtorInfo))) (Option CtorInfo)
  (if (is_empty cs)
      ((None CtorInfo))
      (match (head cs)
        ((CI cn tn tag ps ns fts)
          (if (eq n cn)
              (Some (head cs))
              (find_ctor n (tail cs)))))))

(def find_data ((n (list int)) (ds (list DataDef))) (Option DataDef)
  (if (is_empty ds)
      ((None DataDef))
      (match (head ds)
        ((DD dn ps cs mf)
          (if (eq n dn)
              (Some (head ds))
              (find_data n (tail ds)))))))


; ------------------------------------------------------- type parameters
;
; A data type's parameters are replaced by what they stand for, as a list of
; bindings from parameter name to type. Spec 4 and 5.6.

(def ty_subst ((t Ty) (bs (list Bind))) Ty
  (match t
    ((TyList e) (TyList (ty_subst e bs)))
    ((TyArray e) (TyArray (ty_subst e bs)))
    ((TyData n as)
      (if (is_empty as)
          (match (find_bind n bs)
            ((Some x) x)
            ((None) t))
          (TyData n (tys_subst as bs))))
    ((TyInt) t)
    ((TyBool) t)
    ((TyFloat) t)
    ((TyBytes) t)))

(def tys_subst ((ts (list Ty)) (bs (list Bind))) (list Ty)
  (if (is_empty ts)
      ts
      (cons (ty_subst (head ts) bs) (tys_subst (tail ts) bs))))

; Each parameter bound to the argument in the same position.
(def zip_binds ((ps (list (list int))) (as (list Ty))) (list Bind)
  (if (if (is_empty ps) true (is_empty as))
      (nil Bind)
      (cons (B (head ps) (head as)) (zip_binds (tail ps) (tail as)))))

; What each parameter stands for, in order. Every one is bound when the
; constructor determines them all, which the checker requires.
(def args_of ((ps (list (list int))) (bs (list Bind))) (list Ty)
  (if (is_empty ps)
      (nil Ty)
      (cons (match (find_bind (head ps) bs)
              ((Some t) t)
              ((None) (TyInt)))
            (args_of (tail ps) bs))))

(def is_param ((t Ty) (ps (list (list int)))) bool
  (if (ty_is_data t)
      (if (is_empty (ty_args t)) (any_eq (ty_name t) ps) false)
      false))

; Matches a field's declared type against an argument's type, one way: the
; argument's type is complete, and a parameter in the field's type binds to
; the part of it in the same position, or must equal what it is bound to.
(def match_ty ((pat Ty) (at Ty) (ps (list (list int))) (bs (list Bind)))
    (Checked (list Bind))
  (if (is_param pat ps)
      (match (find_bind (ty_name pat) bs)
        ((Some t) (if (eq t at) (COk bs) ((CErr (list Bind)) 0 "")))
        ((None) (COk (cons (B (ty_name pat) at) bs))))
      (if (not (eq (ty_kind pat) (ty_kind at)))
          ((CErr (list Bind)) 0 "")
          (if (or (ty_is_list pat) (ty_is_array pat))
              (match_ty (ty_elem pat) (ty_elem at) ps bs)
              (if (ty_is_data pat)
                  (if (eq (ty_name pat) (ty_name at))
                      (match_tys (ty_args pat) (ty_args at) ps bs)
                      ((CErr (list Bind)) 0 ""))
                  (COk bs))))))

(def match_tys ((pats (list Ty)) (ats (list Ty)) (ps (list (list int)))
                (bs (list Bind))) (Checked (list Bind))
  (if (is_empty pats)
      (if (is_empty ats) (COk bs) ((CErr (list Bind)) 0 ""))
      (if (is_empty ats)
          ((CErr (list Bind)) 0 "")
          (match (match_ty (head pats) (head ats) ps bs)
            ((CErr o m) ((CErr (list Bind)) o m))
            ((COk bs2) (match_tys (tail pats) (tail ats) ps bs2))))))

; The type arguments a construction gives its data type: those written, or
; else those its arguments' types determine. Only for a construction the
; checker accepted.
(def ctor_type_args ((ci CtorInfo) (tys (list Ty)) (ats (list Ty))) (list Ty)
  (if (not (is_empty tys))
      tys
      (match (match_tys (.fields ci) ats (.params ci) (nil Bind))
        ((COk bs) (args_of (.params ci) bs))
        ((CErr o m) (nil Ty)))))

; A constructor's field types for a value of type t.
(def ctor_fields_at ((ci CtorInfo) (t Ty)) (list Ty)
  (tys_subst (.fields ci) (zip_binds (.params ci) (ty_args t))))

(def ty_mentions ((n (list int)) (t Ty)) bool
  (if (or (ty_is_list t) (ty_is_array t))
      (ty_mentions n (ty_elem t))
      (if (ty_is_data t)
          (if (is_empty (ty_args t))
              (eq (ty_name t) n)
              (tys_mention n (ty_args t)))
          false)))

(def tys_mention ((n (list int)) (ts (list Ty))) bool
  (if (is_empty ts)
      false
      (if (ty_mentions n (head ts)) true (tys_mention n (tail ts)))))

; The first parameter no field type mentions, or an empty name.
(def undetermined ((ps (list (list int))) (fts (list Ty))) (list int)
  (if (is_empty ps)
      ""
      (if (tys_mention (head ps) fts)
          (undetermined (tail ps) fts)
          (head ps))))

(def ty_arity_msg ((n (list int)) (want int) (got int)) (list int)
  (append "type " (append n (append " takes " (append (digits want)
    (append " " (append (plural want "type argument")
      (append ", but got " (digits got)))))))))

; What is wrong with a type, or an empty message: a data type that is not
; declared, or given the wrong number of arguments, or a parameter given
; any. ps are the parameters in scope, which hide data types of the same
; name. Spec 3.
(def ty_problem ((t Ty) (ds (list DataDef)) (ps (list (list int)))) (list int)
  (if (or (ty_is_list t) (ty_is_array t))
      (ty_problem (ty_elem t) ds ps)
      (if (not (ty_is_data t))
          ""
          (if (any_eq (ty_name t) ps)
              (if (is_empty (ty_args t))
                  ""
                  (append "type parameter " (append (ty_name t)
                    " takes no type arguments")))
              (match (find_data (ty_name t) ds)
                ((None) (append "unknown type " (ty_name t)))
                ((Some d)
                  (let want (length (.params d))
                    (let got (length (ty_args t))
                      (if (eq want got)
                          (tys_problem (ty_args t) ds ps)
                          (ty_arity_msg (ty_name t) want got))))))))))

(def tys_problem ((ts (list Ty)) (ds (list DataDef)) (ps (list (list int))))
    (list int)
  (if (is_empty ts)
      ""
      (let bad (ty_problem (head ts) ds ps)
        (if (is_empty bad) (tys_problem (tail ts) ds ps) bad))))

; --------------------------------------------------------------- builtins

(def bi_int_int_int ((i int)) (list (list int))
  (split_spaces "add sub mul div mod bit_and bit_or bit_xor bit_shl bit_shr"))
(def bi_int_int_bool ((i int)) (list (list int)) (split_spaces "lt le gt ge"))
(def bi_bool_bool ((i int)) (list (list int)) (split_spaces "and or"))
(def bi_list_ops ((i int)) (list (list int)) (split_spaces "cons head tail is_empty"))

; The effects of spec 6.2 to 6.4, 6.7, and 6.12 to 6.14, 6.16's machine, 6.12's board_reset, and
; 6.18's cpu_count and cpu_wait, and 6.19's heap_left,
; which asks the host as they do. Those in bi_io
; take and return only ints, so need_all checks them; bi_path take only byte
; lists, paths or bytes to read, and return an int; bi_to_list take an int
; and return a byte list; bi_user take bytes or a context, and
; check_user_builtin checks them.
(def bi_io ((i int)) (list (list int))
  (names_then (split_spaces "read_byte write_byte read_from write_to close flush arg_count open_buffer clock_ns machine board_reset cpu_count cpu_wait heap_left")
              (names_then (bi_region 0)
                (names_then (bi_user_ints 0) (bi_interrupt 0)))))
(def bi_interrupt ((i int)) (list (list int))
  (split_spaces "timer_at interrupt_enable interrupt_wait interrupt_done supervisor_call"))
(def bi_region ((i int)) (list (list int))
  (split_spaces "region_open region_close region_read8 region_read16 region_read32 region_read64 region_write8 region_write16 region_write32 region_write64 barrier"))
(def bi_user_ints ((i int)) (list (list int))
  (split_spaces "space_new frame_new space_map space_map_device frame_address frame_sync space_unmap space_free frame_free frame_free_count"))
(def bi_user ((i int)) (list (list int))
  (split_spaces "space_read space_write user_run supervisor_send supervisor_receive cpu_run cpu_trapped region_read_bytes region_write_bytes"))
(def bi_path ((i int)) (list (list int))
  (split_spaces "open_read open_write open_append rename open_bytes remove"))
(def bi_to_list ((i int)) (list (list int)) (split_spaces "arg buffer_bytes"))
(def bi_array ((i int)) (list (list int))
  (split_spaces "array_new array_len array_get array_set"))
(def bi_bytes ((i int)) (list (list int))
  (split_spaces "read_bytes read_some bytes_len bytes_get bytes_from_list bytes_to_list write_bytes bytes_slice bytes_concat"))

; Every builtin's name. Built once per context (ctx_builtins), not per call.
(def builtin_names ((i int)) (list (list int))
  (names_then (bi_int_int_int 0)
    (names_then (bi_int_int_bool 0)
      (names_then (bi_bool_bool 0)
        (names_then (bi_list_ops 0)
          (names_then (bi_io 0)
            (names_then (bi_path 0)
              (names_then (bi_to_list 0)
                (names_then (bi_array 0)
                  (names_then (bi_bytes 0)
                    (names_then (bi_user 0)
                      (names_then (bi_float 0)
                        (split_spaces "neg bit_count not eq hash compare")))))))))))))

; The floats of spec 6.17. check_float_builtin checks them.
(def bi_float ((i int)) (list (list int))
  (split_spaces "float_add float_sub float_mul float_div float_neg float_sqrt float_lt float_le float_gt float_ge float_from_int float_to_int float_bits float_from_bits"))

(def check_float_builtin ((n (list int)) (ats (list Ty)) (o int)) (Checked Ty)
  (if (any_eq n (split_spaces "float_add float_sub float_mul float_div float_neg float_sqrt"))
      (need_all n ats o (TyFloat) (TyFloat))
      (if (any_eq n (split_spaces "float_lt float_le float_gt float_ge"))
          (need_all n ats o (TyFloat) (TyBool))
          (if (any_eq n (split_spaces "float_to_int float_bits"))
              (need_all n ats o (TyFloat) (TyInt))
              (need_all n ats o (TyInt) (TyFloat))))))

(def names_then ((xs (list (list int))) (ys (list (list int))))
    (list (list int))
  (if (is_empty xs) ys (cons (head xs) (names_then (tail xs) ys))))

(def builtin_arity ((n (list int))) int
  (if (any_eq n (split_spaces "read_byte arg_count open_buffer clock_ns barrier space_new frame_new interrupt_wait machine board_reset frame_free_count cpu_count cpu_trapped cpu_wait heap_left"))
      0
      (if (any_eq n (split_spaces
            "float_neg float_sqrt float_from_int float_to_int float_bits float_from_bits neg bit_count not hash head tail is_empty write_byte read_from close flush arg open_read open_write open_append open_bytes remove buffer_bytes array_len read_bytes bytes_len bytes_from_list bytes_to_list bytes_concat timer_at interrupt_enable interrupt_done frame_address space_free frame_free region_close"))
          1
          (if (any_eq n (split_spaces "array_set region_write8 region_write16 region_write32 region_write64 space_read supervisor_receive bytes_slice region_read_bytes"))
              3
              (builtin_arity_wide n)))))

(def builtin_arity_wide ((n (list int))) int
  (if (any_eq n (split_spaces "write_bytes space_map space_map_device supervisor_call"))
      4
      (if (any_eq n (split_spaces "space_write supervisor_send cpu_run region_write_bytes")) 5 2)))

(def plural ((n int) (word (list int))) (list int)
  (if (eq n 1) word (append word "s")))

(def wrong_arity_msg ((n (list int)) (want int) (got int)) (list int)
  (append n (append " takes " (append (digits want)
    (append " " (append (plural want "argument")
      (append ", but got " (digits got))))))))

(def type_msg ((what (list int)) (want (list int)) (got Ty)) (list int)
  (append what (append " must be " (append want
    (append ", but this is " (ty_str got))))))

(def check_builtin ((n (list int)) (ats (list Ty)) (o int)) (Checked Ty)
  (if (not (eq (length ats) (builtin_arity n)))
      ((CErr Ty) o (wrong_arity_msg n (builtin_arity n) (length ats)))
      (if (any_eq n (bi_int_int_int 0))
          (need_all n ats o (TyInt) (TyInt))
          (if (any_eq n (bi_int_int_bool 0))
              (need_all n ats o (TyInt) (TyBool))
              (if (any_eq n (bi_bool_bool 0))
                  (need_all n ats o (TyBool) (TyBool))
                  (if (or (or (eq n "neg") (eq n "bit_count")) (any_eq n (bi_io 0)))
                      (need_all n ats o (TyInt) (TyInt))
                      (if (eq n "not")
                          (need_all n ats o (TyBool) (TyBool))
                          (check_other_builtin n ats o))))))))

; hash takes a value of any type, and gives an int. Spec 6.9.
(def check_other_builtin ((n (list int)) (ats (list Ty)) (o int)) (Checked Ty)
  (if (eq n "eq")
      (check_eq ats o)
      (if (eq n "hash")
          (COk (TyInt))
          (if (eq n "compare")
              (check_compare ats o)
              (if (any_eq n (bi_float 0))
                  (check_float_builtin n ats o)
                  (check_other_builtin_paths n ats o))))))

(def check_other_builtin_paths ((n (list int)) (ats (list Ty)) (o int))
    (Checked Ty)
  (if (any_eq n (bi_path 0))
      (need_all n ats o (TyList (TyInt)) (TyInt))
      (if (any_eq n (bi_to_list 0))
          (need_all n ats o (TyInt) (TyList (TyInt)))
          (if (any_eq n (bi_array 0))
              (check_array_builtin n ats o)
              (check_other_builtin_rest n ats o)))))

(def check_other_builtin_rest ((n (list int)) (ats (list Ty)) (o int))
    (Checked Ty)
  (if (any_eq n (bi_bytes 0))
      (check_bytes_builtin n ats o)
      (if (any_eq n (bi_user 0))
          (check_user_builtin n ats o)
          (check_list_builtin n ats o))))

; space_read, supervisor_receive, and region_read_bytes give bytes for
; three ints, space_write, supervisor_send, and region_write_bytes take
; bytes and a range of them, user_run takes and gives a context, an
; (array int), cpu_run takes one between two ints and two more, and
; cpu_trapped gives one. Spec 6.12, 6.13, 6.15, and 6.18.
(def check_user_builtin ((n (list int)) (ats (list Ty)) (o int)) (Checked Ty)
  (if (any_eq n (split_spaces "space_read supervisor_receive region_read_bytes"))
      (need_each n ats o (cons (TyInt) (cons (TyInt) (cons (TyInt) (nil Ty)))) (TyBytes))
      (if (any_eq n (split_spaces "space_write supervisor_send region_write_bytes"))
          (need_each n ats o
            (cons (TyInt) (cons (TyInt) (cons (TyBytes) (cons (TyInt) (cons (TyInt) (nil Ty))))))
            (TyInt))
          (check_cpu_builtin n ats o))))

(def check_cpu_builtin ((n (list int)) (ats (list Ty)) (o int)) (Checked Ty)
  (if (eq n "cpu_run")
      (need_each n ats o
        (cons (TyInt) (cons (TyInt) (cons (TyArray (TyInt)) (cons (TyInt) (cons (TyInt) (nil Ty))))))
        (TyInt))
      (if (eq n "cpu_trapped")
          (need_each n ats o (nil Ty) (TyArray (TyInt)))
          (need_each n ats o (cons (TyInt) (cons (TyArray (TyInt)) (nil Ty)))
            (TyArray (TyInt))))))

; eq takes two values of any one type, which the first determines, as cons's
; list does. Spec 6.8.
(def check_eq ((ats (list Ty)) (o int)) (Checked Ty)
  (if (eq (head (tail ats)) (head ats))
      (COk (TyBool))
      ((CErr Ty) o (type_msg "the second argument of eq" (ty_str (head ats))
                          (head (tail ats))))))

; compare takes two values of any one type, as eq does, and gives an int.
; Spec 6.11.
(def check_compare ((ats (list Ty)) (o int)) (Checked Ty)
  (if (eq (head (tail ats)) (head ats))
      (COk (TyInt))
      ((CErr Ty) o (type_msg "the second argument of compare" (ty_str (head ats))
                          (head (tail ats))))))

; The bytes builtins are not polymorphic: each argument has one type.
(def check_bytes_builtin ((n (list int)) (ats (list Ty)) (o int)) (Checked Ty)
  (if (eq n "read_bytes")
      (need_each n ats o (cons (TyInt) (nil Ty)) (TyBytes))
      (if (eq n "read_some")
          (need_each n ats o (cons (TyInt) (cons (TyInt) (nil Ty))) (TyBytes))
          (check_bytes_rest n ats o))))

(def check_bytes_rest ((n (list int)) (ats (list Ty)) (o int)) (Checked Ty)
  (if (eq n "bytes_len")
      (need_each n ats o (cons (TyBytes) (nil Ty)) (TyInt))
      (if (eq n "bytes_get")
          (need_each n ats o (cons (TyBytes) (cons (TyInt) (nil Ty))) (TyInt))
          (if (eq n "bytes_from_list")
              (need_each n ats o (cons (TyList (TyInt)) (nil Ty)) (TyBytes))
              (if (eq n "bytes_to_list")
                  (need_each n ats o (cons (TyBytes) (nil Ty)) (TyList (TyInt)))
                  (check_bytes_new n ats o))))))

(def check_bytes_new ((n (list int)) (ats (list Ty)) (o int)) (Checked Ty)
  (if (eq n "bytes_slice")
      (need_each n ats o (cons (TyBytes) (cons (TyInt) (cons (TyInt) (nil Ty)))) (TyBytes))
      (if (eq n "bytes_concat")
          (need_each n ats o (cons (TyList (TyBytes)) (nil Ty)) (TyBytes))
          (need_each n ats o
            (cons (TyInt) (cons (TyBytes) (cons (TyInt) (cons (TyInt) (nil Ty)))))
            (TyInt)))))

; Each argument against the type in the same position of wants, which is as
; long, since the arity was checked first.
(def need_each ((n (list int)) (ats (list Ty)) (o int) (wants (list Ty)) (res Ty))
    (Checked Ty)
  (if (is_empty ats)
      (COk res)
      (if (eq (head ats) (head wants))
          (need_each n (tail ats) o (tail wants) res)
          ((CErr Ty) o (type_msg (append "an argument of " n) (ty_str (head wants))
                              (head ats))))))

; The array builtins are polymorphic in the element type as the list ones
; are: array_new's element argument determines it, and every other takes the
; array first.
(def check_array_builtin ((n (list int)) (ats (list Ty)) (o int)) (Checked Ty)
  (if (eq n "array_new")
      (if (eq (head ats) (TyInt))
          (COk (TyArray (head (tail ats))))
          ((CErr Ty) o (type_msg "the length given to array_new" "int" (head ats))))
      (let a (head ats)
        (if (not (ty_is_array a))
            ((CErr Ty) o (type_msg (append "the first argument of " n) "an array" a))
            (if (eq n "array_len")
                (COk (TyInt))
                (if (not (eq (head (tail ats)) (TyInt)))
                    ((CErr Ty) o (type_msg (append "the index given to " n) "int"
                                        (head (tail ats))))
                    (if (eq n "array_get")
                        (COk (ty_elem a))
                        (check_array_set a (head (tail (tail ats))) o))))))))

(def check_array_set ((a Ty) (x Ty) (o int)) (Checked Ty)
  (if (eq x (ty_elem a))
      (COk a)
      ((CErr Ty) o (type_msg "the element stored in an array" (ty_str (ty_elem a)) x))))

(def need_all ((n (list int)) (ats (list Ty)) (o int) (want Ty) (res Ty))
    (Checked Ty)
  (if (is_empty ats)
      (COk res)
      (if (eq (head ats) want)
          (need_all n (tail ats) o want res)
          ((CErr Ty) o (type_msg (append "an argument of " n) (ty_str want)
                              (head ats))))))

; cons, head, tail, and is_empty are polymorphic in the element type, which
; the list argument determines. No inference is needed anywhere.
(def check_list_builtin ((n (list int)) (ats (list Ty)) (o int)) (Checked Ty)
  (if (eq n "cons")
      (check_cons ats o)
      (let a (head ats)
        (if (not (ty_is_list a))
            ((CErr Ty) o (type_msg n "a list" a))
            (if (eq n "head")
                (COk (ty_elem a))
                (if (eq n "tail")
                    (COk a)
                    (COk (TyBool))))))))

(def check_cons ((ats (list Ty)) (o int)) (Checked Ty)
  (let x (head ats)
    (let xs (head (tail ats))
      (if (not (ty_is_list xs))
          ((CErr Ty) o (type_msg "the second argument of cons" "a list" xs))
          (if (eq x (ty_elem xs))
              (COk xs)
              ((CErr Ty) o (type_msg "the element consed onto a list"
                                  (ty_str (ty_elem xs)) x)))))))

; ------------------------------------------------------------ expressions

(def check_expr ((e Expr) (env (list Bind)) (ctx Ctx)) (Checked Ty)
  (match e
    ((EInt o v) (COk (TyInt)))
    ((EFloat o m p g) (COk (TyFloat)))
    ((EBool o v) (COk (TyBool)))
    ((EStr o s) (COk (TyList (TyInt))))
    ((ENil o elem) (check_nil o elem ctx))
    ((EVar o n) (check_var o n env ctx))
    ((EIf o c a b) (check_if o c a b env ctx))
    ((ELet o n v body) (check_let o n v body env ctx))
    ((ECtor o n tys args) (check_ctor_expr o n tys args env ctx))
    ((EMatch o subject arms) (check_match o subject arms env ctx))
    ((ECall o n args) (check_call o n args env ctx))
    ((EField o f e) (check_field o f e env ctx))
    ((EWith o f e v) (check_with o f e v env ctx))))

; ---------------------------------------------------------------- fields

; (.f e): e's type says which field f is. Spec 5.8.
(def check_field ((o int) (f (list int)) (e Expr) (env (list Bind)) (ctx Ctx))
    (Checked Ty)
  (match (check_expr e env ctx)
    ((CErr eo m) ((CErr Ty) eo m))
    ((COk et) (field_type o f et ctx))))

; (.f e v): v must have the field's type, and the result has e's.
(def check_with ((o int) (f (list int)) (e Expr) (v Expr) (env (list Bind))
                 (ctx Ctx)) (Checked Ty)
  (match (check_expr e env ctx)
    ((CErr eo m) ((CErr Ty) eo m))
    ((COk et)
      (match (field_type o f et ctx)
        ((CErr eo m) ((CErr Ty) eo m))
        ((COk ft)
          (match (check_expr v env ctx)
            ((CErr eo m) ((CErr Ty) eo m))
            ((COk vt)
              (if (eq vt ft)
                  (COk et)
                  ((CErr Ty) o (type_msg
                    (append "field " (append f (append " of " (ty_str et))))
                    (ty_str ft) vt))))))))))

; The type of field f of a value of type et, or why there is none: et must
; be a data type, not a type parameter, with one constructor that names f.
(def field_type ((o int) (f (list int)) (et Ty) (ctx Ctx)) (Checked Ty)
  (if (not (ty_is_data et))
      ((CErr Ty) o (append "fields belong to data types, but this is " (ty_str et)))
      (if (is_param et (.tparams ctx))
          ((CErr Ty) o (append (as_written (ty_name et))
            " is a type parameter, so its fields are not known"))
          (match (find_data (ty_name et) (.datas ctx))
            ((None) ((CErr Ty) o (append "unknown type " (ty_name et))))
            ((Some dd)
              (if (not (eq (length (.ctors dd)) 1))
                  ((CErr Ty) o (append (as_written (.name dd)) (append " has "
                    (append (digits (length (.ctors dd)))
                      " constructors, so its fields are not read by name; match on it"))))
                  (field_of_ctor o f et (head (.ctors dd)) dd)))))))

(def field_of_ctor ((o int) (f (list int)) (et Ty) (c Ctor) (dd DataDef))
    (Checked Ty)
  (match c
    ((C co cn ns fts)
      (let i (index_of f ns)
        (if (lt i 0)
            ((CErr Ty) o (append "unknown field " (append f (append " of "
              (as_written (.name dd))))))
            (COk (ty_subst (nth_ty fts i)
                           (zip_binds (.params dd) (ty_args et)))))))))

(def nth_ty ((ts (list Ty)) (i int)) Ty
  (if (is_empty ts)
      (TyInt)
      (if (eq i 0) (head ts) (nth_ty (tail ts) (sub i 1)))))

(def check_nil ((o int) (elem Ty) (ctx Ctx)) (Checked Ty)
  (let bad (ty_problem elem (.datas ctx) (.tparams ctx))
    (if (is_empty bad)
        (COk (TyList elem))
        ((CErr Ty) o bad))))

(def check_var ((o int) (n (list int)) (env (list Bind)) (ctx Ctx)) (Checked Ty)
  (match (find_bind n env)
    ((Some t) (COk t))
    ((None)
      (if (or (is_builtin_in n ctx) (sig_exists n (.sigs ctx)))
          ((CErr Ty) o (append n " is a function, and L0 has no function values"))
          ((CErr Ty) o (append "unknown variable " n))))))

(def sig_exists ((n (list int)) (sigs (list Sig))) bool
  (match (find_sig n sigs)
    ((Some s) true)
    ((None) false)))

(def if_branch_msg ((at Ty) (bt Ty)) (list int)
  (append "the branches of an if must have the same type, but then is "
    (append (ty_str at) (append " and else is " (ty_str bt)))))

(def check_if ((o int) (c Expr) (a Expr) (b Expr) (env (list Bind))
               (ctx Ctx)) (Checked Ty)
  (match (check_expr c env ctx)
    ((CErr eo m) ((CErr Ty) eo m))
    ((COk ct)
      (if (not (eq ct (TyBool)))
          ((CErr Ty) o (type_msg "the condition of an if" "bool" ct))
          (check_if_branches o a b env ctx)))))

(def check_if_branches ((o int) (a Expr) (b Expr) (env (list Bind))
                        (ctx Ctx)) (Checked Ty)
  (match (check_expr a env ctx)
    ((CErr eo m) ((CErr Ty) eo m))
    ((COk at)
      (match (check_expr b env ctx)
        ((CErr eo m) ((CErr Ty) eo m))
        ((COk bt)
          (if (eq at bt)
              (COk at)
              ((CErr Ty) o (if_branch_msg at bt))))))))

(def check_let ((o int) (n (list int)) (v Expr) (body Expr) (env (list Bind))
                (ctx Ctx)) (Checked Ty)
  (match (check_expr v env ctx)
    ((CErr eo m) ((CErr Ty) eo m))
    ((COk vt) (check_expr body (cons (B n vt) env) ctx))))

(def check_args ((args (list Expr)) (env (list Bind)) (ctx Ctx)
                 (acc (list Ty))) (Checked (list Ty))
  (if (is_empty args)
      (COk (rev_onto acc (nil Ty)))
      (match (check_expr (head args) env ctx)
        ((CErr o m) ((CErr (list Ty)) o m))
        ((COk t) (check_args (tail args) env ctx (cons t acc))))))

(def check_call ((o int) (n (list int)) (args (list Expr)) (env (list Bind))
                 (ctx Ctx)) (Checked Ty)
  (match (check_args args env ctx (nil Ty))
    ((CErr eo m) ((CErr Ty) eo m))
    ((COk ats)
      (if (is_builtin_in n ctx)
          (check_builtin n ats o)
          (match (find_sig n (.sigs ctx))
            ((None) (check_call_missing o n env))
            ((Some s) (check_user_call o n ats s)))))))

(def check_call_missing ((o int) (n (list int)) (env (list Bind))) (Checked Ty)
  (match (find_bind n env)
    ((Some t)
      ((CErr Ty) o (append n " is a local value, and L0 cannot call a value")))
    ((None) ((CErr Ty) o (append "unknown function " n)))))

(def check_user_call ((o int) (n (list int)) (ats (list Ty)) (s Sig))
    (Checked Ty)
  (match s
    ((S sn tps sps sr)
      (if (not (eq (length ats) (length sps)))
          ((CErr Ty) o (wrong_arity_msg n (length sps) (length ats)))
          (if (is_empty tps)
              (match (match_params n ats sps o 1)
                ((CErr eo m) ((CErr Ty) eo m))
                ((COk ignored) (COk sr)))
              (match (infer_fields n ats sps tps (nil Bind) o 1)
                ((CErr eo m) ((CErr Ty) eo m))
                ((COk bs) (COk (ty_subst sr bs)))))))))

(def match_params ((n (list int)) (ats (list Ty)) (sps (list Ty)) (o int)
                   (i int)) (Checked Ty)
  (if (is_empty ats)
      (COk (TyInt))
      (if (eq (head ats) (head sps))
          (match_params n (tail ats) (tail sps) o (add i 1))
          ((CErr Ty) o (type_msg
            (append "argument " (append (digits i) (append " of " n)))
            (ty_str (head sps)) (head ats))))))

; ------------------------------------------------------ constructors

; tys are the type arguments, if the construction wrote them. Spec 5.6.
(def check_ctor_expr ((o int) (n (list int)) (tys (list Ty)) (args (list Expr))
                      (env (list Bind)) (ctx Ctx)) (Checked Ty)
  (match (find_ctor n (.ctors ctx))
    ((None) ((CErr Ty) o (append "unknown constructor " n)))
    ((Some ci)
      (match (check_args args env ctx (nil Ty))
        ((CErr eo m) ((CErr Ty) eo m))
        ((COk ats) (check_ctor_fields o n tys ats ci ctx))))))

(def check_ctor_fields ((o int) (n (list int)) (tys (list Ty)) (ats (list Ty))
                        (ci CtorInfo) (ctx Ctx)) (Checked Ty)
  (let fts (.fields ci)
    (if (not (eq (length ats) (length fts)))
        ((CErr Ty) o (append n (append " takes " (append (digits (length fts))
          (append " " (append (plural (length fts) "field")
            (append ", but got " (digits (length ats)))))))))
        (if (not (is_empty tys))
            (check_ctor_written o n tys ats ci ctx)
            (if (is_empty (.params ci))
                (match (match_params n ats fts o 1)
                  ((CErr eo m) ((CErr Ty) eo m))
                  ((COk ignored)
                    (COk (TyData (.type_name ci) (nil Ty)))))
                (check_ctor_inferred o n ats ci))))))

; ((C type...) arg...): the types are the data type's arguments.
(def check_ctor_written ((o int) (n (list int)) (tys (list Ty)) (ats (list Ty))
                         (ci CtorInfo) (ctx Ctx)) (Checked Ty)
  (let ps (.params ci)
    (if (not (eq (length tys) (length ps)))
        ((CErr Ty) o (ty_arity_msg (.type_name ci) (length ps)
                                (length tys)))
        (let bad (tys_problem tys (.datas ctx) (.tparams ctx))
          (if (not (is_empty bad))
              ((CErr Ty) o bad)
              (match (match_params n ats (tys_subst (.fields ci) (zip_binds ps tys))
                                   o 1)
                ((CErr eo m) ((CErr Ty) eo m))
                ((COk ignored) (COk (TyData (.type_name ci) tys)))))))))

; (C arg...) of a type with parameters: the arguments' types say what the
; parameters stand for, so the constructor must mention every one.
(def check_ctor_inferred ((o int) (n (list int)) (ats (list Ty)) (ci CtorInfo))
    (Checked Ty)
  (let ps (.params ci)
    (let missing (undetermined ps (.fields ci))
      (if (not (is_empty missing))
          ((CErr Ty) o (undetermined_msg n missing (.type_name ci) ps))
          (match (infer_fields n ats (.fields ci) ps (nil Bind) o 1)
            ((CErr eo m) ((CErr Ty) eo m))
            ((COk bs)
              (COk (TyData (.type_name ci) (args_of ps bs)))))))))

(def undetermined_msg ((n (list int)) (p (list int)) (tn (list int))
                       (ps (list (list int)))) (list int)
  (append n (append " does not determine parameter " (append p
    (append " of " (append tn
      (append ", so it is written with the type's arguments: (("
        (append n (append (names_str ps) ") ...)")))))))))

; " a b ...", each name preceded by a space.
(def names_str ((ns (list (list int)))) (list int)
  (if (is_empty ns)
      ""
      (append " " (append (head ns) (names_str (tail ns))))))

; Each argument against its field, left to right, so a parameter an earlier
; argument bound is reported against the type it was bound to.
(def infer_fields ((n (list int)) (ats (list Ty)) (fts (list Ty))
                   (ps (list (list int))) (bs (list Bind)) (o int) (i int))
    (Checked (list Bind))
  (if (is_empty ats)
      (COk bs)
      (match (match_ty (head fts) (head ats) ps bs)
        ((COk bs2) (infer_fields n (tail ats) (tail fts) ps bs2 o (add i 1)))
        ((CErr eo m)
          ((CErr (list Bind)) o (type_msg
            (append "argument " (append (digits i) (append " of " n)))
            (ty_str (ty_subst (head fts) bs)) (head ats)))))))

; ------------------------------------------------------------------ match

(def check_match ((o int) (subject Expr) (arms (list Arm)) (env (list Bind))
                  (ctx Ctx)) (Checked Ty)
  (match (check_expr subject env ctx)
    ((CErr eo m) ((CErr Ty) eo m))
    ((COk st)
      (if (not (if (ty_is_data st) (not (is_param st (.tparams ctx))) false))
          ((CErr Ty) o (type_msg "the subject of a match" "a data type" st))
          (match (find_data (ty_name st) (.datas ctx))
            ((None) ((CErr Ty) o (append "unknown type " (ty_name st))))
            ((Some dd)
              (check_arms o arms dd (zip_binds (.params dd) (ty_args st))
                          env ctx)))))))

; bs binds the data type's parameters to the subject type's arguments.
(def check_arms ((o int) (arms (list Arm)) (dd DataDef) (bs (list Bind))
                 (env (list Bind)) (ctx Ctx)) (Checked Ty)
  (match (check_each_arm arms dd bs env ctx (nil (list int)))
    ((CErr eo m) ((CErr Ty) eo m))
    ((COk armty)
      (let missing (missing_ctor (.ctors dd) (seen_ctors arms))
        (if (is_empty missing)
            (COk armty)
            ((CErr Ty) o (append "match on " (append (.name dd)
              (append " is missing an arm for " missing)))))))))


(def seen_ctors ((arms (list Arm))) (list (list int))
  (if (is_empty arms)
      (nil (list int))
      (cons (.ctor (head arms)) (seen_ctors (tail arms)))))

; The first constructor of the type with no arm, or an empty name.
(def missing_ctor ((cs (list Ctor)) (seen (list (list int)))) (list int)
  (if (is_empty cs)
      ""
      (if (any_eq (.name (head cs)) seen)
          (missing_ctor (tail cs) seen)
          (.name (head cs)))))

; Checks every arm, requiring they all have the same type. dups carries the
; constructors already seen, which is what makes a repeated arm an error.
(def check_each_arm ((arms (list Arm)) (dd DataDef) (bs (list Bind))
                     (env (list Bind)) (ctx Ctx) (dups (list (list int))))
    (Checked Ty)
  (if (is_empty arms)
      (COk (TyInt))
      (match (check_one_arm (head arms) dd bs env ctx dups)
        ((CErr eo m) ((CErr Ty) eo m))
        ((COk t) (check_rest_arms t arms dd bs env ctx dups)))))

(def check_rest_arms ((t Ty) (arms (list Arm)) (dd DataDef) (bs (list Bind))
                      (env (list Bind)) (ctx Ctx) (dups (list (list int))))
    (Checked Ty)
  (if (is_empty (tail arms))
      (COk t)
      (match (check_each_arm (tail arms) dd bs env ctx
               (cons (.ctor (head arms)) dups))
        ((CErr eo m) ((CErr Ty) eo m))
        ((COk rest)
          (if (eq t rest)
              (COk t)
              ((CErr Ty) (.offset (head (tail arms)))
                (append "all match arms must have the same type, but one is "
                  (append (ty_str t) (append " and another is "
                    (ty_str rest))))))))))

(def check_one_arm ((a Arm) (dd DataDef) (bs (list Bind)) (env (list Bind))
                    (ctx Ctx) (dups (list (list int)))) (Checked Ty)
  (match a
    ((A o cn names body)
      (if (any_eq cn dups)
          ((CErr Ty) o (append cn " already has an arm in this match"))
          (match (find_ctor cn (.ctors ctx))
            ((None) ((CErr Ty) o (append "unknown constructor " cn)))
            ((Some ci)
              (check_arm_binds o cn names body ci dd bs env ctx)))))))

(def check_arm_binds ((o int) (cn (list int)) (names (list (list int)))
                      (body Expr) (ci CtorInfo) (dd DataDef) (bs (list Bind))
                      (env (list Bind)) (ctx Ctx)) (Checked Ty)
  (if (not (eq (.type_name ci) (.name dd)))
      ((CErr Ty) o (append cn (append " is a constructor of "
        (append (.type_name ci) (append ", not " (.name dd))))))
      (if (not (eq (length names) (length (.fields ci))))
          ((CErr Ty) o (append cn (append " has "
            (append (digits (length (.fields ci)))
              (append " " (append (plural (length (.fields ci)) "field")
                (append ", but this pattern binds "
                  (digits (length names)))))))))
          (let dup (dup_name names (nil (list int)))
            (if (not (is_empty dup))
                ((CErr Ty) o (append dup " is bound twice in the same pattern"))
                (check_expr body
                  (bind_fields names (tys_subst (.fields ci) bs) env)
                  ctx))))))

(def bind_fields ((names (list (list int))) (fts (list Ty)) (env (list Bind)))
    (list Bind)
  (if (is_empty names)
      env
      (bind_fields (tail names) (tail fts)
        (cons (B (head names) (head fts)) env))))

(def dup_name ((ns (list (list int))) (seen (list (list int)))) (list int)
  (if (is_empty ns)
      ""
      (if (any_eq (head ns) seen)
          (head ns)
          (dup_name (tail ns) (cons (head ns) seen)))))

; ----------------------------------------------------------- declarations

(def collect_sigs ((ds (list Decl)) (acc (list Sig))) (list Sig)
  (if (is_empty ds)
      acc
      (match (head ds)
        ((DData o n ps cs) (collect_sigs (tail ds) acc))
        ((DDef o n fps ps ret body)
          (collect_sigs (tail ds) (cons (S n fps (param_tys ps) ret) acc))))))

(def max_fields ((cs (list Ctor)) (best int)) int
  (if (is_empty cs)
      best
      (match (head cs)
        ((C o n ns fts)
          (let w (length fts)
            (max_fields (tail cs) (if (gt w best) w best)))))))

(def collect_datas ((ds (list Decl)) (acc (list DataDef))) (list DataDef)
  (if (is_empty ds)
      acc
      (match (head ds)
        ((DDef o n fps ps ret body) (collect_datas (tail ds) acc))
        ((DData o n tps cs)
          (collect_datas (tail ds) (cons (DD n tps cs (max_fields cs 0)) acc))))))

(def collect_ctor_infos ((ds (list Decl)) (acc (list CtorInfo)))
    (list CtorInfo)
  (if (is_empty ds)
      acc
      (match (head ds)
        ((DDef o n fps ps ret body) (collect_ctor_infos (tail ds) acc))
        ((DData o n tps cs)
          (collect_ctor_infos (tail ds) (ctor_infos_of n tps cs 0 acc))))))

; Tags are the constructor's zero-based position in its declaration, per spec
; section 10.1.
(def ctor_infos_of ((tn (list int)) (tps (list (list int))) (cs (list Ctor))
                    (tag int) (acc (list CtorInfo))) (list CtorInfo)
  (if (is_empty cs)
      acc
      (match (head cs)
        ((C o n ns fts)
          (ctor_infos_of tn tps (tail cs) (add tag 1)
            (cons (CI n tn tag tps ns fts) acc))))))

(def param_tys ((ps (list Param))) (list Ty)
  (if (is_empty ps)
      (nil Ty)
      (match (head ps)
        ((P n t) (cons t (param_tys (tail ps)))))))

(def params_to_env ((ps (list Param)) (env (list Bind))) (list Bind)
  (if (is_empty ps)
      env
      (match (head ps)
        ((P n t) (params_to_env (tail ps) (cons (B n t) env))))))

(def dup_param ((ps (list Param)) (seen (list (list int)))) (list int)
  (if (is_empty ps)
      ""
      (match (head ps)
        ((P n t)
          (if (any_eq n seen) n (dup_param (tail ps) (cons n seen)))))))

(def one_diag ((o int) (m (list int))) (list Diag)
  (cons (D o m) (nil Diag)))

(def ret_mismatch_msg ((n (list int)) (ret Ty) (bt Ty)) (list int)
  (append n (append " declares return type "
    (append (ty_str ret) (append ", but its body is " (ty_str bt))))))

; What is wrong with the first bad parameter or return type, if any. fps are
; the function's type parameters.
(def bad_sig_ty ((ps (list Param)) (ret Ty) (ds (list DataDef))
                 (fps (list (list int)))) (list int)
  (if (is_empty ps)
      (ty_problem ret ds fps)
      (match (head ps)
        ((P n t)
          (let bad (ty_problem t ds fps)
            (if (is_empty bad) (bad_sig_ty (tail ps) ret ds fps) bad))))))

(def check_decl ((d Decl) (ctx Ctx)) (list Diag)
  (match d
    ((DData o n tps cs) (check_data_decl o n tps cs ctx))
    ((DDef o n fps ps ret body)
      (check_def_decl o n fps ps ret body (.tparams ctx fps)))))

(def check_def_decl ((o int) (n (list int)) (fps (list (list int)))
                     (ps (list Param)) (ret Ty) (body Expr) (ctx Ctx)) (list Diag)
  (let dup (dup_param ps (nil (list int)))
    (if (not (is_empty dup))
        (one_diag o (append "parameter " (append dup " is declared twice")))
        (let dup2 (dup_name fps (nil (list int)))
          (if (not (is_empty dup2))
              (one_diag o (append "type parameter "
                            (append (as_written dup2) " is declared twice")))
              (let bad (bad_sig_ty ps ret (.datas ctx) fps)
                (if (not (is_empty bad))
                    (one_diag o bad)
                    (let missing (undetermined fps (param_tys ps))
                      (if (not (is_empty missing))
                          (one_diag o (undetermined_fn_msg n missing))
                          (check_body o n ps ret body ctx))))))))))

; Every type parameter is mentioned by a parameter's type, since that is how
; a call finds it. Spec 4.1.
(def undetermined_fn_msg ((n (list int)) (p (list int))) (list int)
  (append "type parameter " (append (as_written p) (append " of " (append n
    " is in no parameter's type, so no call could say what it is")))))

; A type parameter's name as its def wrote it, before hide_tparams.
(def as_written ((p (list int))) (list int)
  (as_written_from p p))

(def as_written_from ((s (list int)) (p (list int))) (list int)
  (if (is_empty s)
      p
      (if (starts_with s "'s ") (drop_n s 3) (as_written_from (tail s) p))))

(def check_body ((o int) (n (list int)) (ps (list Param)) (ret Ty)
                 (body Expr) (ctx Ctx)) (list Diag)
  (match (check_expr body (params_to_env ps (nil Bind)) ctx)
    ((CErr eo m) (one_diag eo m))
    ((COk bt)
      (if (eq bt ret)
          (nil Diag)
          (one_diag o (ret_mismatch_msg n ret bt))))))

; A data declaration's parameters must be distinct, and its field types must
; be types, with its parameters in scope.
(def check_data_decl ((o int) (n (list int)) (tps (list (list int)))
                      (cs (list Ctor)) (ctx Ctx)) (list Diag)
  (let dup (dup_name tps (nil (list int)))
    (if (not (is_empty dup))
        (one_diag o (append "type parameter " (append dup " is declared twice")))
        (let bad (bad_field_ty cs (.datas ctx) tps)
          (if (is_empty bad)
              (let dupf (dup_field cs)
                (if (is_empty dupf) (nil Diag) (one_diag o dupf)))
              (one_diag o bad))))))

(def bad_field_ty ((cs (list Ctor)) (ds (list DataDef)) (tps (list (list int))))
    (list int)
  (if (is_empty cs)
      ""
      (match (head cs)
        ((C o n ns fts)
          (let bad (tys_problem fts ds tps)
            (if (is_empty bad) (bad_field_ty (tail cs) ds tps) bad))))))

; What is wrong with the first constructor naming a field twice, if any.
(def dup_field ((cs (list Ctor))) (list int)
  (if (is_empty cs)
      ""
      (match (head cs)
        ((C o n ns fts)
          (let dup (dup_name ns (nil (list int)))
            (if (is_empty dup)
                (dup_field (tail cs))
                (append "field " (append dup (append " of constructor "
                  (append n " is declared twice"))))))))))

(def decl_name ((d Decl)) (list int)
  (match d
    ((DDef o n fps ps ret body) n)
    ((DData o n tps cs) n)))

(def decl_offset ((d Decl)) int
  (match d
    ((DDef o n fps ps ret body) o)
    ((DData o n tps cs) o)))

(def is_def ((d Decl)) bool
  (match d
    ((DDef o n fps ps ret body) true)
    ((DData o n tps cs) false)))

; Duplicate function names, duplicate type names, and duplicate constructor
; names, in one pass so that diagnostics come out in source order.
;
; Function names get one seen-set per group, because a program function
; sharing a name with a prelude function is shadowing rather than a collision.
; Type and constructor names get a single set spanning both groups, which is
; per group all the same: group_upper has already renamed every prelude one
; the program also declares. Constructors of different types share one
; namespace because a match arm names a constructor without naming its type,
; so the constructor alone determines it. Spec 7.1.
(def check_dups ((ds (list Decl)) (pre int) (fpre (list (list int)))
                 (fprog (list (list int))) (tseen (list (list int)))
                 (cseen (list (list int))) (acc (list Diag))) (list Diag)
  (if (is_empty ds)
      acc
      (let d (head ds)
        (if (is_def d)
            (check_fn_dup d (tail ds) pre fpre fprog tseen cseen acc)
            (check_data_dups d (tail ds) pre fpre fprog tseen cseen acc)))))

(def check_fn_dup ((d Decl) (rest (list Decl)) (pre int)
                   (fpre (list (list int))) (fprog (list (list int)))
                   (tseen (list (list int))) (cseen (list (list int)))
                   (acc (list Diag))) (list Diag)
  (if (in_prelude d pre)
      (if (any_eq (decl_name d) fpre)
          (check_dups rest pre fpre fprog tseen cseen (dup_fn_diag d acc))
          (check_dups rest pre (cons (decl_name d) fpre) fprog tseen cseen
                      acc))
      (if (any_eq (decl_name d) fprog)
          (check_dups rest pre fpre fprog tseen cseen (dup_fn_diag d acc))
          (check_dups rest pre fpre (cons (decl_name d) fprog) tseen cseen
                      acc))))

(def dup_fn_diag ((d Decl) (acc (list Diag))) (list Diag)
  (cons (D (decl_offset d)
          (append "function " (append (decl_name d) " is already defined")))
        acc))

(def check_data_dups ((d Decl) (rest (list Decl)) (pre int)
                      (fpre (list (list int))) (fprog (list (list int)))
                      (tseen (list (list int))) (cseen (list (list int)))
                      (acc (list Diag))) (list Diag)
  (if (any_eq (decl_name d) tseen)
      (check_dups rest pre fpre fprog tseen cseen
        (cons (D (decl_offset d) (append "data type "
          (append (decl_name d) " is already declared"))) acc))
      (let dupc (dup_ctor_name (decl_ctors d) cseen)
        (if (not (is_empty dupc))
            (check_dups rest pre fpre fprog (cons (decl_name d) tseen)
              (add_ctor_names (decl_ctors d) cseen)
              (cons (D (decl_offset d) (append "constructor "
                (append dupc " is already declared"))) acc))
            (check_dups rest pre fpre fprog (cons (decl_name d) tseen)
              (add_ctor_names (decl_ctors d) cseen) acc)))))

(def decl_ctors ((d Decl)) (list Ctor)
  (match d
    ((DData o n tps cs) cs)
    ((DDef o n fps ps ret body) (nil Ctor))))

(def dup_ctor_name ((cs (list Ctor)) (seen (list (list int)))) (list int)
  (if (is_empty cs)
      ""
      (if (any_eq (.name (head cs)) seen)
          (.name (head cs))
          (dup_ctor_name (tail cs) (cons (.name (head cs)) seen)))))

(def add_ctor_names ((cs (list Ctor)) (seen (list (list int))))
    (list (list int))
  (if (is_empty cs)
      seen
      (add_ctor_names (tail cs) (cons (.name (head cs)) seen))))

; Each declaration is checked against the view its own group has, so which
; names a call can see depends on which side of the prelude boundary the
; declaration holding it fell.
(def check_decls ((ds (list Decl)) (cpre Ctx) (cprog Ctx) (pre int)
                  (acc (list Diag))) (list Diag)
  (if (is_empty ds)
      acc
      (check_decls (tail ds) cpre cprog pre
        (prepend_diags
          (check_decl (head ds) (view_for (head ds) cpre cprog pre))
          acc))))

(def view_for ((d Decl) (cpre Ctx) (cprog Ctx) (pre int)) Ctx
  (if (in_prelude d pre) cpre cprog))

(def in_prelude ((d Decl) (pre int)) bool
  (lt (decl_offset d) pre))

(def prepend_diags ((xs (list Diag)) (acc (list Diag))) (list Diag)
  (if (is_empty xs)
      acc
      (prepend_diags (tail xs) (cons (head xs) acc))))

; A missing main is a whole-program problem with no meaningful position, so
; it carries offset -1 and is rendered without a file, line, or column. Offset
; 0 would name the first byte of the first file, which is somewhere the reader
; has no reason to look. A main that exists is checked whether or not one is
; required, and a wrong one is reported where it is declared. Spec 9.1.
(def check_main ((uds (list Decl)) (want_main bool)) (list Diag)
  (match (find_sig "main" (collect_sigs uds (nil Sig)))
    ((None)
      (if want_main
          (one_diag -1 "this program has no main function")
          (nil Diag)))
    ((Some s) (check_main_sig s (main_offset uds)))))

; The two forms of spec 9: a function of the whole input, or a program that
; streams and returns its exit status.
(def check_main_sig ((s Sig) (o int)) (list Diag)
  (match s
    ((S n tps ps ret)
      (if (not (is_empty tps))
          (one_diag o "main takes no type parameters")
          (if (is_empty ps)
              (if (eq ret (TyInt))
                  (nil Diag)
                  (one_diag o "a main with no parameters must return int"))
              (check_input_main ps ret o))))))

(def check_input_main ((ps (list Ty)) (ret Ty) (o int)) (list Diag)
  (if (not (eq (length ps) 1))
      (one_diag o (main_params_msg 0))
      (if (not (eq (head ps) (TyList (TyInt))))
          (one_diag o (main_params_msg 0))
          (if (main_ret_ok ret)
              (nil Diag)
              (one_diag o "main must return (list int), int, or bool")))))

(def main_params_msg ((i int)) (list int)
  "main must take one parameter of type (list int), or none")

(def main_offset ((ds (list Decl))) int
  (if (is_empty ds)
      -1
      (if (is_main_def (head ds))
          (decl_offset (head ds))
          (main_offset (tail ds)))))

(def is_main_def ((d Decl)) bool
  (if (is_def d) (eq (decl_name d) "main") false))

(def main_ret_ok ((t Ty)) bool
  (or (eq t (TyInt))
      (or (eq t (TyBool)) (eq t (TyList (TyInt))))))

(def build_ctx ((ds (list Decl))) Ctx
  (sigs_ctx (collect_sigs ds (nil Sig)) ds))

; A context whose calls see the functions sigs. A builtin is only what no
; def among them shadows. Spec 7.
(def sigs_ctx ((sigs (list Sig)) (ds (list Decl))) Ctx
  (Cx sigs
      (collect_ctor_infos ds (nil CtorInfo))
      (collect_datas ds (nil DataDef))
      (builtins_seen (builtin_names 0) sigs)
      (nil (list int))))

(def builtins_seen ((bs (list (list int))) (sigs (list Sig))) (list (list int))
  (if (is_empty bs)
      bs
      (if (sig_exists (head bs) sigs)
          (builtins_seen (tail bs) sigs)
          (cons (head bs) (builtins_seen (tail bs) sigs)))))

; ------------------------------------------------------- the two groups
;
; Declarations before the prelude boundary are the prelude, the rest are the
; program, and the difference is only in which function names each can see.
; Type and constructor tables are built from every declaration in both views,
; since group_upper has already made the names each group sees distinct.
; Spec 7.1.

(def prelude_decls ((ds (list Decl)) (pre int) (acc (list Decl))) (list Decl)
  (if (is_empty ds)
      (rev_onto acc (nil Decl))
      (prelude_decls (tail ds) pre
        (if (in_prelude (head ds) pre) (cons (head ds) acc) acc))))

(def program_decls ((ds (list Decl)) (pre int) (acc (list Decl))) (list Decl)
  (if (is_empty ds)
      (rev_onto acc (nil Decl))
      (program_decls (tail ds) pre
        (if (in_prelude (head ds) pre) acc (cons (head ds) acc)))))

; A prelude declaration sees prelude functions only.
(def prelude_view ((ds (list Decl)) (pre int)) Ctx
  (sigs_ctx (collect_sigs (prelude_decls ds pre (nil Decl)) (nil Sig)) ds))

; A program declaration sees both, program first. find_sig takes the first
; match, so putting the program's signatures ahead of the prelude's is the
; whole of shadowing.
(def program_view ((ds (list Decl)) (pre int)) Ctx
  (sigs_ctx (append
              (collect_sigs (program_decls ds pre (nil Decl)) (nil Sig))
              (collect_sigs (prelude_decls ds pre (nil Decl)) (nil Sig)))
            ds))

; want_main is false when checking a fragment rather than a whole program,
; such as a library file or a work in progress. Type correctness is still
; checked in full, and so is a main if there is one; only the requirement to
; define main is relaxed.
;
; pre is the byte offset where the prelude ends, and is 0 when there is no
; prelude, which makes every declaration a program declaration and every rule
; below collapse to the flat namespace L0 had before groups existed.
(def check_program ((ds (list Decl)) (want_main bool) (pre int)) (list Diag)
  (check_grouped (hide_tparams (group_upper ds pre)) want_main pre))

(def check_grouped ((ds (list Decl)) (want_main bool) (pre int)) (list Diag)
  (let uds (program_decls ds pre (nil Decl))
    (rev_onto
      (check_decls ds (prelude_view ds pre) (program_view ds pre) pre
        (check_widths ds
          (check_dups ds pre (nil (list int)) (nil (list int))
                      (nil (list int)) (nil (list int)) (nil Diag))))
      (check_main uds want_main))))

; ------------------------------------------------------ constructor widths
;
; A block's header marks which of its words are pointers in a 32-bit mask,
; and word 0 is the tag, so a constructor has at most 31 fields. Spec 4.

(def check_widths ((ds (list Decl)) (acc (list Diag))) (list Diag)
  (if (is_empty ds)
      acc
      (check_widths (tail ds) (prepend_diags (widths_in (head ds)) acc))))

(def widths_in ((d Decl)) (list Diag)
  (match d
    ((DDef o n fps ps ret body) (nil Diag))
    ((DData o n tps cs) (too_wide o cs))))

(def too_wide ((o int) (cs (list Ctor))) (list Diag)
  (if (is_empty cs)
      (nil Diag)
      (match (head cs)
        ((C co cn ns fts)
          (if (gt (length fts) 31)
              (one_diag o (append "constructor " (append cn (append " has "
                (append (digits (length fts))
                  " fields, and at most 31 are allowed")))))
              (too_wide o (tail cs)))))))

; ------------------------------------------------ upper names per group
;
; A program's type or constructor shadows the prelude's of the same name, and
; a prelude declaration sees only the prelude's. Spec 7.1. Rather than
; resolve per group wherever an upper name is looked up, every upper name in
; a prelude declaration that the program also declares is renamed to one no
; source can write, so from here on the two are simply different names. A
; prelude reference to a type only the program declares is renamed too, and
; so is reported as unknown. A data declaration's own parameters are never
; renamed: they hide a type of the same name (spec 3).

(def group_upper ((ds (list Decl)) (pre int)) (list Decl)
  (if (eq pre 0)
      ds
      (let uds (program_decls ds pre (nil Decl))
        (let tns (declared_types uds (nil (list int)))
          (let cns (declared_ctors uds (nil (list int)))
            (if (and (is_empty tns) (is_empty cns))
                ds
                (rename_prelude ds pre tns cns (nil Decl))))))))

(def declared_types ((ds (list Decl)) (acc (list (list int))))
    (list (list int))
  (if (is_empty ds)
      acc
      (declared_types (tail ds)
        (if (is_def (head ds)) acc (cons (decl_name (head ds)) acc)))))

(def declared_ctors ((ds (list Decl)) (acc (list (list int))))
    (list (list int))
  (if (is_empty ds)
      acc
      (declared_ctors (tail ds) (add_ctor_names (decl_ctors (head ds)) acc))))

(def rename_prelude ((ds (list Decl)) (pre int) (tns (list (list int)))
                     (cns (list (list int))) (acc (list Decl))) (list Decl)
  (if (is_empty ds)
      (rev_onto acc (nil Decl))
      (rename_prelude (tail ds) pre tns cns
        (cons (if (in_prelude (head ds) pre)
                  (rn_decl (head ds) tns cns)
                  (head ds))
              acc))))

(def rn_name ((n (list int)) (ns (list (list int)))) (list int)
  (if (any_eq n ns) (append "prelude's " n) n))

(def rn_decl ((d Decl) (tns (list (list int))) (cns (list (list int)))) Decl
  (match d
    ((DDef o n fps ps ret body)
      (DDef o n fps (rn_params ps tns fps) (rn_ty ret tns fps)
            (rn_expr body tns cns fps)))
    ((DData o n tps cs)
      (DData o (rn_name n tns) tps (rn_ctors cs tns cns tps)))))

(def rn_ctors ((cs (list Ctor)) (tns (list (list int))) (cns (list (list int)))
               (tps (list (list int)))) (list Ctor)
  (if (is_empty cs)
      (nil Ctor)
      (match (head cs)
        ((C o cn ns fts)
          (cons (C o (rn_name cn cns) ns (rn_tys fts tns tps))
                (rn_ctors (tail cs) tns cns tps))))))

(def rn_params ((ps (list Param)) (tns (list (list int))) (tps (list (list int))))
    (list Param)
  (if (is_empty ps)
      (nil Param)
      (match (head ps)
        ((P n t) (cons (P n (rn_ty t tns tps))
                       (rn_params (tail ps) tns tps))))))

(def rn_ty ((t Ty) (tns (list (list int))) (tps (list (list int)))) Ty
  (match t
    ((TyInt) (TyInt))
    ((TyBool) (TyBool))
    ((TyList e) (TyList (rn_ty e tns tps)))
    ((TyData n as)
      (TyData (if (any_eq n tps) n (rn_name n tns)) (rn_tys as tns tps)))
    ((TyArray e) (TyArray (rn_ty e tns tps)))
    ((TyFloat) (TyFloat))
    ((TyBytes) (TyBytes))))

(def rn_tys ((ts (list Ty)) (tns (list (list int))) (tps (list (list int))))
    (list Ty)
  (if (is_empty ts)
      (nil Ty)
      (cons (rn_ty (head ts) tns tps) (rn_tys (tail ts) tns tps))))

; tps are the type parameters of the def holding e, which are never renamed.
(def rn_expr ((e Expr) (tns (list (list int))) (cns (list (list int)))
              (tps (list (list int)))) Expr
  (match e
    ((EInt o v) (EInt o v))
    ((EFloat o m p g) e)
    ((EBool o v) (EBool o v))
    ((EStr o s) (EStr o s))
    ((EVar o n) (EVar o n))
    ((EIf o c a b)
      (EIf o (rn_expr c tns cns tps) (rn_expr a tns cns tps) (rn_expr b tns cns tps)))
    ((ELet o n v b) (ELet o n (rn_expr v tns cns tps) (rn_expr b tns cns tps)))
    ((ENil o t) (ENil o (rn_ty t tns tps)))
    ((ECtor o n tys args)
      (ECtor o (rn_name n cns) (rn_tys tys tns tps) (rn_exprs args tns cns tps)))
    ((EMatch o s arms)
      (EMatch o (rn_expr s tns cns tps) (rn_arms arms tns cns tps)))
    ((ECall o n args) (ECall o n (rn_exprs args tns cns tps)))
    ((EField o f e) (EField o f (rn_expr e tns cns tps)))
    ((EWith o f e v) (EWith o f (rn_expr e tns cns tps) (rn_expr v tns cns tps)))))

(def rn_exprs ((es (list Expr)) (tns (list (list int))) (cns (list (list int)))
               (tps (list (list int)))) (list Expr)
  (if (is_empty es)
      (nil Expr)
      (cons (rn_expr (head es) tns cns tps) (rn_exprs (tail es) tns cns tps))))

(def rn_arms ((as (list Arm)) (tns (list (list int))) (cns (list (list int)))
              (tps (list (list int)))) (list Arm)
  (if (is_empty as)
      (nil Arm)
      (match (head as)
        ((A o cn ns b)
          (cons (A o (rn_name cn cns) ns (rn_expr b tns cns tps))
                (rn_arms (tail as) tns cns tps))))))

; ------------------------------------------- a function's type parameters
;
; A def's type parameter hides a data type of the same name within the def
; (spec 4.1). Types compare by name, so one that names a declared data type
; is renamed throughout its def to a name no source can write, "f's T",
; and the two can never be taken for each other.

(def hide_tparams ((ds (list Decl))) (list Decl)
  (let tns (declared_types ds (nil (list int)))
    (if (no_generic ds) ds (hide_decls ds tns (nil Decl)))))

(def no_generic ((ds (list Decl))) bool
  (if (is_empty ds)
      true
      (match (head ds)
        ((DData o n tps cs) (no_generic (tail ds)))
        ((DDef o n fps ps ret body)
          (if (is_empty fps) (no_generic (tail ds)) false)))))

(def hide_decls ((ds (list Decl)) (tns (list (list int))) (acc (list Decl)))
    (list Decl)
  (if (is_empty ds)
      (rev_onto acc (nil Decl))
      (hide_decls (tail ds) tns (cons (hide_decl (head ds) tns) acc))))

(def hide_decl ((d Decl) (tns (list (list int)))) Decl
  (match d
    ((DData o n tps cs) d)
    ((DDef o n fps ps ret body)
      (let bs (hide_binds n fps tns)
        (if (is_empty bs)
            d
            (DDef o n (hidden_names fps bs) (params_inst ps bs) (ty_inst ret bs)
                  (expr_inst body bs)))))))

; Each of fps that is also a type's name, bound to its hidden name.
(def hide_binds ((n (list int)) (fps (list (list int))) (tns (list (list int))))
    (list Bind)
  (if (is_empty fps)
      (nil Bind)
      (if (any_eq (head fps) tns)
          (cons (B (head fps) (TyData (append n (append "'s " (head fps))) (nil Ty)))
                (hide_binds n (tail fps) tns))
          (hide_binds n (tail fps) tns))))

(def hidden_names ((fps (list (list int))) (bs (list Bind))) (list (list int))
  (if (is_empty fps)
      fps
      (cons (match (find_bind (head fps) bs)
              ((Some t) (ty_name t))
              ((None) (head fps)))
            (hidden_names (tail fps) bs))))

; ty_subst, except that a name given arguments is replaced too, by the name
; it is bound to, so that a type parameter given arguments is still one, and
; still an error.
(def ty_inst ((t Ty) (bs (list Bind))) Ty
  (match t
    ((TyList e) (TyList (ty_inst e bs)))
    ((TyArray e) (TyArray (ty_inst e bs)))
    ((TyData n as)
      (match (find_bind n bs)
        ((Some x) (if (is_empty as) x (TyData (ty_name x) (tys_inst as bs))))
        ((None) (TyData n (tys_inst as bs)))))
    ((TyInt) t)
    ((TyBool) t)
    ((TyFloat) t)
    ((TyBytes) t)))

(def tys_inst ((ts (list Ty)) (bs (list Bind))) (list Ty)
  (if (is_empty ts) ts (cons (ty_inst (head ts) bs) (tys_inst (tail ts) bs))))

(def params_inst ((ps (list Param)) (bs (list Bind))) (list Param)
  (if (is_empty ps)
      ps
      (match (head ps)
        ((P n t) (cons (P n (ty_inst t bs)) (params_inst (tail ps) bs))))))

; Every type written in e, in a nil or a construction, with bs applied.
(def expr_inst ((e Expr) (bs (list Bind))) Expr
  (match e
    ((EInt o v) e)
    ((EFloat o m p g) e)
    ((EBool o v) e)
    ((EStr o s) e)
    ((EVar o n) e)
    ((EIf o c a b) (EIf o (expr_inst c bs) (expr_inst a bs) (expr_inst b bs)))
    ((ELet o n v b) (ELet o n (expr_inst v bs) (expr_inst b bs)))
    ((ENil o t) (ENil o (ty_inst t bs)))
    ((ECtor o n tys args) (ECtor o n (tys_inst tys bs) (exprs_inst args bs)))
    ((EMatch o s arms) (EMatch o (expr_inst s bs) (arms_inst arms bs)))
    ((ECall o n args) (ECall o n (exprs_inst args bs)))
    ((EField o f e) (EField o f (expr_inst e bs)))
    ((EWith o f e v) (EWith o f (expr_inst e bs) (expr_inst v bs)))))

(def exprs_inst ((es (list Expr)) (bs (list Bind))) (list Expr)
  (if (is_empty es) es (cons (expr_inst (head es) bs) (exprs_inst (tail es) bs))))

(def arms_inst ((as (list Arm)) (bs (list Bind))) (list Arm)
  (if (is_empty as)
      as
      (match (head as)
        ((A o cn ns b) (cons (A o cn ns (expr_inst b bs)) (arms_inst (tail as) bs))))))

; ------------------------------------------------- copies of a function
;
; A function with type parameters is compiled once per combination of
; whether each stands for a counted type, a list, data, array, or bytes, or
; for int or bool (spec 10.2). Before emission, each such def is replaced by
; its copies, with every type parameter replaced by (list int) or int, which
; stand for their kinds, and every call to one is renamed to the copy its
; arguments' types choose. The emitter then sees only functions without type
; parameters, and decides everything a copy's types decide as for any other
; function. A copy's name has a dot, which no source name has.

(data Mono
  (Mo Expr Ty))

(data Monos
  (Mos (list Expr) (list Ty)))

(def mono_program ((ds (list Decl)) (pre int)) (list Decl)
  (if (no_generic ds)
      ds
      (mono_decls ds pre (prelude_view ds pre) (program_view ds pre) (nil Decl))))

(def mono_decls ((ds (list Decl)) (pre int) (pv Ctx) (gv Ctx) (acc (list Decl)))
    (list Decl)
  (if (is_empty ds)
      (rev_onto acc (nil Decl))
      (mono_decls (tail ds) pre pv gv
        (mono_decl (head ds) (if (in_prelude (head ds) pre) pv gv) acc))))

; d, or its copies, pushed onto acc.
(def mono_decl ((d Decl) (ctx Ctx) (acc (list Decl))) (list Decl)
  (match d
    ((DData o n tps cs) (cons d acc))
    ((DDef o n fps ps ret body)
      (if (is_empty fps)
          (cons (DDef o n fps ps ret (mono_body body ps ctx)) acc)
          (mono_copies o n fps ps ret body ctx (copy_kinds fps) acc)))))

(def mono_copies ((o int) (n (list int)) (fps (list (list int))) (ps (list Param))
                  (ret Ty) (body Expr) (ctx Ctx) (kss (list (list bool)))
                  (acc (list Decl))) (list Decl)
  (if (is_empty kss)
      acc
      (let bs (kind_binds fps (head kss))
        (let cps (params_inst ps bs)
          (mono_copies o n fps ps ret body ctx (tail kss)
            (cons (DDef o (copy_name n (head kss)) (nil (list int)) cps
                        (ty_inst ret bs) (mono_body (expr_inst body bs) cps ctx))
                  acc))))))

; Every combination of kinds for the parameters, true for counted, in the
; order of their names: 0...0 first.
(def copy_kinds ((fps (list (list int)))) (list (list bool))
  (if (is_empty fps)
      (cons (nil bool) (nil (list bool)))
      (let rest (copy_kinds (tail fps))
        (prefix_kinds false rest (prefix_kinds true rest (nil (list bool)))))))

(def prefix_kinds ((k bool) (kss (list (list bool))) (tail_kss (list (list bool))))
    (list (list bool))
  (if (is_empty kss)
      tail_kss
      (cons (cons k (head kss)) (prefix_kinds k (tail kss) tail_kss))))

(def kind_binds ((fps (list (list int))) (ks (list bool))) (list Bind)
  (if (is_empty fps)
      (nil Bind)
      (cons (B (head fps) (if (head ks) (TyList (TyInt)) (TyInt)))
            (kind_binds (tail fps) (tail ks)))))

(def copy_name ((n (list int)) (ks (list bool))) (list int)
  (append n (cons 46 (kind_digits ks))))

(def kind_digits ((ks (list bool))) (list int)
  (if (is_empty ks) (nil int) (cons (if (head ks) 49 48) (kind_digits (tail ks)))))

; Whether values of type t are counted: spec 10.1 and 10.3.
(def ty_is_counted ((t Ty)) bool
  (or (ty_is_list t) (or (ty_is_data t) (or (ty_is_array t) (ty_is_bytes t)))))

; What each type parameter stands for, as kinds, for a call the checker
; accepted.
(def kinds_of ((tps (list (list int))) (bs (list Bind))) (list bool)
  (if (is_empty tps)
      (nil bool)
      (cons (match (find_bind (head tps) bs)
              ((Some t) (ty_is_counted t))
              ((None) false))
            (kinds_of (tail tps) bs))))

(def mono_body ((body Expr) (ps (list Param)) (ctx Ctx)) Expr
  (match (mono_expr body (params_to_env ps (nil Bind)) ctx)
    ((Mo e t) e)))

; e with every call to a function with type parameters renamed to its copy,
; and e's type, which the renaming needs: computed as the checker computes
; it, for an expression the checker accepted.
(def mono_expr ((e Expr) (env (list Bind)) (ctx Ctx)) Mono
  (match e
    ((EInt o v) (Mo e (TyInt)))
    ((EFloat o m p g) (Mo e (TyFloat)))
    ((EBool o v) (Mo e (TyBool)))
    ((EStr o s) (Mo e (TyList (TyInt))))
    ((ENil o t) (Mo e (TyList t)))
    ((EVar o n) (Mo e (match (find_bind n env) ((Some t) t) ((None) (TyInt)))))
    ((EIf o c a b)
      (match (mono_expr a env ctx)
        ((Mo a2 at)
          (Mo (EIf o (mono_e c env ctx) a2 (mono_e b env ctx)) at))))
    ((ELet o n v b)
      (match (mono_expr v env ctx)
        ((Mo v2 vt)
          (match (mono_expr b (cons (B n vt) env) ctx)
            ((Mo b2 bt) (Mo (ELet o n v2 b2) bt))))))
    ((ECtor o n tys args) (mono_ctor o n tys args env ctx))
    ((EMatch o s arms) (mono_match o s arms env ctx))
    ((ECall o n args) (mono_call o n args env ctx))
    ((EField o f e)
      (match (mono_expr e env ctx)
        ((Mo e2 et)
          (Mo (EField o f e2)
              (match (field_type o f et ctx) ((COk t) t) ((CErr eo m) (TyInt)))))))
    ((EWith o f e v)
      (match (mono_expr e env ctx)
        ((Mo e2 et) (Mo (EWith o f e2 (mono_e v env ctx)) et))))))

(def mono_e ((e Expr) (env (list Bind)) (ctx Ctx)) Expr
  (match (mono_expr e env ctx) ((Mo e2 t) e2)))

(def mono_args ((es (list Expr)) (env (list Bind)) (ctx Ctx)) Monos
  (if (is_empty es)
      (Mos es (nil Ty))
      (match (mono_expr (head es) env ctx)
        ((Mo e t)
          (match (mono_args (tail es) env ctx)
            ((Mos rest ts) (Mos (cons e rest) (cons t ts))))))))

(def mono_ctor ((o int) (n (list int)) (tys (list Ty)) (args (list Expr))
                (env (list Bind)) (ctx Ctx)) Mono
  (match (mono_args args env ctx)
    ((Mos args2 ats)
      (Mo (ECtor o n tys args2)
          (match (find_ctor n (.ctors ctx))
            ((Some ci) (TyData (.type_name ci) (ctor_type_args ci tys ats)))
            ((None) (TyInt)))))))

(def mono_call ((o int) (n (list int)) (args (list Expr)) (env (list Bind))
                (ctx Ctx)) Mono
  (match (mono_args args env ctx)
    ((Mos args2 ats)
      (if (is_builtin_in n ctx)
          (Mo (ECall o n args2)
              (match (check_builtin n ats o) ((COk t) t) ((CErr eo m) (TyInt))))
          (match (find_sig n (.sigs ctx))
            ((None) (Mo (ECall o n args2) (TyInt)))
            ((Some s)
              (match s
                ((S sn tps sps sr)
                  (if (is_empty tps)
                      (Mo (ECall o n args2) sr)
                      (match (match_tys sps ats tps (nil Bind))
                        ((COk bs)
                          (Mo (ECall o (copy_name n (kinds_of tps bs)) args2)
                              (ty_subst sr bs)))
                        ((CErr eo m) (Mo (ECall o n args2) sr))))))))))))

(data MonoArms
  (MoA (list Arm) Ty))

(def mono_match ((o int) (s Expr) (arms (list Arm)) (env (list Bind)) (ctx Ctx))
    Mono
  (match (mono_expr s env ctx)
    ((Mo s2 st)
      (match (find_data (ty_name st) (.datas ctx))
        ((None) (Mo (EMatch o s2 arms) (TyInt)))
        ((Some dd)
          (match (mono_arms arms (zip_binds (.params dd) (ty_args st)) env ctx
                            (nil Arm) (TyInt))
            ((MoA as2 t) (Mo (EMatch o s2 as2) t))))))))

; bs binds the data type's parameters to the subject type's arguments.
(def mono_arms ((arms (list Arm)) (bs (list Bind)) (env (list Bind)) (ctx Ctx)
                (acc (list Arm)) (t Ty)) MonoArms
  (if (is_empty arms)
      (MoA (rev_onto acc (nil Arm)) t)
      (match (head arms)
        ((A ao cn names body)
          (match (mono_expr body (bind_fields names (arm_fields_at cn bs ctx) env)
                            ctx)
            ((Mo b2 bt)
              (mono_arms (tail arms) bs env ctx (cons (A ao cn names b2) acc) bt)))))))

(def arm_fields_at ((cn (list int)) (bs (list Bind)) (ctx Ctx)) (list Ty)
  (match (find_ctor cn (.ctors ctx))
    ((Some ci) (tys_subst (.fields ci) bs))
    ((None) (nil Ty))))

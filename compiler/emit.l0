; emit.l0 -- typed AST to LLVM IR text.
;
; This stage cannot fail. The checker has already proved the program correct,
; so there is no error plumbing here, which is what keeps it readable.
;
; Two decisions from spec section 10 do most of the work:
;
;   Every value is an i64, so no type information survives into codegen. An
;   operand is just a piece of text: "42", "%t7", or "%a0". Even match needs
;   no types: an arm names its constructor, and the constructor table gives
;   the tag.
;
;   Temporaries and labels are NAMED. LLVM requires unnamed values (%0, %1) to
;   be numbered in strict sequence, counting function parameters and implicit
;   block labels, which is a rich source of bugs that only appear on complex
;   functions. Named values have no such rule.
;
; let needs no memory at all: it binds a name to an operand that already
; exists. Only if and match need storage, and both use an alloca and a load
; rather than a phi node, so no basic-block bookkeeping is needed. Emission
; is structured, so a value is only ever used in the block that defines it or
; in a block that block dominates. In tail position neither joins: each
; branch returns, which is what lets a call there be a musttail call.

(data Emit
  (Em int (list int)))                  ; next name number, reversed output

; An expression's value carries its type, computed bottom-up as the checker
; computes it, because allocation has to say which words of a block are
; pointers, and only the static type knows whether a list's elements are.
; The instruction helpers below produce int; each expression form sets the
; type it really has.
(data EmitVal
  (Val (list int) Ty Emit))             ; operand text, type, new state

(data EmitOps
  (Ops (list (list int)) (list Ty) Emit))   ; operand texts, types, state

(data EBind
  (EB (list int) (list int) Ty))        ; L0 name, operand text, type

; Local bindings, the global tables, the function names that resolve to the
; prelude from here, and how many parameters each function takes. The
; emitter builds the constructor table from the declarations itself, so it
; still needs nothing the checker produced.
(data Env
  (Ev (list EBind) Ctx (list (list int)) (list Pad)))

(data EnvEmit
  (EnvSt Env Emit))

(def env_binds ((e Env)) (list EBind) (match e ((Ev b c p k) b)))
(def env_ctx ((e Env)) Ctx (match e ((Ev b c p k) c)))
(def env_prelude ((e Env)) (list (list int)) (match e ((Ev b c p k) p)))
(def env_pads ((e Env)) (list Pad) (match e ((Ev b c p k) k)))

(def env_bind ((n (list int)) (op (list int)) (t Ty) (e Env)) Env
  (match e ((Ev b c p k) (Ev (cons (EB n op t) b) c p k))))

; ------------------------------------------------------------------ output

(def emit_line ((s (list int)) (st Emit)) Emit
  (match st
    ((Em n acc) (Em n (push "\n" (push s acc))))))

(def emit_text ((st Emit)) (list int)
  (match st ((Em n acc) (rev acc))))

(def fresh_id ((st Emit)) (list int)
  (match st ((Em n acc) (digits n))))

(def bump ((st Emit)) Emit
  (match st ((Em n acc) (Em (add n 1) acc))))

(def lookup_operand ((n (list int)) (binds (list EBind))) (list int)
  (if (is_empty binds)
      "0"
      (match (head binds)
        ((EB bn op t)
          (if (list_eq n bn) op (lookup_operand n (tail binds)))))))

(def lookup_type ((n (list int)) (binds (list EBind))) Ty
  (if (is_empty binds)
      (TyInt)
      (match (head binds)
        ((EB bn op t)
          (if (list_eq n bn) t (lookup_type n (tail binds)))))))

; Whether a value of type t is a pointer to a heap block rather than a plain
; word. Spec 10.1.
(def ty_is_ptr ((t Ty)) bool
  (or (ty_is_list t) (ty_is_data t)))

(def val_op ((v EmitVal)) (list int) (match v ((Val o t s) o)))
(def val_st ((v EmitVal)) Emit (match v ((Val o t s) s)))

; The same value, known to have type t.
(def retype ((v EmitVal) (t Ty)) EmitVal
  (match v ((Val o old s) (Val o t s))))

; "i64 a, i64 b"
(def fmt_ops ((ops (list (list int)))) (list int)
  (if (is_empty ops)
      ""
      (if (is_empty (tail ops))
          (append "i64 " (head ops))
          (append "i64 " (append (head ops)
            (append ", " (fmt_ops (tail ops))))))))

(def emit_assign ((rhs (list int)) (st Emit)) EmitVal
  (let name (append "%t" (fresh_id st))
    (Val name (TyInt)
      (emit_line (append "  " (append name (append " = " rhs))) (bump st)))))

(def emit_rt_call ((fn (list int)) (ops (list (list int))) (st Emit)) EmitVal
  (emit_assign (append "call i64 @" (append fn
    (append "(" (append (fmt_ops ops) ")")))) st))

(def emit_binop ((op (list int)) (a (list int)) (b (list int)) (st Emit))
    EmitVal
  (emit_assign (append op (append " i64 " (append a (append ", " b)))) st))

(def emit_cmp ((pred (list int)) (a (list int)) (b (list int)) (st Emit))
    EmitVal
  (match (emit_assign (append "icmp " (append pred
            (append " i64 " (append a (append ", " b))))) st)
    ((Val c t st1)
      (retype (emit_assign (append "zext i1 " (append c " to i64")) st1)
              (TyBool)))))

(def two_ops ((a (list int)) (b (list int))) (list (list int))
  (cons a (cons b (nil (list int)))))

(def one_op ((a (list int))) (list (list int))
  (cons a (nil (list int))))

; ------------------------------------------------------------- expressions

; ---------------------------------------------------------------- ownership
;
; Every value of list or data type an expression produces is an owned
; reference, which whoever receives it consumes: a function's parameter, a
; field of a new block, a let binding, or the function's result. A binding
; keeps its own reference, so each use of a pointer-typed variable adds one,
; and the binding's reference is released when its scope ends.
;
; tl is true in tail position. There every scope enclosing the expression
; ends with it, so every binding in the environment is released, and before
; the final call rather than after it: a release after the call would take
; it out of tail position, and it could no longer be a tail call. The
; expression then returns its value itself. Spec 8 and 10.3.

(def emit_inc ((op (list int)) (st Emit)) Emit
  (emit_line (append "  call void @l0_inc(i64 " (append op ")")) st))

(def emit_dec ((op (list int)) (st Emit)) Emit
  (emit_line (append "  call void @l0_dec(i64 " (append op ")")) st))

(def release_all ((binds (list EBind)) (st Emit)) Emit
  (if (is_empty binds)
      st
      (match (head binds)
        ((EB n op t)
          (release_all (tail binds)
            (if (ty_is_ptr t) (emit_dec op st) st))))))

; The first n bindings: those a match arm added in front of the rest.
(def release_n ((binds (list EBind)) (n int) (st Emit)) Emit
  (if (le n 0)
      st
      (match (head binds)
        ((EB bn op t)
          (release_n (tail binds) (sub n 1)
            (if (ty_is_ptr t) (emit_dec op st) st))))))

; A value computed in tail position is followed by releasing every binding,
; and is then the function's result.
(def finish ((tl bool) (env Env) (v EmitVal)) EmitVal
  (if tl
      (match v
        ((Val o t s) (emit_ret true (Val o t (release_all (env_binds env) s)))))
      v))

(def emit_ret ((tl bool) (v EmitVal)) EmitVal
  (if tl
      (match v ((Val o t s) (Val o t (emit_line (append "  ret i64 " o) s))))
      v))

(def emit_use ((n (list int)) (env Env) (st Emit)) EmitVal
  (let op (lookup_operand n (env_binds env))
    (let t (lookup_type n (env_binds env))
      (Val op t (if (ty_is_ptr t) (emit_inc op st) st)))))

(def emit_expr ((e Expr) (env Env) (tl bool) (st Emit)) EmitVal
  (match e
    ((EInt o v) (finish tl env (Val (digits v) (TyInt) st)))
    ((EBool o v) (finish tl env (Val (if v "1" "0") (TyBool) st)))
    ((ENil o t) (finish tl env (Val "0" (TyList t) st)))
    ((EStr o s) (finish tl env (emit_string (rev s) "0" st)))
    ((EVar o n) (finish tl env (emit_use n env st)))
    ((EIf o c a b) (emit_if c a b env tl st))
    ((ELet o n v body) (emit_let n v body env tl st))
    ((ECtor o n args) (finish tl env (emit_ctor n args env st)))
    ((EMatch o subject arms) (emit_match subject arms env tl st))
    ((ECall o n args) (emit_call n args env tl st))))

; A let binds a name to an operand that already exists, and takes over the
; reference the value came with. Outside tail position it releases that
; reference after its body; in tail position the body does.
(def emit_let ((n (list int)) (v Expr) (body Expr) (env Env) (tl bool)
               (st Emit)) EmitVal
  (match (emit_expr v env false st)
    ((Val vv vt st1)
      (let env2 (env_bind n vv vt env)
        (if tl
            (emit_expr body env2 true st1)
            (match (emit_expr body env2 false st1)
              ((Val bv bt st2)
                (Val bv bt (if (ty_is_ptr vt) (emit_dec vv st2) st2)))))))))

; A cons cell's layout mask marks its tail word as a pointer, and its head
; word too when the elements are lists or data. Spec 10.1.
(def cons_mask ((elem Ty)) (list int)
  (if (ty_is_ptr elem) "3" "2"))

; Bytes arrive reversed so the chain can be built from the end forwards.
(def emit_string ((rs (list int)) (acc (list int)) (st Emit)) EmitVal
  (if (is_empty rs)
      (Val acc (TyList (TyInt)) st)
      (match (emit_rt_call "l0_new_cons"
               (cons (digits (head rs)) (two_ops acc "2")) st)
        ((Val r t st1) (emit_string (tail rs) r st1)))))

(def emit_store ((v (list int)) (slot (list int)) (st Emit)) Emit
  (emit_line (append "  store i64 " (append v (append ", ptr " slot))) st))

; An arm's value goes to the join slot, or in tail position the arm has
; returned it already. The arm reports the value's type, which the checker
; has proved is the same for every arm.
(def emit_arm ((lbl (list int)) (e Expr) (slot (list int))
               (lend (list int)) (env Env) (tl bool) (st Emit)) EmitVal
  (let st1 (emit_line (append lbl ":") st)
    (match (emit_expr e env tl st1)
      ((Val v t st2)
        (Val "" t
          (if tl
              st2
              (emit_line (append "  br label %" lend)
                (emit_store v slot st2))))))))

; A slot to join through, which tail position does without.
(def emit_slot ((slot (list int)) (tl bool) (st Emit)) Emit
  (if tl st (emit_line (append "  " (append slot " = alloca i64")) st)))

(def emit_if ((c Expr) (a Expr) (b Expr) (env Env) (tl bool) (st Emit))
    EmitVal
  (let id (fresh_id st)
    (let slot (append "%r" id)
      (let st1 (emit_slot slot tl (bump st))
        (match (emit_expr c env false st1)
          ((Val cv ct st2) (emit_if_arms id slot cv a b env tl st2)))))))

(def emit_if_arms ((id (list int)) (slot (list int)) (cv (list int))
                   (a Expr) (b Expr) (env Env) (tl bool) (st Emit)) EmitVal
  (let lthen (append "Lt" id)
    (let lelse (append "Le" id)
      (let lend (append "Lx" id)
        (match (emit_assign (append "icmp ne i64 " (append cv ", 0")) st)
          ((Val cb cbt st1)
            (let st2 (emit_line (append "  br i1 " (append cb
                        (append ", label %" (append lthen
                          (append ", label %" lelse))))) st1)
              (match (emit_arm lthen a slot lend env tl st2)
                ((Val x t st3)
                  (emit_if_join lelse b slot lend t env tl st3))))))))))

(def emit_if_join ((lelse (list int)) (b Expr) (slot (list int))
                   (lend (list int)) (t Ty) (env Env) (tl bool) (st Emit))
    EmitVal
  (let st4 (val_st (emit_arm lelse b slot lend env tl st))
    (if tl
        (Val "" t st4)
        (let st5 (emit_line (append lend ":") st4)
          (retype (emit_assign (append "load i64, ptr " slot) st5) t)))))

(def emit_args ((args (list Expr)) (env Env) (st Emit)
                (acc (list (list int))) (tacc (list Ty))) EmitOps
  (if (is_empty args)
      (Ops (rev_strs_onto acc (nil (list int))) (rev_tys tacc (nil Ty)) st)
      (match (emit_expr (head args) env false st)
        ((Val v t st1)
          (emit_args (tail args) env st1 (cons v acc) (cons t tacc))))))

(def rev_tys ((ts (list Ty)) (acc (list Ty))) (list Ty)
  (if (is_empty ts) acc (rev_tys (tail ts) (cons (head ts) acc))))

(def call_sym ((n (list int)) (env Env)) (list int)
  (fn_sym n (env_prelude env)))

; In tail position the bindings are released after the arguments are
; evaluated, which took references of their own, and before the call. A call
; to a function there is a tail call, spec 8, and nothing may come between
; it and the ret, which a builtin's borrowing does not need.
(def emit_call ((n (list int)) (args (list Expr)) (env Env) (tl bool)
                (st Emit)) EmitVal
  (match (emit_args args env st (nil (list int)) (nil Ty))
    ((Ops ops ts st1)
      (let st2 (if tl (release_all (env_binds env) st1) st1)
        (let t (call_type n ts env)
          (emit_ret tl
            (if (is_builtin n)
                (after_borrow n ops ts (retype (emit_op n ops ts st2) t))
                (retype (emit_def_call (call_sym n env) ops env tl st2) t))))))))

(def emit_def_call ((sym (list int)) (ops (list (list int))) (env Env)
                    (tl bool) (st Emit)) EmitVal
  (emit_assign
    (append (if tl "musttail call i64 @" "call i64 @")
      (append sym
        (append "("
          (append (fmt_ops (pad_ops ops (pad_of sym (env_pads env)))) ")"))))
    st))

; head, tail, is_empty, and the builtins taking paths read their list
; arguments without consuming them. Their result gains a reference if it is
; a pointer, and then every argument's reference is released, in order.
(def after_borrow ((n (list int)) (ops (list (list int))) (ts (list Ty))
                   (v EmitVal)) EmitVal
  (if (any_eq n (split_spaces "head tail is_empty open_read open_write open_append rename"))
      (match v
        ((Val r t st)
          (Val r t
            (emit_dec_all ops
              (if (ty_is_ptr t) (emit_inc r st) st)))))
      v))

(def emit_dec_all ((ops (list (list int))) (st Emit)) Emit
  (if (is_empty ops)
      st
      (emit_dec_all (tail ops) (emit_dec (head ops) st))))

; The type a call returns: fixed for most builtins, following the argument
; for cons, head, and tail, and the signature for a function. Spec 6.
(def call_type ((n (list int)) (ts (list Ty)) (env Env)) Ty
  (if (any_eq n (split_spaces "lt le gt ge eq and or not is_empty"))
      (TyBool)
      (if (list_eq n "cons")
          (head (tail ts))
          (if (list_eq n "head")
              (ty_elem (head ts))
              (if (list_eq n "tail")
                  (head ts)
                  (call_type_rest n env))))))

(def call_type_rest ((n (list int)) (env Env)) Ty
  (if (list_eq n "arg")
      (TyList (TyInt))
      (if (is_builtin n)
          (TyInt)
          (match (find_sig n (ctx_sigs (env_ctx env)))
            ((SigFound s) (match s ((S sn ps r) r)))
            ((SigMissing) (TyInt))))))

; ------------------------------------------------------------ constructors

; A block is sized for the widest constructor of its type, per spec section
; 10.1, so every value of a type has the same layout.
(def ctor_block_width ((ci CtorInfo) (ctx Ctx)) int
  (match (find_data (ctor_type_name ci) (ctx_datas ctx))
    ((DataFound dd) (data_max_fields dd))
    ((DataMissing) 0)))

(def emit_ctor ((n (list int)) (args (list Expr)) (env Env) (st Emit))
    EmitVal
  (match (find_ctor n (ctx_ctors (env_ctx env)))
    ((CtorMissing) (Val "0" (TyInt) st))
    ((CtorFound ci)
      (match (emit_args args env st (nil (list int)) (nil Ty))
        ((Ops ops ts st1) (emit_ctor_block ci ops (env_ctx env) st1))))))

; A data block's layout mask has bit k set when word k is a pointer. Word 0
; is the tag, so field i is word i + 1. Spec 10.1.
(def ctor_mask ((fts (list Ty)) (bit int) (acc int)) int
  (if (is_empty fts)
      acc
      (ctor_mask (tail fts) (mul bit 2)
        (if (ty_is_ptr (head fts)) (add acc bit) acc))))

(def emit_ctor_block ((ci CtorInfo) (ops (list (list int))) (ctx Ctx)
                      (st Emit)) EmitVal
  (match (emit_rt_call "l0_new_data"
           (cons (digits (ctor_tag ci))
             (two_ops (digits (ctor_block_width ci ctx))
                      (digits (ctor_mask (ctor_fields ci) 2 0)))) st)
    ((Val blk t st1)
      (Val blk (TyData (ctor_type_name ci))
        (emit_field_stores blk ops 0 st1)))))

(def emit_field_stores ((blk (list int)) (ops (list (list int))) (i int)
                        (st Emit)) Emit
  (if (is_empty ops)
      st
      (emit_field_stores blk (tail ops) (add i 1)
        (emit_line (append "  call void @l0_data_set(i64 " (append blk
          (append ", i64 " (append (digits i)
            (append ", i64 " (append (head ops) ")")))))) st))))

; ------------------------------------------------------------------- match

; Lowered as a switch on the tag into one block per arm, joined through an
; alloca. The default block is unreachable because the checker proved the
; match exhaustive.
(def emit_match ((subject Expr) (arms (list Arm)) (env Env) (tl bool)
                 (st Emit)) EmitVal
  (let id (fresh_id st)
    (let slot (append "%m" id)
      (let st1 (emit_slot slot tl (bump st))
        (match (emit_expr subject env false st1)
          ((Val sv svt st2)
            (emit_match_dispatch id slot sv arms (Mx env tl) st2)))))))

; What every arm of one match shares: the environment and whether the match
; is in tail position.
(data MatchCx
  (Mx Env bool))

(def mx_env ((m MatchCx)) Env (match m ((Mx e t) e)))
(def mx_tl ((m MatchCx)) bool (match m ((Mx e t) t)))

(def arm_label ((id (list int)) (k int)) (list int)
  (append "A" (append id (append "_" (digits k)))))

(def arm_tag ((a Arm) (env Env)) int
  (match (find_ctor (arm_ctor_name a) (ctx_ctors (env_ctx env)))
    ((CtorFound ci) (ctor_tag ci))
    ((CtorMissing) 0)))

(def switch_entries ((arms (list Arm)) (env Env) (id (list int)) (k int))
    (list int)
  (if (is_empty arms)
      ""
      (append " i64 " (append (digits (arm_tag (head arms) env))
        (append ", label %" (append (arm_label id k)
          (switch_entries (tail arms) env id (add k 1))))))))

(def emit_match_dispatch ((id (list int)) (slot (list int)) (sv (list int))
                          (arms (list Arm)) (mx MatchCx) (st Emit)) EmitVal
  (match (emit_rt_call "l0_data_tag" (one_op sv) st)
    ((Val tg tgt st1)
      (let lend (append "Lm" id)
        (let lnm (append "Ln" id)
          (let st2 (emit_line (append "  switch i64 " (append tg
                      (append ", label %" (append lnm
                        (append " [" (append (switch_entries arms (mx_env mx) id 0)
                          " ]")))))) st1)
            (emit_match_tail id slot sv arms mx lend lnm st2)))))))

(def emit_match_tail ((id (list int)) (slot (list int)) (sv (list int))
                      (arms (list Arm)) (mx MatchCx) (lend (list int))
                      (lnm (list int)) (st Emit)) EmitVal
  (match (emit_match_arms arms mx id 0 slot sv lend (TyInt) st)
    ((Val x t st1)
      (let st3 (emit_line "  unreachable" (emit_line (append lnm ":") st1))
        (if (mx_tl mx)
            (Val "" t st3)
            (let st4 (emit_line (append lend ":") st3)
              (retype (emit_assign (append "load i64, ptr " slot) st4) t)))))))

; Every arm has the same type, which the checker proved, so the last one
; emitted gives the match its type.
(def emit_match_arms ((arms (list Arm)) (mx MatchCx) (id (list int)) (k int)
                      (slot (list int)) (sv (list int)) (lend (list int))
                      (t Ty) (st Emit)) EmitVal
  (if (is_empty arms)
      (Val "" t st)
      (match (emit_match_arm (head arms) mx (arm_label id k) slot sv lend st)
        ((Val x at st1)
          (emit_match_arms (tail arms) mx id (add k 1) slot sv lend at st1)))))

; An arm takes a reference to each pointer field it binds, then releases the
; subject, which may free it now that its fields are held separately.
(def emit_match_arm ((a Arm) (mx MatchCx) (lbl (list int)) (slot (list int))
                     (sv (list int)) (lend (list int)) (st Emit)) EmitVal
  (match a
    ((A o cn names body)
      (let st1 (emit_line (append lbl ":") st)
        (match (emit_field_loads sv names (arm_field_tys cn (mx_env mx)) 0
                 (mx_env mx) st1)
          ((EnvSt env2 st2)
            (match (emit_arm_body body env2 (length_strs names) (mx_tl mx)
                     (emit_dec sv st2))
              ((Val v t st3)
                (Val "" t
                  (if (mx_tl mx)
                      st3
                      (emit_line (append "  br label %" lend)
                        (emit_store v slot st3))))))))))))

; Outside tail position an arm releases the fields it bound after its body.
(def emit_arm_body ((body Expr) (env Env) (nfields int) (tl bool) (st Emit))
    EmitVal
  (if tl
      (emit_expr body env true st)
      (match (emit_expr body env false st)
        ((Val v t st1) (Val v t (release_n (env_binds env) nfields st1))))))

(def arm_field_tys ((cn (list int)) (env Env)) (list Ty)
  (match (find_ctor cn (ctx_ctors (env_ctx env)))
    ((CtorFound ci) (ctor_fields ci))
    ((CtorMissing) (nil Ty))))

(def emit_field_loads ((sv (list int)) (names (list (list int)))
                       (fts (list Ty)) (i int) (env Env) (st Emit)) EnvEmit
  (if (is_empty names)
      (EnvSt env st)
      (match (emit_rt_call "l0_data_get" (two_ops sv (digits i)) st)
        ((Val f ft st1)
          (emit_field_loads sv (tail names) (tail fts) (add i 1)
            (env_bind (head names) f (head fts) env)
            (if (ty_is_ptr (head fts)) (emit_inc f st1) st1))))))

; ---------------------------------------------------------------- builtins

(def arith_ops ((i int)) (list (list int)) (split_spaces "add sub mul and or"))
(def cmp_names ((i int)) (list (list int)) (split_spaces "lt le gt ge eq"))
(def cmp_preds ((i int)) (list (list int)) (split_spaces "slt sle sgt sge eq"))
; Every I/O builtin is the runtime call of the same name with l0_ in front.
; Spec 10.3.
(def io_names ((i int)) (list (list int))
  (split_spaces
    "read_byte write_byte read_from write_to open_read open_write close arg_count arg flush open_append rename"))

(def rt_names ((i int)) (list (list int))
  (append_strs (split_spaces "div mod head tail is_empty") (io_names 0)))
(def rt_syms ((i int)) (list (list int))
  (append_strs (split_spaces "l0_div l0_mod l0_head l0_tail l0_is_empty")
               (l0_prefixed (io_names 0))))

(def l0_prefixed ((ns (list (list int)))) (list (list int))
  (if (is_empty ns)
      ns
      (cons (append "l0_" (head ns)) (l0_prefixed (tail ns)))))

(def append_strs ((xs (list (list int))) (ys (list (list int))))
    (list (list int))
  (if (is_empty xs) ys (cons (head xs) (append_strs (tail xs) ys))))

(def nth_str ((xs (list (list int))) (i int)) (list int)
  (if (le i 0) (head xs) (nth_str (tail xs) (sub i 1))))

; A builtin. ts are the arguments' types; emit_call sets the result's type
; afterwards.
(def emit_op ((n (list int)) (ops (list (list int))) (ts (list Ty))
              (st Emit)) EmitVal
  (if (any_eq n (arith_ops 0))
      (emit_binop n (head ops) (head (tail ops)) st)
      (if (ge (index_of n (cmp_names 0)) 0)
          (emit_cmp (nth_str (cmp_preds 0) (index_of n (cmp_names 0)))
                    (head ops) (head (tail ops)) st)
          (if (ge (index_of n (rt_names 0)) 0)
              (emit_rt_call (nth_str (rt_syms 0) (index_of n (rt_names 0)))
                            ops st)
              (emit_op_rest n ops ts st)))))

(def emit_op_rest ((n (list int)) (ops (list (list int))) (ts (list Ty))
                   (st Emit)) EmitVal
  (if (list_eq n "neg")
      (emit_binop "sub" "0" (head ops) st)
      (if (list_eq n "not")
          (emit_binop "xor" (head ops) "1" st)
          (emit_rt_call "l0_new_cons"
            (append_strs ops (one_op (cons_mask (ty_elem (head (tail ts))))))
            st))))

; ------------------------------------------------------------- tail calls
;
; A tail call is emitted as musttail, which LLVM accepts only between
; functions of one prototype. So every function takes as many parameters as
; the widest function in its tail-call component, the functions joined to it
; by tail calls in either direction, and a caller passes 0 for the extra
; ones. Spec 8 and 10.2.

(data Pad
  (Pd (list int) int))                  ; symbol, parameters it takes

; One function: its symbol, its L0 arity, and the symbols it tail-calls.
(data Node
  (Nd (list int) int (list (list int))))

(data Edge
  (Ed int int))                         ; positions of caller and callee

; A call resolves to the prelude's function when the name is one this scope
; reaches there, and to the program's otherwise. The two carry different
; symbols, which is what lets both exist at once, and the program's main has
; a body apart from the entry point the runtime calls. Spec 7.1 and 10.2.
(def fn_sym ((n (list int)) (pnames (list (list int)))) (list int)
  (if (any_eq n pnames)
      (append "l0_p_" n)
      (if (list_eq n "main") "l0_f_main.body" (append "l0_f_" n))))

(def def_sym ((n (list int)) (inpre bool)) (list int)
  (if inpre (append "l0_p_" n) (fn_sym n (nil (list int)))))

(def tail_callees ((e Expr) (pn (list (list int))) (acc (list (list int))))
    (list (list int))
  (match e
    ((EInt o v) acc)
    ((EBool o v) acc)
    ((EStr o s) acc)
    ((EVar o n) acc)
    ((EIf o c a b) (tail_callees b pn (tail_callees a pn acc)))
    ((ELet o n v body) (tail_callees body pn acc))
    ((ENil o t) acc)
    ((ECtor o n args) acc)
    ((EMatch o s arms) (arm_callees arms pn acc))
    ((ECall o n args)
      (if (is_builtin n) acc (cons (fn_sym n pn) acc)))))

(def arm_callees ((arms (list Arm)) (pn (list (list int)))
                  (acc (list (list int)))) (list (list int))
  (if (is_empty arms)
      acc
      (match (head arms)
        ((A o cn names body)
          (arm_callees (tail arms) pn (tail_callees body pn acc))))))

(def length_params ((ps (list Param))) int
  (if (is_empty ps) 0 (add 1 (length_params (tail ps)))))

; Every function of both groups, in declaration order. ppre and pprog are the
; prelude names each group's calls reach.
(def graph_nodes ((ds (list Decl)) (pre int) (ppre (list (list int)))
                  (pprog (list (list int)))) (list Node)
  (if (is_empty ds)
      (nil Node)
      (match (head ds)
        ((DData o n cs) (graph_nodes (tail ds) pre ppre pprog))
        ((DDef o n ps ret body)
          (let inpre (lt o pre)
            (cons (Nd (def_sym n inpre) (length_params ps)
                      (tail_callees body (if inpre ppre pprog)
                                    (nil (list int))))
                  (graph_nodes (tail ds) pre ppre pprog)))))))

(def node_syms ((ns (list Node))) (list (list int))
  (if (is_empty ns)
      (nil (list int))
      (match (head ns) ((Nd s k cs) (cons s (node_syms (tail ns)))))))

(def node_arities ((ns (list Node))) (list int)
  (if (is_empty ns)
      (nil int)
      (match (head ns) ((Nd s k cs) (cons k (node_arities (tail ns)))))))

(def graph_edges ((ns (list Node)) (syms (list (list int))) (i int)
                  (acc (list Edge))) (list Edge)
  (if (is_empty ns)
      acc
      (match (head ns)
        ((Nd s k cs)
          (graph_edges (tail ns) syms (add i 1)
            (callee_edges cs syms i acc))))))

(def callee_edges ((cs (list (list int))) (syms (list (list int))) (i int)
                   (acc (list Edge))) (list Edge)
  (if (is_empty cs)
      acc
      (let j (index_of (head cs) syms)
        (callee_edges (tail cs) syms i
          (if (or (lt j 0) (eq i j)) acc (cons (Ed i j) acc))))))

(def nth_int ((xs (list int)) (i int)) int
  (if (le i 0) (head xs) (nth_int (tail xs) (sub i 1))))

(def set_int ((xs (list int)) (i int) (v int)) (list int)
  (if (le i 0)
      (cons v (tail xs))
      (cons (head xs) (set_int (tail xs) (sub i 1) v))))

; Raises both ends of every edge to the larger arity until nothing changes,
; which leaves each function with its component's widest.
(def spread ((es (list Edge)) (ks (list int))) (list int)
  (let next (spread_once es ks)
    (if (list_eq next ks) ks (spread es next))))

(def spread_once ((es (list Edge)) (ks (list int))) (list int)
  (if (is_empty es)
      ks
      (match (head es)
        ((Ed i j)
          (spread_once (tail es) (spread_edge i j ks))))))

(def spread_edge ((i int) (j int) (ks (list int))) (list int)
  (let a (nth_int ks i)
    (let b (nth_int ks j)
      (if (eq a b)
          ks
          (let m (if (gt a b) a b)
            (set_int (set_int ks i m) j m))))))

(def pad_table ((ns (list Node)) (ks (list int)) (acc (list Pad)))
    (list Pad)
  (if (is_empty ns)
      acc
      (match (head ns)
        ((Nd s k cs)
          (pad_table (tail ns) (tail ks) (cons (Pd s (head ks)) acc))))))

(def module_pads ((ds (list Decl)) (pre int) (ppre (list (list int)))
                  (pprog (list (list int)))) (list Pad)
  (let ns (graph_nodes ds pre ppre pprog)
    (pad_table ns
      (spread (graph_edges ns (node_syms ns) 0 (nil Edge)) (node_arities ns))
      (nil Pad))))

(def pad_of ((s (list int)) (ps (list Pad))) int
  (if (is_empty ps)
      0
      (match (head ps)
        ((Pd n k) (if (list_eq s n) k (pad_of s (tail ps)))))))

; ops followed by as many "0" as bring them to k.
(def pad_ops ((ops (list (list int))) (k int)) (list (list int))
  (if (is_empty ops)
      (if (le k 0) ops (cons "0" (pad_ops ops (sub k 1))))
      (cons (head ops) (pad_ops (tail ops) (sub k 1)))))

; -------------------------------------------------------------- functions

; "i64 %a0, i64 %a1", for k parameters from the i-th.
(def fmt_params ((i int) (k int)) (list int)
  (if (ge i k)
      ""
      (append "i64 %a" (append (digits i)
        (if (ge (add i 1) k) "" (append ", " (fmt_params (add i 1) k)))))))

(def param_binds ((ps (list Param)) (i int) (acc (list EBind))) (list EBind)
  (if (is_empty ps)
      acc
      (match (head ps)
        ((P n t)
          (param_binds (tail ps) (add i 1)
            (cons (EB n (append "%a" (digits i)) t) acc))))))

; What emitting one group's declarations needs: the tables its calls resolve
; against, the names among them that land in the prelude, which group it is,
; and how many parameters every function takes.
(data Scope
  (Sc Ctx (list (list int)) bool (list Pad)))

(def sc_ctx ((s Scope)) Ctx (match s ((Sc c p i k) c)))
(def sc_prelude_names ((s Scope)) (list (list int)) (match s ((Sc c p i k) p)))
(def sc_is_prelude ((s Scope)) bool (match s ((Sc c p i k) i)))
(def sc_pads ((s Scope)) (list Pad) (match s ((Sc c p i k) k)))

; A program is a closed module, and the runtime reaches into it by name for
; exactly one function, so everything else gets internal linkage and LLVM can
; delete what the program never calls. Every function checks the stack
; before doing anything else, since the runtime cannot portably catch running
; off the end of it. The body is in tail position, so it returns by itself.
; Spec 10.2 and 10.3.
(def emit_fn ((d Decl) (sc Scope) (st Emit)) Emit
  (match d
    ((DData o n cs) st)
    ((DDef o n ps ret body)
      (let sym (def_sym n (sc_is_prelude sc))
        (let k (pad_of sym (sc_pads sc))
          (let st1 (emit_line
                     (append "define internal i64 @"
                       (append sym
                         (append "(" (append (fmt_params 0 k) ") {"))))
                     (emit_entry n ps k sc st))
            (let st2 (emit_line "  call void @l0_stack_check()"
                       (emit_line "entry:" st1))
              (emit_line ""
                (emit_line "}"
                  (val_st (emit_expr body
                            (Ev (param_binds ps 0 (nil EBind)) (sc_ctx sc)
                                (sc_prelude_names sc) (sc_pads sc))
                            true st2)))))))))))

; The runtime calls every main as @l0_f_main with one argument, whatever the
; body's prototype, and a main that takes no parameters ignores it. Prelude
; functions are never the entry point, however they are named. Spec 10.2.
(def emit_entry ((n (list int)) (ps (list Param)) (k int) (sc Scope)
                 (st Emit)) Emit
  (if (or (sc_is_prelude sc) (not (list_eq n "main")))
      st
      (let ops (pad_ops (if (is_empty ps) (nil (list int)) (one_op "%a0")) k)
        (emit_line ""
          (emit_line "}"
            (emit_line "  ret i64 %r"
              (emit_line (append "  %r = call i64 @l0_f_main.body("
                           (append (fmt_ops ops) ")"))
                (emit_line "entry:"
                  (emit_line "define i64 @l0_f_main(i64 %a0) {" st)))))))))

; The counter restarts per function purely to keep names short. Numbering is
; a function of program structure either way, so output stays deterministic.
(def reset_counter ((st Emit)) Emit
  (match st ((Em n acc) (Em 0 acc))))

(def emit_fns ((ds (list Decl)) (scpre Scope) (scprog Scope) (pre int)
               (st Emit)) Emit
  (if (is_empty ds)
      st
      (emit_fns (tail ds) scpre scprog pre
        (emit_fn (head ds)
                 (if (in_prelude (head ds) pre) scpre scprog)
                 (reset_counter st)))))

; Function names declared by one group.
(def fn_names ((ds (list Decl)) (acc (list (list int)))) (list (list int))
  (if (is_empty ds)
      acc
      (fn_names (tail ds)
        (if (is_def (head ds)) (cons (decl_name (head ds)) acc) acc))))

; The prelude names a program declaration still reaches: the ones the program
; did not define itself, since its own definition shadows the prelude's.
(def unshadowed ((pnames (list (list int))) (unames (list (list int)))
                 (acc (list (list int)))) (list (list int))
  (if (is_empty pnames)
      acc
      (unshadowed (tail pnames) unames
        (if (any_eq (head pnames) unames) acc (cons (head pnames) acc)))))

(def prelude_names ((ds (list Decl)) (pre int)) (list (list int))
  (fn_names (prelude_decls ds pre (nil Decl)) (nil (list int))))

(def program_prelude_names ((ds (list Decl)) (pre int)) (list (list int))
  (unshadowed (prelude_names ds pre)
    (fn_names (program_decls ds pre (nil Decl)) (nil (list int)))
    (nil (list int))))

; ----------------------------------------------------------------- module

(def ir_header ((i int)) (list int)
  (append "; generated by the L0 compiler\n"
    (append "declare i64 @l0_cons(i64, i64)\n"
      (append "declare i64 @l0_head(i64)\n"
        (append "declare i64 @l0_tail(i64)\n"
          (append "declare i64 @l0_is_empty(i64)\n"
            (append "declare i64 @l0_div(i64, i64)\n"
              (append "declare i64 @l0_mod(i64, i64)\n"
                (append "declare i64 @l0_data_new(i64, i64)\n"
                  (append "declare void @l0_data_set(i64, i64, i64)\n"
                    (append "declare i64 @l0_data_tag(i64)\n"
                      (append "declare i64 @l0_data_get(i64, i64)\n"
                        (append "declare void @l0_stack_check()\n"
                          (append "declare i64 @l0_read_byte()\n"
                            (append "declare i64 @l0_write_byte(i64)\n"
                              (io_decls 0))))))))))))))))

(def io_decls ((i int)) (list int)
  (append "declare void @l0_inc(i64)\n"
   (append "declare void @l0_dec(i64)\n" (io_decls_counted 0))))

(def io_decls_counted ((i int)) (list int)
  (append "declare i64 @l0_new_cons(i64, i64, i64)\n"
    (append "declare i64 @l0_new_data(i64, i64, i64)\n" (io_decls_rest 0))))

(def io_decls_rest ((i int)) (list int)
  (append "declare i64 @l0_read_from(i64)\n"
    (append "declare i64 @l0_write_to(i64, i64)\n"
      (append "declare i64 @l0_open_read(i64)\n"
        (append "declare i64 @l0_open_write(i64)\n"
          (append "declare i64 @l0_close(i64)\n"
            (append "declare i64 @l0_arg_count()\n"
              (append "declare i64 @l0_arg(i64)\n" (io_decls_files 0)))))))))

(def io_decls_files ((i int)) (list int)
  (append "declare i64 @l0_flush(i64)\n"
    (append "declare i64 @l0_open_append(i64)\n"
      "declare i64 @l0_rename(i64, i64)\n\n")))

(def ret_kind ((ds (list Decl))) int
  (if (is_empty ds)
      2
      (match (head ds)
        ((DData o n cs) (ret_kind (tail ds)))
        ((DDef o n ps ret body)
          (if (list_eq n "main")
              (if (is_empty ps)
                  3
                  (if (ty_eq ret (TyInt)) 0 (if (ty_eq ret (TyBool)) 1 2)))
              (ret_kind (tail ds)))))))

; The return kind is read off the program's main, not the prelude's: a main in
; the prelude is library code that happens to be called main, not an entry
; point. Spec section 9.
(def emit_module ((ds (list Decl)) (pre int)) (list int)
  (let st0 (Em 0 (push (ir_header 0) (nil int)))
    (let st1 (emit_line (append "@l0_main_ret_kind = global i64 "
                (append (digits (ret_kind (program_decls ds pre (nil Decl))))
                        "\n")) st0)
      (emit_module_fns ds pre (prelude_names ds pre)
        (program_prelude_names ds pre) st1))))

(def emit_module_fns ((ds (list Decl)) (pre int) (ppre (list (list int)))
                      (pprog (list (list int))) (st Emit)) (list int)
  (let pads (module_pads ds pre ppre pprog)
    (emit_text
      (emit_fns ds (Sc (prelude_view ds pre) ppre true pads)
                   (Sc (program_view ds pre) pprog false pads) pre st))))

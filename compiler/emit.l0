; emit.l0 -- typed AST to LLVM IR text.
;
; This stage cannot fail. The checker has already proved the program correct,
; so there is no error plumbing here, which is what keeps it readable.
;
; Two decisions from spec section 10 do most of the work:
;
;   Every value is an i64, so no type information survives into codegen. An
;   operand is just a piece of text: "42", "%t7", or "%a0". Even match needs
;   no types: an arm names its constructor, and the constructor table gives
;   the tag.
;
;   Temporaries and labels are NAMED. LLVM requires unnamed values (%0, %1) to
;   be numbered in strict sequence, counting function parameters and implicit
;   block labels, which is a rich source of bugs that only appear on complex
;   functions. Named values have no such rule.
;
; let needs no memory at all: it binds a name to an operand that already
; exists. Only if and match need storage, and both use an alloca and a load
; rather than a phi node, so no basic-block bookkeeping is needed. Emission
; is structured, so a value is only ever used in the block that defines it or
; in a block that block dominates. In tail position neither joins: each
; branch returns, which is what lets a call there be a musttail call.

; The next name number, the output reversed, the warnings newest first, and
; the string literals, each once, by the number of its constant, and newest
; first, for emitting their constants after the functions.
(data Emit
  (Em (next int) (out (list int)) (warns (list Diag))
      (str_ids (Map (list int) int)) (strs (list (list int)))))

; An expression's value carries its type, computed bottom-up as the checker
; computes it, because allocation has to say which words of a block are
; pointers, and only the static type knows whether a list's elements are.
; The instruction helpers below produce int; each expression form sets the
; type it really has.
(data EmitVal
  (Val (op (list int)) (ty Ty) (st Emit)))   ; operand text, type, new state

(data EmitOps
  (Ops (list (list int)) (list Ty) (list bool) Emit))   ; texts, types, owned, state

; A read-only parameter (spec 10.3) holds no reference: it is never handed
; over or released, and every use of it that needs one adds one.
(data EBind
  (EB (name (list int)) (op (list int)) (ty Ty) (ro bool)))   ; L0 name, operand
                                        ; text, type, read-only

; Local bindings, the global tables, the function names that resolve to the
; prelude from here, and how many parameters each function takes. The
; emitter builds the constructor table from the declarations itself, so it
; still needs nothing the checker produced.
(data Env
  (Ev (binds (list EBind)) (ctx Ctx) (prelude (list (list int)))
      (pads (Map (list int) Pad)) (fa FnArgs)))

; What the type of a call that functions were passed to needs: both groups'
; signatures, since a def passed may be of either, and what each copy's
; function parameters were given, by the copy's name. Spec 10.2.
(data FnArgs
  (FA (psigs (Map (list int) Sig)) (gsigs (Map (list int) Sig))
      (copies (Map (list int) (list FnRef)))))

(data EnvEmit
  (EnvSt Env Emit))

(def env_bind ((n (list int)) (op (list int)) (t Ty) (e Env)) Env
  (.binds e (cons (EB n op t false) (.binds e))))

; ------------------------------------------------------------------ output

(def emit_line ((s (list int)) (st Emit)) Emit
  (.out st (push "\n" (push s (.out st)))))

(def emit_text ((st Emit)) (list int)
  (rev (.out st)))

(def fresh_id ((st Emit)) (list int)
  (digits (.next st)))

(def bump ((st Emit)) Emit
  (.next st (add (.next st) 1)))

(def ebind_name ((b EBind)) (list int) (.name b))

(def lookup_operand ((n (list int)) (binds (list EBind))) (list int)
  (match (find_by ebind_name n binds)
    ((Some b) (.op b))
    ((None) "0")))

(def lookup_type ((n (list int)) (binds (list EBind))) Ty
  (match (find_by ebind_name n binds)
    ((Some b) (.ty b))
    ((None) (TyInt))))

(def lookup_read_only ((n (list int)) (binds (list EBind))) bool
  (match (find_by ebind_name n binds)
    ((Some b) (.ro b))
    ((None) false)))

(def is_read_only ((n (list int)) (env Env)) bool
  (lookup_read_only n (.binds env)))

; Whether a value of type t is a pointer to a heap block rather than a plain
; word. Spec 10.1.
(def ty_is_ptr ((t Ty)) bool
  (ty_is_counted t))

; "i64 a, i64 b"
(def fmt_ops ((ops (list (list int)))) (list int)
  (if (is_empty ops)
      ""
      (if (is_empty (tail ops))
          (append "i64 " (head ops))
          (append "i64 " (append (head ops)
            (append ", " (fmt_ops (tail ops))))))))

(def emit_assign ((rhs (list int)) (st Emit)) EmitVal
  (let name (append "%t" (fresh_id st))
    (Val name (TyInt)
      (emit_line (append "  " (append name (append " = " rhs))) (bump st)))))

(def emit_rt_call ((fn (list int)) (ops (list (list int))) (st Emit)) EmitVal
  (emit_assign (append "call i64 @" (append fn
    (append "(" (append (fmt_ops ops) ")")))) st))

(def emit_binop ((op (list int)) (a (list int)) (b (list int)) (st Emit))
    EmitVal
  (emit_assign (append op (append " i64 " (append a (append ", " b)))) st))

(def emit_cmp ((pred (list int)) (a (list int)) (b (list int)) (st Emit))
    EmitVal
  (match (emit_assign (append "icmp " (append pred
            (append " i64 " (append a (append ", " b))))) st)
    ((Val c t st1)
      (.ty (emit_assign (append "zext i1 " (append c " to i64")) st1)
              (TyBool)))))

(def two_ops ((a (list int)) (b (list int))) (list (list int))
  (cons a (cons b (nil (list int)))))

(def one_op ((a (list int))) (list (list int))
  (cons a (nil (list int))))

; ------------------------------------------------------------- expressions

; ---------------------------------------------------------------- ownership
;
; Every value of list or data type an expression produces is an owned
; reference, which whoever receives it consumes: a function's parameter, a
; field of a new block, a let binding, or the function's result. A binding's
; own reference lasts until its last use on each path, not until its scope
; ends:
;
;   live is the set of names used after the expression being emitted, on the
;   path it is on, each meaning the binding it means there. A use of a
;   pointer-typed variable not in live is its last, and hands over the
;   binding's reference; any other use adds one.
;
;   So at the start of every expression, the bindings still holding a
;   reference are exactly the live ones. A binding that becomes dead without
;   a use is released where that happens: a let or a parameter whose name
;   the body never uses, at once; one that a branch of an if or match does
;   not use, as that branch starts; a field an arm never uses is never taken.
;
;   Within a call or construction the variable operands are taken after the
;   others, as spec 10.3 requires, so that in (f xs (g xs)) the last use of
;   xs is f's, not g's.
;
; tl is true in tail position. live is then empty, so every binding has been
; used or released by the time the value is ready, nothing is released after
; a call there, and it can be a tail call. The expression returns its value
; itself. Spec 8 and 10.3.

(def emit_inc ((op (list int)) (st Emit)) Emit
  (emit_line (append "  call void @l0_inc(i64 " (append op ")")) st))

(def emit_dec ((op (list int)) (st Emit)) Emit
  (emit_line (append "  call void @l0_dec(i64 " (append op ")")) st))

; Sets of names are lists without repeats.
(def set_add ((n (list int)) (s (list (list int)))) (list (list int))
  (if (any_eq n s) s (cons n s)))

(def set_union ((a (list (list int))) (b (list (list int)))) (list (list int))
  (if (is_empty a) b (set_union (tail a) (set_add (head a) b))))

(def set_del ((n (list int)) (s (list (list int)))) (list (list int))
  (if (is_empty s)
      s
      (if (eq n (head s)) (tail s) (cons (head s) (set_del n (tail s))))))

(def set_del_all ((ns (list (list int))) (s (list (list int)))) (list (list int))
  (if (is_empty ns) s (set_del_all (tail ns) (set_del (head ns) s))))

; The names in a that are not in b.
(def set_minus ((a (list (list int))) (b (list (list int)))) (list (list int))
  (if (is_empty a)
      a
      (if (any_eq (head a) b)
          (set_minus (tail a) b)
          (cons (head a) (set_minus (tail a) b)))))

; The variables an expression uses that it does not bind itself.
(def fv ((e Expr)) (list (list int))
  (fv_onto e (nil (list int))))

(def fv_onto ((e Expr) (acc (list (list int)))) (list (list int))
  (match e
    ((EInt o v) acc)
    ((EFloat o m p g) acc)
    ((EBool o v) acc)
    ((EStr o s) acc)
    ((ENil o t) acc)
    ((EVar o n) (set_add n acc))
    ((EIf o c a b) (fv_onto c (fv_onto a (fv_onto b acc))))
    ((ELet o n v body) (fv_onto v (set_union (set_del n (fv body)) acc)))
    ((ECtor o n tys args) (fv_list args acc))
    ((EMatch o s arms) (fv_onto s (fv_arms arms acc)))
    ((ECall o n args) (fv_list args acc))
    ((EField o f e) (fv_onto e acc))
    ((EWith o f e v) (fv_onto e (fv_onto v acc)))))

(def fv_list ((es (list Expr)) (acc (list (list int)))) (list (list int))
  (if (is_empty es) acc (fv_list (tail es) (fv_onto (head es) acc))))

(def fv_arms ((arms (list Arm)) (acc (list (list int)))) (list (list int))
  (if (is_empty arms)
      acc
      (fv_arms (tail arms) (set_union (arm_fv (head arms)) acc))))

(def arm_fv ((a Arm)) (list (list int))
  (match a ((A o cn names body) (set_del_all names (fv body)))))

; Releases each named binding that is a pointer and holds a reference, which
; a read-only parameter never does. The names are ones a branch does not use
; and nothing after it does either.
(def release_names ((ns (list (list int))) (env Env) (st Emit)) Emit
  (if (is_empty ns)
      st
      (release_names (tail ns) env
        (if (if (ty_is_ptr (lookup_type (head ns) (.binds env)))
                (not (is_read_only (head ns) env))
                false)
            (emit_dec (lookup_operand (head ns) (.binds env)) st)
            st))))

(def finish ((tl bool) (v EmitVal)) EmitVal
  (emit_ret tl v))

(def emit_ret ((tl bool) (v EmitVal)) EmitVal
  (if tl
      (match v ((Val o t s) (Val o t (emit_line (append "  ret i64 " o) s))))
      v))

(def emit_use ((n (list int)) (env Env) (live (list (list int))) (st Emit))
    EmitVal
  (let op (lookup_operand n (.binds env))
    (let t (lookup_type n (.binds env))
      (Val op t (if (if (ty_is_ptr t) (still_held n env live) false)
                    (emit_inc op st)
                    st)))))

; Whether a use of n must leave the binding its reference: it is used later,
; or it is a read-only parameter, which has none to hand over.
(def still_held ((n (list int)) (env Env) (live (list (list int)))) bool
  (if (any_eq n live) true (is_read_only n env)))

(def emit_expr ((e Expr) (env Env) (live (list (list int))) (tl bool)
                (st Emit)) EmitVal
  (match e
    ((EInt o v) (finish tl (Val (digits v) (TyInt) st)))
    ((EFloat o m p g) (finish tl (emit_float_lit m p g st)))
    ((EBool o v) (finish tl (Val (if v "1" "0") (TyBool) st)))
    ((ENil o t) (finish tl (Val "0" (TyList t) st)))
    ((EStr o s) (finish tl (emit_string s st)))
    ((EVar o n) (finish tl (emit_use n env live st)))
    ((EIf o c a b) (emit_if c a b env live tl st))
    ((ELet o n v body) (emit_let n v body env live tl st))
    ((ECtor o n tys args) (finish tl (emit_ctor n tys args env live st)))
    ((EMatch o subject arms)
      (if (is_word_arms arms env)
          (emit_let (head (.names (head arms))) subject (.body (head arms)) env live tl st)
          (emit_match subject arms env live tl st)))
    ((ECall o n args) (emit_call n args env live tl (warn_call o n args env live st)))
    ((EField o f e) (finish tl (emit_field f e env live st)))
    ((EWith o f e v) (finish tl (emit_with f e v env live st)))))

; ---------------------------------------------------------------- warnings
;
; An update given a variable that is still used after it copies what the
; variable holds, since the variable is another holder (spec 6.5): the
; builtin array_set, and a call of a function that updates the parameter
; it is given, the variable or a field of it (module_updates). These are
; warned of, at the update, and compile as written. A read inside the
; update's own operands is not after it, since a variable operand is taken
; last.

(def warn_call ((o int) (n (list int)) (args (list Expr)) (env Env)
                (live (list (list int))) (st Emit)) Emit
  (if (is_empty live)
      st
      (if (is_builtin_in n (.ctx env))
          (if (eq n "array_set")
              (warn_if (var_name (head args)) live o "this array_set" st)
              st)
          (warn_passed args (updates_of (call_sym n env) (.pads env)) live o
                       (append "this call of " (shown_name n)) st))))

(def warn_passed ((args (list Expr)) (flags (list bool)) (live (list (list int)))
                  (o int) (what (list int)) (st Emit)) Emit
  (if (is_empty args)
      st
      (if (flag_head flags)
          (let x (held_var (head args))
            (if (if (is_empty x) false (any_eq x live))
                (warn_if x live o what st)
                (warn_passed (tail args) (flag_tail flags) live o what st)))
          (warn_passed (tail args) (flag_tail flags) live o what st))))

(def warn_if ((x (list int)) (live (list (list int))) (o int) (what (list int))
              (st Emit)) Emit
  (if (if (is_empty x) true (not (any_eq x live)))
      st
      (.warns st (cons (D o (append x (append " is used after " (append what
                         (append ", so it copies " (append x
                           "; read it first, with let, and update last"))))))
                       (.warns st)))))

; A function's name as written: a copy's without its kinds and the defs it
; was given, and one called by symbol without the symbol's prefix.
(def shown_name ((n (list int))) (list int)
  (if (is_sym_name n) (copy_base (drop_n n 6)) (copy_base n)))

; ------------------------------------------------------------------ fields

; (.f e): l0_data_get of the field's word, e read without consuming it, as
; head reads its list, and the result given a reference if it is a pointer
; into e. Spec 5.8 and 10.3.
(def emit_field ((f (list int)) (e Expr) (env Env) (live (list (list int)))
                 (st Emit)) EmitVal
  (match (emit_args (cons e (nil Expr)) env live (cons true (nil bool)) st)
    ((Ops ops ts ws st1)
      (let cs (.ctors (.ctx env))
        (if (is_unboxed_name (ty_name (head ts)))
            (Val (head ops) (field_ty_of f (head ts) cs) st1)
            (borrowed ops ts ws
              (.ty (emit_rt_call "l0_data_get"
                        (two_ops (head ops) (digits (field_index f (head ts) cs))) st1)
                      (field_ty_of f (head ts) cs))
              false))))))

; (.f e v): l0_data_with, e and v consumed as array_set's operands are, so
; the runtime stores in place when nothing else holds e.
(def emit_with ((f (list int)) (e Expr) (v Expr) (env Env)
                (live (list (list int))) (st Emit)) EmitVal
  (match (emit_args (cons e (cons (field_through f e v env live) (nil Expr))) env live
                    (nil bool) st)
    ((Ops ops ts ws st1)
      (if (is_unboxed_name (ty_name (head ts)))
          (Val (head (tail ops)) (head ts) st1)
          (.ty (emit_rt_call "l0_data_with"
                    (cons (head ops)
                      (two_ops (digits (field_index f (head ts) (.ctors (.ctx env))))
                               (head (tail ops))))
                    st1)
                  (head ts))))))

; The field form of spec 6.5, (.f r (g ... (.f r) ...)), with r one
; variable that no other argument of g mentions and f a field of a counted
; type: v with its one argument (.f r) made (data.take r "f"), which
; emit_call emits as l0_data_take, and which no program can write, since no
; L0 name has a dot. Anything else is v as written, and so is v when r is
; used after the replacement, which is another holder. Spec 10.3.
(def field_through ((f (list int)) (e Expr) (v Expr) (env Env)
                    (live (list (list int)))) Expr
  (let r (var_name e)
    (if (if (is_empty r) true (any_eq r live))
        v
        (if (ty_is_ptr (field_ty_of f (lookup_type r (.binds env)) (.ctors (.ctx env))))
            (match v
              ((ECall o g gargs)
                (if (if (eq (count_fields f r gargs 0) 1) (eq (count_mentions r gargs 0) 1) false)
                    (ECall o g (take_field f r gargs))
                    v))
              ((EInt o x) v)
              ((EFloat o m p s) v)
              ((EBool o b) v)
              ((EStr o s) v)
              ((ENil o t) v)
              ((EVar o n) v)
              ((EIf o c a b) v)
              ((ELet o n x b) v)
              ((ECtor o n ts a) v)
              ((EMatch o s a) v)
              ((EField o h x) v)
              ((EWith o h x y) v))
            v))))

(def count_fields ((f (list int)) (r (list int)) (es (list Expr)) (k int)) int
  (if (is_empty es)
      k
      (count_fields f r (tail es) (if (is_field_of f r (head es)) (add k 1) k))))

(def take_field ((f (list int)) (r (list int)) (es (list Expr))) (list Expr)
  (if (is_empty es)
      es
      (if (is_field_of f r (head es))
          (cons (ECall 0 "data.take" (cons (EVar 0 r) (cons (EStr 0 f) (nil Expr))))
                (tail es))
          (cons (head es) (take_field f r (tail es))))))

; Whether e is (.f r).
(def is_field_of ((f (list int)) (r (list int)) (e Expr)) bool
  (match e
    ((EField o h x) (if (eq h f) (eq (var_name x) r) false))
    ((EInt o v) false)
    ((EFloat o m p g) false)
    ((EBool o v) false)
    ((EStr o s) false)
    ((ENil o t) false)
    ((EVar o n) false)
    ((EIf o c a b) false)
    ((ELet o n v b) false)
    ((ECtor o n ts a) false)
    ((EMatch o s a) false)
    ((ECall o n a) false)
    ((EWith o h x v) false)))

; (data.take r "f"): l0_data_take, the field r's type says, with a
; reference the caller owns.
(def emit_data_take ((r (list int)) (f (list int)) (env Env) (st Emit)) EmitVal
  (let t (lookup_type r (.binds env))
    (let cs (.ctors (.ctx env))
      (.ty (emit_rt_call "l0_data_take"
                (two_ops (lookup_operand r (.binds env)) (digits (field_index f t cs)))
                st)
              (field_ty_of f t cs)))))

; The one constructor of the data type t, which the checker found to have
; exactly one.
(def ctor_of_type ((t Ty) (cs (list CtorInfo))) (Option CtorInfo)
  (if (is_empty cs)
      ((None CtorInfo))
      (if (eq (.type_name (head cs)) (ty_name t))
          (Some (head cs))
          (ctor_of_type t (tail cs)))))

(def field_index ((f (list int)) (t Ty) (cs (list CtorInfo))) int
  (match (ctor_of_type t cs)
    ((Some ci) (index_of f (.field_names ci)))
    ((None) 0)))

; The type of field f of a value of type t, with t's arguments in place of
; the parameters, which is what says whether the field is a pointer.
(def field_ty_of ((f (list int)) (t Ty) (cs (list CtorInfo))) Ty
  (match (ctor_of_type t cs)
    ((Some ci) (nth_ty (ctor_fields_at ci t) (index_of f (.field_names ci))))
    ((None) (TyInt))))

; A let binds a name to an operand that already exists, and takes over the
; reference the value came with, releasing it at once if the body never uses
; the name. Inside the body the name means the new binding, so an outer one
; of the same name is not what live means there.
(def emit_let ((n (list int)) (v Expr) (body Expr) (env Env)
               (live (list (list int))) (tl bool) (st Emit)) EmitVal
  (let bfv (fv body)
    (match (emit_expr v env (set_union (set_del n bfv) live) false st)
      ((Val vv vt st1)
        (emit_expr body (env_bind n vv vt env) (set_del n live) tl
          (if (and (ty_is_ptr vt) (not (any_eq n bfv))) (emit_dec vv st1) st1))))))

; A cons cell's layout mask marks its tail word as a pointer, and its head
; word too when the elements are lists or data. Spec 10.1.
(def cons_mask ((elem Ty)) (list int)
  (if (ty_is_ptr elem) "3" "2"))

; Bytes arrive reversed so the chain can be built from the end forwards.
; A string literal is a call of l0_string on a private constant of its
; bytes, one per distinct literal in the module, numbered in the order
; first used, so the output is a function of the input (spec 10.3, 10.4).
; The empty one is the empty list.
(def emit_string ((s (list int)) (st Emit)) EmitVal
  (if (is_empty s)
      (Val "0" (TyList (TyInt)) st)
      (match (map_get (.str_ids st) s)
        ((Some k) (emit_string_call k (length s) st))
        ((None)
          (let (k (length (.strs st)) old (.strs st))
            (emit_string_call k (length s)
              (.strs (.str_ids st (map_put (.str_ids st) s k)) (cons s old))))))))

(def emit_string_call ((k int) (n int) (st Emit)) EmitVal
  (.ty (emit_assign (append "call i64 @l0_string(ptr @l0_str." (append (digits k)
         (append ", i64 " (append (digits n) ")")))) st)
       (TyList (TyInt))))

; Each literal's constant, oldest first.
(def emit_strs ((ss (list (list int))) (k int) (st Emit)) Emit
  (if (is_empty ss)
      st
      (emit_strs (tail ss) (add k 1)
        (emit_line (append "@l0_str." (append (digits k)
          (append " = private unnamed_addr constant ["
            (append (digits (length (head ss)))
              (append " x i8] c\"" (append (ir_bytes (head ss) (nil int)) "\""))))))
          st))))

; Bytes in an LLVM string constant: printable ones as they are, but " and
; \, and every other as \ and two hex digits.
(def ir_bytes ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s)
      (rev acc)
      (ir_bytes (tail s)
        (let b (head s)
          (if (if (ge b 32) (if (le b 126) (if (eq b 34) false (not (eq b 92))) false) false)
              (cons b acc)
              (push (hex_digits b 2) (cons 92 acc)))))))

(def emit_store ((v (list int)) (slot (list int)) (st Emit)) Emit
  (emit_line (append "  store i64 " (append v (append ", ptr " slot))) st))

; An arm's value goes to the join slot, or in tail position the arm has
; returned it already. The arm reports the value's type, which the checker
; has proved is the same for every arm.
(def emit_arm ((lbl (list int)) (e Expr) (dead (list (list int)))
               (slot (list int)) (lend (list int)) (env Env)
               (live (list (list int))) (tl bool) (st Emit)) EmitVal
  (let st1 (release_names dead env (emit_line (append lbl ":") st))
    (match (emit_expr e env live tl st1)
      ((Val v t st2)
        (Val "" t
          (if tl
              st2
              (emit_line (append "  br label %" lend)
                (emit_store v slot st2))))))))

; A slot to join through, which tail position does without.
(def emit_slot ((slot (list int)) (tl bool) (st Emit)) Emit
  (if tl st (emit_line (append "  " (append slot " = alloca i64")) st)))

; The names each branch of an if uses, and those it must release as it
; starts because only the other branch uses them.
(data Branches
  (Br (list (list int)) (list (list int))))   ; released in then, in else

(def emit_if ((c Expr) (a Expr) (b Expr) (env Env) (live (list (list int)))
              (tl bool) (st Emit)) EmitVal
  (let fa (fv a)
    (let fb (fv b)
      (let id (fresh_id st)
        (let slot (append "%r" id)
          (let st1 (emit_slot slot tl (bump st))
            (match (emit_expr c env (set_union fa (set_union fb live)) false st1)
              ((Val cv ct st2)
                (emit_if_arms id slot cv a b
                  (Br (set_minus fb (set_union fa live))
                      (set_minus fa (set_union fb live)))
                  env live tl st2)))))))))

(def emit_if_arms ((id (list int)) (slot (list int)) (cv (list int))
                   (a Expr) (b Expr) (br Branches) (env Env)
                   (live (list (list int))) (tl bool) (st Emit)) EmitVal
  (let lthen (append "Lt" id)
    (let lelse (append "Le" id)
      (let lend (append "Lx" id)
        (match (emit_assign (append "icmp ne i64 " (append cv ", 0")) st)
          ((Val cb cbt st1)
            (let st2 (emit_line (append "  br i1 " (append cb
                        (append ", label %" (append lthen
                          (append ", label %" lelse))))) st1)
              (match br
                ((Br da db)
                  (match (emit_arm lthen a da slot lend env live tl st2)
                    ((Val x t st3)
                      (emit_if_join lelse b db slot lend t env live tl st3))))))))))))

(def emit_if_join ((lelse (list int)) (b Expr) (db (list (list int)))
                   (slot (list int)) (lend (list int)) (t Ty) (env Env)
                   (live (list (list int))) (tl bool) (st Emit)) EmitVal
  (let st4 (.st (emit_arm lelse b db slot lend env live tl st))
    (if tl
        (Val "" t st4)
        (let st5 (emit_line (append lend ":") st4)
          (.ty (emit_assign (append "load i64, ptr " slot) st5) t)))))

; One operand: its text, its type, and whether it carries a reference the
; call consumes. Only a borrowing builtin is given operands without one.
(data EArg
  (EA (list int) Ty bool))

(data EArgs
  (EAs (list EArg) Emit))

(data EArgSt
  (EAS EArg Emit))

; The name of a variable, or "" for any other expression.
(def var_names ((args (list Expr)) (acc (list (list int)))) (list (list int))
  (if (is_empty args)
      acc
      (let n (var_name (head args))
        (var_names (tail args) (if (is_empty n) acc (set_add n acc))))))

(def fv_nonvars ((args (list Expr)) (acc (list (list int)))) (list (list int))
  (if (is_empty args)
      acc
      (fv_nonvars (tail args)
        (if (is_empty (var_name (head args))) (fv_onto (head args) acc) acc))))

; Operands that are not variables are evaluated first, left to right, and
; the variables are taken after them, so each variable's last use is as late
; as it can be. borrows has a flag per operand: the callee reads that
; operand without consuming it, so a variable still live afterwards is given
; without a reference.
(def emit_args ((args (list Expr)) (env Env) (live (list (list int)))
                (borrows (list bool)) (st Emit)) EmitOps
  (match (emit_nonvars args env (var_names args live) st (nil EArg))
    ((EAs nvs st1)
      (match (emit_vars args env live borrows st1 (nil EArg))
        ((EAs vs st2)
          (ops_of (merge_args args nvs vs (nil EArg)) st2))))))

; The same flag for every operand.
(def flags_for ((b bool) (args (list Expr))) (list bool)
  (if (is_empty args) (nil bool) (cons b (flags_for b (tail args)))))

(def flag_head ((bs (list bool))) bool
  (if (is_empty bs) false (head bs)))

(def flag_tail ((bs (list bool))) (list bool)
  (if (is_empty bs) bs (tail bs)))

(def emit_nonvars ((args (list Expr)) (env Env) (vlive (list (list int)))
                   (st Emit) (acc (list EArg))) EArgs
  (if (is_empty args)
      (EAs (rev_onto acc (nil EArg)) st)
      (if (is_empty (var_name (head args)))
          (match (emit_expr (head args) env (fv_nonvars (tail args) vlive) false st)
            ((Val v t st1)
              (emit_nonvars (tail args) env vlive st1 (cons (EA v t true) acc))))
          (emit_nonvars (tail args) env vlive st acc))))

(def emit_vars ((args (list Expr)) (env Env) (live (list (list int)))
                (borrows (list bool)) (st Emit) (acc (list EArg))) EArgs
  (if (is_empty args)
      (EAs (rev_onto acc (nil EArg)) st)
      (let n (var_name (head args))
        (if (is_empty n)
            (emit_vars (tail args) env live (flag_tail borrows) st acc)
            (match (emit_var_arg n env
                     (if (any_eq n (var_names (tail args) live))
                         true
                         (is_read_only n env))
                     (flag_head borrows) st)
              ((EAS a st1)
                (emit_vars (tail args) env live (flag_tail borrows) st1
                           (cons a acc))))))))

; later: the binding keeps its reference after this operand, because the
; variable is used again or is a read-only parameter.
(def emit_var_arg ((n (list int)) (env Env) (later bool) (borrow bool)
                   (st Emit)) EArgSt
  (let op (lookup_operand n (.binds env))
    (let t (lookup_type n (.binds env))
      (if (not (ty_is_ptr t))
          (EAS (EA op t false) st)
          (if borrow
              (EAS (EA op t (not later)) st)
              (EAS (EA op t true) (if later (emit_inc op st) st)))))))

(def merge_args ((args (list Expr)) (nvs (list EArg)) (vs (list EArg))
                 (acc (list EArg))) (list EArg)
  (if (is_empty args)
      (rev_onto acc (nil EArg))
      (if (is_empty (var_name (head args)))
          (merge_args (tail args) (tail nvs) vs (cons (head nvs) acc))
          (merge_args (tail args) nvs (tail vs) (cons (head vs) acc)))))

(def ops_of ((as (list EArg)) (st Emit)) EmitOps
  (if (is_empty as)
      (Ops (nil (list int)) (nil Ty) (nil bool) st)
      (match (ops_of (tail as) st)
        ((Ops os ts ws st1)
          (match (head as)
            ((EA o t w) (Ops (cons o os) (cons t ts) (cons w ws) st1)))))))

(def call_sym ((n (list int)) (env Env)) (list int)
  (fn_sym n (.prelude env)))

(def is_borrowing ((n (list int))) bool
  (any_eq n (split_spaces "head tail is_empty eq hash compare open_read open_write open_append rename remove open_bytes array_len array_get bytes_len bytes_get write_bytes bytes_slice bytes_concat region_write_bytes space_write supervisor_send cpu_run")))

; Borrowing builtins whose result is new, with a reference of its own, not a
; part of an argument. Spec 10.3.
(def borrows_into_new ((n (list int))) bool
  (any_eq n (split_spaces "bytes_slice bytes_concat")))

; A call to a function in tail position is a tail call, spec 8, and nothing
; may come between it and the ret. Nothing does: live is empty there, so the
; operands took every reference still held, and a read-only position in a
; tail call is only ever given a read-only parameter, which the caller does
; not own either (module_read_only). A builtin's borrowing is not a tail call
; and may release what it read afterwards, and so may a call that is not a
; tail call, for what it passed in read-only positions.
(def emit_call ((n (list int)) (args (list Expr)) (env Env)
                (live (list (list int))) (tl bool) (st Emit)) EmitVal
  (if (eq n "array.take")
      (emit_take (var_name (head args)) (head (tail args)) env st)
      (if (eq n "data.take")
          (emit_data_take (var_name (head args)) (str_of (head (tail args))) env st)
          (if (is_short n env)
              (emit_short n (head args) (head (tail args)) env live tl st)
              (match (row_update n args (.ctx env))
                ((RowUpdate g y x v) (emit_row_update g y x v env live tl st))
                ((NotRowUpdate) (emit_call_plain n (through_args n args env live) env live tl st)))))))

; The builtins and and or, which a def of the name shadows. Spec 7 and 8.
(def is_short ((n (list int)) (env Env)) bool
  (if (if (eq n "and") true (eq n "or")) (is_builtin_in n (.ctx env)) false))

; (and a b) as (if a b false), and (or a b) as (if a true b), with b never
; in tail position, so tail-call components are those section 8 gives.
(def emit_short ((n (list int)) (a Expr) (b Expr) (env Env)
                 (live (list (list int))) (tl bool) (st Emit)) EmitVal
  (finish tl
    (.ty (if (eq n "and")
             (emit_if a b (EBool 0 false) env live false st)
             (emit_if a (EBool 0 true) b env live false st))
         (TyBool))))

; A string literal's bytes, or nothing for any other expression.
(def str_of ((e Expr)) (list int)
  (match e
    ((EStr o s) s)
    ((EVar o n) "")
    ((EInt o v) "")
    ((EFloat o m p g) "")
    ((EBool o v) "")
    ((ENil o t) "")
    ((EIf o c a b) "")
    ((ELet o n v b) "")
    ((ECtor o n ts a) "")
    ((EMatch o s a) "")
    ((ECall o n a) "")
    ((EField o f x) "")
    ((EWith o f x v) "")))

; (array_set g y (array_set (array_get g y) x v)), with g one variable and y
; the same variable or integer literal both times: spec 6.5.
(data RowUpdate
  (RowUpdate (list int) Expr Expr Expr)      ; g, y, x, v
  (NotRowUpdate))

; Only when array_set and array_get are the builtins, which a def may
; shadow. Spec 7.
(def row_update ((n (list int)) (args (list Expr)) (c Ctx)) RowUpdate
  (if (if (eq n "array_set") (eq (length args) 3) false)
      (if (if (is_builtin_in "array_set" c) (is_builtin_in "array_get" c) false)
          (row_update_of (head args) (head (tail args)) (head (tail (tail args))))
          (NotRowUpdate))
      (NotRowUpdate)))

(def row_update_of ((g Expr) (y Expr) (inner Expr)) RowUpdate
  (match inner
    ((ECall o n args)
      (if (if (eq n "array_set") (eq (length args) 3) false)
          (match (head args)
            ((ECall o2 n2 args2)
              (if (if (eq n2 "array_get") (eq (length args2) 2) false)
                  (if (if (same_var g (head args2)) (same_index y (head (tail args2))) false)
                      (RowUpdate (var_name g) y (head (tail args)) (head (tail (tail args))))
                      (NotRowUpdate))
                  (NotRowUpdate)))
            ((EInt o2 v2) (NotRowUpdate))
            ((EFloat o2 m2 p2 g2) (NotRowUpdate))
            ((EBool o2 v2) (NotRowUpdate))
            ((EStr o2 s2) (NotRowUpdate))
            ((ENil o2 t2) (NotRowUpdate))
            ((EVar o2 n2) (NotRowUpdate))
            ((EIf o2 c2 a2 b2) (NotRowUpdate))
            ((ELet o2 n2 v2 b2) (NotRowUpdate))
            ((ECtor o2 n2 t2 a2) (NotRowUpdate))
            ((EMatch o2 s2 a2) (NotRowUpdate))
            ((EField o2 f2 e2) (NotRowUpdate))
            ((EWith o2 f2 e2 v2) (NotRowUpdate)))
          (NotRowUpdate)))
    ((EInt o v) (NotRowUpdate))
    ((EFloat o m p g) (NotRowUpdate))
    ((EBool o v) (NotRowUpdate))
    ((EStr o s) (NotRowUpdate))
    ((ENil o t) (NotRowUpdate))
    ((EVar o n) (NotRowUpdate))
    ((EIf o c a b) (NotRowUpdate))
    ((ELet o n v b) (NotRowUpdate))
    ((ECtor o n ts a) (NotRowUpdate))
    ((EMatch o s a) (NotRowUpdate))
    ((EField o f e) (NotRowUpdate))
    ((EWith o f e v) (NotRowUpdate))))

(def same_var ((a Expr) (b Expr)) bool
  (if (is_empty (var_name a)) false (eq (var_name a) (var_name b))))

; The same variable, or the same integer literal, so that one evaluation is
; the same as two.
(def same_index ((a Expr) (b Expr)) bool
  (if (same_var a b) true (same_int a b)))

(def same_int ((a Expr) (b Expr)) bool
  (match a
    ((EInt o v)
      (match b
        ((EInt o2 v2) (eq v v2))
        ((EFloat o2 m2 p2 g2) false)
        ((EBool o2 v2) false)
        ((EStr o2 s2) false)
        ((ENil o2 t2) false)
        ((EVar o2 n2) false)
        ((EIf o2 c2 a2 b2) false)
        ((ELet o2 n2 v3 b3) false)
        ((ECtor o2 n2 t2 a2) false)
        ((EMatch o2 s2 a2) false)
        ((ECall o2 n2 a2) false)
        ((EField o2 f2 e2) false)
        ((EWith o2 f2 e2 v3) false)))
    ((EFloat o m p g) false)
    ((EBool o v) false)
    ((EStr o s) false)
    ((ENil o t) false)
    ((EVar o n) false)
    ((EIf o c x y) false)
    ((ELet o n v b) false)
    ((ECtor o n ts x) false)
    ((EMatch o s x) false)
    ((ECall o n x) false)
    ((EField o f e) false)
    ((EWith o f e v) false)))

; The row check first, as (array_get g y) makes it before x and v are
; evaluated, then the operands, then one runtime call. g is consumed, as
; array_set's array is.
(def emit_row_update ((g (list int)) (y Expr) (x Expr) (v Expr) (env Env)
                      (live (list (list int))) (tl bool) (st Emit)) EmitVal
  (let yop (index_op y env)
    (match (emit_rt_call "l0_array_get"
             (two_ops (lookup_operand g (.binds env)) yop) st)
      ((Val chk ct st1)
        (match (emit_args (cons (EVar 0 g) (cons y (cons x (cons v (nil Expr)))))
                          env live (nil bool) st1)
          ((Ops ops ts ws st2)
            (emit_ret tl
              (.ty (emit_rt_call "l0_array_set_row" ops st2)
                      (lookup_type g (.binds env))))))))))

; The operand for y in a row form: an integer literal, or a variable's
; value, read without a reference since it is an int.
(def index_op ((y Expr) (env Env)) (list int)
  (if (is_empty (var_name y))
      (match y
        ((EInt o k) (digits k))
        ((EFloat o m p g) "0")
        ((EBool o b) "0")
        ((EStr o s) "0")
        ((ENil o t) "0")
        ((EVar o n) "0")
        ((EIf o c a b) "0")
        ((ELet o n e b) "0")
        ((ECtor o n ts a) "0")
        ((EMatch o s a) "0")
        ((ECall o n a) "0")
        ((EField o f e) "0")
        ((EWith o f e v) "0"))
      (lookup_operand (var_name y) (.binds env))))

; The form of spec 6.5 that hands an element through a function and back,
; (array_set g y (f ... (array_get g y) ...)), with g one variable that no
; other argument of f mentions and whose elements are counted: the argument
; (array_get g y) becomes (array.take g y), which emit_call emits as
; l0_array_take, and which no program can write, since no L0 name has a
; dot. Everything else is emitted as written. g used after the array_set is
; another holder, so then the element is shared as written. Spec 10.3.
(def through_args ((n (list int)) (args (list Expr)) (env Env) (live (list (list int))))
    (list Expr)
  (if (if (eq n "array_set") (eq (length args) 3) false)
      (if (if (is_builtin_in "array_set" (.ctx env)) (is_builtin_in "array_get" (.ctx env)) false)
          (let g (var_name (head args))
            (if (if (is_empty g) true (any_eq g live))
                args
                (if (counted_elems (lookup_type g (.binds env)))
                    (cons (head args)
                      (cons (head (tail args))
                        (cons (through_arg g (head (tail args)) (head (tail (tail args))))
                              (nil Expr))))
                    args)))
          args)
      args))

(def counted_elems ((t Ty)) bool
  (match t
    ((TyArray e) (ty_is_ptr e))
    ((TyInt) false)
    ((TyBool) false)
    ((TyList e) false)
    ((TyData n ts) false)
    ((TyFloat) false)
    ((TyBytes) false)
    ((TyFn ps r) false)))

; inner with its one argument (array_get g y) made (array.take g y), when it
; is a call that has exactly one such argument and no other mentioning g.
(def through_arg ((g (list int)) (y Expr) (inner Expr)) Expr
  (match inner
    ((ECall o f fargs)
      (if (if (eq (count_rows g y fargs 0) 1) (eq (count_mentions g fargs 0) 1) false)
          (ECall o f (take_row g y fargs))
          inner))
    ((EInt o v) inner)
    ((EFloat o m p g) inner)
    ((EBool o v) inner)
    ((EStr o s) inner)
    ((ENil o t) inner)
    ((EVar o n) inner)
    ((EIf o c a b) inner)
    ((ELet o n v b) inner)
    ((ECtor o n ts a) inner)
    ((EMatch o s a) inner)
    ((EField o f e) inner)
    ((EWith o f e v) inner)))

(def count_rows ((g (list int)) (y Expr) (es (list Expr)) (k int)) int
  (if (is_empty es)
      k
      (count_rows g y (tail es) (if (is_row g y (head es)) (add k 1) k))))

(def count_mentions ((g (list int)) (es (list Expr)) (k int)) int
  (if (is_empty es)
      k
      (count_mentions g (tail es) (if (any_eq g (fv (head es))) (add k 1) k))))

(def take_row ((g (list int)) (y Expr) (es (list Expr))) (list Expr)
  (if (is_empty es)
      es
      (if (is_row g y (head es))
          (cons (ECall 0 "array.take" (cons (EVar 0 g) (cons y (nil Expr)))) (tail es))
          (cons (head es) (take_row g y (tail es))))))

; Whether e is (array_get g y), with y the same variable or literal.
(def is_row ((g (list int)) (y Expr) (e Expr)) bool
  (match e
    ((ECall o n a)
      (if (if (eq n "array_get") (eq (length a) 2) false)
          (if (eq (var_name (head a)) g) (same_index y (head (tail a))) false)
          false))
    ((EInt o v) false)
    ((EFloat o m p g) false)
    ((EBool o v) false)
    ((EStr o s) false)
    ((ENil o t) false)
    ((EVar o n) false)
    ((EIf o c a b) false)
    ((ELet o n v b) false)
    ((ECtor o n ts a) false)
    ((EMatch o s a) false)
    ((EField o f e) false)
    ((EWith o f e v) false)))

; (array.take g y): l0_array_take, y checked where the argument stands, the
; element g's type says, with a reference the caller owns.
(def emit_take ((g (list int)) (y Expr) (env Env) (st Emit)) EmitVal
  (match (lookup_type g (.binds env))
    ((TyArray e)
      (.ty (emit_rt_call "l0_array_take"
                (two_ops (lookup_operand g (.binds env)) (index_op y env)) st)
              e))
    ((TyInt) (emit_rt_call "l0_array_take" (nil (list int)) st))
    ((TyBool) (emit_rt_call "l0_array_take" (nil (list int)) st))
    ((TyList t) (emit_rt_call "l0_array_take" (nil (list int)) st))
    ((TyData n ts) (emit_rt_call "l0_array_take" (nil (list int)) st))
    ((TyFloat) (emit_rt_call "l0_array_take" (nil (list int)) st))
    ((TyBytes) (emit_rt_call "l0_array_take" (nil (list int)) st))
    ((TyFn ps r) (emit_rt_call "l0_array_take" (nil (list int)) st))))

(def emit_call_plain ((n (list int)) (args (list Expr)) (env Env)
                      (live (list (list int))) (tl bool) (st Emit)) EmitVal
  (if (is_builtin_in n (.ctx env))
      (match (emit_args args env live (flags_for (is_borrowing n) args) st)
        ((Ops ops ts ws st1)
          (emit_ret tl
            (after_borrow n ops ts ws
              (.ty (emit_op n ops ts st1) (builtin_type n ts))))))
      (let sym (call_sym n env)
        (let ro (read_only_of sym (.pads env))
          (match (emit_args args env live ro st)
            ((Ops ops ts ws st1)
              (match (emit_def_call sym ops env tl st1)
                ((Val r rt st2)
                  (emit_ret tl
                    (Val r (call_type n ts env)
                      (emit_dec_read_only ops ts ws ro st2)))))))))))

; Releases what a call was given in its read-only positions with a reference.
(def emit_dec_read_only ((ops (list (list int))) (ts (list Ty)) (ws (list bool))
                         (ro (list bool)) (st Emit)) Emit
  (if (is_empty ops)
      st
      (emit_dec_read_only (tail ops) (tail ts) (tail ws) (flag_tail ro)
        (if (if (flag_head ro) (if (head ws) (ty_is_ptr (head ts)) false) false)
            (emit_dec (head ops) st)
            st))))

(def emit_def_call ((sym (list int)) (ops (list (list int))) (env Env)
                    (tl bool) (st Emit)) EmitVal
  (emit_assign
    (append (if tl "musttail call fastcc i64 @" "call fastcc i64 @")
      (append sym
        (append "("
          (append (fmt_ops (pad_ops ops (pad_of sym (.pads env)))) ")"))))
    st))

; head, tail, is_empty, eq, hash, array_len, array_get, open_bytes, bytes_len,
; bytes_get, write_bytes, bytes_slice, bytes_concat, region_write_bytes,
; space_write, supervisor_send, and the builtins taking paths read their list, data,
; array, and bytes arguments without consuming them.
; Their result gains a reference if it is a pointer to a part of an argument,
; and then each argument that came with a reference is released, in order:
; every one but a variable still live afterwards, which was read without one.
(def after_borrow ((n (list int)) (ops (list (list int))) (ts (list Ty))
                   (ws (list bool)) (v EmitVal)) EmitVal
  (if (is_borrowing n)
      (borrowed ops ts ws v (borrows_into_new n))
      v))

; A borrowing operation's result gains a reference if it is a pointer into
; an operand, not when it is new, and then each operand that came with a
; reference is released, in order.
(def borrowed ((ops (list (list int))) (ts (list Ty)) (ws (list bool))
               (v EmitVal) (new bool)) EmitVal
  (match v
    ((Val r t st)
      (Val r t
        (emit_dec_owned ops ts ws
          (if (and (ty_is_ptr t) (not new)) (emit_inc r st) st))))))

(def emit_dec_owned ((ops (list (list int))) (ts (list Ty)) (ws (list bool))
                     (st Emit)) Emit
  (if (is_empty ops)
      st
      (emit_dec_owned (tail ops) (tail ts) (tail ws)
        (if (and (head ws) (ty_is_ptr (head ts))) (emit_dec (head ops) st) st))))

; The type a builtin returns: fixed for most, following the argument for
; cons, head, tail, and the array builtins. Spec 6.
(def builtin_type ((n (list int)) (ts (list Ty))) Ty
  (if (any_eq n (split_spaces "lt le gt ge eq and or not is_empty float_lt float_le float_gt float_ge"))
      (TyBool)
      (if (eq n "cons")
          (head (tail ts))
          (if (any_eq n (split_spaces "head array_get"))
              (ty_elem (head ts))
              (if (any_eq n (split_spaces "tail array_set"))
                  (head ts)
                  (builtin_type_rest n ts))))))

(def builtin_type_rest ((n (list int)) (ts (list Ty))) Ty
  (if (any_eq n (split_spaces "arg buffer_bytes"))
      (TyList (TyInt))
      (if (any_eq n (split_spaces "float_add float_sub float_mul float_div float_neg float_sqrt float_from_int float_from_bits"))
          (TyFloat)
      (if (eq n "array_new")
          (TyArray (head (tail ts)))
          (if (any_eq n (split_spaces "read_bytes read_some bytes_from_list bytes_slice bytes_concat region_read_bytes space_read supervisor_receive"))
              (TyBytes)
              (if (eq n "bytes_to_list")
                  (TyList (TyInt))
                  (if (any_eq n (split_spaces "user_run cpu_trapped")) (TyArray (TyInt)) (TyInt))))))))

; The type a function returns, from its signature.
(def fn_type ((n (list int)) (sigs (Map (list int) Sig))) Ty
  (match (map_get sigs n)
    ((Some s) (.ret s))
    ((None) (TyInt))))

; The type of a call's result. A copy's return type is written in kinds, so
; a call to one has the type its function's signature gives it for the
; arguments' types, which keeps what lies inside a counted type parameter.
; A call through a function parameter, by symbol, is typed by its def's
; signature, in that def's group.
(def call_type ((n (list int)) (ts (list Ty)) (env Env)) Ty
  (if (is_sym_name n)
      (if (starts_with n "@l0_p_")
          (call_type_in (drop_n n 6) ts (.psigs (.fa env)) env)
          (call_type_in (if (eq n "@l0_f_main.body") "main" (drop_n n 6))
                        ts (.gsigs (.fa env)) env))
      (call_type_in n ts (.sigs (.ctx env)) env)))

(def call_type_in ((n (list int)) (ts (list Ty)) (sigs (Map (list int) Sig)) (env Env))
    Ty
  (match (map_get sigs (copy_base n))
    ((Some s)
      (match s
        ((S sn tps sps sr)
          (if (tys_have_fn sps)
              (copy_call_type n ts s env)
              (if (is_empty tps)
                  (fn_type n sigs)
                  (match (match_tys sps ts tps (nil Bind))
                    ((COk bs) (ty_subst sr bs))
                    ((CErr o m) (fn_type n sigs))))))))
    ((None) (fn_type n sigs))))

; A call to a copy for functions passed, given only the arguments that are
; not functions: the functions it was given complete them, as the checker
; matched them. Spec 5.7.
(def copy_call_type ((n (list int)) (ts (list Ty)) (s Sig) (env Env)) Ty
  (match (map_get (.copies (.fa env)) n)
    ((None) (.ret s))
    ((Some refs)
      (match (fn_call_binds n (copy_arg_tys (.params s) ts refs env) s 0)
        ((COk bs) (ty_subst (.ret s) bs))
        ((CErr o m) (.ret s))))))

(def copy_arg_tys ((sps (list Ty)) (ts (list Ty)) (refs (list FnRef)) (env Env))
    (list ArgTy)
  (if (is_empty sps)
      (nil ArgTy)
      (if (ty_is_fn (head sps))
          (cons (ref_arg_ty (.call (head refs)) env)
                (copy_arg_tys (tail sps) ts (tail refs) env))
          (cons (AT (head ts)) (copy_arg_tys (tail sps) (tail ts) refs env)))))

; A def passed, by its @ name, as the argument it was.
(def ref_arg_ty ((call (list int)) (env Env)) ArgTy
  (let sigs (if (starts_with call "@l0_p_") (.psigs (.fa env)) (.gsigs (.fa env)))
    (match (map_get sigs (copy_base (if (eq call "@l0_f_main.body") "main" (drop_n call 6))))
      ((Some h)
        (if (is_empty (.tparams h))
            (AFn (TyFn (.params h) (.ret h)))
            (AGen h)))
      ((None) (AT (TyInt))))))

; A copy's name without its kinds, and any other name as it is.
(def copy_base ((n (list int))) (list int)
  (if (is_empty n)
      n
      (if (eq (head n) 46) (nil int) (cons (head n) (copy_base (tail n))))))

; ------------------------------------------------------------ constructors

; A block is sized for the widest constructor of its type, per spec section
; 10.1, so every value of a type has the same layout.
(def ctor_block_width ((ci CtorInfo) (ctx Ctx)) int
  (match (find_data (.type_name ci) (.datas ctx))
    ((Some dd) (.width dd))
    ((None) 0)))

; tys are the type arguments, if the construction wrote them; otherwise the
; arguments' types give them, as the checker found. Spec 5.6.
(def emit_ctor ((n (list int)) (tys (list Ty)) (args (list Expr)) (env Env)
                (live (list (list int))) (st Emit)) EmitVal
  (match (find_ctor n (.ctors (.ctx env)))
    ((None) (Val "0" (TyInt) st))
    ((Some ci)
      (match (emit_args args env live (nil bool) st)
        ((Ops ops ts ws st1)
          (if (is_unboxed_name (.type_name ci))
              (Val (head ops) (TyData (.type_name ci) (nil Ty)) st1)
              (emit_ctor_block ci
                (TyData (.type_name ci) (ctor_type_args ci tys ts))
                ops (.ctx env) st1)))))))

; Whether a match's one arm names a word wrapper's constructor, so the match
; is a let of the word (spec 10.1).
(def is_word_arms ((arms (list Arm)) (env Env)) bool
  (if (if (is_empty arms) true (not (is_empty (tail arms))))
      false
      (match (find_ctor (.ctor (head arms)) (.ctors (.ctx env)))
        ((Some ci) (is_unboxed_name (.type_name ci)))
        ((None) false))))

; A data block's layout mask has bit k set when word k is a pointer. Word 0
; is the tag, so field i is word i + 1. A field whose declared type is a
; parameter is a pointer or not as the value's type says. Spec 10.1.
(def ctor_mask ((fts (list Ty)) (bit int) (acc int)) int
  (if (is_empty fts)
      acc
      (ctor_mask (tail fts) (mul bit 2)
        (if (ty_is_ptr (head fts)) (add acc bit) acc))))

; dt is the type of the value being built.
(def emit_ctor_block ((ci CtorInfo) (dt Ty) (ops (list (list int))) (ctx Ctx)
                      (st Emit)) EmitVal
  (match (emit_rt_call "l0_new_data"
           (cons (digits (.tag ci))
             (two_ops (digits (ctor_block_width ci ctx))
                      (digits (ctor_mask (ctor_fields_at ci dt) 2 0)))) st)
    ((Val blk t st1)
      (Val blk dt (emit_field_stores blk ops 0 st1)))))

(def emit_field_stores ((blk (list int)) (ops (list (list int))) (i int)
                        (st Emit)) Emit
  (if (is_empty ops)
      st
      (emit_field_stores blk (tail ops) (add i 1)
        (emit_line (append "  call void @l0_data_set(i64 " (append blk
          (append ", i64 " (append (digits i)
            (append ", i64 " (append (head ops) ")")))))) st))))

; ------------------------------------------------------------------- match

; Lowered as a switch on the tag into one block per arm, joined through an
; alloca. The default block is unreachable because the checker proved the
; match exhaustive.
; A subject that is a variable still live afterwards is read without a
; reference, since the binding keeps it alive while the arm takes its fields.
; Any other subject comes with one, which each arm releases once it has.
(def emit_match ((subject Expr) (arms (list Arm)) (env Env)
                 (live (list (list int))) (tl bool) (st Emit)) EmitVal
  (let farms (fv_arms arms (nil (list int)))
    (let slive (set_union farms live)
      (let id (fresh_id st)
        (let slot (append "%m" id)
          (let st1 (emit_slot slot tl (bump st))
            (let sn (var_name subject)
              (if (if (is_empty sn) false (still_held sn env slive))
                  (emit_match_dispatch id slot
                    (lookup_operand sn (.binds env)) arms
                    (Mx env live tl farms false (is_read_only sn env)
                        (lookup_type sn (.binds env))) st1)
                  (match (emit_expr subject env slive false st1)
                    ((Val sv svt st2)
                      (emit_match_dispatch id slot sv arms
                        (Mx env live tl farms true false svt) st2)))))))))))

; What every arm of one match shares: the environment, what is live after
; the match, whether it is in tail position, the names any arm uses,
; whether the subject came with a reference, whether it is a read-only
; parameter, which outlives the whole call, and the subject's type, which
; gives the fields theirs.
(data MatchCx
  (Mx (env Env) (live (list (list int))) (tl bool) (farms (list (list int)))
      (owned bool) (read_only bool) (subject_ty Ty)))

(def arm_label ((id (list int)) (k int)) (list int)
  (append "A" (append id (append "_" (digits k)))))

(def arm_tag ((a Arm) (env Env)) int
  (match (find_ctor (.ctor a) (.ctors (.ctx env)))
    ((Some ci) (.tag ci))
    ((None) 0)))

(def switch_entries ((arms (list Arm)) (env Env) (id (list int)) (k int))
    (list int)
  (if (is_empty arms)
      ""
      (append " i64 " (append (digits (arm_tag (head arms) env))
        (append ", label %" (append (arm_label id k)
          (switch_entries (tail arms) env id (add k 1))))))))

(def emit_match_dispatch ((id (list int)) (slot (list int)) (sv (list int))
                          (arms (list Arm)) (mx MatchCx) (st Emit)) EmitVal
  (match (emit_rt_call "l0_data_tag" (one_op sv) st)
    ((Val tg tgt st1)
      (let lend (append "Lm" id)
        (let lnm (append "Ln" id)
          (let st2 (emit_line (append "  switch i64 " (append tg
                      (append ", label %" (append lnm
                        (append " [" (append (switch_entries arms (.env mx) id 0)
                          " ]")))))) st1)
            (emit_match_tail id slot sv arms mx lend lnm st2)))))))

(def emit_match_tail ((id (list int)) (slot (list int)) (sv (list int))
                      (arms (list Arm)) (mx MatchCx) (lend (list int))
                      (lnm (list int)) (st Emit)) EmitVal
  (match (emit_match_arms arms mx id 0 slot sv lend (TyInt) st)
    ((Val x t st1)
      (let st3 (emit_line "  unreachable" (emit_line (append lnm ":") st1))
        (if (.tl mx)
            (Val "" t st3)
            (let st4 (emit_line (append lend ":") st3)
              (.ty (emit_assign (append "load i64, ptr " slot) st4) t)))))))

; Every arm has the same type, which the checker proved, so the last one
; emitted gives the match its type.
(def emit_match_arms ((arms (list Arm)) (mx MatchCx) (id (list int)) (k int)
                      (slot (list int)) (sv (list int)) (lend (list int))
                      (t Ty) (st Emit)) EmitVal
  (if (is_empty arms)
      (Val "" t st)
      (match (emit_match_arm (head arms) mx (arm_label id k) slot sv lend st)
        ((Val x at st1)
          (emit_match_arms (tail arms) mx id (add k 1) slot sv lend at st1)))))

; An arm takes a reference to each pointer field its body uses, then
; releases the subject if it came with a reference, which may free it now
; that its fields are held separately, and then the bindings only other arms
; use. The fields' names mean the fields in the body, not whatever they meant
; after the match.
(def emit_match_arm ((a Arm) (mx MatchCx) (lbl (list int)) (slot (list int))
                     (sv (list int)) (lend (list int)) (st Emit)) EmitVal
  (match a
    ((A o cn names body)
      (let bfv (fv body)
        (let st1 (emit_line (append lbl ":") st)
          (match (emit_field_loads sv names
                   (arm_field_tys cn (.subject_ty mx) (.env mx)) 0 bfv
                   (if (.read_only mx) (ReadOnlySubject body) (OtherSubject))
                   (.env mx) st1)
            ((EnvSt env2 st2)
              (let st3 (release_names
                         (set_minus (.farms mx)
                           (set_union (set_del_all names bfv) (.live mx)))
                         (.env mx)
                         (if (.owned mx) (emit_dec sv st2) st2))
                (match (emit_expr body env2 (set_del_all names (.live mx))
                                  (.tl mx) st3)
                  ((Val v t st4)
                    (Val "" t
                      (if (.tl mx)
                          st4
                          (emit_line (append "  br label %" lend)
                            (emit_store v slot st4))))))))))))))

(def arm_field_tys ((cn (list int)) (st Ty) (env Env)) (list Ty)
  (arm_fields cn st (.ctors (.ctx env))))

; The arm's body, when the subject is a read-only parameter, which outlives
; the whole call.
(data MaybeBody
  (ReadOnlySubject Expr)
  (OtherSubject))

; A field is taken only if the body uses it, and a later field of the same
; name does not hide it. A field of a read-only subject that the body only
; reads, as ro_ok judges a parameter, is taken without a reference, as a
; read-only binding, since the subject keeps it alive throughout.
(def emit_field_loads ((sv (list int)) (names (list (list int)))
                       (fts (list Ty)) (i int) (used (list (list int)))
                       (rbody MaybeBody) (env Env) (st Emit)) EnvEmit
  (if (is_empty names)
      (EnvSt env st)
      (match (emit_rt_call "l0_data_get" (two_ops sv (digits i)) st)
        ((Val f ft st1)
          (let taken (if (ty_is_ptr (head fts))
                         (if (any_eq (head names) used)
                             (not (any_eq (head names) (tail names)))
                             false)
                         false)
            (if (if taken (field_read_only (head names) (head fts) rbody env) false)
                (emit_field_loads sv (tail names) (tail fts) (add i 1) used rbody
                  (env_bind_read_only (head names) f (head fts) env) st1)
                (emit_field_loads sv (tail names) (tail fts) (add i 1) used rbody
                  (env_bind (head names) f (head fts) env)
                  (if taken (emit_inc f st1) st1))))))))

(def field_read_only ((n (list int)) (t Ty) (rbody MaybeBody) (env Env)) bool
  (match rbody
    ((OtherSubject) false)
    ((ReadOnlySubject body)
      (ro_ok n t body
        (Rx (.pads env) (.builtins (.ctx env)) (.prelude env)
            (.ctors (.ctx env)))))))

(def env_bind_read_only ((n (list int)) (op (list int)) (t Ty) (e Env)) Env
  (.binds e (cons (EB n op t true) (.binds e))))

; ---------------------------------------------------------------- builtins

(def arith_ops ((i int)) (list (list int)) (split_spaces "add sub mul and or"))
(def cmp_names ((i int)) (list (list int)) (split_spaces "lt le gt ge eq"))
(def cmp_preds ((i int)) (list (list int)) (split_spaces "slt sle sgt sge eq"))
; Every I/O builtin is the runtime call of the same name with l0_ in front.
; Spec 10.3.
(def io_names ((i int)) (list (list int))
  (split_spaces
    "read_byte write_byte read_from write_to open_read open_write close arg_count arg flush open_append rename open_bytes open_buffer buffer_bytes read_bytes bytes_len bytes_get bytes_from_list bytes_to_list write_bytes bytes_slice bytes_concat clock_ns remove read_some region_open region_close region_read8 region_read16 region_read32 region_read64 region_write8 region_write16 region_write32 region_write64 barrier space_new frame_new space_map space_map_device space_read space_write user_run timer_at interrupt_enable interrupt_wait interrupt_done supervisor_call supervisor_send supervisor_receive frame_address space_unmap space_free frame_free machine frame_free_count frame_sync board_reset cpu_count cpu_run cpu_trapped cpu_wait heap_left region_read_bytes region_write_bytes"))

(def rt_names ((i int)) (list (list int))
  (append (split_spaces "div mod head tail is_empty array_len array_get array_set bit_shl bit_shr bit_count")
               (io_names 0)))
(def rt_syms ((i int)) (list (list int))
  (append (split_spaces "l0_div l0_mod l0_head l0_tail l0_is_empty l0_array_len l0_array_get l0_array_set l0_bit_shl l0_bit_shr l0_bit_count")
               (l0_prefixed (io_names 0))))

; bit_and, bit_or, and bit_xor are the LLVM instructions of those names.
; Spec 6.10 and 10.3.
(def bit_ops ((i int)) (list (list int)) (split_spaces "bit_and bit_or bit_xor"))
(def bit_insts ((i int)) (list (list int)) (split_spaces "and or xor"))

(def l0_prefixed ((ns (list (list int)))) (list (list int))
  (if (is_empty ns)
      ns
      (cons (append "l0_" (head ns)) (l0_prefixed (tail ns)))))

(def nth_str ((xs (list (list int))) (i int)) (list int)
  (if (le i 0) (head xs) (nth_str (tail xs) (sub i 1))))

; A builtin. ts are the arguments' types; emit_call sets the result's type
; afterwards. eq and compare on counted values are the runtime's, and on int
; or bool are icmp like the other comparisons; hash is always the runtime's,
; told whether its argument is counted, since the word cannot say. Spec 6.8,
; 6.9, 6.11, and 10.3.
(def emit_op ((n (list int)) (ops (list (list int))) (ts (list Ty))
              (st Emit)) EmitVal
  (if (if (eq n "eq") (ty_is_ptr (head ts)) false)
      (emit_rt_call "l0_equal" ops st)
      (if (eq n "hash")
          (emit_rt_call "l0_hash"
            (append ops (one_op (if (ty_is_ptr (head ts)) "1" "0"))) st)
          (if (eq n "compare")
              (if (ty_is_ptr (head ts))
                  (emit_rt_call "l0_compare" ops st)
                  (emit_compare_ints (head ops) (head (tail ops)) st))
              (emit_op_plain n ops ts st)))))

; compare on two ints or bools: (a > b) - (a < b), which is -1, 0, or 1.
(def emit_compare_ints ((a (list int)) (b (list int)) (st Emit)) EmitVal
  (match (emit_cmp "sgt" a b st)
    ((Val g gt st1)
      (match (emit_cmp "slt" a b st1)
        ((Val l lt st2) (emit_binop "sub" g l st2))))))

(def emit_op_plain ((n (list int)) (ops (list (list int))) (ts (list Ty))
                    (st Emit)) EmitVal
  (if (any_eq n (arith_ops 0))
      (emit_binop n (head ops) (head (tail ops)) st)
      (if (ge (index_of n (cmp_names 0)) 0)
          (emit_cmp (nth_str (cmp_preds 0) (index_of n (cmp_names 0)))
                    (head ops) (head (tail ops)) st)
          (if (ge (index_of n (rt_names 0)) 0)
              (emit_rt_call (nth_str (rt_syms 0) (index_of n (rt_names 0)))
                            ops st)
              (emit_op_rest n ops ts st)))))

(def emit_op_rest ((n (list int)) (ops (list (list int))) (ts (list Ty))
                   (st Emit)) EmitVal
  (if (eq n "neg")
      (emit_binop "sub" "0" (head ops) st)
      (if (ge (index_of n (bit_ops 0)) 0)
          (emit_binop (nth_str (bit_insts 0) (index_of n (bit_ops 0)))
                      (head ops) (head (tail ops)) st)
          (if (any_eq n (bi_float 0))
              (emit_float_op n ops st)
              (emit_op_more n ops ts st)))))

; ------------------------------------------------------------------ floats
;
; A float is held as its key (spec 10.1): the IEEE bits with bits 0 to 62
; flipped when bit 63 is set. The map is its own inverse. An operation
; decodes to a double, computes, and encodes; every operation that can make
; a NaN gives 0x7FF8000000000000 instead of the CPU's. Spec 6.17.

; x xor ((x ashr 63) lshr 1)
(def f_map ((x (list int)) (st Emit)) EmitVal
  (match (emit_assign (append "ashr i64 " (append x ", 63")) st)
    ((Val s ts st1)
      (match (emit_assign (append "lshr i64 " (append s ", 1")) st1)
        ((Val m tm st2) (emit_binop "xor" x m st2))))))

; A key as a double.
(def f_decode ((k (list int)) (st Emit)) EmitVal
  (match (f_map k st)
    ((Val b tb st1)
      (emit_assign (append "bitcast i64 " (append b " to double")) st1))))

; A double as a key.
(def f_encode ((d (list int)) (st Emit)) EmitVal
  (match (emit_assign (append "bitcast double " (append d " to i64")) st)
    ((Val b tb st1) (f_map b st1))))

; The key of the double d, or the one NaN's if d is a NaN.
(def f_encode_canon ((d (list int)) (st Emit)) EmitVal
  (match (f_encode d st)
    ((Val e te st1)
      (match (emit_assign (append "fcmp uno double " (append d (append ", " d))) st1)
        ((Val u tu st2)
          (emit_assign (append "select i1 " (append u
            (append ", i64 9221120237041090560, i64 " e))) st2))))))

(def f_arith ((n (list int))) (list int)
  (nth_str (split_spaces "fadd fsub fmul fdiv")
           (index_of n (split_spaces "float_add float_sub float_mul float_div"))))

(def f_pred ((n (list int))) (list int)
  (nth_str (split_spaces "olt ole ogt oge")
           (index_of n (split_spaces "float_lt float_le float_gt float_ge"))))

(def emit_float_op ((n (list int)) (ops (list (list int))) (st Emit)) EmitVal
  (if (any_eq n (split_spaces "float_add float_sub float_mul float_div"))
      (match (f_decode (head ops) st)
        ((Val da ta st1)
          (match (f_decode (head (tail ops)) st1)
            ((Val db tb st2)
              (match (emit_assign (append (f_arith n) (append " double "
                         (append da (append ", " db)))) st2)
                ((Val r tr st3) (f_encode_canon r st3)))))))
      (emit_float_op_rest n ops st)))

(def emit_float_op_rest ((n (list int)) (ops (list (list int))) (st Emit))
    EmitVal
  (if (any_eq n (split_spaces "float_lt float_le float_gt float_ge"))
      (match (f_decode (head ops) st)
        ((Val da ta st1)
          (match (f_decode (head (tail ops)) st1)
            ((Val db tb st2)
              (match (emit_assign (append "fcmp " (append (f_pred n)
                         (append " double " (append da (append ", " db))))) st2)
                ((Val c tc st3)
                  (emit_assign (append "zext i1 " (append c " to i64")) st3)))))))
      (emit_float_op_conv n (head ops) st)))

(def emit_float_op_conv ((n (list int)) (a (list int)) (st Emit)) EmitVal
  (if (eq n "float_neg")
      (match (f_decode a st)
        ((Val d td st1)
          (match (emit_assign (append "fneg double " d) st1)
            ((Val r tr st2) (f_encode r st2)))))
      (if (eq n "float_sqrt")
          (match (f_decode a st)
            ((Val d td st1)
              (match (emit_assign (append "call double @llvm.sqrt.f64(double "
                                   (append d ")")) st1)
                ((Val r tr st2) (f_encode_canon r st2)))))
      (if (eq n "float_from_int")
          (match (emit_assign (append "sitofp i64 " (append a " to double")) st)
            ((Val d td st1) (f_encode d st1)))
          (if (eq n "float_to_int")
              (match (f_decode a st)
                ((Val d td st1)
                  (emit_assign (append "call i64 @llvm.fptosi.sat.i64.f64(double "
                                 (append d ")")) st1)))
              (if (eq n "float_bits")
                  (f_map a st)
                  (emit_from_bits a st)))))))

; float_from_bits: the key of the bits, or the one NaN's for any NaN.
(def emit_from_bits ((a (list int)) (st Emit)) EmitVal
  (match (f_map a st)
    ((Val k tk st1)
      (match (emit_assign (append "bitcast i64 " (append a " to double")) st1)
        ((Val d td st2)
          (match (emit_assign (append "fcmp uno double " (append d (append ", " d))) st2)
            ((Val u tu st3)
              (emit_assign (append "select i1 " (append u
                (append ", i64 9221120237041090560, i64 " k))) st3))))))))

; A float literal: the IEEE bits of m divided by those of 10^k, which is
; correctly rounded since both are exact (spec 2.1), negated if written so.
(def emit_float_lit ((m int) (p int) (neg bool) (st Emit)) EmitVal
  (match (emit_assign (append "fdiv double 0x" (append (hex_digits m 16)
           (append ", 0x" (hex_digits p 16)))) st)
    ((Val q tq st1)
      (if neg
          (match (emit_assign (append "fneg double " q) st1)
            ((Val r tr st2) (.ty (f_encode r st2) (TyFloat))))
          (.ty (f_encode q st1) (TyFloat))))))

(def emit_op_more ((n (list int)) (ops (list (list int))) (ts (list Ty))
                   (st Emit)) EmitVal
  (if (eq n "not")
      (emit_binop "xor" (head ops) "1" st)
      (if (eq n "array_new")
          (emit_rt_call "l0_array_new"
            (append ops
              (one_op (if (ty_is_ptr (head (tail ts))) "1" "0")))
            st)
          (emit_rt_call "l0_new_cons"
            (append ops (one_op (cons_mask (ty_elem (head (tail ts))))))
            st))))

; ------------------------------------------------------------- tail calls
;
; A tail call is emitted as musttail, which LLVM accepts only between
; functions of one prototype. So every function takes as many parameters as
; the widest function in its tail-call component, the functions joined to it
; by tail calls in either direction, and a caller passes 0 for the extra
; ones. Spec 8 and 10.2.

(data Pad
  (Pd (sym (list int)) (arity int) (read_only (list bool)) (updates (list bool))))
                                        ; symbol, parameters it takes, read-only

; One function: its symbol, its L0 arity, and the symbols it tail-calls.
(data Node
  (Nd (list int) int (list (list int))))

(data Edge
  (Ed int int))                         ; positions of caller and callee

; A call resolves to the prelude's function when the name is one this scope
; reaches there, and to the program's otherwise. The two carry different
; symbols, which is what lets both exist at once, and the program's main has
; a body apart from the entry point the runtime calls. Spec 7.1 and 10.2.
; A name that starts with @ is a symbol already: a call through a function
; parameter in a copy, which mono_program resolved to its def (check.l0).
(def fn_sym ((n (list int)) (pnames (list (list int)))) (list int)
  (if (is_sym_name n)
      (tail n)
      (if (any_eq n pnames)
          (append "l0_p_" n)
          (if (eq n "main") "l0_f_main.body" (append "l0_f_" n)))))

(def is_sym_name ((n (list int))) bool
  (if (is_empty n) false (eq (head n) 64)))

(def def_sym ((n (list int)) (inpre bool)) (list int)
  (if inpre (append "l0_p_" n) (fn_sym n (nil (list int)))))

; bs is every builtin's name, ctx_builtins.
(def tail_callees ((e Expr) (pn (list (list int))) (bs (list (list int)))
                   (acc (list (list int)))) (list (list int))
  (match e
    ((EFloat o m p g) acc)
    ((EInt o v) acc)
    ((EBool o v) acc)
    ((EStr o s) acc)
    ((EVar o n) acc)
    ((EIf o c a b) (tail_callees b pn bs (tail_callees a pn bs acc)))
    ((ELet o n v body) (tail_callees body pn bs acc))
    ((ENil o t) acc)
    ((ECtor o n tys args) acc)
    ((EMatch o s arms) (arm_callees arms pn bs acc))
    ((ECall o n args)
      (if (any_eq n bs) acc (cons (fn_sym n pn) acc)))
    ((EField o f e) acc)
    ((EWith o f e v) acc)))

(def arm_callees ((arms (list Arm)) (pn (list (list int)))
                  (bs (list (list int))) (acc (list (list int))))
    (list (list int))
  (if (is_empty arms)
      acc
      (match (head arms)
        ((A o cn names body)
          (arm_callees (tail arms) pn bs (tail_callees body pn bs acc))))))

; Every function of both groups, in declaration order. ppre and pprog are the
; prelude names each group's calls reach, and bpre and bprog its builtins.
(def graph_nodes ((ds (list Decl)) (pre int) (ppre (list (list int)))
                  (pprog (list (list int))) (bpre (list (list int)))
                  (bprog (list (list int)))) (list Node)
  (if (is_empty ds)
      (nil Node)
      (match (head ds)
        ((DData o n tps cs) (graph_nodes (tail ds) pre ppre pprog bpre bprog))
        ((DDef o n fps ps ret body)
          (let inpre (lt o pre)
            (cons (Nd (def_sym n inpre) (length ps)
                      (tail_callees body (if inpre ppre pprog) (if inpre bpre bprog)
                                    (nil (list int))))
                  (graph_nodes (tail ds) pre ppre pprog bpre bprog)))))))

(def node_syms ((ns (list Node))) (list (list int))
  (if (is_empty ns)
      (nil (list int))
      (match (head ns) ((Nd s k cs) (cons s (node_syms (tail ns)))))))

(def node_arities ((ns (list Node))) (list int)
  (if (is_empty ns)
      (nil int)
      (match (head ns) ((Nd s k cs) (cons k (node_arities (tail ns)))))))

(def graph_edges ((ns (list Node)) (syms (list (list int))) (i int)
                  (acc (list Edge))) (list Edge)
  (if (is_empty ns)
      acc
      (match (head ns)
        ((Nd s k cs)
          (graph_edges (tail ns) syms (add i 1)
            (callee_edges cs syms i acc))))))

(def callee_edges ((cs (list (list int))) (syms (list (list int))) (i int)
                   (acc (list Edge))) (list Edge)
  (if (is_empty cs)
      acc
      (let j (index_of (head cs) syms)
        (callee_edges (tail cs) syms i
          (if (or (lt j 0) (eq i j)) acc (cons (Ed i j) acc))))))

(def nth_int ((xs (list int)) (i int)) int
  (if (le i 0) (head xs) (nth_int (tail xs) (sub i 1))))

(def set_int ((xs (list int)) (i int) (v int)) (list int)
  (if (le i 0)
      (cons v (tail xs))
      (cons (head xs) (set_int (tail xs) (sub i 1) v))))

; Raises both ends of every edge to the larger arity until nothing changes,
; which leaves each function with its component's widest.
(def spread ((es (list Edge)) (ks (list int))) (list int)
  (let next (spread_once es ks)
    (if (eq next ks) ks (spread es next))))

(def spread_once ((es (list Edge)) (ks (list int))) (list int)
  (if (is_empty es)
      ks
      (match (head es)
        ((Ed i j)
          (spread_once (tail es) (spread_edge i j ks))))))

(def spread_edge ((i int) (j int) (ks (list int))) (list int)
  (let a (nth_int ks i)
    (let b (nth_int ks j)
      (if (eq a b)
          ks
          (let m (if (gt a b) a b)
            (set_int (set_int ks i m) j m))))))

; ns, rs, and us are all in declaration order, one per function.
(def pad_table ((ns (list Node)) (ks (list int)) (rs (list RoFn))
                (us (list (list bool))) (acc (list Pad))) (list Pad)
  (if (is_empty ns)
      acc
      (match (head ns)
        ((Nd s k cs)
          (pad_table (tail ns) (tail ks) (tail rs) (tail us)
            (cons (Pd s (head ks) (.flags (head rs)) (head us)) acc))))))

(def module_pads ((ds (list Decl)) (pre int) (ppre (list (list int)))
                  (pprog (list (list int))) (bpre (list (list int)))
                  (bprog (list (list int)))) (Map (list int) Pad)
  (let ns (graph_nodes ds pre ppre pprog bpre bprog)
    (let fs (ro_fns ds pre ppre pprog bpre bprog)
      (pad_map
        (pad_table ns
          (spread (graph_edges ns (node_syms ns) 0 (nil Edge)) (node_arities ns))
          (module_read_only fs (collect_ctor_infos ds (nil CtorInfo)))
          (module_updates fs)
          (nil Pad))
        ((MapEmpty (list int) Pad))))))

(def updates_of ((s (list int)) (m (Map (list int) Pad))) (list bool)
  (match (map_get m s)
    ((None) (nil bool))
    ((Some p) (.updates p))))

; ---------------------------------------------------- parameters updated
;
; Which parameters a function updates, so that a caller giving it one of
; its variables still used after the call is told the update copies
; (warn_call). A parameter is updated when the body gives it to the
; builtin array_set, takes it apart with match and updates a field so
; bound, or passes it, or a field of it, where a callee updates; flags
; start clear and passes repeat until nothing changes. Replacing a field is
; not an update here: a shared record's copy is its few words, where an
; array's or a map's is the whole of it, which is what goes quadratic.

(def module_updates ((fs (list RoFn))) (list (list bool))
  (upd_fix fs (upd_none fs)))

(def upd_none ((fs (list RoFn))) (list (list bool))
  (if (is_empty fs)
      (nil (list bool))
      (cons (no_flags (.params (head fs))) (upd_none (tail fs)))))

(def no_flags ((ps (list Param))) (list bool)
  (if (is_empty ps) (nil bool) (cons false (no_flags (tail ps)))))

(def upd_fix ((fs (list RoFn)) (cur (list (list bool)))) (list (list bool))
  (let next (upd_pass fs (upd_table fs cur ((MapEmpty (list int) (list bool)))))
    (if (eq next cur) cur (upd_fix fs next))))

(def upd_table ((fs (list RoFn)) (us (list (list bool))) (m (Map (list int) (list bool))))
    (Map (list int) (list bool))
  (if (is_empty fs)
      m
      (upd_table (tail fs) (tail us) (map_put m (.sym (head fs)) (head us)))))

(def upd_pass ((fs (list RoFn)) (t (Map (list int) (list bool)))) (list (list bool))
  (if (is_empty fs)
      (nil (list bool))
      (cons (upd_params (.params (head fs)) (head fs) t) (upd_pass (tail fs) t))))

; Only a parameter of a counted type can be updated, so a function with
; none is not walked.
(def upd_params ((ps (list Param)) (f RoFn) (t (Map (list int) (list bool))))
    (list bool)
  (if (any_counted ps)
      (upd_flags ps (upd_vars (.body f) f t (nil (list int))))
      (no_flags ps)))

(def any_counted ((ps (list Param))) bool
  (if (is_empty ps)
      false
      (match (head ps) ((P n ty) (if (ty_is_ptr ty) true (any_counted (tail ps)))))))

(def upd_flags ((ps (list Param)) (us (list (list int)))) (list bool)
  (if (is_empty ps)
      (nil bool)
      (cons (match (head ps) ((P n ty) (any_eq n us))) (upd_flags (tail ps) us))))

; The variables e updates, by the rules above, pushed onto acc, in one walk
; of e. f gives the names e's calls reach.
(def upd_vars ((e Expr) (f RoFn) (t (Map (list int) (list bool)))
               (acc (list (list int)))) (list (list int))
  (match e
    ((ECall o n args)
      (upd_all args f t
        (if (if (any_eq n (.bs f)) (eq n "array_set") false)
            (add_name (var_name (head args)) acc)
            (if (any_held args)
                (upd_passed args (callee_updates n f t) acc)
                acc))))
    ((EWith o h r v) (upd_vars v f t (upd_vars r f t acc)))
    ((EMatch o s arms)
      (upd_arms (var_name s) arms f t (upd_vars s f t acc)))
    ((ELet o n v b)
      (upd_vars v f t (names_but n (upd_vars b f t (nil (list int))) acc)))
    ((EIf o c a b) (upd_vars b f t (upd_vars a f t (upd_vars c f t acc))))
    ((ECtor o n ts args) (upd_all args f t acc))
    ((EField o h r) (upd_vars r f t acc))
    ((EInt o v) acc)
    ((EFloat o m p g) acc)
    ((EBool o v) acc)
    ((EStr o s) acc)
    ((ENil o ty) acc)
    ((EVar o n) acc)))

(def any_held ((args (list Expr))) bool
  (if (is_empty args)
      false
      (if (is_empty (held_var (head args))) (any_held (tail args)) true)))

(def add_name ((n (list int)) (acc (list (list int)))) (list (list int))
  (if (if (is_empty n) true (any_eq n acc)) acc (cons n acc)))

; Each of ns but x, pushed onto acc: a binding of x hides an outer x.
(def names_but ((x (list int)) (ns (list (list int))) (acc (list (list int))))
    (list (list int))
  (if (is_empty ns)
      acc
      (names_but x (tail ns) (if (eq (head ns) x) acc (add_name (head ns) acc)))))

(def callee_updates ((n (list int)) (f RoFn) (t (Map (list int) (list bool)))) (list bool)
  (if (any_eq n (.bs f))
      (nil bool)
      (match (map_get t (fn_sym n (.pn f)))
        ((None) (nil bool))
        ((Some us) us))))

; Each variable passed, or whose field (.f x) is passed, in a position flags
; says is updated, pushed onto acc.
(def upd_passed ((args (list Expr)) (flags (list bool)) (acc (list (list int))))
    (list (list int))
  (if (is_empty args)
      acc
      (upd_passed (tail args) (flag_tail flags)
        (if (flag_head flags) (add_name (held_var (head args)) acc) acc))))

; The variable e is, or whose field it reads, or an empty name.
(def held_var ((e Expr)) (list int)
  (match e
    ((EField o f r) (var_name r))
    ((EVar o n) n)
    ((EInt o v) "")
    ((EFloat o m p g) "")
    ((EBool o v) "")
    ((EStr o s) "")
    ((ENil o t) "")
    ((EIf o c a b) "")
    ((ELet o n v b) "")
    ((ECtor o n ts a) "")
    ((EMatch o s a) "")
    ((ECall o n a) "")
    ((EWith o f r v) "")))

(def upd_all ((es (list Expr)) (f RoFn) (t (Map (list int) (list bool)))
              (acc (list (list int)))) (list (list int))
  (if (is_empty es) acc (upd_all (tail es) f t (upd_vars (head es) f t acc))))

; What each arm updates, but the names it binds; and the subject s, a
; variable or an empty name, when an arm updates a field it bound.
(def upd_arms ((s (list int)) (arms (list Arm)) (f RoFn) (t (Map (list int) (list bool)))
               (acc (list (list int)))) (list (list int))
  (if (is_empty arms)
      acc
      (let (a (head arms) inner (upd_vars (.body a) f t (nil (list int))))
        (upd_arms s (tail arms) f t
          (names_but_all (.names a) inner
            (if (any_in (.names a) inner) (add_name s acc) acc))))))

(def any_in ((ns (list (list int))) (us (list (list int)))) bool
  (if (is_empty ns) false (if (any_eq (head ns) us) true (any_in (tail ns) us))))

(def names_but_all ((xs (list (list int))) (ns (list (list int))) (acc (list (list int))))
    (list (list int))
  (if (is_empty ns)
      acc
      (names_but_all xs (tail ns)
        (if (any_eq (head ns) xs) acc (add_name (head ns) acc)))))

; The pad table, looked up at every call: each function's symbol to its Pad,
; in the prelude's map. A symbol given twice keeps the later Pad.
(def pad_map ((ps (list Pad)) (m (Map (list int) Pad)))
    (Map (list int) Pad)
  (if (is_empty ps)
      m
      (match (head ps)
        ((Pd n k ro us) (pad_map (tail ps) (map_put m n (head ps)))))))

(def pad_of ((s (list int)) (m (Map (list int) Pad))) int
  (match (map_get m s)
    ((None) 0)
    ((Some p) (.arity p))))

; Which parameters of the function s are read-only, spec 10.3; empty for a
; symbol not in the table.
(def read_only_of ((s (list int)) (m (Map (list int) Pad))) (list bool)
  (match (map_get m s)
    ((None) (nil bool))
    ((Some p) (.read_only p))))

; ------------------------------------------------------ read-only parameters
;
; Spec 10.3. A flag says a parameter position never consumes what it is
; given: every position of int or bool type, and each read-only one of list,
; data, or array type. Every flag starts set, but main's, and a pass clears
; a pointer parameter's flag if its body lets anything of it escape, and any
; pointer position a tail call gives something the caller owns, since
; releasing it after the call would take the call out of tail position.
; Passes repeat until nothing changes; flags only ever clear, so they stop.
;
; Escaping is anything but a read that yields no pointer. If a callee could
; keep or update a part of its parameter, the caller's reference, held
; across the call, would leave that part shared: an array in it would copy
; on update, and a list walked through it would not be freed as it goes.

; One function: its symbol, parameters, flags, body, the prelude names its
; calls reach, and the builtins no def its calls see shadows.
(data RoFn
  (Rf (sym (list int)) (params (list Param)) (flags (list bool)) (body Expr)
      (pn (list (list int))) (bs (list (list int)))))

(data Demote
  (Dm (list int) int))                  ; symbol, parameter position


; bpre and bprog are each group's builtins, as ppre and pprog are its
; prelude names.
(def ro_fns ((ds (list Decl)) (pre int) (ppre (list (list int)))
             (pprog (list (list int))) (bpre (list (list int)))
             (bprog (list (list int)))) (list RoFn)
  (if (is_empty ds)
      (nil RoFn)
      (match (head ds)
        ((DData o n tps cs) (ro_fns (tail ds) pre ppre pprog bpre bprog))
        ((DDef o n fps ps ret body)
          (let inpre (lt o pre)
            (let sym (def_sym n inpre)
              (cons (Rf sym ps
                        (if (eq sym "l0_f_main.body")
                            (nil bool)
                            (all_set ps))
                        body (if inpre ppre pprog) (if inpre bpre bprog))
                    (ro_fns (tail ds) pre ppre pprog bpre bprog))))))))

(def all_set ((ps (list Param))) (list bool)
  (if (is_empty ps) (nil bool) (cons true (all_set (tail ps)))))

(def module_read_only ((fs (list RoFn)) (cs (list CtorInfo))) (list RoFn)
  (let next (ro_pass fs cs)
    (if (ro_same next fs) fs (module_read_only next cs))))

(def ro_same ((a (list RoFn)) (b (list RoFn))) bool
  (if (is_empty a)
      true
      (if (eq (.flags (head a)) (.flags (head b)))
          (ro_same (tail a) (tail b))
          false)))

; The flag table is built once per pass, since every body consults it.
(def ro_pass ((fs (list RoFn)) (cs (list CtorInfo))) (list RoFn)
  (let own (ro_own_all fs (ro_table fs) cs)
    (ro_apply own (ro_demotions own own (ro_table own) cs (nil Demote)))))

; Each function's flags from its own body.
(def ro_own_all ((todo (list RoFn)) (table (Map (list int) Pad))
                 (cs (list CtorInfo)))
    (list RoFn)
  (if (is_empty todo)
      (nil RoFn)
      (match (head todo)
        ((Rf s ps flags body pn bs)
          (cons (Rf s ps (ro_own_flags ps flags body (Rx table bs pn cs)) body pn bs)
                (ro_own_all (tail todo) table cs))))))

; What judging a body needs: every function's flags, as the pad table holds
; them, the builtins, the prelude names its calls reach, and the
; constructors. The emitter builds one too, to bind fields (emit_field_loads).
(data RoCx
  (Rx (pads (Map (list int) Pad)) (bs (list (list int))) (pn (list (list int)))
      (cs (list CtorInfo))))

(def ro_table ((fs (list RoFn))) (Map (list int) Pad)
  (pad_map (ro_pads fs) ((MapEmpty (list int) Pad))))

(def ro_pads ((fs (list RoFn))) (list Pad)
  (if (is_empty fs)
      (nil Pad)
      (cons (Pd (.sym (head fs)) 0 (.flags (head fs)) (nil bool)) (ro_pads (tail fs)))))


(def ro_own_flags ((ps (list Param)) (flags (list bool)) (body Expr) (x RoCx))
    (list bool)
  (if (is_empty ps)
      (nil bool)
      (match (head ps)
        ((P n t)
          (cons (if (flag_head flags) (ro_ok n t body x) false)
                (ro_own_flags (tail ps) (flag_tail flags) body x))))))

; Whether nothing of p, of type t, escapes e: p itself is only an operand of
; a builtin read that yields no pointer, the subject of a match whose pointer
; fields escape nothing either, or an operand where the callee's flag is
; set. A value of int or bool type cannot escape. A let or a field of the
; same name hides p below it.
(def ro_ok ((p (list int)) (t Ty) (e Expr) (x RoCx)) bool
  (if (not (ty_is_ptr t))
      true
      (match e
        ((EInt o v) true)
        ((EFloat o m p g) true)
        ((EBool o v) true)
        ((EStr o s) true)
        ((ENil o ty) true)
        ((EVar o n) (not (eq n p)))
        ((EIf o c a b)
          (if (ro_ok p t c x) (if (ro_ok p t a x) (ro_ok p t b x) false) false))
        ((ELet o n v body)
          (if (ro_ok p t v x) (if (eq n p) true (ro_ok p t body x)) false))
        ((ECtor o n tys args) (ro_ok_args p t args (nil bool) x))
        ((EMatch o s arms)
          (if (eq (var_name s) p)
              (ro_ok_fields p t arms x)
              (if (ro_ok p t s x) (ro_ok_arms p t arms x) false)))
        ((ECall o n args)
          (ro_ok_args p t args
            (if (any_eq n (.bs x))
                (flags_for (reads_no_pointer n t) args)
                (read_only_of (fn_sym n (.pn x)) (.pads x)))
            x))
        ((EField o f e)
          (if (eq (var_name e) p)
              (not (ty_is_ptr (field_ty_of f t (.cs x))))
              (ro_ok p t e x)))
        ((EWith o f e v)
          (if (ro_ok p t e x) (ro_ok p t v x) false)))))

; Whether the builtin n, given a value of type t, only reads it and yields no
; pointer: head and array_get yield an element, and tail a list.
(def reads_no_pointer ((n (list int)) (t Ty)) bool
  (if (any_eq n (split_spaces "head array_get"))
      (not (ty_is_ptr (ty_elem t)))
      (if (eq n "tail") false (is_borrowing n))))

; p may be an operand itself only where the flag is set.
(def ro_ok_args ((p (list int)) (t Ty) (args (list Expr)) (flags (list bool))
                 (x RoCx)) bool
  (if (is_empty args)
      true
      (if (if (eq (var_name (head args)) p)
              (flag_head flags)
              (ro_ok p t (head args) x))
          (ro_ok_args p t (tail args) (flag_tail flags) x)
          false)))

(def ro_ok_arms ((p (list int)) (t Ty) (arms (list Arm)) (x RoCx)) bool
  (if (is_empty arms)
      true
      (match (head arms)
        ((A o cn names body)
          (if (if (any_eq p names) true (ro_ok p t body x))
              (ro_ok_arms p t (tail arms) x)
              false)))))

; A match on p itself: in each arm, the fields must escape nothing, and nor
; must p, unless a field of the same name hides it.
(def ro_ok_fields ((p (list int)) (t Ty) (arms (list Arm)) (x RoCx)) bool
  (if (is_empty arms)
      true
      (match (head arms)
        ((A o cn names body)
          (if (if (ro_fields_ok names (arm_fields cn t (.cs x)) body x)
                  (if (any_eq p names) true (ro_ok p t body x))
                  false)
              (ro_ok_fields p t (tail arms) x)
              false)))))

; The field types of the constructor cn, for a subject of type st: a field
; whose declared type is a parameter has the type st gives it, which is what
; decides whether it is a pointer.
(def arm_fields ((cn (list int)) (st Ty) (cs (list CtorInfo))) (list Ty)
  (match (find_ctor cn cs)
    ((Some ci) (ctor_fields_at ci st))
    ((None) (nil Ty))))

; A later field of the same name hides an earlier one, which then cannot be
; used at all.
(def ro_fields_ok ((names (list (list int))) (ts (list Ty)) (body Expr) (x RoCx))
    bool
  (if (is_empty names)
      true
      (if (if (is_empty ts)
              true
              (if (any_eq (head names) (tail names))
                  true
                  (ro_ok (head names) (head ts) body x)))
          (ro_fields_ok (tail names) (if (is_empty ts) ts (tail ts)) body x)
          false)))

; Every read-only position a tail call gives anything but a read-only
; parameter of the caller.
(def ro_demotions ((todo (list RoFn)) (fs (list RoFn))
                   (table (Map (list int) Pad))
                   (cs (list CtorInfo)) (acc (list Demote)))
    (list Demote)
  (if (is_empty todo)
      acc
      (match (head todo)
        ((Rf s ps flags body pn bs)
          (ro_demotions (tail todo) fs table cs
            (ro_tail_demote body (ro_names ps flags) (params_to_env ps (nil Bind))
                            fs bs pn (Rx table bs pn cs) acc))))))

; The names of the pointer parameters whose flags are set: read-only.
(def ro_names ((ps (list Param)) (flags (list bool))) (list (list int))
  (if (is_empty ps)
      (nil (list int))
      (match (head ps)
        ((P n t)
          (if (if (flag_head flags) (ty_is_ptr t) false)
              (cons n (ro_names (tail ps) (flag_tail flags)))
              (ro_names (tail ps) (flag_tail flags)))))))

; ok is the caller's read-only parameters not hidden at e by a let or field.
; tys gives each name in ok its type, the latest binding of a name first.
(def ro_tail_demote ((e Expr) (ok (list (list int))) (tys (list Bind))
                     (fs (list RoFn)) (bs (list (list int)))
                     (pn (list (list int))) (x RoCx) (acc (list Demote)))
    (list Demote)
  (match e
    ((EFloat o m p g) acc)
    ((EInt o v) acc)
    ((EBool o v) acc)
    ((EStr o s) acc)
    ((ENil o t) acc)
    ((EVar o n) acc)
    ((ECtor o n ts args) acc)
    ((EIf o c a b)
      (ro_tail_demote b ok tys fs bs pn x
        (ro_tail_demote a ok tys fs bs pn x acc)))
    ((ELet o n v body) (ro_tail_demote body (set_del n ok) tys fs bs pn x acc))
    ((EMatch o s arms)
      (ro_arms_demote arms ok tys
        (if (any_eq (var_name s) ok) (SubjectOk (bind_ty (var_name s) tys)) (SubjectOther))
        fs bs pn x acc))
    ((ECall o n args)
      (if (any_eq n bs)
          acc
          (let g (fn_sym n pn)
            (ro_args_demote g args (read_only_of g (.pads x)) ok 0 acc))))
    ((EField o f e) acc)
    ((EWith o f e v) acc)))

; Whether a match's subject is one of the read-only names, and if so its type.
(data RoSubject
  (SubjectOk Ty)
  (SubjectOther))

(def bind_ty ((n (list int)) (tys (list Bind))) Ty
  (match (find_bind n tys)
    ((Some t) t)
    ((None) (TyInt))))

; A match on a read-only parameter binds each pointer field its arm only
; reads as read-only too (emit_field_loads), so a tail call may pass those.
(def ro_arms_demote ((arms (list Arm)) (ok (list (list int))) (tys (list Bind))
                     (subj RoSubject) (fs (list RoFn)) (bs (list (list int)))
                     (pn (list (list int))) (x RoCx) (acc (list Demote)))
    (list Demote)
  (if (is_empty arms)
      acc
      (match (head arms)
        ((A o cn names body)
          (ro_arms_demote (tail arms) ok tys subj fs bs pn x
            (match subj
              ((SubjectOther)
                (ro_tail_demote body (set_del_all names ok) tys fs bs pn x acc))
              ((SubjectOk st)
                (let fts (arm_fields cn st (.cs x))
                  (ro_tail_demote body
                    (set_union (ro_read_fields names fts body x)
                               (set_del_all names ok))
                    (bind_fields names fts tys)
                    fs bs pn x acc)))))))))

; The pointer fields of an arm, not hidden by a later one of the same name,
; that its body only reads.
(def ro_read_fields ((names (list (list int))) (ts (list Ty)) (body Expr) (x RoCx))
    (list (list int))
  (if (if (is_empty names) true (is_empty ts))
      (nil (list int))
      (if (if (ty_is_ptr (head ts))
              (if (any_eq (head names) (tail names))
                  false
                  (ro_ok (head names) (head ts) body x))
              false)
          (cons (head names) (ro_read_fields (tail names) (tail ts) body x))
          (ro_read_fields (tail names) (tail ts) body x))))

; This also clears flags of int and bool positions, which is harmless: such
; a flag is only ever asked about a pointer variable passed there, which
; types rule out, and a value of those types has nothing to release.
(def ro_args_demote ((g (list int)) (args (list Expr)) (flags (list bool))
                     (ok (list (list int))) (j int) (acc (list Demote)))
    (list Demote)
  (if (is_empty args)
      acc
      (ro_args_demote g (tail args) (flag_tail flags) ok (add j 1)
        (if (if (flag_head flags) (not (any_eq (var_name (head args)) ok)) false)
            (cons (Dm g j) acc)
            acc))))

(def ro_apply ((fs (list RoFn)) (ds (list Demote))) (list RoFn)
  (if (is_empty fs)
      fs
      (match (head fs)
        ((Rf s ps flags body pn bs)
          (cons (Rf s ps (ro_clear s flags ds) body pn bs) (ro_apply (tail fs) ds))))))

(def ro_clear ((s (list int)) (flags (list bool)) (ds (list Demote))) (list bool)
  (if (is_empty ds)
      flags
      (match (head ds)
        ((Dm g j)
          (ro_clear s (if (eq g s) (set_bool flags j false) flags) (tail ds))))))

(def set_bool ((xs (list bool)) (i int) (v bool)) (list bool)
  (if (is_empty xs)
      xs
      (if (le i 0)
          (cons v (tail xs))
          (cons (head xs) (set_bool (tail xs) (sub i 1) v)))))

; ops followed by as many "0" as bring them to k.
(def pad_ops ((ops (list (list int))) (k int)) (list (list int))
  (if (is_empty ops)
      (if (le k 0) ops (cons "0" (pad_ops ops (sub k 1))))
      (cons (head ops) (pad_ops (tail ops) (sub k 1)))))

; -------------------------------------------------------------- functions

; "i64 %a0, i64 %a1", for k parameters from the i-th.
(def fmt_params ((i int) (k int)) (list int)
  (if (ge i k)
      ""
      (append "i64 %a" (append (digits i)
        (if (ge (add i 1) k) "" (append ", " (fmt_params (add i 1) k)))))))

; ro is the read-only flag of each parameter, in order.
(def param_binds ((ps (list Param)) (ro (list bool)) (i int)
                  (acc (list EBind))) (list EBind)
  (if (is_empty ps)
      acc
      (match (head ps)
        ((P n t)
          (param_binds (tail ps) (flag_tail ro) (add i 1)
            (cons (EB n (append "%a" (digits i)) t (flag_head ro)) acc))))))

; What emitting one group's declarations needs: the tables its calls resolve
; against, the names among them that land in the prelude, which group it is,
; and how many parameters every function takes.
(data Scope
  (Sc (ctx Ctx) (prelude_names (list (list int))) (is_prelude bool)
      (pads (Map (list int) Pad)) (fa FnArgs)))

; A program is a closed module, and the runtime reaches into it by name for
; exactly one function, so everything else gets internal linkage and LLVM can
; delete what the program never calls. Every function checks the stack
; before doing anything else, since the runtime cannot portably catch running
; off the end of it. The body is in tail position, so it returns by itself.
; Spec 10.2 and 10.3.
(def emit_fn ((d Decl) (sc Scope) (st Emit)) Emit
  (match d
    ((DData o n tps cs) st)
    ((DDef o n fps ps ret body)
      (let sym (def_sym n (.is_prelude sc))
        (let k (pad_of sym (.pads sc))
          (let st1 (emit_line
                     (append "define internal fastcc i64 @"
                       (append sym
                         (append "(" (append (fmt_params 0 k) ") {"))))
                     (emit_entry n ps k sc st))
            (let st2 (emit_line "  call void @l0_stack_check()"
                       (emit_line "entry:" st1))
              (let env (Ev (param_binds ps (read_only_of sym (.pads sc)) 0
                                        (nil EBind))
                           (.ctx sc) (.prelude_names sc) (.pads sc) (.fa sc))
                (emit_line ""
                  (emit_line "}"
                    (.st (emit_expr body env (nil (list int)) true
                              (release_names
                                (set_minus (param_names ps) (fv body))
                                env st2)))))))))))))

(def param_names ((ps (list Param))) (list (list int))
  (if (is_empty ps)
      (nil (list int))
      (match (head ps) ((P n t) (cons n (param_names (tail ps)))))))

; The runtime calls every main as @l0_f_main with one argument, whatever the
; body's prototype, and a main that takes no parameters ignores it. Prelude
; functions are never the entry point, however they are named. Spec 10.2.
(def emit_entry ((n (list int)) (ps (list Param)) (k int) (sc Scope)
                 (st Emit)) Emit
  (if (or (.is_prelude sc) (not (eq n "main")))
      st
      (let ops (pad_ops (if (is_empty ps) (nil (list int)) (one_op "%a0")) k)
        (emit_line ""
          (emit_line "}"
            (emit_line "  ret i64 %r"
              (emit_line (append "  %r = call fastcc i64 @l0_f_main.body("
                           (append (fmt_ops ops) ")"))
                (emit_line "entry:"
                  (emit_line "define i64 @l0_f_main(i64 %a0) {" st)))))))))

; The counter restarts per function purely to keep names short. Numbering is
; a function of program structure either way, so output stays deterministic.
(def reset_counter ((st Emit)) Emit
  (.next st 0))

(def emit_fns ((ds (list Decl)) (scpre Scope) (scprog Scope) (pre int)
               (st Emit)) Emit
  (if (is_empty ds)
      st
      (emit_fns (tail ds) scpre scprog pre
        (emit_fn (head ds)
                 (if (in_prelude (head ds) pre) scpre scprog)
                 (reset_counter st)))))

; The prelude names a program declaration still reaches: the ones the program
; did not define itself, since its own definition shadows the prelude's.
(def unshadowed ((pnames (list (list int))) (unames (list (list int)))
                 (acc (list (list int)))) (list (list int))
  (if (is_empty pnames)
      acc
      (unshadowed (tail pnames) unames
        (if (any_eq (head pnames) unames) acc (cons (head pnames) acc)))))

(def prelude_names ((ds (list Decl)) (pre int)) (list (list int))
  (fn_names (prelude_decls ds pre (nil Decl)) (nil (list int))))

(def program_prelude_names ((ds (list Decl)) (pre int)) (list (list int))
  (unshadowed (prelude_names ds pre)
    (fn_names (program_decls ds pre (nil Decl)) (nil (list int)))
    (nil (list int))))

; ----------------------------------------------------------------- module

(def ir_header ((i int)) (list int)
  (append "; generated by the L0 compiler\n"
    (append "declare i64 @l0_cons(i64, i64)\n"
      (append "declare i64 @l0_head(i64)\n"
        (append "declare i64 @l0_tail(i64)\n"
          (append "declare i64 @l0_is_empty(i64)\n"
            (append "declare i64 @l0_div(i64, i64)\n"
              (append "declare i64 @l0_mod(i64, i64)\n"
                (append "declare i64 @l0_data_new(i64, i64)\n"
                  (append "declare void @l0_data_set(i64, i64, i64)\n"
                    (append "declare i64 @l0_data_tag(i64)\n"
                      (append "declare i64 @l0_data_get(i64, i64)\ndeclare i64 @l0_data_with(i64, i64, i64)\ndeclare i64 @l0_data_take(i64, i64)\n"
                        (append "declare void @l0_stack_check()\n"
                          (append "declare i64 @l0_read_byte()\n"
                            (append "declare i64 @l0_write_byte(i64)\n"
                              (io_decls 0))))))))))))))))

(def io_decls ((i int)) (list int)
  (append "declare void @l0_inc(i64)\n"
   (append "declare void @l0_dec(i64)\n" (io_decls_counted 0))))

(def io_decls_counted ((i int)) (list int)
  (append "declare i64 @l0_new_cons(i64, i64, i64)\ndeclare i64 @l0_string(ptr, i64)\n"
    (append "declare i64 @l0_new_data(i64, i64, i64)\n" (io_decls_rest 0))))

(def io_decls_rest ((i int)) (list int)
  (append "declare i64 @l0_read_from(i64)\n"
    (append "declare i64 @l0_write_to(i64, i64)\n"
      (append "declare i64 @l0_open_read(i64)\n"
        (append "declare i64 @l0_open_write(i64)\n"
          (append "declare i64 @l0_close(i64)\n"
            (append "declare i64 @l0_arg_count()\n"
              (append "declare i64 @l0_arg(i64)\n" (io_decls_files 0)))))))))

(def io_decls_files ((i int)) (list int)
  (append "declare i64 @l0_flush(i64)\n"
    (append "declare i64 @l0_open_append(i64)\n"
      (append "declare i64 @l0_rename(i64, i64)\n"
        (append "declare i64 @l0_open_bytes(i64)\n"
          (append "declare i64 @l0_open_buffer()\n"
            (append "declare i64 @l0_buffer_bytes(i64)\n" (array_decls 0))))))))

(def array_decls ((i int)) (list int)
  (append "declare i64 @l0_array_new(i64, i64, i64)\n"
    (append "declare i64 @l0_array_len(i64)\n"
      (append "declare i64 @l0_array_get(i64, i64)\n"
        (append "declare i64 @l0_array_set(i64, i64, i64)\n"
          (append "declare i64 @l0_array_set_row(i64, i64, i64, i64)\n"
            (bytes_decls 0)))))))

(def bytes_decls ((i int)) (list int)
  (append "declare i64 @l0_read_bytes(i64)\n"
    (append "declare i64 @l0_bytes_len(i64)\n"
      (append "declare i64 @l0_bytes_get(i64, i64)\n"
        (append "declare i64 @l0_bytes_from_list(i64)\n"
          (append "declare i64 @l0_bytes_to_list(i64)\n"
            (append "declare i64 @l0_write_bytes(i64, i64, i64, i64)\n"
              (append "declare i64 @l0_clock_ns()\n"
                (append "declare i64 @l0_equal(i64, i64)\n"
                  (append "declare i64 @l0_hash(i64, i64)\n" (bit_decls 0)))))))))))

(def bit_decls ((i int)) (list int)
  (append "declare i64 @l0_bit_shl(i64, i64)\n"
    (append "declare i64 @l0_bit_shr(i64, i64)\n"
      (append "declare i64 @l0_bit_count(i64)\n"
        (append "declare i64 @llvm.fptosi.sat.i64.f64(double)\n"
        (append "declare double @llvm.sqrt.f64(double)\n"
        (append "declare i64 @l0_remove(i64)\n"
          (append "declare i64 @l0_compare(i64, i64)\n"
            (append "declare i64 @l0_read_some(i64, i64)\n" (region_decls 0))))))))))

(def region_decls ((i int)) (list int)
  (append "declare i64 @l0_region_open(i64, i64)\n"
    (append "declare i64 @l0_region_close(i64)\n"
    (append "declare i64 @l0_region_read8(i64, i64)\n"
      (append "declare i64 @l0_region_read16(i64, i64)\n"
        (append "declare i64 @l0_region_read32(i64, i64)\n"
          (append "declare i64 @l0_region_read64(i64, i64)\n"
            (append "declare i64 @l0_region_write8(i64, i64, i64)\n"
              (append "declare i64 @l0_region_write16(i64, i64, i64)\n"
                (append "declare i64 @l0_region_write32(i64, i64, i64)\n"
                  (append "declare i64 @l0_region_write64(i64, i64, i64)\n"
                    (append "declare i64 @l0_region_read_bytes(i64, i64, i64)\n"
                    (append "declare i64 @l0_region_write_bytes(i64, i64, i64, i64, i64)\n"
                    (append "declare i64 @l0_barrier()\n"
                      (append "declare i64 @l0_array_take(i64, i64)\n" (user_decls 0))))))))))))))))

(def user_decls ((i int)) (list int)
  (append "declare i64 @l0_space_new()\n"
    (append "declare i64 @l0_frame_new()\n"
      (append "declare i64 @l0_space_map(i64, i64, i64, i64)\n"
        (append "declare i64 @l0_space_map_device(i64, i64, i64, i64)\n"
          (append "declare i64 @l0_space_read(i64, i64, i64)\n"
            (append "declare i64 @l0_space_write(i64, i64, i64, i64, i64)\n"
              (append "declare i64 @l0_user_run(i64, i64)\n" (interrupt_decls 0)))))))))

(def interrupt_decls ((i int)) (list int)
  (append "declare i64 @l0_timer_at(i64)\n"
    (append "declare i64 @l0_interrupt_enable(i64)\n"
      (append "declare i64 @l0_interrupt_wait()\n"
        (append "declare i64 @l0_interrupt_done(i64)\n"
          (append "declare i64 @l0_supervisor_call(i64, i64, i64, i64)\n"
            (append "declare i64 @l0_supervisor_send(i64, i64, i64, i64, i64)\n"
              (append "declare i64 @l0_supervisor_receive(i64, i64, i64)\n"
                (append "declare i64 @l0_frame_address(i64)\n"
                  (append "declare i64 @l0_space_unmap(i64, i64)\n"
                    (append "declare i64 @l0_space_free(i64)\n"
                      (append "declare i64 @l0_frame_free(i64)\n"
                        (append "declare i64 @l0_machine()\n"
                          (append "declare i64 @l0_frame_free_count()\n"
                            (append "declare i64 @l0_frame_sync(i64, i64)\n"
                              (append "declare i64 @l0_bytes_slice(i64, i64, i64)\n"
                                (append "declare i64 @l0_bytes_concat(i64)\n"
                                  (append "declare i64 @l0_board_reset()\n" (cpu_decls 0)))))))))))))))))))

(def cpu_decls ((i int)) (list int)
  (append "declare i64 @l0_cpu_count()\n"
    (append "declare i64 @l0_cpu_run(i64, i64, i64, i64, i64)\n"
      (append "declare i64 @l0_cpu_trapped()\n"
        (append "declare i64 @l0_cpu_wait()\n"
          "declare i64 @l0_heap_left()\n\n")))))

(def ret_kind ((ds (list Decl))) int
  (if (is_empty ds)
      2
      (match (head ds)
        ((DData o n tps cs) (ret_kind (tail ds)))
        ((DDef o n fps ps ret body)
          (if (eq n "main")
              (if (is_empty ps)
                  3
                  (if (eq ret (TyInt)) 0 (if (eq ret (TyBool)) 1 2)))
              (ret_kind (tail ds)))))))

; The return kind is read off the program's main, not the prelude's: a main in
; the prelude is library code that happens to be called main, not an entry
; point. Spec section 9.
; A function with type parameters is emitted as its copies, spec 10.2.
(def emit_module ((ds (list Decl)) (pre int)) Emitted
  (let hs (unbox_words (hide_tparams (group_upper ds pre)))
    (match (mono_program hs pre)
      ((MP ms rs) (emit_grouped ms (copied_defs hs (nil Decl)) rs pre)))))

; The functions with type or function parameters, which copies replace in
; what is emitted but whose signatures a call's type is computed from, spec
; 10.2.
(def copied_defs ((ds (list Decl)) (acc (list Decl))) (list Decl)
  (if (is_empty ds)
      (rev_onto acc (nil Decl))
      (copied_defs (tail ds)
        (match (head ds)
          ((DData o n tps cs) acc)
          ((DDef o n fps ps ret body)
            (if (if (is_empty fps) (not (tys_have_fn (param_tys ps))) false)
                acc
                (cons (head ds) acc)))))))

; The module's text, and the warnings of the program's own declarations,
; each once, in the order emitted; the prelude's are the library's to fix.
(data Emitted
  (Emitted (text (list int)) (warns (list Diag))))

(def emit_grouped ((ds (list Decl)) (gs (list Decl)) (rs (list Req)) (pre int))
    Emitted
  (let st0 (Em 0 (push (ir_header 0) (nil int)) (nil Diag)
               ((MapEmpty (list int) int)) (nil (list int)))
    (let st1 (emit_line (append "@l0_main_ret_kind = global i64 "
                (append (digits (ret_kind (program_decls ds pre (nil Decl))))
                        "\n")) st0)
      (emit_module_fns ds gs rs pre (prelude_names ds pre)
        (program_prelude_names ds pre) st1))))

(def emit_module_fns ((ds (list Decl)) (gs (list Decl)) (rs (list Req)) (pre int)
                      (ppre (list (list int))) (pprog (list (list int)))
                      (st Emit)) Emitted
  (let pv (prelude_view (append gs ds) pre)
    (let gv (program_view (append gs ds) pre)
      (let pads (module_pads ds pre ppre pprog (.builtins pv) (.builtins gv))
        (let fa (FA (.sigs pv) (.sigs gv) (copy_refs rs ((MapEmpty (list int) (list FnRef)))))
          (let done (emit_fns ds (Sc pv ppre true pads fa) (Sc gv pprog false pads fa)
                              pre st)
            (Emitted (emit_text (emit_strs (rev (.strs done)) 0 done))
                     (program_warns (rev (.warns done)) pre (nil Diag)))))))))

(def program_warns ((ws (list Diag)) (pre int) (acc (list Diag))) (list Diag)
  (if (is_empty ws)
      (rev acc)
      (program_warns (tail ws) pre
        (if (if (lt (diag_offset (head ws)) pre) true (any_eq (head ws) acc))
            acc
            (cons (head ws) acc)))))

(def diag_offset ((d Diag)) int
  (match d
    ((D o m) o)
    ((DParens o n next deficit) o)))

(def copy_refs ((rs (list Req)) (m (Map (list int) (list FnRef))))
    (Map (list int) (list FnRef))
  (if (is_empty rs)
      m
      (copy_refs (tail rs) (map_put m (.name (head rs)) (.refs (head rs))))))

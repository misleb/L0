; lex.l0 -- source bytes to tokens.
;
; The lexer never fails. Problems become TErr tokens and scanning continues,
; so there is no error plumbing here at all; the parser reports any TErr it
; meets. This keeps the lexer a plain fold over the input.
;
; Every token carries a byte offset rather than a line and column. Rendering a
; diagnostic turns an offset into line:column by scanning the source, which
; keeps positions to one int and means a future multi-file input bundle only
; changes the renderer.

(data Token
  (TLParen int)                ; offset
  (TRParen int)                ; offset
  (TInt int int)               ; offset, value
  (TFloat int int int bool)    ; offset, IEEE bits of m, of 10^k, negative
  (TStr int (list int))        ; offset, bytes
  (TName int (list int))       ; offset, name
  (TErr int (list int))        ; offset, message
  (TField int (list int)))     ; offset, the field name after the . (spec 2.4)

; A position in the input: what is left, and the offset it starts at.
(data Cursor
  (Cur (list int) int))

; A scanned token plus the cursor after it.
(data Scan
  (Scanned Token (list int) int))

(def tok_offset ((t Token)) int
  (match t
    ((TLParen o) o)
    ((TRParen o) o)
    ((TInt o v) o)
    ((TFloat o m p g) o)
    ((TStr o s) o)
    ((TName o s) o)
    ((TErr o m) o)
    ((TField o s) o)))

; ---------------------------------------------------------------- accessors
;
; match has no wildcard arm, so inspecting a token inline costs six lines
; every time. These collapse that to a predicate, which is what makes the
; parser readable.

(def tok_kind ((t Token)) int
  (match t
    ((TLParen o) 0)
    ((TRParen o) 1)
    ((TInt o v) 2)
    ((TStr o s) 3)
    ((TName o s) 4)
    ((TErr o m) 5)
    ((TFloat o m p g) 6)
    ((TField o s) 7)))

(def tok_is_lparen ((t Token)) bool (eq (tok_kind t) 0))
(def tok_is_rparen ((t Token)) bool (eq (tok_kind t) 1))
(def tok_is_int ((t Token)) bool (eq (tok_kind t) 2))
(def tok_is_str ((t Token)) bool (eq (tok_kind t) 3))
(def tok_is_name ((t Token)) bool (eq (tok_kind t) 4))
(def tok_is_err ((t Token)) bool (eq (tok_kind t) 5))
(def tok_is_float ((t Token)) bool (eq (tok_kind t) 6))
(def tok_is_field ((t Token)) bool (eq (tok_kind t) 7))

; A float token's bits of m, then of 10^k, and whether it is negative.
(def tok_float_m ((t Token)) int
  (match t
    ((TFloat o m p g) m)
    ((TInt o v) 0)
    ((TLParen o) 0)
    ((TRParen o) 0)
    ((TStr o s) 0)
    ((TName o s) 0)
    ((TErr o e) 0)
    ((TField o s) 0)))

(def tok_float_p ((t Token)) int
  (match t
    ((TFloat o m p g) p)
    ((TInt o v) 0)
    ((TLParen o) 0)
    ((TRParen o) 0)
    ((TStr o s) 0)
    ((TName o s) 0)
    ((TErr o e) 0)
    ((TField o s) 0)))

(def tok_float_neg ((t Token)) bool
  (match t
    ((TFloat o m p g) g)
    ((TInt o v) false)
    ((TLParen o) false)
    ((TRParen o) false)
    ((TStr o s) false)
    ((TName o s) false)
    ((TErr o e) false)
    ((TField o s) false)))

(def tok_int ((t Token)) int
  (match t
    ((TInt o v) v)
    ((TFloat o m p g) 0)
    ((TLParen o) 0)
    ((TRParen o) 0)
    ((TStr o s) 0)
    ((TName o s) 0)
    ((TErr o m) 0)
    ((TField o s) 0)))

; The payload of whichever token kinds carry bytes.
(def tok_bytes ((t Token)) (list int)
  (match t
    ((TStr o s) s)
    ((TName o s) s)
    ((TErr o m) m)
    ((TField o s) s)
    ((TLParen o) (nil int))
    ((TRParen o) (nil int))
    ((TFloat o m p g) (nil int))
    ((TInt o v) (nil int))))

; Offset of the first token, or the supplied fallback when there is none.
(def head_offset ((ts (list Token)) (fallback int)) int
  (if (is_empty ts) fallback (tok_offset (head ts))))

; ------------------------------------------------------------------ trivia

(def skip_trivia ((src (list int)) (off int)) Cursor
  (if (is_empty src)
      (Cur src off)
      (let c (head src)
        (if (is_space c)
            (skip_trivia (tail src) (add off 1))
            (if (eq c 59)
                (skip_comment (tail src) (add off 1))
                (Cur src off))))))

(def skip_comment ((src (list int)) (off int)) Cursor
  (if (is_empty src)
      (Cur src off)
      (if (eq (head src) 10)
          (skip_trivia (tail src) (add off 1))
          (skip_comment (tail src) (add off 1)))))

; ------------------------------------------------------------------ strings

; Accumulates bytes in reverse; start is the offset of the opening quote.
(def scan_string ((src (list int)) (off int) (start int) (acc (list int))) Scan
  (if (is_empty src)
      (Scanned (TErr start "unterminated string literal") src off)
      (let c (head src)
        (if (eq c 34)
            (Scanned (TStr start (rev acc)) (tail src) (add off 1))
            (if (eq c 10)
                (Scanned (TErr off "newline in string literal; use \\n")
                         (tail src) (add off 1))
                (if (eq c 92)
                    (scan_escape (tail src) (add off 1) start acc)
                    (scan_string (tail src) (add off 1) start (cons c acc))))))))

; The byte an escape letter denotes, or -1 if it is not an escape. Keeping
; this separate holds scan_escape to a readable nesting depth.
(def escape_byte ((e int)) int
  (if (eq e 110) 10
  (if (eq e 116) 9
  (if (eq e 114) 13
  (if (eq e 92) 92
  (if (eq e 34) 34
    -1))))))

(def scan_escape ((src (list int)) (off int) (start int) (acc (list int))) Scan
  (if (is_empty src)
      (Scanned (TErr start "unterminated string literal") src off)
      (let e (head src)
        (if (eq e 120)
            (scan_hex (tail src) (add off 1) start acc)
            (let b (escape_byte e)
              (if (lt b 0)
                  (Scanned
                    (TErr (sub off 1)
                      "unknown escape; the escapes are \\n \\t \\r \\\\ \\\" \\xHH")
                    (tail src) (add off 1))
                  (scan_string (tail src) (add off 1) start (cons b acc))))))))

(def scan_hex ((src (list int)) (off int) (start int) (acc (list int))) Scan
  (if (is_empty src)
      (Scanned (TErr off "incomplete \\x escape") src off)
      (if (is_empty (tail src))
          (Scanned (TErr off "incomplete \\x escape") (tail src) (add off 1))
          (let h1 (hex_val (head src))
            (let h2 (hex_val (head (tail src)))
              (if (or (lt h1 0) (lt h2 0))
                  (Scanned (TErr off "\\x needs exactly two hexadecimal digits")
                           (tail (tail src)) (add off 2))
                  (scan_string (tail (tail src)) (add off 2) start
                               (cons (add (mul h1 16) h2) acc))))))))

; ------------------------------------------------------------------ numbers

; Digits accumulate as a non-positive value so that the most negative integer
; is representable on the way in; a positive literal is negated at the end.
(def acc_overflows ((n int) (d int)) bool
  (or (lt n -922337203685477580)
      (and (eq n -922337203685477580) (gt d 8))))

(def scan_digits ((src (list int)) (off int) (n int) (count int)) Scan
  (if (is_empty src)
      (Scanned (TInt off n) src off)
      (let c (head src)
        (if (is_digit c)
            (if (acc_overflows n (sub c 48))
                (Scanned (TErr off "integer literal does not fit in 64 bits")
                         (skip_name_rest (tail src)) off)
                (scan_digits (tail src) (add off 1)
                             (sub (mul n 10) (sub c 48)) (add count 1)))
            (Scanned (TInt off n) src off)))))

(def skip_name_rest ((src (list int))) (list int)
  (if (is_empty src)
      src
      (if (is_name_rest (head src))
          (skip_name_rest (tail src))
          src)))

(def count_digits ((src (list int)) (n int)) int
  (if (is_empty src)
      n
      (if (is_digit (head src))
          (count_digits (tail src) (add n 1))
          n)))

(def scan_number ((src (list int)) (off int)) Scan
  (let negative (eq (head src) 45)
    (let body (if negative (tail src) src)
      (let body_off (if negative (add off 1) off)
        (if (eq (count_digits body 0) 0)
            (Scanned (TErr off "expected digits after '-'") body body_off)
            (if (float_ahead body)
                (scan_float body body_off off negative)
                (finish_number (scan_digits body body_off 0 0) off negative)))))))

; ------------------------------------------------------------------- floats
;
; Spec 2.1: m divided by 10^k, with m at most 2^53 and k at most 22, so both
; are exact binary64s and one IEEE division gives the correctly rounded
; value. The token carries the IEEE bits of m and of 10^k, computed here
; with integers, since the compiler has no floats.

; Digit values, in reverse, then what is left and its offset.
(data Run
  (Run (list int) (list int) int))

(def take_digits ((src (list int)) (off int) (acc (list int))) Run
  (if (is_empty src)
      (Run acc src off)
      (if (is_digit (head src))
          (take_digits (tail src) (add off 1) (cons (sub (head src) 48) acc))
          (Run acc src off))))

; Whether src, which starts with a digit, is digits, a point, and a digit.
(def float_ahead ((src (list int))) bool
  (match (take_digits src 0 (nil int))
    ((Run ds rest o)
      (if (is_empty rest)
          false
          (if (eq (head rest) 46)
              (if (is_empty (tail rest)) false (is_digit (head (tail rest))))
              false)))))

; Reversed digits without their leading zeros: the trailing zeros of the
; number they spell.
(def drop_zeros ((ds (list int))) (list int)
  (if (is_empty ds)
      ds
      (if (eq (head ds) 0) (drop_zeros (tail ds)) ds)))

; Digits, first to last, as an integer held at 2^53 + 1 once it is past 2^53.
(def fold_digits ((ds (list int)) (m int)) int
  (if (is_empty ds)
      m
      (let v (add (mul m 10) (head ds))
        (fold_digits (tail ds) (if (gt v 9007199254740993) 9007199254740993 v)))))

(def pow5 ((k int) (acc int)) int
  (if (eq k 0) acc (pow5 (sub k 1) (mul acc 5))))

; The position of the highest set bit of n, for n at least 1.
(def high_bit ((n int) (e int)) int
  (if (eq n 1) e (high_bit (bit_shr n 1) (add e 1))))

; The IEEE bits of n times 2^e2, for n from 0 to 2^53.
(def double_bits ((n int) (e2 int)) int
  (if (eq n 0)
      0
      (let e (high_bit n 0)
        (let mant (if (le e 52) (bit_shl n (sub 52 e)) (bit_shr n (sub e 52)))
          (bit_or (bit_shl (add (add e e2) 1023) 52)
                  (bit_and mant 4503599627370495))))))

; body starts with digits, a point, and a digit; start is the offset of the
; token, which has a - first if negative.
(def scan_float ((body (list int)) (off int) (start int) (negative bool)) Scan
  (match (take_digits body off (nil int))
    ((Run ids rest o1)
      (match (take_digits (tail rest) (add o1 1) (nil int))
        ((Run fds rest2 o2)
          (let fr (drop_zeros fds)
            (let k (length fr)
              (let m (fold_digits (rev fr) (fold_digits (rev ids) 0))
                (if (if (is_empty rest2) false (is_name_rest (head rest2)))
                    (Scanned (TErr start "invalid character in float literal")
                             (skip_name_rest rest2) o2)
                    (if (gt m 9007199254740992)
                        (Scanned (TErr start "float literal's digits are more than 2^53; write it with float_from_bits")
                                 rest2 o2)
                        (if (gt k 22)
                            (Scanned (TErr start "float literal has more than 22 digits after the point; write it with float_from_bits")
                                     rest2 o2)
                            (Scanned (TFloat start (double_bits m 0)
                                             (double_bits (pow5 k 1) k) negative)
                                     rest2 o2))))))))))))

; scan_digits produced a non-positive magnitude. Fix the sign, reject a
; positive literal that only fits as a negative one, and reject a name
; character glued to the end such as 12abc.
(def finish_number ((s Scan) (start int) (negative bool)) Scan
  (match s
    ((Scanned t rest off)
      (match t
        ((TErr o m) (Scanned (TErr start m) rest off))
        ((TFloat o m p g) s)
        ((TInt o n)
          (if (if (is_empty rest) false (is_name_rest (head rest)))
              (Scanned (TErr start "invalid character in integer literal")
                       (skip_name_rest rest) off)
              (if negative
                  (Scanned (TInt start n) rest off)
                  (if (eq n (int_min 0))
                      (Scanned (TErr start
                                 "integer literal does not fit in 64 bits")
                               rest off)
                      (Scanned (TInt start (neg n)) rest off)))))
        ((TLParen o) s)
        ((TRParen o) s)
        ((TStr o v) s)
        ((TName o v) s)
        ((TField o v) s)))))

; -------------------------------------------------------------------- names

(def scan_name_bytes ((src (list int)) (off int) (acc (list int))) Scan
  (if (is_empty src)
      (Scanned (TName off (rev acc)) src off)
      (if (is_name_rest (head src))
          (scan_name_bytes (tail src) (add off 1) (cons (head src) acc))
          (Scanned (TName off (rev acc)) src off))))

(def scan_name ((src (list int)) (off int)) Scan
  (match (scan_name_bytes src off (nil int))
    ((Scanned t rest noff)
      (match t
        ((TName o s) (Scanned (TName off s) rest noff))
        ((TLParen o) (Scanned t rest noff))
        ((TRParen o) (Scanned t rest noff))
        ((TInt o v) (Scanned t rest noff))
        ((TFloat o m p g) (Scanned t rest noff))
        ((TStr o v) (Scanned t rest noff))
        ((TErr o m) (Scanned t rest noff))
        ((TField o v) (Scanned t rest noff))))))

; A field name, spec 2.4: the . is behind src and off is its offset. A .
; followed by anything but a lower name's first character is an error, as
; it always was.
(def scan_field ((src (list int)) (off int)) Scan
  (if (if (is_empty src) false (is_name_start (head src)))
      (match (scan_name src (add off 1))
        ((Scanned t rest noff) (Scanned (TField off (tok_bytes t)) rest noff)))
      (Scanned (TErr off "unexpected character") src (add off 1))))

; ------------------------------------------------------------------- driver

(def scan_token ((src (list int)) (off int)) Scan
  (let c (head src)
    (if (eq c 40)
        (Scanned (TLParen off) (tail src) (add off 1))
        (if (eq c 41)
            (Scanned (TRParen off) (tail src) (add off 1))
            (if (eq c 34)
                (scan_string (tail src) (add off 1) off (nil int))
                (if (or (is_digit c) (eq c 45))
                    (scan_number src off)
                    (if (is_name_start c)
                        (scan_name src off)
                        (if (eq c 46)
                            (scan_field (tail src) off)
                            (Scanned (TErr off "unexpected character")
                                     (tail src) (add off 1))))))))))

(def lex_onto ((src (list int)) (off int) (acc (list Token))) (list Token)
  (match (skip_trivia src off)
    ((Cur rest roff)
      (if (is_empty rest)
          acc
          (match (scan_token rest roff)
            ((Scanned t rest2 off2) (lex_onto rest2 off2 (cons t acc))))))))

(def lex ((src (list int))) (list Token)
  (rev (lex_onto src 0 (nil Token))))

; First error token in a stream, if any. The parser uses this to report
; lexical problems before attempting to build an AST.
(def first_lex_error ((ts (list Token))) (list int)
  (if (is_empty ts)
      (nil int)
      (match (head ts)
        ((TErr o m) m)
        ((TLParen o) (first_lex_error (tail ts)))
        ((TRParen o) (first_lex_error (tail ts)))
        ((TInt o v) (first_lex_error (tail ts)))
        ((TFloat o m p g) (first_lex_error (tail ts)))
        ((TStr o s) (first_lex_error (tail ts)))
        ((TName o s) (first_lex_error (tail ts)))
        ((TField o s) (first_lex_error (tail ts))))))

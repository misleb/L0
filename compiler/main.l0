; main.l0 -- the compiler's entry point, input bundle, and output protocol.
;
; The compiler is a pure byte function: source in, LLVM IR text out. It has
; exactly one channel in each direction, and both carry a little structure so
; that no I/O primitive is needed in the language.
;
; OUTPUT. Success and failure are distinguished by a tag on the first line:
;
;   "O\n" followed by LLVM IR
;   "E\n" followed by diagnostics, one per line
;
; INPUT. L0 has no module system, so a multi-file program is concatenated.
; Concatenation alone loses the file boundaries, which would make every
; diagnostic report a line number in the joined text rather than in the file
; the reader is looking at. An optional bundle header restores them, and also
; says where the prelude ends. Spec section 9.1 is the definition:
;
;   #l0bundle
;   #prelude <byte offset>
;   <byte offset> <path>
;   <byte offset> <path>
;   #source
;   <the concatenated file contents>
;
; Input that does not begin with #l0bundle is treated as a single unnamed
; source, so piping a bare file still works and the bootstrap is unaffected.

(data FileEntry
  (FE (start int) (path (list int))))   ; start offset, path

; The file table, the source text, whether a main is required, and the byte
; offset where the prelude ends. A bundle header line of #nomain relaxes the
; main requirement, for checking a library file or a work in progress without
; being nagged about a missing entry point. An offset of 0 means there is no
; prelude, which is the case for every input that does not say otherwise.
(data Bundle
  (Bnd (list FileEntry) (list int) bool int))


(def parse_entry ((ln (list int))) FileEntry
  (FE (int_prefix ln 0) (skip_spaces (skip_digits ln))))

(def parse_entries ((s (list int)) (acc (list FileEntry)) (want_main bool)
                    (pre int)) Bundle
  (if (is_empty s)
      (Bnd (rev_onto acc (nil FileEntry)) (nil int) want_main pre)
      (if (starts_with s "#source")
          (Bnd (rev_onto acc (nil FileEntry)) (drop_line s)
               want_main pre)
          (parse_header_line s acc want_main pre))))

; Directives and file entries may be interleaved in any order, so each line is
; recognised on its own rather than by position.
(def parse_header_line ((s (list int)) (acc (list FileEntry))
                        (want_main bool) (pre int)) Bundle
  (if (starts_with s "#nomain")
      (parse_entries (drop_line s) acc false pre)
      (if (starts_with s "#prelude")
          (parse_entries (drop_line s) acc want_main
                         (int_prefix (skip_spaces (drop_n s 8)) 0))
          (parse_entries (drop_line s)
                         (cons (parse_entry (take_line s)) acc)
                         want_main pre))))

(def parse_bundle ((input (list int))) Bundle
  (if (starts_with input "#l0bundle")
      (parse_entries (drop_line input) (nil FileEntry) true 0)
      (Bnd (nil FileEntry) input true 0)))

; The last entry starting at or before this offset, which is the file the
; offset falls in. Entries are in ascending order of start.
(def file_at ((entries (list FileEntry)) (o int) (best FileEntry)) FileEntry
  (if (is_empty entries)
      best
      (if (le (.start (head entries)) o)
          (file_at (tail entries) o (head entries))
          best)))

; ------------------------------------------------------------- diagnostics

; Positions are byte offsets, so line and column are recovered by scanning.
; Diagnostics are rare, so the cost per diagnostic does not matter, and the
; front end stays free of line tracking.
(def line_at ((src (list int)) (o int) (i int) (line int)) int
  (if (is_empty src)
      line
      (if (ge i o)
          line
          (line_at (tail src) o (add i 1)
            (if (eq (head src) 10) (add line 1) line)))))

(def col_at ((src (list int)) (o int) (i int) (col int)) int
  (if (is_empty src)
      col
      (if (ge i o)
          col
          (col_at (tail src) o (add i 1)
            (if (eq (head src) 10) 1 (add col 1))))))

(def render_diag ((src (list int)) (entries (list FileEntry)) (d Diag))
    (list int)
  (match d
    ((D o m)
      (if (lt o 0)
          (append "error: " (append m "\n"))
          (let fe (file_at entries o (FE 0 ""))
            (render_at src (.path fe) (.start fe) o m))))
    ((DParens o name next deficit)
      (let fe (file_at entries o (FE 0 ""))
        (render_at src (.path fe) (.start fe) o
          (parens_message src (.start fe) o name next deficit))))))

; ------------------------------------------------- miscounted parentheses

; A declaration short of closing parens, or over, is reported at the
; declaration with the count, and with a guess at where: for closers
; missing, the end of the last line indented past the form still open where
; the next line starts, since a line of L0 is indented past its parent, so
; the first line that is not marks where the parent should have closed; for
; closers too many, the line where the declaration closed, which is exact.
(def parens_message ((src (list int)) (start int) (o int) (name (list int))
                     (next int) (deficit int)) (list int)
  (let who (if (is_empty name) "this declaration" name)
    (if (gt deficit 0)
        (append who (append " is missing " (append (parens_count deficit)
          (append (if (lt next 0)
                      " before the end of the input"
                      (append " before the declaration at line "
                        (digits (line_of src start next))))
            (probable_end src start o next)))))
        (append who (append " has " (append (parens_count (neg deficit))
          (append " too many" (closes_at src start o next))))))))

(def parens_count ((n int)) (list int)
  (append (digits n) (if (eq n 1) " closing paren" " closing parens")))

(def line_of ((src (list int)) (start int) (o int)) int
  (line_at (drop_n src start) (sub o start) 0 1))

(def probable_end ((src (list int)) (start int) (o int) (next int)) (list int)
  (let p (ind_scan (drop_n src o) o next
                   (sub (col_at (drop_n src start) (sub o start) 0 1) 1)
                   (nil int) false -1)
    (if (lt p 0)
        ""
        (append "; probably at the end of line " (digits (line_of src start p))))))

(def closes_at ((src (list int)) (start int) (o int) (next int)) (list int)
  (let p (close_scan (drop_n src o) o next 0 false)
    (if (lt p 0)
        ""
        (append ": it closes at line " (digits (line_of src start p))))))

; Whether the scan is past its end: the source, or the byte after the offset
; stop when it is not negative. The byte at stop, the next declaration's (,
; is scanned, since its indentation is what judges the line before it.
(def scan_done ((src (list int)) (i int) (stop int)) bool
  (if (is_empty src) true (if (lt stop 0) false (gt i stop))))

; The offset of the newline ending the last line with text before the first
; line whose first byte is not indented past the innermost ( still open, or
; -1. i is the offset of src's first byte and col its column; opens holds
; the columns of the open parens, innermost first; fresh says the current
; line has had only blanks so far; last_end is the newline ending the last
; line with text, or -1 on the first line, which is never reported, since
; it is the declaration's own. Comments and strings are skipped, and a
; comment's indentation is not judged.
(def ind_scan ((src (list int)) (i int) (stop int) (col int) (opens (list int))
               (fresh bool) (last_end int)) int
  (if (scan_done src i stop)
      -1
      (let c (head src)
        (if (eq c 10)
            (ind_scan (tail src) (add i 1) stop 0 opens true
                      (if fresh last_end i))
            (if (if fresh (or (eq c 32) (eq c 9)) false)
                (ind_scan (tail src) (add i 1) stop (add col 1) opens true last_end)
                (if (ind_breaks c col opens fresh last_end)
                    last_end
                    (ind_step src i stop col opens c last_end)))))))

; Whether the first byte of a line, c at column col, is not indented past
; the innermost open paren.
(def ind_breaks ((c int) (col int) (opens (list int)) (fresh bool)
                 (last_end int)) bool
  (if (not fresh)
      false
      (if (lt last_end 0)
          false
          (if (is_empty opens)
              false
              (if (eq c 59) false (le col (head opens)))))))

(def ind_step ((src (list int)) (i int) (stop int) (col int) (opens (list int))
               (c int) (last_end int)) int
  (if (eq c 59)
      (match (skip_to_eol (tail src) (add i 1))
        ((Cur rest j) (ind_scan rest j stop col opens false last_end)))
      (if (eq c 34)
          (match (skip_str (tail src) (add i 1))
            ((Cur rest j)
              (ind_scan rest j stop (add col (sub j i)) opens false last_end)))
          (if (eq c 40)
              (ind_scan (tail src) (add i 1) stop (add col 1) (cons col opens)
                        false last_end)
              (if (eq c 41)
                  (ind_scan (tail src) (add i 1) stop (add col 1)
                            (if (is_empty opens) opens (tail opens)) false last_end)
                  (ind_scan (tail src) (add i 1) stop (add col 1) opens false
                            last_end))))))

; The offset of the ) that brings the declaration back to depth 0, once a (
; has been seen, or -1.
(def close_scan ((src (list int)) (i int) (stop int) (depth int) (seen bool)) int
  (if (scan_done src i stop)
      -1
      (let c (head src)
        (if (eq c 59)
            (match (skip_to_eol (tail src) (add i 1))
              ((Cur rest j) (close_scan rest j stop depth seen)))
            (if (eq c 34)
                (match (skip_str (tail src) (add i 1))
                  ((Cur rest j) (close_scan rest j stop depth seen)))
                (if (eq c 40)
                    (close_scan (tail src) (add i 1) stop (add depth 1) true)
                    (if (eq c 41)
                        (if (if seen (eq depth 1) false)
                            i
                            (close_scan (tail src) (add i 1) stop (sub depth 1) seen))
                        (close_scan (tail src) (add i 1) stop depth seen))))))))

; At the newline that ends a comment, or the end of the input, so that the
; scans above see the newline; the lexer's skip_comment runs on past it.
(def skip_to_eol ((src (list int)) (off int)) Cursor
  (if (is_empty src)
      (Cur src off)
      (if (eq (head src) 10)
          (Cur src off)
          (skip_to_eol (tail src) (add off 1)))))

; Past the rest of a string literal whose opening " is behind src.
(def skip_str ((src (list int)) (off int)) Cursor
  (if (is_empty src)
      (Cur src off)
      (if (eq (head src) 34)
          (Cur (tail src) (add off 1))
          (if (eq (head src) 92)
              (if (is_empty (tail src))
                  (Cur (tail src) (add off 1))
                  (skip_str (tail (tail src)) (add off 2)))
              (skip_str (tail src) (add off 1))))))

; Line and column are measured from the start of the file the offset falls
; in, not from the start of the concatenation, which is the whole point of
; carrying a file table.
(def render_at ((src (list int)) (path (list int)) (start int) (o int)
                (m (list int))) (list int)
  (let text (drop_n src start)
    (let rel (sub o start)
      (append (file_prefix path)
        (append (digits (line_at text rel 0 1))
          (append ":" (append (digits (col_at text rel 0 1))
            (append ": error: " (append m "\n")))))))))

(def file_prefix ((path (list int))) (list int)
  (if (is_empty path) "" (append path ":")))

(def render_diags ((src (list int)) (entries (list FileEntry))
                   (ds (list Diag)) (acc (list int))) (list int)
  (if (is_empty ds)
      acc
      (render_diags src entries (tail ds)
        (push (render_diag src entries (head ds)) acc))))

(def failure ((src (list int)) (entries (list FileEntry)) (ds (list Diag)))
    (list int)
  (append "E\n" (rev (render_diags src entries ds (nil int)))))

; ---------------------------------------------------------------- driver

; Declarations that failed to parse are dropped, and the rest are still type
; checked, so one bad declaration does not hide type errors everywhere else.
; A use of a def that was dropped is not reported as unknown, since the
; syntax error already says what is wrong with it. Emission happens only
; when nothing at all was reported, so a partial AST is never compiled.
(def compile ((input (list int))) (list int)
  (match (parse_bundle input)
    ((Bnd entries src want_main pre)
      (match (parse_program (lex src))
        ((PP ds perrs bad)
          (let all (append perrs (known_only (check_program ds want_main pre) bad))
            (if (is_empty all)
                (append "O\n" (emit_module ds pre))
                (failure src entries all))))))))

; ds without the reports that one of bad, the defs that failed to parse, is
; an unknown function or variable.
(def known_only ((ds (list Diag)) (bad (list (list int)))) (list Diag)
  (if (is_empty bad)
      ds
      (keep_known ds (dropped_reports bad (nil (list int))) (nil Diag))))

(def dropped_reports ((bad (list (list int))) (acc (list (list int))))
    (list (list int))
  (if (is_empty bad)
      acc
      (dropped_reports (tail bad)
        (cons (append "unknown function " (head bad))
          (cons (append "unknown variable " (head bad)) acc)))))

(def keep_known ((ds (list Diag)) (quiet (list (list int))) (acc (list Diag)))
    (list Diag)
  (if (is_empty ds)
      (rev acc)
      (match (head ds)
        ((D o m)
          (keep_known (tail ds) quiet
            (if (any_eq m quiet) acc (cons (head ds) acc))))
        ((DParens o n next deficit)
          (keep_known (tail ds) quiet (cons (head ds) acc))))))

(def main ((input (list int))) (list int)
  (compile input))

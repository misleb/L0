; parse.l0 -- tokens to an abstract syntax tree.
;
; Covers the slice-1 subset: everything in L0 v1 except data declarations and
; match. Parsing stops at the first error, which is reported with the byte
; offset of the token that caused it.
;
; Note the family of near-identical result types below. L0's data types are
; monomorphic and list is its only parametric type constructor, so a "either a
; value or an error" type cannot be written once and reused. This is the
; concrete case for parametric data types; adopting them here follows the
; two-step rule in the l0-bootstrap skill.

(data Ty
  (TyInt)
  (TyBool)
  (TyList Ty)
  (TyData (list int)))                  ; declared type name

(data Expr
  (EInt int int)                        ; offset, value
  (EBool int bool)                      ; offset, value
  (EStr int (list int))                 ; offset, bytes
  (EVar int (list int))                 ; offset, name
  (EIf int Expr Expr Expr)              ; offset, condition, then, else
  (ELet int (list int) Expr Expr)       ; offset, name, value, body
  (ENil int Ty)                         ; offset, element type
  (ECtor int (list int) (list Expr))    ; offset, constructor, arguments
  (EMatch int Expr (list Arm))          ; offset, subject, arms
  (ECall int (list int) (list Expr)))   ; offset, callee name, arguments

; One match arm: the constructor it names, one binding name per field, and
; the expression to evaluate. Patterns are one level deep, so a binding is
; always a plain name.
(data Arm
  (A int (list int) (list (list int)) Expr))

(data Param
  (P (list int) Ty))                    ; name, type

(data Ctor
  (C int (list int) (list Ty)))         ; offset, name, field types

(data Decl
  (DDef int (list int) (list Param) Ty Expr)
  (DData int (list int) (list Ctor)))   ; offset, type name, constructors

; ----------------------------------------------------------------- on types

(def ty_kind ((t Ty)) int
  (match t
    ((TyInt) 0)
    ((TyBool) 1)
    ((TyList e) 2)
    ((TyData n) 3)))

(def ty_is_list ((t Ty)) bool (eq (ty_kind t) 2))
(def ty_is_data ((t Ty)) bool (eq (ty_kind t) 3))

; The element type of a list. The result is meaningless for non-lists, which
; callers guard with ty_is_list.
(def ty_elem ((t Ty)) Ty
  (match t
    ((TyList e) e)
    ((TyInt) (TyInt))
    ((TyBool) (TyBool))
    ((TyData n) (TyInt))))

(def ty_name ((t Ty)) (list int)
  (match t
    ((TyData n) n)
    ((TyInt) "")
    ((TyBool) "")
    ((TyList e) "")))

(def ty_eq ((a Ty) (b Ty)) bool
  (if (not (eq (ty_kind a) (ty_kind b)))
      false
      (if (ty_is_list a)
          (ty_eq (ty_elem a) (ty_elem b))
          (if (ty_is_data a)
              (list_eq (ty_name a) (ty_name b))
              true))))

; Renders a type as spec-legal source text, for diagnostics.
(def ty_str ((t Ty)) (list int)
  (match t
    ((TyInt) "int")
    ((TyBool) "bool")
    ((TyList e) (append "(list " (append (ty_str e) ")")))
    ((TyData n) n)))

(data PTy
  (PTOk Ty (list Token))
  (PTErr int (list int)))

(data PExpr
  (PEOk Expr (list Token))
  (PEErr int (list int)))

(data PArgs
  (PAOk (list Expr) (list Token))
  (PAErr int (list int)))

(data PParams
  (PPsOk (list Param) (list Token))
  (PPsErr int (list int)))

(data PArms
  (PAsOk (list Arm) (list Token))
  (PAsErr int (list int)))

(data PCtors
  (PCsOk (list Ctor) (list Token))
  (PCsErr int (list int)))

(data PNames
  (PNsOk (list (list int)) (list Token))
  (PNsErr int (list int)))

(data PDecl
  (PDOk Decl (list Token))
  (PDErr int (list int)))

; A diagnostic: byte offset and message. Defined here rather than in check.l0
; because the parser produces them too. Declaration order across files does
; not matter in L0, so either file could hold it.
(data Diag
  (D int (list int)))

; The declarations that parsed, and the errors found. Both at once, so that
; a file with one bad declaration still gets its remaining declarations type
; checked instead of only reporting the syntax error.
(data PProg
  (PP (list Decl) (list Diag)))

; ------------------------------------------------------------------- names

(def reserved_words ((ignored int)) (list (list int))
  (split_spaces "def data if let match nil true false int bool list"))

(def is_reserved ((n (list int))) bool
  (any_eq n (reserved_words 0)))

(def name_is_lower ((n (list int))) bool
  (if (is_empty n) false (is_lower (head n))))

(def name_is_upper ((n (list int))) bool
  (if (is_empty n) false (is_upper (head n))))

(def rev_exprs_onto ((xs (list Expr)) (acc (list Expr))) (list Expr)
  (if (is_empty xs)
      acc
      (rev_exprs_onto (tail xs) (cons (head xs) acc))))

(def rev_params_onto ((xs (list Param)) (acc (list Param))) (list Param)
  (if (is_empty xs)
      acc
      (rev_params_onto (tail xs) (cons (head xs) acc))))

(def rev_decls_onto ((xs (list Decl)) (acc (list Decl))) (list Decl)
  (if (is_empty xs)
      acc
      (rev_decls_onto (tail xs) (cons (head xs) acc))))

(def rev_arms_onto ((xs (list Arm)) (acc (list Arm))) (list Arm)
  (if (is_empty xs)
      acc
      (rev_arms_onto (tail xs) (cons (head xs) acc))))

(def rev_ctors_onto ((xs (list Ctor)) (acc (list Ctor))) (list Ctor)
  (if (is_empty xs)
      acc
      (rev_ctors_onto (tail xs) (cons (head xs) acc))))

(def rev_tys_list_onto ((xs (list Ty)) (acc (list Ty))) (list Ty)
  (if (is_empty xs)
      acc
      (rev_tys_list_onto (tail xs) (cons (head xs) acc))))

; ------------------------------------------------------------------- types

(def parse_type ((ts (list Token))) PTy
  (if (is_empty ts)
      (PTErr 0 "expected a type")
      (let t (head ts)
        (if (tok_is_err t)
            (PTErr (tok_offset t) (tok_bytes t))
            (if (tok_is_name t)
                (parse_type_name t (tail ts))
                (if (tok_is_lparen t)
                    (parse_list_type (tail ts) (tok_offset t))
                    (PTErr (tok_offset t)
                      "expected a type: int, bool, or (list T)")))))))

; An uppercase name is a declared data type. Whether it was actually
; declared is the checker's business, not the parser's.
(def parse_type_name ((t Token) (rest (list Token))) PTy
  (let n (tok_bytes t)
    (if (list_eq n "int")
        (PTOk (TyInt) rest)
        (if (list_eq n "bool")
            (PTOk (TyBool) rest)
            (if (list_eq n "list")
                (PTErr (tok_offset t)
                  "list needs an element type, as in (list int)")
                (if (name_is_upper n)
                    (PTOk (TyData n) rest)
                    (PTErr (tok_offset t) "unknown type")))))))

(def parse_list_type ((ts (list Token)) (open int)) PTy
  (if (is_empty ts)
      (PTErr open "unclosed ( in a type")
      (let t (head ts)
        (if (not (and (tok_is_name t) (list_eq (tok_bytes t) "list")))
            (PTErr (tok_offset t) "expected list after ( in a type")
            (match (parse_type (tail ts))
              ((PTErr o m) (PTErr o m))
              ((PTOk elem rest) (close_list_type elem rest open)))))))

(def close_list_type ((elem Ty) (rest (list Token)) (open int)) PTy
  (if (is_empty rest)
      (PTErr open "unclosed ( in a type")
      (if (tok_is_rparen (head rest))
          (PTOk (TyList elem) (tail rest))
          (PTErr (tok_offset (head rest))
            "(list ...) takes exactly one element type"))))

; ------------------------------------------------------------- expressions

(def parse_expr ((ts (list Token))) PExpr
  (if (is_empty ts)
      (PEErr 0 "expected an expression")
      (let t (head ts)
        (if (tok_is_err t)
            (PEErr (tok_offset t) (tok_bytes t))
            (if (tok_is_int t)
                (PEOk (EInt (tok_offset t) (tok_int t)) (tail ts))
                (if (tok_is_str t)
                    (PEOk (EStr (tok_offset t) (tok_bytes t)) (tail ts))
                    (if (tok_is_name t)
                        (parse_atom_name t (tail ts))
                        (if (tok_is_lparen t)
                            (parse_form (tail ts) (tok_offset t))
                            (PEErr (tok_offset t)
                              "unexpected ) where an expression was expected")))))))))

(def parse_atom_name ((t Token) (rest (list Token))) PExpr
  (let n (tok_bytes t)
    (let o (tok_offset t)
      (if (list_eq n "true")
          (PEOk (EBool o true) rest)
          (if (list_eq n "false")
              (PEOk (EBool o false) rest)
              (if (name_is_upper n)
                  (PEErr o "uppercase names are types and constructors, not values")
                  (if (is_reserved n)
                      (PEErr o "this word is reserved and is not a value here")
                      (PEOk (EVar o n) rest))))))))

; A parenthesised form: the ( is already consumed and open is its offset.
(def parse_form ((ts (list Token)) (open int)) PExpr
  (if (is_empty ts)
      (PEErr open "unclosed (")
      (let t (head ts)
        (if (tok_is_err t)
            (PEErr (tok_offset t) (tok_bytes t))
            (if (not (tok_is_name t))
                (PEErr (tok_offset t)
                  "expected a function or special form name after (")
                (dispatch_form (tok_bytes t) (tail ts) open (tok_offset t)))))))

(def dispatch_form ((n (list int)) (ts (list Token)) (open int) (o int)) PExpr
  (if (list_eq n "if") (parse_if ts open)
  (if (list_eq n "let") (parse_let ts open)
  (if (list_eq n "nil") (parse_nil ts open)
  (if (list_eq n "match") (parse_match ts open)
  (if (or (list_eq n "def") (list_eq n "data"))
      (PEErr o "this can only appear at the top level")
  (if (or (list_eq n "true") (list_eq n "false"))
      (PEErr o "this is not a function")
  (if (name_is_upper n)
      (parse_ctor_call n ts open)
      (parse_call n ts open o)))))))))

; (Ctor arg...) -- arguments are ordinary expressions.
(def parse_ctor_call ((n (list int)) (ts (list Token)) (open int)) PExpr
  (match (parse_args ts (nil Expr))
    ((PAErr eo m) (PEErr eo m))
    ((PAOk args rest) (PEOk (ECtor open n args) rest))))

; (match subject arm...) where each arm is ((Ctor name...) result).
(def parse_match ((ts (list Token)) (open int)) PExpr
  (match (need_expr ts open "match needs a subject and at least one arm")
    ((PEErr o m) (PEErr o m))
    ((PEOk subject rest)
      (match (parse_arms rest (nil Arm) open)
        ((PAsErr o m) (PEErr o m))
        ((PAsOk arms rest2)
          (if (is_empty arms)
              (PEErr open "match needs a subject and at least one arm")
              (PEOk (EMatch open subject arms) rest2)))))))

(def parse_arms ((ts (list Token)) (acc (list Arm)) (open int)) PArms
  (if (is_empty ts)
      (PAsErr open "unclosed ( in a match")
      (if (tok_is_rparen (head ts))
          (PAsOk (rev_arms_onto acc (nil Arm)) (tail ts))
          (match (parse_arm ts)
            ((PAsErr o m) (PAsErr o m))
            ((PAsOk got rest)
              (parse_arms rest (cons (head got) acc) open))))))

; Returns a single-element list so it can share the PArms result type.
(def parse_arm ((ts (list Token))) PArms
  (let t (head ts)
    (if (not (tok_is_lparen t))
        (PAsErr (tok_offset t)
          "each match arm is ((Constructor names...) result)")
        (parse_arm_pattern (tail ts) (tok_offset t)))))

(def parse_arm_pattern ((ts (list Token)) (open int)) PArms
  (if (is_empty ts)
      (PAsErr open "unclosed ( in a match arm")
      (if (not (tok_is_lparen (head ts)))
          (PAsErr (tok_offset (head ts))
            "a match pattern is (Constructor names...)")
          (parse_arm_ctor (tail ts) open))))

(def parse_arm_ctor ((ts (list Token)) (open int)) PArms
  (if (is_empty ts)
      (PAsErr open "unclosed ( in a match pattern")
      (let t (head ts)
        (if (not (and (tok_is_name t) (name_is_upper (tok_bytes t))))
            (PAsErr (tok_offset t) "a match pattern starts with a constructor name")
            (match (parse_binders (tail ts) (nil (list int)) open)
              ((PNsErr o m) (PAsErr o m))
              ((PNsOk names rest)
                (parse_arm_body (tok_bytes t) names rest open)))))))

(def parse_binders ((ts (list Token)) (acc (list (list int))) (open int))
    PNames
  (if (is_empty ts)
      (PNsErr open "unclosed ( in a match pattern")
      (let t (head ts)
        (if (tok_is_rparen t)
            (PNsOk (rev_strs_onto acc (nil (list int))) (tail ts))
            (if (not (tok_is_name t))
                (PNsErr (tok_offset t) "expected a field binding name")
                (if (or (is_reserved (tok_bytes t))
                        (not (name_is_lower (tok_bytes t))))
                    (PNsErr (tok_offset t)
                      "a field binding name must be lowercase and not reserved")
                    (parse_binders (tail ts) (cons (tok_bytes t) acc) open)))))))

(def parse_arm_body ((cname (list int)) (names (list (list int)))
                     (ts (list Token)) (open int)) PArms
  (match (need_expr ts open "each match arm is ((Constructor names...) result)")
    ((PEErr o m) (PAsErr o m))
    ((PEOk body rest)
      (if (is_empty rest)
          (PAsErr open "unclosed ( in a match arm")
          (if (tok_is_rparen (head rest))
              (PAsOk (cons (A open cname names body) (nil Arm)) (tail rest))
              (PAsErr (tok_offset (head rest))
                "each match arm is ((Constructor names...) result)"))))))

; Parses a required subexpression of a fixed-arity form. Hitting the closing
; ) here means the form is short, which deserves the arity message rather
; than a bare complaint about an unexpected parenthesis.
(def need_expr ((ts (list Token)) (open int) (msg (list int))) PExpr
  (if (is_empty ts)
      (PEErr open "unclosed (")
      (if (tok_is_rparen (head ts))
          (PEErr (tok_offset (head ts)) msg)
          (parse_expr ts))))

(def if_arity ((ignored int)) (list int)
  "if takes exactly 3 parts: (if condition then else)")

(def let_arity ((ignored int)) (list int)
  "let takes exactly 3 parts: (let name value body)")

(def parse_if ((ts (list Token)) (open int)) PExpr
  (match (need_expr ts open (if_arity 0))
    ((PEErr o m) (PEErr o m))
    ((PEOk c rest1)
      (match (need_expr rest1 open (if_arity 0))
        ((PEErr o m) (PEErr o m))
        ((PEOk a rest2)
          (match (need_expr rest2 open (if_arity 0))
            ((PEErr o m) (PEErr o m))
            ((PEOk b rest3)
              (close_form (EIf open c a b) rest3 open (if_arity 0)))))))))

(def parse_let ((ts (list Token)) (open int)) PExpr
  (if (is_empty ts)
      (PEErr open "let needs a name, a value, and a body")
      (let t (head ts)
        (if (not (tok_is_name t))
            (PEErr (tok_offset t) "expected a name after let")
            (if (or (is_reserved (tok_bytes t))
                    (not (name_is_lower (tok_bytes t))))
                (PEErr (tok_offset t)
                  "a let binding name must be lowercase and not reserved")
                (parse_let_value (tok_bytes t) (tail ts) open))))))

(def parse_let_value ((n (list int)) (ts (list Token)) (open int)) PExpr
  (match (need_expr ts open (let_arity 0))
    ((PEErr o m) (PEErr o m))
    ((PEOk v rest1)
      (match (need_expr rest1 open (let_arity 0))
        ((PEErr o m) (PEErr o m))
        ((PEOk body rest2)
          (close_form (ELet open n v body) rest2 open (let_arity 0)))))))

(def parse_nil ((ts (list Token)) (open int)) PExpr
  (match (parse_type ts)
    ((PTErr o m) (PEErr o m))
    ((PTOk elem rest)
      (close_form (ENil open elem) rest open
        "nil takes exactly one element type, as in (nil int)"))))

(def parse_call ((n (list int)) (ts (list Token)) (open int) (o int)) PExpr
  (if (not (name_is_lower n))
      (PEErr o "a function name must be lowercase")
      (match (parse_args ts (nil Expr))
        ((PAErr eo m) (PEErr eo m))
        ((PAOk args rest) (PEOk (ECall open n args) rest)))))

(def parse_args ((ts (list Token)) (acc (list Expr))) PArgs
  (if (is_empty ts)
      (PAErr 0 "unclosed ( in a call")
      (if (tok_is_rparen (head ts))
          (PAOk (rev_exprs_onto acc (nil Expr)) (tail ts))
          (match (parse_expr ts)
            ((PEErr o m) (PAErr o m))
            ((PEOk e rest) (parse_args rest (cons e acc)))))))

; Requires the closing ) of a fixed-arity form.
(def close_form ((e Expr) (ts (list Token)) (open int) (msg (list int))) PExpr
  (if (is_empty ts)
      (PEErr open "unclosed (")
      (if (tok_is_rparen (head ts))
          (PEOk e (tail ts))
          (PEErr (tok_offset (head ts)) msg))))

; ------------------------------------------------------------ declarations

(def parse_params ((ts (list Token)) (acc (list Param))) PParams
  (if (is_empty ts)
      (PPsErr 0 "unclosed ( in a parameter list")
      (if (tok_is_rparen (head ts))
          (PPsOk (rev_params_onto acc (nil Param)) (tail ts))
          (if (not (tok_is_lparen (head ts)))
              (PPsErr (tok_offset (head ts)) "each parameter is (name type)")
              (parse_param (tail ts) acc (tok_offset (head ts)))))))

(def parse_param ((ts (list Token)) (acc (list Param)) (open int)) PParams
  (if (is_empty ts)
      (PPsErr open "unclosed ( in a parameter")
      (let t (head ts)
        (if (not (tok_is_name t))
            (PPsErr (tok_offset t) "expected a parameter name")
            (if (or (is_reserved (tok_bytes t))
                    (not (name_is_lower (tok_bytes t))))
                (PPsErr (tok_offset t)
                  "a parameter name must be lowercase and not reserved")
                (parse_param_type (tok_bytes t) (tail ts) acc open))))))

(def parse_param_type ((n (list int)) (ts (list Token)) (acc (list Param))
                       (open int)) PParams
  (match (parse_type ts)
    ((PTErr o m) (PPsErr o m))
    ((PTOk ty rest)
      (if (is_empty rest)
          (PPsErr open "unclosed ( in a parameter")
          (if (tok_is_rparen (head rest))
              (parse_params (tail rest) (cons (P n ty) acc))
              (PPsErr (tok_offset (head rest)) "each parameter is (name type)"))))))

(def parse_decl ((ts (list Token))) PDecl
  (if (is_empty ts)
      (PDErr 0 "expected a declaration")
      (let t (head ts)
        (if (tok_is_err t)
            (PDErr (tok_offset t) (tok_bytes t))
            (if (not (tok_is_lparen t))
                (PDErr (tok_offset t) "expected a top-level (def ...)")
                (parse_decl_head (tail ts) (tok_offset t)))))))

(def parse_decl_head ((ts (list Token)) (open int)) PDecl
  (if (is_empty ts)
      (PDErr open "unclosed (")
      (let t (head ts)
        (if (not (tok_is_name t))
            (PDErr (tok_offset t) "expected def at the top level")
            (if (list_eq (tok_bytes t) "data")
                (parse_data_name (tail ts) open)
                (if (not (list_eq (tok_bytes t) "def"))
                    (PDErr (tok_offset t)
                      "expected a top-level (def ...) or (data ...)")
                    (parse_def_name (tail ts) open)))))))

; ---------------------------------------------------- data declarations

(def parse_data_name ((ts (list Token)) (open int)) PDecl
  (if (is_empty ts)
      (PDErr open "unclosed (")
      (let t (head ts)
        (if (not (and (tok_is_name t) (name_is_upper (tok_bytes t))))
            (PDErr (tok_offset t) "a data declaration needs an uppercase type name")
            (match (parse_ctors (tail ts) (nil Ctor) open)
              ((PCsErr o m) (PDErr o m))
              ((PCsOk cs rest)
                (if (is_empty cs)
                    (PDErr open "a data type needs at least one constructor")
                    (PDOk (DData open (tok_bytes t) cs) rest))))))))

(def parse_ctors ((ts (list Token)) (acc (list Ctor)) (open int)) PCtors
  (if (is_empty ts)
      (PCsErr open "unclosed ( in a data declaration")
      (if (tok_is_rparen (head ts))
          (PCsOk (rev_ctors_onto acc (nil Ctor)) (tail ts))
          (if (not (tok_is_lparen (head ts)))
              (PCsErr (tok_offset (head ts))
                "a constructor is (Name field-types...)")
              (match (parse_ctor (tail ts) (tok_offset (head ts)))
                ((PCsErr o m) (PCsErr o m))
                ((PCsOk got rest)
                  (parse_ctors rest (cons (head got) acc) open)))))))

; Returns a single-element list so it can share the PCtors result type.
(def parse_ctor ((ts (list Token)) (open int)) PCtors
  (if (is_empty ts)
      (PCsErr open "unclosed ( in a constructor")
      (let t (head ts)
        (if (not (and (tok_is_name t) (name_is_upper (tok_bytes t))))
            (PCsErr (tok_offset t) "a constructor is (Name field-types...)")
            (parse_ctor_fields (tok_bytes t) (tail ts) (nil Ty) open)))))

(def parse_ctor_fields ((n (list int)) (ts (list Token)) (acc (list Ty))
                        (open int)) PCtors
  (if (is_empty ts)
      (PCsErr open "unclosed ( in a constructor")
      (if (tok_is_rparen (head ts))
          (PCsOk (cons (C open n (rev_tys_list_onto acc (nil Ty))) (nil Ctor))
                 (tail ts))
          (match (parse_type ts)
            ((PTErr o m) (PCsErr o m))
            ((PTOk ty rest) (parse_ctor_fields n rest (cons ty acc) open))))))

(def parse_def_name ((ts (list Token)) (open int)) PDecl
  (if (is_empty ts)
      (PDErr open "unclosed (")
      (let t (head ts)
        (if (not (tok_is_name t))
            (PDErr (tok_offset t) "expected a function name after def")
            (if (or (is_reserved (tok_bytes t))
                    (not (name_is_lower (tok_bytes t))))
                (PDErr (tok_offset t)
                  "a function name must be lowercase and not reserved")
                (parse_def_params (tok_bytes t) (tail ts) open))))))

(def parse_def_params ((n (list int)) (ts (list Token)) (open int)) PDecl
  (if (is_empty ts)
      (PDErr open "unclosed (")
      (if (not (tok_is_lparen (head ts)))
          (PDErr (tok_offset (head ts))
            "expected a parameter list, as in ((x int) (y bool))")
          (match (parse_params (tail ts) (nil Param))
            ((PPsErr o m) (PDErr o m))
            ((PPsOk ps rest) (parse_def_ret n ps rest open))))))

(def parse_def_ret ((n (list int)) (ps (list Param)) (ts (list Token))
                    (open int)) PDecl
  (match (parse_type ts)
    ((PTErr o m) (PDErr o m))
    ((PTOk ret rest)
      (match (parse_expr rest)
        ((PEErr o m) (PDErr o m))
        ((PEOk body rest2) (close_decl n ps ret body rest2 open))))))

(def close_decl ((n (list int)) (ps (list Param)) (ret Ty) (body Expr)
                 (ts (list Token)) (open int)) PDecl
  (if (is_empty ts)
      (PDErr open "unclosed (")
      (if (tok_is_rparen (head ts))
          (PDOk (DDef open n ps ret body) (tail ts))
          (PDErr (tok_offset (head ts))
            "a def is (def name (params...) return-type body)"))))

; ------------------------------------------------------- error recovery

; Does this position begin a top-level declaration?
(def starts_decl ((ts (list Token))) bool
  (if (is_empty ts)
      false
      (if (not (tok_is_lparen (head ts)))
          false
          (if (is_empty (tail ts))
              false
              (let t (head (tail ts))
                (and (tok_is_name t)
                     (or (list_eq (tok_bytes t) "def")
                         (list_eq (tok_bytes t) "data"))))))))

; Skips forward to the next top-level declaration so that one bad
; declaration does not hide every later one. Callers always drop at least
; one token first, which is what guarantees progress.
(def resync ((ts (list Token))) (list Token)
  (if (is_empty ts)
      ts
      (if (starts_decl ts)
          ts
          (resync (tail ts)))))

(def parse_decls ((ts (list Token)) (acc (list Decl)) (diags (list Diag)))
    PProg
  (if (is_empty ts)
      (PP (rev_decls_onto acc (nil Decl)) (rev_diags_onto diags (nil Diag)))
      (match (parse_decl ts)
        ((PDOk d rest) (parse_decls rest (cons d acc) diags))
        ((PDErr o m)
          (parse_decls (resync (tail ts)) acc (cons (D o m) diags))))))

(def parse_program ((ts (list Token))) PProg
  (if (is_empty ts)
      (PP (nil Decl) (cons (D 0 "no declarations found") (nil Diag)))
      (parse_decls ts (nil Decl) (nil Diag))))

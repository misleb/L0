; parse.l0 -- tokens to an abstract syntax tree.
;
; Parsing stops at the first error in a declaration, which is reported with
; the byte offset of the token that caused it.
;
; Every parsing function returns a (Parsed T): what it parsed and the tokens
; after it, or where it failed and why.

; Within a data declaration that takes parameters, a parameter is a TyData
; with its name and no arguments, and substitution (check.l0) replaces it.
(data Ty
  (TyInt)
  (TyBool)
  (TyList Ty)
  (TyData (list int) (list Ty))         ; declared type name, arguments
  (TyArray Ty)
  (TyBytes)
  (TyFloat))

(data Expr
  (EInt int int)                        ; offset, value
  (EFloat int int int bool)             ; offset, IEEE bits of m, of 10^k, negative
  (EBool int bool)                      ; offset, value
  (EStr int (list int))                 ; offset, bytes
  (EVar int (list int))                 ; offset, name
  (EIf int Expr Expr Expr)              ; offset, condition, then, else
  (ELet int (list int) Expr Expr)       ; offset, name, value, body
  (ENil int Ty)                         ; offset, element type
  (ECtor int (list int) (list Ty) (list Expr))  ; offset, constructor, type
                                                ; arguments if written, arguments
  (EMatch int Expr (list Arm))          ; offset, subject, arms
  (ECall int (list int) (list Expr))    ; offset, callee name, arguments
  (EField int (list int) Expr)          ; offset, field name, value: a read, 5.8
  (EWith int (list int) Expr Expr))     ; offset, field name, value, new field

; One match arm: the constructor it names, one binding name per field, and
; the expression to evaluate. Patterns are one level deep, so a binding is
; always a plain name.
(data Arm
  (A (offset int) (ctor (list int)) (names (list (list int))) (body Expr)))

(data Param
  (P (list int) Ty))                    ; name, type

(data Ctor
  (C (offset int) (name (list int)) (field_names (list (list int)))
     (fields (list Ty))))               ; field_names is empty when the fields
                                        ; are not named (spec 4)

(data Decl
  (DDef int (list int) (list (list int)) (list Param) Ty Expr)  ; offset, name,
                                                ; type parameters, parameters,
                                                ; return type, body
  (DData int (list int) (list (list int)) (list Ctor)))   ; offset, type name,
                                                          ; parameters, constructors

; ----------------------------------------------------------------- on types

(def ty_kind ((t Ty)) int
  (match t
    ((TyInt) 0)
    ((TyBool) 1)
    ((TyList e) 2)
    ((TyData n as) 3)
    ((TyArray e) 4)
    ((TyBytes) 5)
    ((TyFloat) 6)))

(def ty_is_list ((t Ty)) bool (eq (ty_kind t) 2))
(def ty_is_data ((t Ty)) bool (eq (ty_kind t) 3))
(def ty_is_array ((t Ty)) bool (eq (ty_kind t) 4))
(def ty_is_bytes ((t Ty)) bool (eq (ty_kind t) 5))

; The element type of a list or an array. The result is meaningless for
; anything else, which callers guard with ty_is_list or ty_is_array.
(def ty_elem ((t Ty)) Ty
  (match t
    ((TyList e) e)
    ((TyArray e) e)
    ((TyInt) (TyInt))
    ((TyBool) (TyBool))
    ((TyData n as) (TyInt))
    ((TyFloat) (TyInt))
    ((TyBytes) (TyInt))))

(def ty_name ((t Ty)) (list int)
  (match t
    ((TyData n as) n)
    ((TyInt) "")
    ((TyBool) "")
    ((TyList e) "")
    ((TyArray e) "")
    ((TyFloat) "")
    ((TyBytes) "")))

; A data type's arguments, and none for any other type.
(def ty_args ((t Ty)) (list Ty)
  (match t
    ((TyData n as) as)
    ((TyInt) (nil Ty))
    ((TyBool) (nil Ty))
    ((TyList e) (nil Ty))
    ((TyArray e) (nil Ty))
    ((TyFloat) (nil Ty))
    ((TyBytes) (nil Ty))))

; Renders a type as spec-legal source text, for diagnostics.
(def ty_str ((t Ty)) (list int)
  (match t
    ((TyInt) "int")
    ((TyBool) "bool")
    ((TyList e) (append "(list " (append (ty_str e) ")")))
    ((TyArray e) (append "(array " (append (ty_str e) ")")))
    ((TyData n as)
      (if (is_empty as) n (append "(" (append n (append (tys_str as) ")")))))
    ((TyFloat) "float")
    ((TyBytes) "bytes")))

; " t1 t2 ...", each type preceded by a space.
(def tys_str ((ts (list Ty))) (list int)
  (if (is_empty ts)
      ""
      (append " " (append (ty_str (head ts)) (tys_str (tail ts))))))

; What a parsing function parsed, and the tokens after it; or the offset of
; the token it failed at, and why. Not a Result: success carries the rest of
; the tokens beside the value, and failure an offset beside the message, and
; Ok and Err hold one value each.
(data (Parsed T)
  (POk T (list Token))
  (PErr int (list int)))

; A diagnostic: byte offset and message. Defined here rather than in check.l0
; because the parser produces them too. Declaration order across files does
; not matter in L0, so either file could hold it.
(data Diag
  (D int (list int))                    ; offset, message
  (DParens int (list int) int int))     ; a declaration's offset and name, the
                                        ; offset of the declaration after it
                                        ; or -1 at the end of the input, and
                                        ; how many closing parens it is short
                                        ; of (positive) or over (negative)

; The declarations that parsed, the errors found, and the names of the defs
; that failed to parse. All at once, so that a file with one bad declaration
; still gets its remaining declarations type checked instead of only
; reporting the syntax error, and a use of the bad one is not then reported
; as unknown.
(data PProg
  (PP (list Decl) (list Diag) (list (list int))))

; ------------------------------------------------------------------- names

(def reserved_words ((ignored int)) (list (list int))
  (split_spaces "def data if let match nil true false int bool list array"))

(def is_reserved ((n (list int))) bool
  (any_eq n (reserved_words 0)))

(def name_is_lower ((n (list int))) bool
  (if (is_empty n) false (is_lower (head n))))

(def name_is_upper ((n (list int))) bool
  (if (is_empty n) false (is_upper (head n))))

; ------------------------------------------------------------------- types

(def parse_type ((ts (list Token))) (Parsed Ty)
  (if (is_empty ts)
      ((PErr Ty) 0 "expected a type")
      (let t (head ts)
        (if (tok_is_err t)
            ((PErr Ty) (tok_offset t) (tok_bytes t))
            (if (tok_is_name t)
                (parse_type_name t (tail ts))
                (if (tok_is_lparen t)
                    (parse_list_type (tail ts) (tok_offset t))
                    ((PErr Ty) (tok_offset t)
                      "expected a type: int, bool, float, bytes, (list T), or (array T)")))))))

; An uppercase name is a declared data type. Whether it was actually
; declared is the checker's business, not the parser's.
(def parse_type_name ((t Token) (rest (list Token))) (Parsed Ty)
  (let n (tok_bytes t)
    (if (eq n "int")
        (POk (TyInt) rest)
        (if (eq n "bool")
            (POk (TyBool) rest)
            (if (eq n "bytes")
                (POk (TyBytes) rest)
                (if (eq n "float")
                    (POk (TyFloat) rest)
                    (parse_type_other t n rest)))))))

(def parse_type_other ((t Token) (n (list int)) (rest (list Token))) (Parsed Ty)
  (if (any_eq n (split_spaces "list array"))
      ((PErr Ty) (tok_offset t)
        (append n (append " needs an element type, as in (" (append n " int)"))))
      (if (name_is_upper n)
          (POk (TyData n (nil Ty)) rest)
          ((PErr Ty) (tok_offset t)
            (append "unknown type " (append n
              ": a type is int, bool, float, bytes, (list T), (array T), or a data type, whose name starts uppercase"))))))

(def parse_list_type ((ts (list Token)) (open int)) (Parsed Ty)
  (if (is_empty ts)
      ((PErr Ty) open "unclosed ( in a type")
      (let t (head ts)
        (if (and (tok_is_name t) (name_is_upper (tok_bytes t)))
            (parse_data_type (tok_bytes t) (tail ts) open)
            (if (not (and (tok_is_name t)
                          (or (eq (tok_bytes t) "list")
                              (eq (tok_bytes t) "array"))))
                ((PErr Ty) (tok_offset t)
                  "expected list, array, or a data type name after ( in a type")
                (match (parse_type (tail ts))
                  ((PErr o m) ((PErr Ty) o m))
                  ((POk elem rest)
                    (close_list_type (eq (tok_bytes t) "array") elem rest
                                     open))))))))

; (Name type...) -- a data type given its arguments. Whether it takes that
; many is the checker's business.
(def parse_data_type ((n (list int)) (ts (list Token)) (open int)) (Parsed Ty)
  (match (parse_types ts (nil Ty) open)
    ((PErr o m) ((PErr Ty) o m))
    ((POk as rest)
      (if (is_empty as)
          ((PErr Ty) open
            (append "(" (append n (append " ...) needs at least one type argument; "
              (append "a type without parameters is written " n)))))
          (POk (TyData n as) rest)))))

; Types up to and including the closing ).
(def parse_types ((ts (list Token)) (acc (list Ty)) (open int))
    (Parsed (list Ty))
  (if (is_empty ts)
      ((PErr (list Ty)) open "unclosed ( in a type")
      (if (tok_is_rparen (head ts))
          (POk (rev_onto acc (nil Ty)) (tail ts))
          (match (parse_type ts)
            ((PErr o m) ((PErr (list Ty)) o m))
            ((POk t rest) (parse_types rest (cons t acc) open))))))

(def close_list_type ((arr bool) (elem Ty) (rest (list Token)) (open int))
    (Parsed Ty)
  (if (is_empty rest)
      ((PErr Ty) open "unclosed ( in a type")
      (if (tok_is_rparen (head rest))
          (POk (if arr (TyArray elem) (TyList elem)) (tail rest))
          ((PErr Ty) (tok_offset (head rest))
            (if arr
                "(array ...) takes exactly one element type"
                "(list ...) takes exactly one element type")))))

; ------------------------------------------------------------- expressions

(def parse_expr ((ts (list Token))) (Parsed Expr)
  (if (is_empty ts)
      ((PErr Expr) 0 "expected an expression")
      (let t (head ts)
        (if (tok_is_err t)
            ((PErr Expr) (tok_offset t) (tok_bytes t))
            (if (tok_is_int t)
                (POk (EInt (tok_offset t) (tok_int t)) (tail ts))
                (if (tok_is_float t)
                    (POk (EFloat (tok_offset t) (tok_float_m t) (tok_float_p t)
                                 (tok_float_neg t))
                         (tail ts))
                (if (tok_is_str t)
                    (POk (EStr (tok_offset t) (tok_bytes t)) (tail ts))
                    (if (tok_is_name t)
                        (parse_atom_name t (tail ts))
                        (if (tok_is_lparen t)
                            (parse_form (tail ts) (tok_offset t))
                            (if (tok_is_field t)
                                ((PErr Expr) (tok_offset t)
                                  "a field is read as (.name value) or replaced as (.name value new)")
                                ((PErr Expr) (tok_offset t)
                                  "unexpected ) where an expression was expected")))))))))))

(def parse_atom_name ((t Token) (rest (list Token))) (Parsed Expr)
  (let n (tok_bytes t)
    (let o (tok_offset t)
      (if (eq n "true")
          (POk (EBool o true) rest)
          (if (eq n "false")
              (POk (EBool o false) rest)
              (if (name_is_upper n)
                  ((PErr Expr) o "uppercase names are types and constructors, not values")
                  (if (is_reserved n)
                      ((PErr Expr) o "this word is reserved and is not a value here")
                      (POk (EVar o n) rest))))))))

; A parenthesised form: the ( is already consumed and open is its offset.
(def parse_form ((ts (list Token)) (open int)) (Parsed Expr)
  (if (is_empty ts)
      ((PErr Expr) open "unclosed (")
      (let t (head ts)
        (if (tok_is_err t)
            ((PErr Expr) (tok_offset t) (tok_bytes t))
            (if (tok_is_lparen t)
                (parse_typed_ctor (tail ts) open (tok_offset t))
                (if (tok_is_field t)
                    (parse_field (tok_bytes t) (tail ts) open)
                    (if (not (tok_is_name t))
                        ((PErr Expr) (tok_offset t)
                          "expected a function or special form name after (")
                        (dispatch_form (tok_bytes t) (tail ts) open (tok_offset t)))))))))

; (.f e) reads field f of e, and (.f e v) is e with v as that field. Spec
; 5.8. The ( and the field name are consumed.
(def parse_field ((f (list int)) (ts (list Token)) (open int)) (Parsed Expr)
  (match (parse_args ts (nil Expr) open)
    ((PErr o m) ((PErr Expr) o m))
    ((POk args rest)
      (if (eq (length args) 1)
          (POk (EField open f (head args)) rest)
          (if (eq (length args) 2)
              (POk (EWith open f (head args) (head (tail args))) rest)
              ((PErr Expr) open
                "a field is read as (.name value) or replaced as (.name value new)"))))))

; ((Ctor type...) arg...) -- the ( of the head is already consumed, and
; hopen is its offset. Spec 5.6.
(def parse_typed_ctor ((ts (list Token)) (open int) (hopen int)) (Parsed Expr)
  (if (is_empty ts)
      ((PErr Expr) hopen "unclosed (")
      (let t (head ts)
        (if (not (and (tok_is_name t) (name_is_upper (tok_bytes t))))
            ((PErr Expr) (tok_offset t)
              "a constructor written with its type is ((Constructor type...) arguments...)")
            (match (parse_types (tail ts) (nil Ty) hopen)
              ((PErr o m) ((PErr Expr) o m))
              ((POk tys rest)
                (if (is_empty tys)
                    ((PErr Expr) hopen
                      (append "((" (append (tok_bytes t)
                        ") ...) needs at least one type argument")))
                    (match (parse_args rest (nil Expr) open)
                      ((PErr eo m) ((PErr Expr) eo m))
                      ((POk args rest2)
                        (POk (ECtor open (tok_bytes t) tys args) rest2))))))))))

(def dispatch_form ((n (list int)) (ts (list Token)) (open int) (o int))
    (Parsed Expr)
  (if (eq n "if") (parse_if ts open)
  (if (eq n "let") (parse_let ts open)
  (if (eq n "nil") (parse_nil ts open)
  (if (eq n "match") (parse_match ts open)
  (if (or (eq n "def") (eq n "data"))
      ((PErr Expr) o "this can only appear at the top level")
  (if (or (eq n "true") (eq n "false"))
      ((PErr Expr) o "this is not a function")
  (if (name_is_upper n)
      (parse_ctor_call n ts open)
      (parse_call n ts open o)))))))))

; (Ctor arg...) -- arguments are ordinary expressions.
(def parse_ctor_call ((n (list int)) (ts (list Token)) (open int)) (Parsed Expr)
  (match (parse_args ts (nil Expr) open)
    ((PErr eo m) ((PErr Expr) eo m))
    ((POk args rest) (POk (ECtor open n (nil Ty) args) rest))))

; (match subject arm...) where each arm is ((Ctor name...) result).
(def parse_match ((ts (list Token)) (open int)) (Parsed Expr)
  (match (need_expr ts open "match needs a subject and at least one arm")
    ((PErr o m) ((PErr Expr) o m))
    ((POk subject rest)
      (match (parse_arms rest (nil Arm) open)
        ((PErr o m) ((PErr Expr) o m))
        ((POk arms rest2)
          (if (is_empty arms)
              ((PErr Expr) open "match needs a subject and at least one arm")
              (POk (EMatch open subject arms) rest2)))))))

(def parse_arms ((ts (list Token)) (acc (list Arm)) (open int))
    (Parsed (list Arm))
  (if (is_empty ts)
      ((PErr (list Arm)) open "unclosed ( in a match")
      (if (tok_is_rparen (head ts))
          (POk (rev_onto acc (nil Arm)) (tail ts))
          (match (parse_arm ts)
            ((PErr o m) ((PErr (list Arm)) o m))
            ((POk got rest)
              (parse_arms rest (cons got acc) open))))))

(def parse_arm ((ts (list Token))) (Parsed Arm)
  (let t (head ts)
    (if (not (tok_is_lparen t))
        ((PErr Arm) (tok_offset t)
          "each match arm is ((Constructor names...) result)")
        (parse_arm_pattern (tail ts) (tok_offset t)))))

(def parse_arm_pattern ((ts (list Token)) (open int)) (Parsed Arm)
  (if (is_empty ts)
      ((PErr Arm) open "unclosed ( in a match arm")
      (if (not (tok_is_lparen (head ts)))
          ((PErr Arm) (tok_offset (head ts))
            "a match pattern is (Constructor names...)")
          (parse_arm_ctor (tail ts) open))))

(def parse_arm_ctor ((ts (list Token)) (open int)) (Parsed Arm)
  (if (is_empty ts)
      ((PErr Arm) open "unclosed ( in a match pattern")
      (let t (head ts)
        (if (not (and (tok_is_name t) (name_is_upper (tok_bytes t))))
            ((PErr Arm) (tok_offset t) "a match pattern starts with a constructor name")
            (match (parse_binders (tail ts) (nil (list int)) open)
              ((PErr o m) ((PErr Arm) o m))
              ((POk names rest)
                (parse_arm_body (tok_bytes t) names rest open)))))))

(def parse_binders ((ts (list Token)) (acc (list (list int))) (open int))
    (Parsed (list (list int)))
  (if (is_empty ts)
      ((PErr (list (list int))) open "unclosed ( in a match pattern")
      (let t (head ts)
        (if (tok_is_rparen t)
            (POk (rev acc) (tail ts))
            (if (not (tok_is_name t))
                ((PErr (list (list int))) (tok_offset t) "expected a field binding name")
                (if (or (is_reserved (tok_bytes t))
                        (not (name_is_lower (tok_bytes t))))
                    ((PErr (list (list int))) (tok_offset t)
                      "a field binding name must be lowercase and not reserved")
                    (parse_binders (tail ts) (cons (tok_bytes t) acc) open)))))))

(def parse_arm_body ((cname (list int)) (names (list (list int)))
                     (ts (list Token)) (open int)) (Parsed Arm)
  (match (need_expr ts open "each match arm is ((Constructor names...) result)")
    ((PErr o m) ((PErr Arm) o m))
    ((POk body rest)
      (if (is_empty rest)
          ((PErr Arm) open "unclosed ( in a match arm")
          (if (tok_is_rparen (head rest))
              (POk (A open cname names body) (tail rest))
              ((PErr Arm) (tok_offset (head rest))
                "each match arm is ((Constructor names...) result)"))))))

; Parses a required subexpression of a fixed-arity form. Hitting the closing
; ) here means the form is short, which deserves the arity message rather
; than a bare complaint about an unexpected parenthesis.
(def need_expr ((ts (list Token)) (open int) (msg (list int))) (Parsed Expr)
  (if (is_empty ts)
      ((PErr Expr) open "unclosed (")
      (if (tok_is_rparen (head ts))
          ((PErr Expr) (tok_offset (head ts)) msg)
          (parse_expr ts))))

(def if_arity ((ignored int)) (list int)
  "if takes a condition, a value, and an else, or pairs of them before the else: (if c1 e1 c2 e2 else)")

(def let_arity ((ignored int)) (list int)
  "let takes exactly 3 parts: (let name value body)")

; (if c1 e1 c2 e2 ... else): an odd number of operands, at least three,
; nested as spec 5.2 says, every nested if carrying the chain's offset.
(def parse_if ((ts (list Token)) (open int)) (Parsed Expr)
  (match (parse_operands ts (nil Expr) open "unclosed ( in an if")
    ((PErr o m) ((PErr Expr) o m))
    ((POk ops rest)
      (if (if (lt (length ops) 3) true (eq (mod (length ops) 2) 0))
          ((PErr Expr) open (if_arity 0))
          (POk (if_chain open ops) rest)))))

(def if_chain ((open int) (ops (list Expr))) Expr
  (if (is_empty (tail ops))
      (head ops)
      (EIf open (head ops) (head (tail ops)) (if_chain open (tail (tail ops))))))

(def parse_let ((ts (list Token)) (open int)) (Parsed Expr)
  (if (is_empty ts)
      ((PErr Expr) open "let needs a name, a value, and a body")
      (let t (head ts)
        (if (tok_is_lparen t)
            (parse_let_binds (tail ts) open (tok_offset t) (nil (list int)) (nil Expr))
            (if (not (tok_is_name t))
                ((PErr Expr) (tok_offset t) "expected a name after let")
                (if (or (is_reserved (tok_bytes t))
                        (not (name_is_lower (tok_bytes t))))
                    ((PErr Expr) (tok_offset t)
                      "a let binding name must be lowercase and not reserved")
                    (parse_let_value (tok_bytes t) (tail ts) open)))))))

; (let (n1 v1 n2 v2 ...) body): the names and values, in pairs, up to the )
; that closes the list, then the body, nested as spec 5.3 says. lopen is the
; list's (; names and values are reversed.
(def parse_let_binds ((ts (list Token)) (open int) (lopen int)
                      (names (list (list int))) (vals (list Expr))) (Parsed Expr)
  (if (is_empty ts)
      ((PErr Expr) lopen "unclosed ( in a let's bindings")
      (let t (head ts)
        (if (tok_is_rparen t)
            (if (is_empty names)
                ((PErr Expr) lopen (let_binds_msg 0))
                (parse_let_body (tail ts) open (rev names) (rev vals)))
            (if (not (tok_is_name t))
                ((PErr Expr) (tok_offset t) (let_binds_msg 0))
                (if (or (is_reserved (tok_bytes t))
                        (not (name_is_lower (tok_bytes t))))
                    ((PErr Expr) (tok_offset t)
                      "a let binding name must be lowercase and not reserved")
                    (match (need_expr (tail ts) lopen (let_binds_msg 0))
                      ((PErr o m) ((PErr Expr) o m))
                      ((POk v rest)
                        (parse_let_binds rest open lopen
                                         (cons (tok_bytes t) names) (cons v vals))))))))))

(def let_binds_msg ((ignored int)) (list int)
  "a let's bindings are pairs of a name and a value: (let (a 1 b 2) body)")

(def parse_let_body ((ts (list Token)) (open int) (names (list (list int)))
                     (vals (list Expr))) (Parsed Expr)
  (match (need_expr ts open (let_arity 0))
    ((PErr o m) ((PErr Expr) o m))
    ((POk body rest)
      (close_form (let_chain open names vals body) rest open (let_arity 0)))))

(def let_chain ((open int) (names (list (list int))) (vals (list Expr)) (body Expr))
    Expr
  (if (is_empty names)
      body
      (ELet open (head names) (head vals) (let_chain open (tail names) (tail vals) body))))

(def parse_let_value ((n (list int)) (ts (list Token)) (open int)) (Parsed Expr)
  (match (need_expr ts open (let_arity 0))
    ((PErr o m) ((PErr Expr) o m))
    ((POk v rest1)
      (match (need_expr rest1 open (let_arity 0))
        ((PErr o m) ((PErr Expr) o m))
        ((POk body rest2)
          (close_form (ELet open n v body) rest2 open (let_arity 0)))))))

(def parse_nil ((ts (list Token)) (open int)) (Parsed Expr)
  (match (parse_type ts)
    ((PErr o m) ((PErr Expr) o m))
    ((POk elem rest)
      (close_form (ENil open elem) rest open
        "nil takes exactly one element type, as in (nil int)"))))

(def parse_call ((n (list int)) (ts (list Token)) (open int) (o int))
    (Parsed Expr)
  (if (not (name_is_lower n))
      ((PErr Expr) o "a function name must be lowercase")
      (match (parse_args ts (nil Expr) open)
        ((PErr eo m) ((PErr Expr) eo m))
        ((POk args rest) (POk (ECall open n args) rest)))))

(def parse_args ((ts (list Token)) (acc (list Expr)) (open int))
    (Parsed (list Expr))
  (parse_operands ts acc open "unclosed ( in a call"))

; Expressions up to and including the closing ); unclosed is what to say if
; the list never ends.
(def parse_operands ((ts (list Token)) (acc (list Expr)) (open int)
                     (unclosed (list int))) (Parsed (list Expr))
  (if (is_empty ts)
      ((PErr (list Expr)) open unclosed)
      (if (tok_is_rparen (head ts))
          (POk (rev_onto acc (nil Expr)) (tail ts))
          (match (parse_expr ts)
            ((PErr o m) ((PErr (list Expr)) o m))
            ((POk e rest) (parse_operands rest (cons e acc) open unclosed))))))

; Requires the closing ) of a fixed-arity form.
(def close_form ((e Expr) (ts (list Token)) (open int) (msg (list int)))
    (Parsed Expr)
  (if (is_empty ts)
      ((PErr Expr) open "unclosed (")
      (if (tok_is_rparen (head ts))
          (POk e (tail ts))
          ((PErr Expr) (tok_offset (head ts)) msg))))

; ------------------------------------------------------------ declarations

(def parse_params ((ts (list Token)) (acc (list Param)) (lopen int))
    (Parsed (list Param))
  (if (is_empty ts)
      ((PErr (list Param)) lopen "unclosed ( in a parameter list")
      (if (tok_is_rparen (head ts))
          (POk (rev_onto acc (nil Param)) (tail ts))
          (if (not (tok_is_lparen (head ts)))
              ((PErr (list Param)) (tok_offset (head ts)) "each parameter is (name type)")
              (parse_param (tail ts) acc (tok_offset (head ts)) lopen)))))

; lopen is the offset of the ( that opened the parameter list.
(def parse_param ((ts (list Token)) (acc (list Param)) (open int) (lopen int))
    (Parsed (list Param))
  (if (is_empty ts)
      ((PErr (list Param)) open "unclosed ( in a parameter")
      (let t (head ts)
        (if (not (tok_is_name t))
            ((PErr (list Param)) (tok_offset t) "expected a parameter name")
            (if (or (is_reserved (tok_bytes t))
                    (not (name_is_lower (tok_bytes t))))
                ((PErr (list Param)) (tok_offset t)
                  "a parameter name must be lowercase and not reserved")
                (parse_param_type (tok_bytes t) (tail ts) acc open lopen))))))

(def parse_param_type ((n (list int)) (ts (list Token)) (acc (list Param))
                       (open int) (lopen int)) (Parsed (list Param))
  (match (parse_type ts)
    ((PErr o m) ((PErr (list Param)) o m))
    ((POk ty rest)
      (if (is_empty rest)
          ((PErr (list Param)) open "unclosed ( in a parameter")
          (if (tok_is_rparen (head rest))
              (parse_params (tail rest) (cons (P n ty) acc) lopen)
              ((PErr (list Param)) (tok_offset (head rest)) "each parameter is (name type)"))))))

(def parse_decl ((ts (list Token))) (Parsed Decl)
  (if (is_empty ts)
      ((PErr Decl) 0 "expected a declaration")
      (let t (head ts)
        (if (tok_is_err t)
            ((PErr Decl) (tok_offset t) (tok_bytes t))
            (if (not (tok_is_lparen t))
                ((PErr Decl) (tok_offset t) "expected a top-level (def ...)")
                (parse_decl_head (tail ts) (tok_offset t)))))))

(def parse_decl_head ((ts (list Token)) (open int)) (Parsed Decl)
  (if (is_empty ts)
      ((PErr Decl) open "unclosed (")
      (let t (head ts)
        (if (not (tok_is_name t))
            ((PErr Decl) (tok_offset t) "expected def at the top level")
            (if (eq (tok_bytes t) "data")
                (parse_data_name (tail ts) open)
                (if (not (eq (tok_bytes t) "def"))
                    ((PErr Decl) (tok_offset t)
                      "expected a top-level (def ...) or (data ...)")
                    (parse_def_name (tail ts) open)))))))

; ---------------------------------------------------- data declarations

(def parse_data_name ((ts (list Token)) (open int)) (Parsed Decl)
  (if (is_empty ts)
      ((PErr Decl) open "unclosed (")
      (let t (head ts)
        (if (tok_is_lparen t)
            (parse_data_header (tail ts) open (tok_offset t))
            (if (not (and (tok_is_name t) (name_is_upper (tok_bytes t))))
                ((PErr Decl) (tok_offset t) "a data declaration needs an uppercase type name")
                (parse_data_body (tok_bytes t) (nil (list int)) (tail ts) open))))))

; (data (Name Param...) ctor...) -- the ( of the header is already consumed,
; and hopen is its offset.
(def parse_data_header ((ts (list Token)) (open int) (hopen int)) (Parsed Decl)
  (if (is_empty ts)
      ((PErr Decl) hopen "unclosed (")
      (let t (head ts)
        (if (not (and (tok_is_name t) (name_is_upper (tok_bytes t))))
            ((PErr Decl) (tok_offset t) "a data declaration needs an uppercase type name")
            (match (parse_ty_params (tail ts) (nil (list int)) hopen
                                    "unclosed ( in a data declaration")
              ((PErr o m) ((PErr Decl) o m))
              ((POk ps rest)
                (if (is_empty ps)
                    ((PErr Decl) hopen
                      (append "(" (append (tok_bytes t)
                        (append ") needs at least one type parameter; "
                          (append "a type without parameters is declared (data "
                            (append (tok_bytes t) " ...)"))))))
                    (parse_data_body (tok_bytes t) ps rest open))))))))

; unclosed is what to say if the list never ends.
(def parse_ty_params ((ts (list Token)) (acc (list (list int))) (open int)
                      (unclosed (list int))) (Parsed (list (list int)))
  (if (is_empty ts)
      ((PErr (list (list int))) open unclosed)
      (let t (head ts)
        (if (tok_is_rparen t)
            (POk (rev acc) (tail ts))
            (if (and (tok_is_name t) (name_is_upper (tok_bytes t)))
                (parse_ty_params (tail ts) (cons (tok_bytes t) acc) open unclosed)
                ((PErr (list (list int))) (tok_offset t) "a type parameter is an uppercase name"))))))

(def parse_data_body ((n (list int)) (ps (list (list int))) (ts (list Token))
                      (open int)) (Parsed Decl)
  (match (parse_ctors ts (nil Ctor) open)
    ((PErr o m) ((PErr Decl) o m))
    ((POk cs rest)
      (if (is_empty cs)
          ((PErr Decl) open "a data type needs at least one constructor")
          (POk (DData open n ps cs) rest)))))

(def parse_ctors ((ts (list Token)) (acc (list Ctor)) (open int))
    (Parsed (list Ctor))
  (if (is_empty ts)
      ((PErr (list Ctor)) open "unclosed ( in a data declaration")
      (if (tok_is_rparen (head ts))
          (POk (rev_onto acc (nil Ctor)) (tail ts))
          (if (not (tok_is_lparen (head ts)))
              ((PErr (list Ctor)) (tok_offset (head ts))
                "a constructor is (Name field-types...)")
              (match (parse_ctor (tail ts) (tok_offset (head ts)))
                ((PErr o m) ((PErr (list Ctor)) o m))
                ((POk got rest)
                  (parse_ctors rest (cons got acc) open)))))))

(def parse_ctor ((ts (list Token)) (open int)) (Parsed Ctor)
  (if (is_empty ts)
      ((PErr Ctor) open "unclosed ( in a constructor")
      (let t (head ts)
        (if (not (and (tok_is_name t) (name_is_upper (tok_bytes t))))
            ((PErr Ctor) (tok_offset t) "a constructor is (Name field-types...)")
            (parse_ctor_fields (tok_bytes t) (tail ts) (nil (list int)) (nil Ty)
                               open)))))

; A constructor's fields are types, or (name type) pairs, all one or all the
; other (spec 4). names and acc are reversed; names stays empty for fields
; by position.
(def parse_ctor_fields ((n (list int)) (ts (list Token)) (names (list (list int)))
                        (acc (list Ty)) (open int)) (Parsed Ctor)
  (if (is_empty ts)
      ((PErr Ctor) open "unclosed ( in a constructor")
      (if (tok_is_rparen (head ts))
          (POk (C open n (rev_onto names (nil (list int))) (rev_onto acc (nil Ty)))
               (tail ts))
          (if (named_field_ahead ts)
              (if (if (is_empty acc) true (not (is_empty names)))
                  (parse_named_field n (tail (tail ts)) (tok_bytes (head (tail ts)))
                                     names acc open (tok_offset (head ts)))
                  ((PErr Ctor) (tok_offset (head ts))
                    "a constructor names all of its fields or none"))
              (if (is_empty names)
                  (match (parse_type ts)
                    ((PErr o m) ((PErr Ctor) o m))
                    ((POk ty rest) (parse_ctor_fields n rest names (cons ty acc) open)))
                  ((PErr Ctor) (tok_offset (head ts))
                    "a constructor names all of its fields or none"))))))

; Whether ( and a lower name begin the next field: a named field, since a
; type in parentheses begins with list or array, which are reserved.
(def named_field_ahead ((ts (list Token))) bool
  (if (not (tok_is_lparen (head ts)))
      false
      (if (is_empty (tail ts))
          false
          (let t (head (tail ts))
            (if (not (tok_is_name t))
                false
                (if (name_is_lower (tok_bytes t))
                    (not (or (eq (tok_bytes t) "list") (eq (tok_bytes t) "array")))
                    false))))))

; (name type) -- the ( and the name are consumed, and fopen is the ('s offset.
(def parse_named_field ((n (list int)) (ts (list Token)) (fname (list int))
                        (names (list (list int))) (acc (list Ty)) (open int)
                        (fopen int)) (Parsed Ctor)
  (if (is_reserved fname)
      ((PErr Ctor) fopen "a field name must not be reserved")
      (match (parse_type ts)
        ((PErr o m) ((PErr Ctor) o m))
        ((POk ty rest)
          (if (is_empty rest)
              ((PErr Ctor) fopen "unclosed ( in a field")
              (if (tok_is_rparen (head rest))
                  (parse_ctor_fields n (tail rest) (cons fname names) (cons ty acc) open)
                  ((PErr Ctor) (tok_offset (head rest)) "a field is (name type)")))))))

(def parse_def_name ((ts (list Token)) (open int)) (Parsed Decl)
  (if (is_empty ts)
      ((PErr Decl) open "unclosed (")
      (let t (head ts)
        (if (tok_is_lparen t)
            (parse_def_header (tail ts) open (tok_offset t))
            (let bad (def_name_problem t)
              (if (is_empty bad)
                  (parse_def_params (tok_bytes t) (nil (list int)) (tail ts) open)
                  ((PErr Decl) (tok_offset t) bad)))))))

; What is wrong with t as a function's name, or an empty message.
(def def_name_problem ((t Token)) (list int)
  (if (not (tok_is_name t))
      "expected a function name after def"
      (if (or (is_reserved (tok_bytes t)) (not (name_is_lower (tok_bytes t))))
          "a function name must be lowercase and not reserved"
          "")))

; (def (name Param...) ...) -- the ( of the header is already consumed, and
; hopen is its offset. Spec 4.1.
(def parse_def_header ((ts (list Token)) (open int) (hopen int)) (Parsed Decl)
  (if (is_empty ts)
      ((PErr Decl) hopen "unclosed (")
      (let t (head ts)
        (let bad (def_name_problem t)
          (if (not (is_empty bad))
              ((PErr Decl) (tok_offset t) bad)
              (match (parse_ty_params (tail ts) (nil (list int)) hopen
                                      "unclosed ( in a def's type parameters")
                ((PErr o m) ((PErr Decl) o m))
                ((POk fps rest)
                  (if (is_empty fps)
                      ((PErr Decl) hopen
                        (append "(" (append (tok_bytes t)
                          (append ") needs at least one type parameter; "
                            (append "a function without them is (def "
                              (append (tok_bytes t) " ...)"))))))
                      (parse_def_params (tok_bytes t) fps rest open)))))))))

(def parse_def_params ((n (list int)) (fps (list (list int))) (ts (list Token))
                       (open int)) (Parsed Decl)
  (if (is_empty ts)
      ((PErr Decl) open "unclosed (")
      (if (not (tok_is_lparen (head ts)))
          ((PErr Decl) (tok_offset (head ts))
            "expected a parameter list, as in ((x int) (y bool))")
          (match (parse_params (tail ts) (nil Param) (tok_offset (head ts)))
            ((PErr o m) ((PErr Decl) o m))
            ((POk ps rest) (parse_def_ret n fps ps rest open))))))

(def parse_def_ret ((n (list int)) (fps (list (list int))) (ps (list Param))
                    (ts (list Token)) (open int)) (Parsed Decl)
  (match (parse_type ts)
    ((PErr o m) ((PErr Decl) o m))
    ((POk ret rest)
      (match (parse_expr rest)
        ((PErr o m) ((PErr Decl) o m))
        ((POk body rest2) (close_decl n fps ps ret body rest2 open))))))

(def close_decl ((n (list int)) (fps (list (list int))) (ps (list Param)) (ret Ty)
                 (body Expr) (ts (list Token)) (open int)) (Parsed Decl)
  (if (is_empty ts)
      ((PErr Decl) open "unclosed (")
      (if (tok_is_rparen (head ts))
          (POk (DDef open n fps ps ret body) (tail ts))
          ((PErr Decl) (tok_offset (head ts))
            "a def is (def name (params...) return-type body)"))))

; ------------------------------------------------------- error recovery

; Does this position begin a top-level declaration? (def or (data is
; followed by a (, or by a name and then a (, so a parameter named def or
; data, as in ((data int)), is not taken for one, while a declaration with a
; badly formed name still is, and gets its own error.
(def starts_decl ((ts (list Token))) bool
  (if (is_empty ts)
      false
      (if (not (tok_is_lparen (head ts)))
          false
          (if (is_empty (tail ts))
              false
              (let t (head (tail ts))
                (if (not (tok_is_name t))
                    false
                    (if (or (eq (tok_bytes t) "def") (eq (tok_bytes t) "data"))
                        (decl_follows (tail (tail ts)))
                        false)))))))

; What follows (def or (data in a declaration: a (, or a name and a (.
(def decl_follows ((ts (list Token))) bool
  (if (is_empty ts)
      false
      (let t (head ts)
        (if (tok_is_lparen t)
            true
            (if (tok_is_name t)
                (if (is_empty (tail ts)) false (tok_is_lparen (head (tail ts))))
                false)))))

; The name a def that failed to parse was declaring, if it got that far:
; (def name ... or (def (name T...) ...; "" otherwise, and for data.
(def failed_def_name ((ts (list Token))) (list int)
  (if (not (starts_decl ts))
      ""
      (let kw (head (tail ts))
        (if (not (eq (tok_bytes kw) "def"))
            ""
            (let after (tail (tail ts))
              (if (tok_is_lparen (head after))
                  (if (is_empty (tail after)) "" (lower_name_of (head (tail after))))
                  (lower_name_of (head after))))))))

(def lower_name_of ((t Token)) (list int)
  (if (if (tok_is_name t) (name_is_lower (tok_bytes t)) false) (tok_bytes t) ""))

; Skips forward to the next top-level declaration so that one bad
; declaration does not hide every later one. Callers always drop at least
; one token first, which is what guarantees progress.
(def resync ((ts (list Token))) (list Token)
  (if (is_empty ts)
      ts
      (if (starts_decl ts)
          ts
          (resync (tail ts)))))

(def parse_decls ((ts (list Token)) (acc (list Decl)) (diags (list Diag))
                   (bad (list (list int)))) PProg
  (if (is_empty ts)
      (PP (rev_onto acc (nil Decl)) (rev_onto diags (nil Diag)) bad)
      (match (parse_decl ts)
        ((POk d rest) (parse_decls rest (cons d acc) diags bad))
        ((PErr o m)
          (let n (failed_def_name ts)
            (let rest (resync (tail ts))
              (parse_decls rest acc
                (parens_diag ts rest acc (cons (D o m) diags))
                (if (is_empty n) bad (cons n bad)))))))))

; When the tokens of a declaration that failed to parse, up to rest, where
; the next one begins, do not balance, a diagnostic of its own says by how
; many closing parens, since the error that stopped the parse is usually
; far from the paren that is missing or extra. Tokens that start no
; declaration, such as stray ) after one that closed early, are counted
; against the declaration parsed before them.
(def parens_diag ((ts (list Token)) (rest (list Token)) (acc (list Decl))
                  (diags (list Diag))) (list Diag)
  (let deficit (paren_balance ts (sub (length ts) (length rest)) 0)
    (if (eq deficit 0)
        diags
        (let next (if (is_empty rest) -1 (tok_offset (head rest)))
          (if (starts_decl ts)
              (cons (DParens (tok_offset (head ts)) (failed_decl_name ts) next deficit)
                    diags)
              (if (is_empty acc)
                  (cons (DParens (tok_offset (head ts)) "" next deficit) diags)
                  (cons (DParens (decl_offset (head acc)) (decl_name (head acc))
                                 next deficit)
                        diags)))))))

; Opening parens less closing ones among the first k tokens.
(def paren_balance ((ts (list Token)) (k int) (acc int)) int
  (if (le k 0)
      acc
      (paren_balance (tail ts) (sub k 1)
        (if (tok_is_lparen (head ts))
            (add acc 1)
            (if (tok_is_rparen (head ts)) (sub acc 1) acc)))))

; The name a declaration that failed to parse was declaring, a def's or a
; data type's, if it got that far; "" otherwise. ts starts a declaration.
(def failed_decl_name ((ts (list Token))) (list int)
  (let after (tail (tail ts))
    (let t (if (tok_is_lparen (head after))
               (if (is_empty (tail after)) (head after) (head (tail after)))
               (head after))
      (if (tok_is_name t) (tok_bytes t) ""))))

(def parse_program ((ts (list Token))) PProg
  (if (is_empty ts)
      (PP (nil Decl) (cons (D 0 "no declarations found") (nil Diag)) (nil (list int)))
      (parse_decls ts (nil Decl) (nil Diag) (nil (list int)))))

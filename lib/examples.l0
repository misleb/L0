; examples.l0 -- worked L0 programs, for reading.
;
; Every declaration here compiles. This file is checked by the L0 project's
; own test suite, so nothing in it can quietly rot into something that no
; longer works.
;
; It is meant to be read rather than linked. The names would collide with
; your own, and the standard library it uses is already linked for you.
;
; Nothing here defines main, so it is not a program on its own. Run its tests
; with `l0 test $(l0 examples --path)`.

; --------------------------------------------------------------- the basics

; if is an expression, and both branches have the same type. The library's
; max does this for a value of any type; this one shows if.
(def max2 ((a int) (b int)) int
  (if (gt a b) a b))

; There are no loops. Iteration is recursion.
(def count_up_to ((n int) (acc int)) int
  (if (gt acc n) acc (count_up_to n (add acc 1))))

; Prefer an accumulator when the list may be long: this version holds one
; stack frame regardless of length, because the recursive call is the last
; thing it does.
(def sum_tail ((xs (list int)) (acc int)) int
  (if (is_empty xs) acc (sum_tail (tail xs) (add acc (head xs)))))

; The same thing without an accumulator. Correct, and holds one frame per
; element. Fine for short lists, and the runtime allows very deep recursion,
; but the version above is the habit worth having.
(def sum_naive ((xs (list int))) int
  (if (is_empty xs) 0 (add (head xs) (sum_naive (tail xs)))))

; ------------------------------------------------------- strings are lists

; A string literal is a (list int) of byte values, so string handling is
; just list handling. There is no separate string type.
(def shout ((ignored int)) (list int)
  "HELLO\n")

; A membership test is one call, not a chain of or: a string is a list of
; its bytes, and any_eq works on a list of anything.
(def is_vowel ((c int)) bool
  (any_eq c "aeiou"))

(def count_vowels ((xs (list int)) (acc int)) int
  (if (is_empty xs)
      acc
      (count_vowels (tail xs) (if (is_vowel (head xs)) (add acc 1) acc))))

; ------------------------------------------------------- building output

; Appending to the end of a list copies the whole list, so building output
; with repeated appends is quadratic and will appear to hang on large
; inputs. Push chunks onto a reversed accumulator and reverse once at the
; end. push, rev, and digits are all in the standard library.
(def report ((n int) (total int)) (list int)
  (let a (push "count=" (nil int))
    (let b (push (digits n) a)
      (let c (push " total=" b)
        (let d (push (digits total) c)
          (rev (push "\n" d)))))))

; -------------------------------------------------------------- data types

(data Shape
  (Circle int)
  (Rect int int)
  (Dot))

; match has no wildcard and no default: every constructor must appear
; exactly once. That is deliberate, so that adding a constructor becomes a
; compile error at every site that has to handle it.
(def area ((s Shape)) int
  (match s
    ((Circle r) (mul 3 (mul r r)))
    ((Rect w h) (mul w h))
    ((Dot) 0)))

; Data types may be recursive, which is how trees are built.
(data Tree
  (Leaf int)
  (Branch Tree Tree))

(def sum_tree ((t Tree)) int
  (match t
    ((Leaf n) n)
    ((Branch l r) (add (sum_tree l) (sum_tree r)))))

(def depth ((t Tree)) int
  (match t
    ((Leaf n) 1)
    ((Branch l r)
      (let dl (depth l)
        (let dr (depth r)
          (add 1 (max2 dl dr)))))))

; Lists may hold any type, including data values and other lists.
(def total_area ((ss (list Shape))) int
  (if (is_empty ss)
      0
      (add (area (head ss)) (total_area (tail ss)))))

(def two_shapes ((ignored int)) (list Shape)
  (cons (Circle 2) (cons (Rect 3 4) (nil Shape))))

; ------------------------------------------- returning more than one value

; L0 has no tuples. A small data type does the same job, and is how any
; function that must thread state through a computation returns its result.
(data Split
  (Sp (list int) (list int)))           ; taken, remaining

(def split_at_nl ((xs (list int)) (acc (list int))) Split
  (if (is_empty xs)
      (Sp (rev acc) (nil int))
      (if (eq (head xs) 10)
          (Sp (rev acc) (tail xs))
          (split_at_nl (tail xs) (cons (head xs) acc)))))

(def first_line ((xs (list int))) (list int)
  (match (split_at_nl xs (nil int))
    ((Sp taken rest) taken)))

; ------------------------------------------------------- reporting failure

; There are no exceptions. A function that can fail returns a data type with
; a case for each outcome, and callers match on it.
(data Parsed
  (Num int (list int))                  ; value, remaining input
  (Bad (list int)))                     ; message

(def parse_digits ((xs (list int)) (acc int) (seen bool)) Parsed
  (if (is_empty xs)
      (if seen (Num acc xs) (Bad "expected a digit"))
      (if (is_digit (head xs))
          (parse_digits (tail xs) (add (mul acc 10) (sub (head xs) 48)) true)
          (if seen (Num acc xs) (Bad "expected a digit")))))

(def parse_or_zero ((xs (list int))) int
  (match (parse_digits xs 0 false)
    ((Num v rest) v)
    ((Bad msg) 0)))

; When success is one value, the library's Result is that type already (l0
; doc Result). Ok says nothing of the error's type, nor Err of the value's,
; so each is written with the type's arguments, as nil is with its element.
(def parse_number ((xs (list int))) (Result int (list int))
  (match (parse_digits xs 0 false)
    ((Num v rest)
      (if (is_empty rest)
          ((Ok int (list int)) v)
          ((Err int (list int)) "expected only digits")))
    ((Bad msg) ((Err int (list int)) msg))))

; ---------------------------------------------------------- type parameters

; A data type may take type parameters, so one declaration serves every type
; it holds: (Option int) and (Option (list int)) are both types. The library
; declares Option as (data (Option T) (None) (Some T)), and a program
; declares its own the same way.

; (Some x) takes its type from x, as cons takes its type from the list. A
; constructor whose fields do not mention T is written with the type, as nil
; is: ((None int)).
(def first_even ((xs (list int))) (Option int)
  (if (is_empty xs)
      ((None int))
      (if (eq (mod (head xs) 2) 0)
          (Some (head xs))
          (first_even (tail xs)))))

; In a match, each field has the subject's type in place of T.
(def first_even_or ((xs (list int)) (fallback int)) int
  (match (first_even xs)
    ((None) fallback)
    ((Some n) n)))

; A function may take type parameters too, named after it as a data type's
; are, and then works at every type. A call writes nothing extra: its
; arguments' types say what T stands for, so every type parameter must
; appear in some parameter's type. Inside, T is a type of its own, so the
; body can keep, pass, and return a T, compare two with eq, and order them
; with compare, though not with lt, which takes only int.
(def (last_or T) ((xs (list T)) (fallback T)) T
  (if (is_empty xs)
      fallback
      (last_or (tail xs) (head xs))))

; The same function at two types.
(def last_word_length ((words (list (list int)))) int
  (length (last_or words "")))

; eq compares two values of any one type by what they hold, so one count
; serves ints, strings, and data values alike: (count_of "b" (split_spaces
; "a b b")) is 2.
(def (count_of T) ((x T) (xs (list T)) (n int)) int
  (if (is_empty xs)
      n
      (count_of x (tail xs) (if (eq x (head xs)) (add n 1) n))))

; -------------------------------------------------------------------- maps

; A (Map K V) is in the library for every key and value type. The empty map
; is written with its types, as ((None int)) is, and each map_put gives the
; map back changed, in place while nothing else holds it, so thread one map
; through a loop and keep no other name for the old one. Here each word of
; ws is counted.
(def word_counts ((ws (list (list int))) (m (Map (list int) int)))
    (Map (list int) int)
  (if (is_empty ws)
      m
      (word_counts (tail ws)
        (map_put m (head ws)
          (add 1 (match (map_get m (head ws)) ((None) 0) ((Some n) n)))))))

(def count_of_word ((text (list int)) (w (list int))) int
  (match (map_get (word_counts (split_spaces text) ((MapEmpty (list int) int))) w)
    ((None) 0)
    ((Some n) n)))

; map_keys lists every key, in the table's order, which hash decides: the
; same on every run, but not the order the keys went in. map_remove takes a
; key out. Here every word seen only once is dropped, leaving how many
; different words were repeated.
(def without_singletons ((m (Map (list int) int)) (ks (list (list int))))
    (Map (list int) int)
  (if (is_empty ks)
      m
      (without_singletons
        (if (eq (match (map_get m (head ks)) ((None) 0) ((Some n) n)) 1)
            (map_remove m (head ks))
            m)
        (tail ks))))

(def repeated_words ((text (list int))) int
  (let m (word_counts (split_spaces text) ((MapEmpty (list int) int)))
    (map_size (without_singletons m (map_keys m)))))

; A map works at a type parameter too, since its keys need only eq and hash.
; Here a map to bool serves as a set, to count distinct elements of any type.
(def (distinct_count T) ((xs (list T))) int
  (map_size (as_set xs ((MapEmpty T bool)))))

(def (as_set T) ((xs (list T)) (s (Map T bool))) (Map T bool)
  (if (is_empty xs) s (as_set (tail xs) (map_put s (head xs) true))))

; hash, which the map is built on, gives a value of any type an int, the
; same for values eq calls the same, and never negative, so (mod (hash k) n)
; is a slot from 0 to n - 1 for a key of any type (spec section 6.9).
(def (slot_of K) ((key K) (n int)) int
  (mod (hash key) n))

; ---------------------------------------------------------------- ordering

; compare orders two values of any type by what they hold (spec section
; 6.11), and sort orders a list by it. To order by something else, sort keys
; built for that order: a data value orders by its fields in turn, and neg
; turns a count around, so (Rank (neg n) w) puts the highest count first and
; breaks ties by word. Here the words of text come out most frequent first,
; as a word-frequency table lists them, though map_keys gave them in no
; useful order.
(data Rank
  (Rank int (list int)))                ; minus the count, then the word

(def by_frequency ((text (list int))) (list (list int))
  (let m (word_counts (split_spaces text) ((MapEmpty (list int) int)))
    (rank_words (sort (ranks m (map_keys m) (nil Rank))) (nil (list int)))))

(def ranks ((m (Map (list int) int)) (ks (list (list int))) (acc (list Rank)))
    (list Rank)
  (if (is_empty ks)
      acc
      (ranks m (tail ks)
        (cons (Rank (neg (match (map_get m (head ks)) ((None) 0) ((Some n) n)))
                    (head ks))
              acc))))

(def rank_words ((rs (list Rank)) (acc (list (list int)))) (list (list int))
  (if (is_empty rs)
      (rev acc)
      (rank_words (tail rs) (match (head rs) ((Rank n w) (cons w acc))))))

; min and max take the lesser and the greater of two values of any type.
(def (smallest T) ((first T) (rest (list T))) T
  (if (is_empty rest) first (smallest (min first (head rest)) (tail rest))))

; ------------------------------------------------ reading and writing as you go

; read_line and write_str are in the standard library (l0 doc io), built on the
; read_byte and write_byte builtins. They are effects, and effects happen in
; evaluation order, so let is how to put one before another: its value is
; evaluated before its body, even when the name is never used.
(def ask ((question (list int))) (list int)
  (let w (write_str question)
    (take_line (read_line))))

; read_line returns the empty list only at end of input; a blank line is "\n".
; A failed read looks like the end of input too, which is fine for a prompt.
(def count_lines ((n int)) int
  (if (is_empty (read_line)) n (count_lines (add n 1))))

; When a failed read must not pass for the end, next_line, or file_next_line
; for a file, gives an IoLine, whose IoError case match makes you handle.
; Here the result is the number of lines, or the read's negative error code.
(def count_lines_in ((f IoFile) (n int)) int
  (match (file_next_line f)
    ((IoLine s) (count_lines_in f (add n 1)))
    ((IoEnd) n)
    ((IoError code) code)))

; ------------------------------------------------------- files and arguments

; Opening a file returns IoOpened, and match makes you handle IoFailed, whose
; fields say which failure it was and why, in words. write_err writes to
; standard error. A main with no parameters returns its exit status, so 1
; reports failure to the shell.
(def first_line_of ((path (list int))) int
  (match (open_in path)
    ((IoFailed fault why)
      (let w (write_err (append path (append ": " (append why "\n"))))
        1))
    ((IoOpened f)
      (let w (write_str (file_read_line f))
        (let c (file_close f)
          0)))))

; The failure is a case, for code to test with eq or match, beside the words
; for a message. Here a file that does not exist has no lines, and any other
; failure is passed on. Each kind of open has its own cases, OpenFault for
; reading and CreateFault for writing, so testing for OpenMissing after
; open_out does not compile: creating a file cannot fail that way.
(def lines_or_none ((path (list int))) (Result int (list int))
  (match (open_in path)
    ((IoFailed fault why)
      (if (eq fault (OpenMissing))
          ((Ok int (list int)) 0)
          ((Err int (list int)) why)))
    ((IoOpened f)
      (let n (count_lines_in f 0)
        (let c (file_close f)
          (if (lt n 0)
              ((Err int (list int)) (io_error n))
              ((Ok int (list int)) n)))))))

; (arg_count) and (arg i) are the command-line arguments, not counting the
; program's name, and (args) is all of them as a list.
(def first_line_of_first_arg ((ignored int)) int
  (if (lt (arg_count) 1)
      (let w (write_err "usage: first FILE\n") 2)
      (first_line_of (arg 0))))

; Writes are held back, so a write that fails, on a full disk say, shows only
; in what file_close or file_flush returns, an IoDone: (Done), or (NotDone
; fault why). Check it after writing. To replace a file, write the new
; contents under another name and rename that over the old, so a reader sees
; the old file or the new one and never half of one. If that fails,
; remove_file deletes the half-written one rather than leave it behind. The
; result is "" when it worked, and otherwise why it did not.
(def replace_file ((path (list int)) (text (list int))) (list int)
  (let tmp (append path ".new")
    (match (open_out tmp)
      ((IoFailed fault why) why)
      ((IoOpened f)
        (let w (file_write_str f text)
          (match (file_close f)
            ((NotDone fault why) (let d (remove_file tmp) why))
            ((Done)
              (match (rename_file tmp path)
                ((NotDone fault why) (let d (remove_file tmp) why))
                ((Done) "")))))))))

; Each operation's failures are a type of their own, as opening's are, so
; code can tell them apart with eq: renaming a file onto a directory, or
; across file systems, says so. A program that only needs to know whether it
; worked asks is_done.
(def rename_why ((from (list int)) (to (list int))) (list int)
  (match (rename_file from to)
    ((Done) "")
    ((NotDone fault why)
      (if (eq fault (RenameCrossDevice))
          (append to " is on another file system: copy it, then remove the first")
          why))))

; file_read_some reads the next piece of a file, here at most 65,536 bytes,
; and empty bytes at the end, so a file of any size is copied, or checked,
; holding one piece at a time. Each piece goes out with one file_write_bytes.
; The result is how many bytes were copied, or the negative code a read
; failed with; a lost write to dst shows when the caller flushes or closes it.
(def copy_in_pieces ((src IoFile) (dst IoFile) (n int)) int
  (match (file_read_some src 65536)
    ((IoReadFailed code) code)
    ((IoBytes b)
      (if (eq (bytes_len b) 0)
          n
          (let w (file_write_bytes dst b 0 (bytes_len b))
            (copy_in_pieces src dst (add n (bytes_len b))))))))

; open_appending writes at the end of a file, creating it if need be, so a
; log keeps every line written to it.
(def log_line ((path (list int)) (line (list int))) (list int)
  (match (open_appending path)
    ((IoFailed fault why) why)
    ((IoOpened f)
      (let w (file_write_str f (append line "\n"))
        (match (file_close f)
          ((NotDone fault why) why)
          ((Done) ""))))))

; A function that reads or writes an IoFile cannot tell a file on disk from
; one in memory, so it is tested on a string: open_in_bytes reads one, and
; open_out_buffer keeps what is written for buffer_contents. See
; count_lines_in's test.

; ------------------------------------------------------------------- arrays

; An (array T) is read and updated by index in constant time. array_set
; returns the updated array, and updates it in place when nothing else holds
; it, so thread one array through a tail-recursive loop and keep no other name
; for the old one. Here the bytes of xs, each 0 to 255, are counted.
(def byte_counts ((xs (list int)) (counts (array int))) (array int)
  (if (is_empty xs)
      counts
      (byte_counts (tail xs)
        (array_set counts (head xs) (add (array_get counts (head xs)) 1)))))

(def most_common_byte ((xs (list int))) int
  (index_of_max (byte_counts xs (array_new 256 0)) 0 0))

; A function that only reads an array costs nothing to call, so factor reads
; out freely.
(def index_of_max ((a (array int)) (i int) (best int)) int
  (if (ge i (array_len a))
      best
      (index_of_max a (add i 1)
        (if (gt (array_get a i) (array_get a best)) i best))))

; An array has a fixed length, and array_resize copies it into a longer one,
; so grow it by doubling when it fills: then each element is copied a
; constant number of times on average. A data value keeps the array and how
; much of it is in use; taking it apart with match at its last use leaves the
; array with one holder, so array_set still updates in place.
(data IntStack
  (Stack (array int) int))                ; elements, how many are in use

(def stack_push ((s IntStack) (x int)) IntStack
  (match s
    ((Stack a n)
      (let b (if (lt n (array_len a)) a (array_resize a (mul 2 (add n 1)) 0))
        (Stack (array_set b n x) (add n 1))))))

(def stack_of ((xs (list int)) (s IntStack)) IntStack
  (if (is_empty xs) s (stack_of (tail xs) (stack_push s (head xs)))))

(def stack_top ((s IntStack)) int
  (match s ((Stack a n) (array_get a (sub n 1)))))

; A grid is an array of rows. A cell updates in place only when written in
; exactly this form, the row read and replaced within one expression; bind
; the row with let first and it is copied (spec section 6.5). array_new of a
; row makes every row the same array, so each is copied once, on its first
; update, and after that each update is in place.
(def grid_set ((g (array (array int))) (y int) (x int) (v int))
    (array (array int))
  (array_set g y (array_set (array_get g y) x v)))

(def grid_get ((g (array (array int))) (y int) (x int)) int
  (array_get (array_get g y) x))

; -------------------------------------------------------------------- bytes

; bytes hold one byte in a byte of memory, where a list spends 24, and are
; read by index. Nothing changes them. read_input reads all of standard
; input into bytes; bytes_from_list makes them from a string.
(def count_newlines ((b bytes) (i int) (n int)) int
  (if (ge i (bytes_len b))
      n
      (count_newlines b (add i 1) (if (eq (bytes_get b i) 10) (add n 1) n))))

; read_input returns IoBytes, and match makes you handle a failed read.
(def lines_of_input ((ignored int)) int
  (match (read_input)
    ((IoReadFailed code)
      (let w (write_err (append "reading input: " (append (io_error code) "\n")))
        -1))
    ((IoBytes b) (count_newlines b 0 0))))

; Part of a bytes value, such as a line, is written out by position, without
; building a list of it: file_write_bytes writes bytes i up to j.
(def write_first_line ((f IoFile) (b bytes)) int
  (file_write_bytes f b 0 (line_end b 0)))

; Where the line starting at i ends, just past its newline if it has one.
(def line_end ((b bytes) (i int)) int
  (if (ge i (bytes_len b))
      i
      (if (eq (bytes_get b i) 10) (add i 1) (line_end b (add i 1)))))

; --------------------------------------------------------------------- bits

; bit_and, bit_or, bit_xor, bit_shl, bit_shr, and bit_count work on the 64
; bits of an int. A set of small ints as one int: bit i is whether i is in
; it. bit_shl and bit_shr bring in zeros, and shifting by 64 or more gives 0.
(def set_add ((s int) (i int)) int
  (bit_or s (bit_shl 1 i)))

(def set_has ((s int) (i int)) bool
  (not (eq (bit_and (bit_shr s i) 1) 0)))

; A checksum a byte at a time: CRC-32, as zlib computes it, without a table.
; There are no hexadecimal literals: 3988292384 is 0xEDB88320, and
; 4294967295 is 0xFFFFFFFF, the 32 bits a CRC keeps.
(def crc32 ((s (list int)) (c int)) int
  (if (is_empty s)
      (bit_xor c 4294967295)
      (crc32 (tail s) (crc_byte (bit_xor c (head s)) 8))))

(def crc_byte ((c int) (k int)) int
  (if (eq k 0)
      c
      (crc_byte (if (eq (bit_and c 1) 1)
                    (bit_xor (bit_shr c 1) 3988292384)
                    (bit_shr c 1))
                (sub k 1))))

; -------------------------------------------------------------------- time

; clock_ns reads a clock that never goes back, so the difference of two
; readings is the time that passed between them, in nanoseconds. A reading on
; its own means nothing. Reading it is an effect, so let puts the readings
; around the work, which happens even though n is never used.
(def vowel_count_ns ((xs (list int))) int
  (let t0 (clock_ns)
    (let n (count_vowels xs 0)
      (let t1 (clock_ns)
        (sub t1 t0)))))

; --------------------------------------------------------- the entry point

; A program defines main in one of two forms. The first takes stdin as a list
; of bytes and returns the output. The return type may be (list int) for raw
; bytes, or int or bool, which are printed as a decimal or as true/false.
;
;   (def main ((input (list int))) (list int)
;     (report (count_vowels input 0) (sum_tail input 0)))
;
; The second takes nothing, reads and writes as it goes, and returns the exit
; status. Use it whenever a program must write before its input has ended, or
; must not hold all of its input at once.
;
;   (def main () int
;     (let name (ask "What is your name? ")
;       (let w (write_str (append "Hello, " (append name "!\n")))
;         0)))
;
; Both are commented out because this file is a reference rather than a
; program, and two definitions of main could not coexist with yours.

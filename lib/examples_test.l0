; examples_test.l0 -- tests of examples.l0, and worked examples of l0 test.
;
; Run them with:
;
;   l0 test $(l0 examples --path)
;
; l0 test runs every (def test_NAME () int ...) in its own process and
; reports each as a line of TAP. A test returns how many of its assertions
; failed. Keep tests small: one to three assertions each, and as many tests
; as you like, since there is no list of them to maintain.

; One assertion: the name, what the code computed, what it should be.
(def test_max2 () int
  (check_int "larger first" (max2 7 3) 7))

; Several assertions are summed. add evaluates left to right, so they run,
; and report, in the order written.
(def test_count_vowels () int
  (add (check_int "none" (count_vowels "rhythm" 0) 0)
       (check_int "some" (count_vowels "education" 0) 5)))

; check_str shows both strings as L0 literals, and where they first differ.
(def test_report () int
  (check_str "format" (report 3 12) "count=3 total=12\n"))

(def test_area () int
  (add (check_int "circle" (area (Circle 2)) 12)
       (add (check_int "rect" (area (Rect 3 4)) 12)
            (check_int "dot" (area (Dot)) 0))))

(def test_depth () int
  (check_int "lopsided" (depth (Branch (Leaf 1) (Branch (Leaf 2) (Leaf 3)))) 3))

(def test_first_line () int
  (add (check_str "stops at newline" (first_line "one\ntwo") "one")
       (check_str "no newline" (first_line "only") "only")))

; A function that returns a data type is tested by matching on it, and a case
; that should not happen is a failure you name.
(def test_parse_digits () int
  (match (parse_digits "42rest" 0 false)
    ((Num v rest)
      (add (check_int "value" v 42)
           (check_str "remaining" rest "rest")))
    ((Bad msg) (check_str "should have parsed" msg ""))))

(def test_parse_rejects_letters () int
  (match (parse_digits "x" 0 false)
    ((Num v rest) (check_true "should have failed" false))
    ((Bad msg) (check_str "message" msg "expected a digit"))))

(def test_parse_number () int
  (add (match (parse_number "42")
         ((Ok v) (check_int "value" v 42))
         ((Err msg) (check_str "should have parsed" msg "")))
       (match (parse_number "42x")
         ((Ok v) (check_true "should have failed" false))
         ((Err msg) (check_str "message" msg "expected only digits")))))

(def test_last_or () int
  (add (check_int "ints" (last_or (cons 1 (cons 2 (nil int))) 0) 2)
       (add (check_int "empty" (last_or (nil int) -1) -1)
            (check_int "words" (last_word_length (split_spaces "a bb ccc")) 3))))

(def test_count_of () int
  (add (check_int "ints" (count_of 2 (cons 2 (cons 1 (cons 2 (nil int)))) 0) 2)
    (add (check_int "strings" (count_of "b" (split_spaces "a b b") 0) 2)
         (check_int "data" (count_of ((None int)) (cons (Some 1) (cons ((None int))
                             (nil (Option int)))) 0) 1))))

(def test_word_counts () int
  (add (check_int "the" (count_of_word "the cat saw the dog" "the") 2)
    (add (check_int "dog" (count_of_word "the cat saw the dog" "dog") 1)
         (check_int "absent" (count_of_word "the cat" "cow") 0))))

(def test_repeated_words () int
  (add (check_int "a and b" (repeated_words "a b a c b a") 2)
       (check_int "none" (repeated_words "x y z") 0)))

(def test_distinct_count () int
  (add (check_int "ints" (distinct_count (cons 1 (cons 2 (cons 1 (nil int))))) 2)
    (add (check_int "strings" (distinct_count (split_spaces "x y x x")) 2)
         (check_int "data" (distinct_count (cons (Some 1) (cons ((None int))
                                             (cons (Some 1) (nil (Option int))))))
                    2))))

(def test_by_frequency () int
  (check_true "most frequent first, then by word"
    (eq (by_frequency "b a c b a b") (split_spaces "b a c"))))

(def test_smallest () int
  (add (check_str "strings" (smallest "pear" (split_spaces "fig apple kiwi")) "apple")
       (check_int "ints" (smallest 3 (cons 9 (cons -2 (nil int)))) -2)))

; A key built two ways is one key, so it has one slot.
(def test_slot_of () int
  (add (check_int "same key" (slot_of "word" 16) (slot_of (cons 119 "ord") 16))
       (check_true "in range" (lt (slot_of (Some 42) 16) 16))))

(def test_first_even_or () int
  (add (check_int "found" (first_even_or (cons 3 (cons 8 (nil int))) 0) 8)
       (check_int "fallback" (first_even_or (cons 3 (nil int)) -1) -1)))

; A test that must die with a runtime error names it in expect_NAME, with the
; same NAME. It passes only if it dies with exactly that error.
(def test_head_of_nothing () int
  (head (first_line "")))

(def expect_head_of_nothing () (list int)
  "head of empty list")

(def test_most_common_byte () int
  (check_int "a" (most_common_byte "abracadabra") 97))

(def test_count_newlines () int
  (add (check_int "three" (count_newlines (bytes_from_list "a\nb\n\n") 0 0) 3)
       (check_int "none" (count_newlines (bytes_from_list "") 0 0) 0)))

; Code that writes to an IoFile is tested by giving it a buffer in memory,
; whose contents buffer_contents returns.
(def written_first_line ((text (list int))) (list int)
  (match (open_out_buffer)
    ((IoFailed fault why) why)
    ((IoOpened f)
      (let w (write_first_line f (bytes_from_list text))
        (let s (buffer_contents f)
          (let c (file_close f)
            s))))))

(def test_write_first_line () int
  (add (check_str "with newline" (written_first_line "one\ntwo\n") "one\n")
       (check_str "without" (written_first_line "only") "only")))

; Code that reads an IoFile is tested by giving it a string to read.
(def lines_in ((text (list int))) int
  (match (open_in_bytes text)
    ((IoFailed fault why) -100)
    ((IoOpened f)
      (let n (count_lines_in f 0)
        (let c (file_close f)
          n)))))

(def test_count_lines_in () int
  (add (check_int "three" (lines_in "one\n\nthree") 3)
       (check_int "none" (lines_in "") 0)))

; A missing file reads as no lines; a directory, which cannot be read, is
; the failure passed on.
(def test_lines_or_none () int
  (add (match (lines_or_none "no/such/file")
         ((Ok n) (check_int "missing" n 0))
         ((Err why) (check_str "should have been none" why "")))
       (match (lines_or_none ".")
         ((Ok n) (check_true "a directory should fail" false))
         ((Err why) (check_str "directory" why "is a directory")))))

; A test must not leave files behind, since l0 test runs wherever it is
; started, so code that writes files is tested where it fails. Creating a
; file in a directory that does not exist is spec section 6.3's -9, which
; io_error words as "no such directory".
(def test_replace_file_reports () int
  (check_str "missing directory" (replace_file "no/such/dir/notes" "x")
             "no such directory"))

; Renaming a file that is not there says so by its case and its words.
(def test_rename_why () int
  (check_str "missing" (rename_why "no/such/file" "elsewhere") "no such file"))

; "." is a directory, so renaming the new file over it fails, and the new
; file, "..new", must not be left behind.
(def test_replace_file_cleans_up () int
  (let why (replace_file "." "x")
    (add (check_true "failed" (not (is_empty why)))
         (check_true "removed" (is_missing "..new")))))

(def is_missing ((path (list int))) bool
  (match (open_in path)
    ((IoFailed fault why) (eq fault (OpenMissing)))
    ((IoOpened f) (let c (file_close f) false))))

(def test_copy_in_pieces () int
  (match (open_in_bytes (rand_bytes 3 200000))
    ((IoFailed fault why) (fail_because "open" why))
    ((IoOpened src)
      (match (open_out_buffer)
        ((IoFailed fault why) (fail_because "buffer" why))
        ((IoOpened dst)
          (let n (copy_in_pieces src dst 0)
            (let got (buffer_contents dst)
              (let a (file_close src)
                (let b (file_close dst)
                  (add (check_int "count" n 200000)
                       (check_str "contents" got (rand_bytes 3 200000))))))))))))

(def test_log_line_reports () int
  (check_str "missing directory" (log_line "no/such/dir/log" "x")
             "no such directory"))

; Many pushes, so that a stack copying its array on every push, rather than
; growing it by doubling and updating it in place, would take far too long.
(def one_to ((n int) (acc (list int))) (list int)
  (if (eq n 0) acc (one_to (sub n 1) (cons n acc))))

(def test_stack () int
  (match (stack_of (one_to 100000 (nil int)) (Stack (array_new 0 0) 0))
    ((Stack a n)
      (add (check_int "count" n 100000)
           (add (check_int "top" (stack_top (Stack a n)) 100000)
                (check_true "room" (ge (array_len a) n)))))))

; The rows array_new shares are told apart on their first update.
(def test_grid () int
  (let g (grid_set (array_new 3 (array_new 3 0)) 1 2 5)
    (add (check_int "set" (grid_get g 1 2) 5)
         (check_int "other row" (grid_get g 0 2) 0))))

(def test_bit_set () int
  (let s (set_add (set_add 0 3) 63)
    (add (check_true "has 3" (set_has s 3))
      (add (check_true "has 63" (set_has s 63))
        (add (check_true "not 4" (not (set_has s 4)))
          (check_int "two members" (bit_count s) 2))))))

; The published check value of CRC-32, 0xCBF43926.
(def test_crc32 () int
  (check_int "check value" (crc32 "123456789" 4294967295) 3421780262))

(def test_vowel_count_ns () int
  (check_true "never negative" (ge (vowel_count_ns "education") 0)))

; A property test: the two ways of summing agree on many pseudo-random
; lists. rand_next and rand_below come from l0 doc test, and give the same
; sequence on every run, so a failure can be reproduced.
(def sums_agree ((s int) (runs int)) int
  (if (eq runs 0)
      0
      (let xs (rand_bytes s (rand_below s 50))
        (if (eq (sum_tail xs 0) (sum_naive xs))
            (sums_agree (rand_next (rand_next s)) (sub runs 1))
            (check_int "sum_tail against sum_naive" (sum_tail xs 0)
                       (sum_naive xs))))))

(def test_sums_agree () int
  (sums_agree 1 200))

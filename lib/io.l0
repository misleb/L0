; io.l0 -- line and string I/O over the read_byte and write_byte builtins of
; spec section 6.2.
;
; tools/l0 links this into every program, in the prelude group alongside
; lib/prelude.l0, so a program may define its own read_line and keep calling
; it. It is a separate file because the compiler is built from
; lib/prelude.l0, and the stage-0 interpreter that runs the compiler for
; tools/l0check does not know the I/O builtins.

; The next line of standard input, including its newline if it has one. The
; empty list means end of input, and nothing else does: a blank line is "\n",
; and a last line with no newline comes back without one.
(def read_line () (list int)
  (rev (read_line_onto (nil int))))

(def read_line_onto ((acc (list int))) (list int)
  (let b (read_byte)
    (if (lt b 0)
        acc
        (if (eq b 10)
            (cons b acc)
            (read_line_onto (cons b acc))))))

; Writes every byte of s, in order, and returns 0.
(def write_str ((s (list int))) int
  (if (is_empty s)
      0
      (let w (write_byte (head s))
        (write_str (tail s)))))

; Writes s followed by a newline, and returns 0.
(def write_line ((s (list int))) int
  (let w (write_str s)
    (write_byte 10)))

; io.l0 -- lines, strings, bytes, arguments, files, devices, and threads'
; traps, over the I/O builtins of spec sections 6.2 to 6.4 and 6.6, the
; regions of 6.12, and the user mode of 6.13.
;
; tools/l0 links this into every program, in the prelude group alongside
; lib/prelude.l0, so a program may define its own read_line and keep using it
; (spec section 7.1). It is a separate file because the compiler is built
; from lib/prelude.l0 and needs no I/O, so what does I/O is here and
; everything else is there. It calls rev, Option, and the rest of
; lib/prelude.l0, and so checks only beside it.
; ;; comments are what l0 doc shows, as in lib/prelude.l0.

;;; Reading and writing lines, strings, and bytes, command-line arguments,
;;; files, devices' registers, and the traps of threads a kernel runs. The
;;; I/O is built on the builtins of spec sections 6.2 to 6.4, 6.6, 6.12, and
;;; 6.13, and like them happens in evaluation order: sequence it with let.

;; The next line of standard input, including its newline if it has one. The
;; empty list means end of input: a blank line is "\n", and a last line with
;; no newline comes back without one. A failed read also ends the line, and
;; looks like end of input; use next_line when that must be told apart.
(def read_line () (list int)
  (rev (read_line_onto (nil int))))

(def read_line_onto ((acc (list int))) (list int)
  (let b (read_byte)
    (if (lt b 0)
        acc
        (if (eq b 10)
            (cons b acc)
            (read_line_onto (cons b acc))))))

;; A line read by next_line or file_next_line. IoError carries the negative
;; code of spec section 6.3, which io_error puts into words; the bytes of the
;; line read before the failure are dropped.
(data IoLine
  (IoLine (list int))                   ; a line, with its newline if it had one
  (IoEnd)                               ; end of input, before any byte of a line
  (IoError int))

;; The next line of standard input as an IoLine: (IoLine s) with its newline
;; if it had one, (IoEnd) at end of input, or (IoError code) if a read failed.
(def next_line () IoLine
  (next_line_from 0 (nil int)))

(def next_line_from ((h int) (acc (list int))) IoLine
  (let b (read_from h)
    (if (eq b 10)
        (IoLine (rev (cons b acc)))
        (if (ge b 0)
            (next_line_from h (cons b acc))
            (if (lt b -1)
                (IoError b)
                (if (is_empty acc) (IoEnd) (IoLine (rev acc))))))))

;; Writes every byte of s to standard output, in order, and returns 0. A
;; failure to write shows only when (file_flush (IoFile 1)) says so; one
;; never checked is a runtime error when the program ends.
(def write_str ((s (list int))) int
  (if (is_empty s)
      0
      (let w (write_byte (head s))
        (write_str (tail s)))))

;; Writes s and then a newline to standard output, and returns 0.
(def write_line ((s (list int))) int
  (let w (write_str s)
    (write_byte 10)))

;; Writes every byte of s to standard error, and returns 0.
(def write_err ((s (list int))) int
  (write_to_handle 2 s))

(def write_to_handle ((h int) (s (list int))) int
  (if (is_empty s)
      0
      (let w (write_to h (head s))
        (write_to_handle h (tail s)))))

; ---------------------------------------------------------------------- bytes

;; The rest of an input, read at once by read_input or file_read_all. It is
;; (IoBytes b), or (IoReadFailed code) if a read failed, with the negative
;; code of spec section 6.3, which io_error puts into words; the bytes read
;; before the failure are dropped.
(data IoBytes
  (IoBytes bytes)
  (IoReadFailed int))

;; All of standard input that is left, as an IoBytes. bytes take about one
;; byte of memory per byte, where a list takes 24, so this is how to hold a
;; large input whole. A main that takes its input has read all of it already,
;; so there this gives empty bytes.
(def read_input () IoBytes
  (read_all_from 0))

; After read_bytes, read_from says why it stopped: -1 at the end, and any other
; code if reading failed or h was not open for reading (spec 6.6).
(def read_all_from ((h int)) IoBytes
  (let b (read_bytes h)
    (let e (read_from h)
      (if (eq e -1) (IoBytes b) (IoReadFailed e)))))

; ------------------------------------------------------------------ arguments

;; Every command-line argument, in order, not counting the program's name.
;; (arg i) and (arg_count) are the builtins beneath it, spec section 6.4.
(def args () (list (list int))
  (args_before (sub (arg_count) 1) (nil (list int))))

; Arguments 0 to i, consed on in front of acc from the last.
(def args_before ((i int) (acc (list (list int)))) (list (list int))
  (if (lt i 0)
      acc
      (args_before (sub i 1) (cons (arg i) acc))))

; ---------------------------------------------------------------------- files
;
; A file is an IoFile rather than a bare handle, so the checker can tell one
; from any other int. Opening returns IoOpened, whose IoFailed case a match
; has to handle, so a program cannot forget that opening can fail.
;
; The names here follow one rule, so a reader can guess one from another:
; - a thing the library hands out is Io and its noun, IoFile and IoRegion,
;   and what reading gives is Io and what it is, IoLine and IoBytes
; - the result of an operation that can fail is Io and the operation's past
;   participle, IoOpened, IoRegionOpened, and IoDone, whose success case
;   has the type's name, or Done, and whose failure case ends in Failed or
;   Error, or is NotDone, and carries a fault and words
; - a fault is the operation's noun and Fault, OpenFault to RegionFault,
;   and its cases begin with that noun, OpenMissing and RegionNoRoom
; - a function on an open thing is the thing's noun first, file_read_byte
;   and region_get32; one that takes a path or opens is the verb first,
;   open_in, rename_file
; - no library name is a builtin's, since that would take the builtin from
;   every program (spec section 7): so open_appending, not open_append,
;   and region_get32, not region_read32
; Trap and its cases name what the CPU did, not an I/O operation. A
; program that declares a name of its own shadows the library's (spec
; section 7.1).

;; An open file. Get one from open_in, open_out, or open_appending, or from
;; open_in_bytes and open_out_buffer for one in memory; use it with the file_
;; functions, and close it with file_close.
(data IoFile
  (IoFile int))

;; The result of opening a file: (IoOpened f), or (IoFailed fault why), where
;; fault says which failure it was, as a case of E, and why says it in words,
;; such as "no such file", for a message. E is the kind of open's failures:
;; OpenFault for reading, CreateFault for writing. Tell them apart with eq or
;; match, as in (eq fault (OpenMissing)); the checker rejects a case that
;; kind of open cannot give.
(data (IoOpened E)
  (IoOpened IoFile)
  (IoFailed E (list int)))

;; Why opening a file to read failed: it does not exist, it may not be read,
;; it is a directory, or anything else (spec section 6.3's -3, -4, -8, and
;; -5).
(data OpenFault
  (OpenMissing)
  (OpenDenied)
  (OpenIsDirectory)
  (OpenFailed))

;; Why creating a file, or opening one to append, failed: the file, or the
;; directory it would be created in, may not be written; that directory does
;; not exist; the name is a directory; or anything else (spec section 6.3's
;; -4, -9, -8, and -5). A missing file is not a failure here, since these
;; create it.
(data CreateFault
  (CreateDenied)
  (CreateNoDirectory)
  (CreateIsDirectory)
  (CreateFailed))

;; The result of renaming, removing, flushing, or closing a file: (Done), or
;; (NotDone fault why), where fault says which failure it was, as a case of
;; E, and why says it in words, for a message. E is the operation's failures:
;; RenameFault, RemoveFault, or WriteFault. Tell them apart with eq or match,
;; and use is_done where only success matters.
(data (IoDone E)
  (Done)
  (NotDone E (list int)))

;; Whether r is (Done).
(def (is_done E) ((r (IoDone E))) bool
  (match r
    ((Done) true)
    ((NotDone fault why) false)))

;; Why renaming failed: there is no file by the first name; either directory
;; may not be written; the new name is a directory; the directory the new
;; name would be in does not exist; the two are on different file systems; or
;; anything else (spec section 6.3's -3, -4, -8, -9, -10, and -5). Neither
;; name has changed.
(data RenameFault
  (RenameMissing)
  (RenameDenied)
  (RenameIsDirectory)
  (RenameNoDirectory)
  (RenameCrossDevice)
  (RenameFailed))

;; Why deleting a file failed: there is no file by that name, which a program
;; cleaning up may take as done; it may not be deleted; it is a directory; or
;; anything else (spec section 6.3's -3, -4, -8, and -5). The file is still
;; there.
(data RemoveFault
  (RemoveMissing)
  (RemoveDenied)
  (RemoveIsDirectory)
  (RemoveFailed))

;; Why bytes written to a file were lost, as flushing or closing it says:
;; there was no space for them; it is a pipe whose reader had gone; it is not
;; open for writing, as when it was already closed; or anything else (spec
;; section 6.3's -6, -7, -2, and -5). The first loss is the one reported, on
;; every later flush and the close.
(data WriteFault
  (WriteNoSpace)
  (WriteBrokenPipe)
  (WriteNotOpen)
  (WriteFailed))

;; Opens the file at path for reading.
(def open_in ((path (list int))) (IoOpened OpenFault)
  (opened_in (open_read path)))

;; Creates the file at path, or empties it if it exists, and opens it for
;; writing.
(def open_out ((path (list int))) (IoOpened CreateFault)
  (opened_out (open_write path)))

;; Opens the file at path for writing at its end, creating it if it does not
;; exist; what it already holds is kept.
(def open_appending ((path (list int))) (IoOpened CreateFault)
  (opened_out (open_append path)))

;; Gives the file at from the name to, replacing any file already there in
;; one step, or says why not, with neither name changed. To update a file
;; safely, write the new contents under another name, check file_close, and
;; rename that over the old.
(def rename_file ((from (list int)) (to (list int))) (IoDone RenameFault)
  (let c (rename from to)
    (done_or c (rename_fault c))))

;; Deletes the file at path, in one step, or says why not, with the file still
;; there; RemoveMissing means there was no such file, which a program cleaning
;; up may take as done. A directory is never deleted, and a link is deleted
;; rather than what it leads to. A handle already open on the file keeps
;; working until closed.
(def remove_file ((path (list int))) (IoDone RemoveFault)
  (let c (remove path)
    (done_or c (remove_fault c))))

;; Opens a file that reads the bytes of s and then ends, held in memory. Code
;; that reads an IoFile cannot tell it from a file on disk, which is how to
;; test such code on a string.
(def open_in_bytes ((s (list int))) (IoOpened OpenFault)
  (opened_in (open_bytes s)))

;; Opens a file in memory that keeps every byte written to it, for
;; buffer_contents to return. Code that writes an IoFile cannot tell it from
;; a file on disk, which is how to test such code's output as a string.
(def open_out_buffer () (IoOpened CreateFault)
  (opened_out (open_buffer)))

;; Every byte written so far to f, a file from open_out_buffer, or the empty
;; list if f is not one. Close f with file_close when done with it.
(def buffer_contents ((f IoFile)) (list int)
  (match f ((IoFile h) (buffer_bytes h))))

; The places a code from the builtins becomes a case: each takes a handle or
; 0, or one of the codes spec section 6.3 lets that operation return, and
; any other code is the operation's Failed case.
(def opened_in ((h int)) (IoOpened OpenFault)
  (if (ge h 0)
      ((IoOpened OpenFault) (IoFile h))
      (IoFailed (open_fault h) (io_error h))))

(def open_fault ((c int)) OpenFault
  (if (eq c -3) (OpenMissing)
    (if (eq c -4) (OpenDenied)
      (if (eq c -8) (OpenIsDirectory) (OpenFailed)))))

(def opened_out ((h int)) (IoOpened CreateFault)
  (if (ge h 0)
      ((IoOpened CreateFault) (IoFile h))
      (IoFailed (create_fault h) (io_error h))))

(def create_fault ((c int)) CreateFault
  (if (eq c -4) (CreateDenied)
    (if (eq c -9) (CreateNoDirectory)
      (if (eq c -8) (CreateIsDirectory) (CreateFailed)))))

; (Done) for 0, and otherwise fault, with the words for c.
(def (done_or E) ((c int) (fault E)) (IoDone E)
  (if (eq c 0) ((Done E)) (NotDone fault (io_error c))))

(def rename_fault ((c int)) RenameFault
  (if (eq c -3) (RenameMissing)
    (if (eq c -4) (RenameDenied)
      (if (eq c -8) (RenameIsDirectory)
        (if (eq c -9) (RenameNoDirectory)
          (if (eq c -10) (RenameCrossDevice) (RenameFailed)))))))

(def remove_fault ((c int)) RemoveFault
  (if (eq c -3) (RemoveMissing)
    (if (eq c -4) (RemoveDenied)
      (if (eq c -8) (RemoveIsDirectory) (RemoveFailed)))))

(def write_fault ((c int)) WriteFault
  (if (eq c -6) (WriteNoSpace)
    (if (eq c -7) (WriteBrokenPipe)
      (if (eq c -2) (WriteNotOpen) (WriteFailed)))))

;; What a negative result from an I/O builtin means, in words, for each code
;; of spec section 6.3: -1 "end of input", -2 "not open in that direction",
;; -3 "no such file", -4 "permission denied", -6 "no space left", -7 "the
;; reader has gone", -8 "is a directory", -9 "no such directory", -10 "on
;; another file system", and anything else "input or output failed".
(def io_error ((code int)) (list int)
  (if (eq code -1) "end of input"
    (if (eq code -2) "not open in that direction"
      (if (eq code -3) "no such file"
        (if (eq code -4) "permission denied"
          (io_error_more code))))))

(def io_error_more ((code int)) (list int)
  (if (eq code -6) "no space left"
    (if (eq code -7) "the reader has gone"
      (if (eq code -8) "is a directory"
        (if (eq code -9) "no such directory"
          (if (eq code -10) "on another file system"
            "input or output failed"))))))

;; The next byte of f, or -1 at end of input, or another negative code if the
;; read failed. Test for -1 and for other negatives separately.
(def file_read_byte ((f IoFile)) int
  (match f ((IoFile h) (read_from h))))

;; Writes the byte b to f, and returns 0, or a negative code.
(def file_write_byte ((f IoFile) (b int)) int
  (match f ((IoFile h) (write_to h b))))

;; Writes every byte of s to f, and returns 0.
(def file_write_str ((f IoFile) (s (list int))) int
  (match f ((IoFile h) (write_to_handle h s))))

;; Writes bytes i up to but not including j of b to f, and returns 0, or a
;; negative code. Unless 0 <= i <= j <= (bytes_len b) it is a runtime error,
;; so write all of b with (file_write_bytes f b 0 (bytes_len b)).
(def file_write_bytes ((f IoFile) (b bytes) (i int) (j int)) int
  (match f ((IoFile h) (write_bytes h b i j))))

;; The rest of f as an IoBytes, as read_input reads standard input.
(def file_read_all ((f IoFile)) IoBytes
  (match f ((IoFile h) (read_all_from h))))

;; The next piece of f, at least one byte and at most n, as (IoBytes b), with
;; b empty only at the end, or (IoReadFailed code). It waits only
;; until some byte has arrived, so call it until the bytes are empty to read
;; a whole file, holding one piece at a time: this is how a large file is
;; copied, or checked, in constant memory. (IoFile 0) reads standard input.
;; n below 1 is a runtime error.
(def file_read_some ((f IoFile) (n int)) IoBytes
  (match f
    ((IoFile h)
      (let b (read_some h n)
        (if (gt (bytes_len b) 0)
            (IoBytes b)
            (let e (read_from h)
              (if (eq e -1) (IoBytes b) (IoReadFailed e))))))))

;; The next line of f, as read_line reads standard input, so a failed read
;; looks like end of input; file_next_line tells them apart.
(def file_read_line ((f IoFile)) (list int)
  (match f ((IoFile h) (rev (read_line_from h (nil int))))))

(def read_line_from ((h int) (acc (list int))) (list int)
  (let b (read_from h)
    (if (lt b 0)
        acc
        (if (eq b 10)
            (cons b acc)
            (read_line_from h (cons b acc))))))

;; The next line of f as an IoLine, as next_line reads standard input.
(def file_next_line ((f IoFile)) IoLine
  (match f ((IoFile h) (next_line_from h (nil int)))))

;; Delivers the bytes written to f so far, leaving it open, or says why some
;; byte written to it could not be written. A failure shows only here and in
;; file_close, since writes are held back.
(def file_flush ((f IoFile)) (IoDone WriteFault)
  (match f
    ((IoFile h) (let c (flush h) (done_or c (write_fault c))))))

;; Closes f, or says why some byte written to it could not be written. Check
;; it after writing, as (is_done (file_close f)) or by its case: with
;; file_flush, it is the only place such a failure shows. f is closed either
;; way.
(def file_close ((f IoFile)) (IoDone WriteFault)
  (match f
    ((IoFile h) (let c (close h) (done_or c (write_fault c))))))

; -------------------------------------------------------------------- devices
;
; A device's registers, over the region builtins of spec section 6.12. A
; region is an IoRegion rather than a bare int, as a file is an IoFile, so
; the checker can tell it from a handle; it is a word, so this costs
; nothing (spec 10.1). The builtins have the names region_read32 and the
; rest, and a library function of a builtin's name would take it from
; every program (spec section 7), so a region is read with region_get32
; and written with region_set32, as an array is with array_get and
; array_set.

;; A range of a device's memory, its registers, opened with open_region.
;; Read it with region_get8 to region_get64 and write it with region_set8 to
;; region_set64, at offsets from the range's start, or copy bytes out and
;; in with region_get_bytes and region_set_bytes.
(data IoRegion
  (IoRegion (id int)))

;; The result of opening a region: (IoRegionOpened g), or (IoRegionFailed
;; fault why), where fault says which failure it was and why says it in
;; words.
(data IoRegionOpened
  (IoRegionOpened IoRegion)
  (IoRegionFailed RegionFault (list int)))

;; Why opening a region failed: the host has no device there, which under
;; an operating system is every range; or no more can be open (spec section
;; 6.12's -3 and -5).
(data RegionFault
  (RegionMissing)
  (RegionNoRoom))

;; Opens the len bytes of device memory at address base, which must lie
;; wholly within one of the machine's devices: on QEMU's virt board, those
;; spec section 10.3 lists, such as the PL011 serial port's 4096 bytes at
;; 0x09000000.
(def open_region ((base int) (len int)) IoRegionOpened
  (let r (region_open base len)
    (if (ge r 0)
        (IoRegionOpened (IoRegion r))
        (if (eq r -3)
            (IoRegionFailed (RegionMissing) "no device there")
            (IoRegionFailed (RegionNoRoom) "too many regions open")))))

;; Closes g, which open_region gave, once every access to it is complete,
;; and returns 0: g is then no region, and its number may be given to a
;; later open_region. Closing it again is a runtime error. At most 64
;; regions are open at once.
(def close_region ((g IoRegion)) int
  (region_close (.id g)))

;; The byte at off in g, 0 to 255. Every region_get and region_set is one
;; access of its width, where evaluation order puts it, even when its
;; result is unused; an off past either end of g, or an address not a
;; multiple of the width, is a runtime error.
(def region_get8 ((g IoRegion) (off int)) int
  (region_read8 (.id g) off))

;; The 2 bytes at off in g, 0 to 65535, the lower address least significant.
(def region_get16 ((g IoRegion) (off int)) int
  (region_read16 (.id g) off))

;; The 4 bytes at off in g, never negative, the lower address least
;; significant: a 32-bit register.
(def region_get32 ((g IoRegion) (off int)) int
  (region_read32 (.id g) off))

;; The 8 bytes at off in g as all 64 bits of an int, so negative when the
;; top bit is set.
(def region_get64 ((g IoRegion) (off int)) int
  (region_read64 (.id g) off))

;; Writes the low 8 bits of v at off in g, and returns 0.
(def region_set8 ((g IoRegion) (off int) (v int)) int
  (region_write8 (.id g) off v))

;; Writes the low 16 bits of v at off in g, and returns 0.
(def region_set16 ((g IoRegion) (off int) (v int)) int
  (region_write16 (.id g) off v))

;; Writes the low 32 bits of v at off in g, and returns 0.
(def region_set32 ((g IoRegion) (off int) (v int)) int
  (region_write32 (.id g) off v))

;; Writes all 64 bits of v at off in g, and returns 0.
(def region_set64 ((g IoRegion) (off int) (v int)) int
  (region_write64 (.id g) off v))

;; A copy of the n bytes at off in g, as bytes: for a range over memory,
;; such as pages shared or given a device, not over registers, since each
;; byte is read once, lowest first, but at widths the host chooses. A
;; negative n, or a range past either end of g, is a runtime error.
(def region_get_bytes ((g IoRegion) (off int) (n int)) bytes
  (region_read_bytes (.id g) off n))

;; Copies bytes i up to j of b into g from off, as region_get_bytes reads
;; them, and returns 0. A range not within b, as write_bytes takes one, or
;; past either end of g, is a runtime error.
(def region_set_bytes ((g IoRegion) (off int) (b bytes) (i int) (j int)) int
  (region_write_bytes (.id g) off b i j))

; The names these had before roadmap 0144, kept so that programs written
; with them still compile; each is the new one, and costs nothing, since an
; IoDevice is a word too and each call inlines. They go once L0S has moved.

;; The old name of IoRegion, which open_device gives and the device_
;; functions take.
(data IoDevice
  (IoDevice int))

;; The old name of IoRegionOpened.
(data DeviceOpened
  (DeviceOpened IoDevice)
  (DeviceFailed DeviceFault (list int)))

;; The old name of RegionFault.
(data DeviceFault
  (DeviceMissing)
  (DeviceNoRoom))

;; The old name of open_region.
(def open_device ((base int) (len int)) DeviceOpened
  (match (open_region base len)
    ((IoRegionOpened g) (DeviceOpened (IoDevice (.id g))))
    ((IoRegionFailed fault why)
      (DeviceFailed (if (eq fault (RegionMissing)) (DeviceMissing) (DeviceNoRoom)) why))))

(def as_region ((d IoDevice)) IoRegion
  (match d ((IoDevice r) (IoRegion r))))

;; The old name of close_region.
(def close_device ((d IoDevice)) int (close_region (as_region d)))
;; The old name of region_get8.
(def device_read8 ((d IoDevice) (off int)) int (region_get8 (as_region d) off))
;; The old name of region_get16.
(def device_read16 ((d IoDevice) (off int)) int (region_get16 (as_region d) off))
;; The old name of region_get32.
(def device_read32 ((d IoDevice) (off int)) int (region_get32 (as_region d) off))
;; The old name of region_get64.
(def device_read64 ((d IoDevice) (off int)) int (region_get64 (as_region d) off))
;; The old name of region_set8.
(def device_write8 ((d IoDevice) (off int) (v int)) int (region_set8 (as_region d) off v))
;; The old name of region_set16.
(def device_write16 ((d IoDevice) (off int) (v int)) int (region_set16 (as_region d) off v))
;; The old name of region_set32.
(def device_write32 ((d IoDevice) (off int) (v int)) int (region_set32 (as_region d) off v))
;; The old name of region_set64.
(def device_write64 ((d IoDevice) (off int) (v int)) int (region_set64 (as_region d) off v))
;; The old name of region_get_bytes.
(def device_read_bytes ((d IoDevice) (off int) (n int)) bytes
  (region_get_bytes (as_region d) off n))
;; The old name of region_set_bytes.
(def device_write_bytes ((d IoDevice) (off int) (b bytes) (i int) (j int)) int
  (region_set_bytes (as_region d) off b i j))

; A thread's trap, over the user-mode builtins of spec section 6.13, read
; from its context as section 10.3 lays one out for the CPU machine names
; (6.16): on every CPU the trap's kind is word 35, what the CPU said of it
; word 36, and the address word 37, and the rest are its registers.

;; Why a thread came back from user_run: (TrapCall n), a system call with
;; number n, which call_number reads; (TrapMissing va), a fault at the user
;; address va where nothing is mapped, which a kernel answers by mapping a
;; page there or ending the thread; (TrapFault why va), any other fault,
;; with what the CPU said of it, its syndrome or cause, and the address; or
;; (TrapInterrupt n), interrupt n, taken, which interrupt_done ends (spec
;; section 6.14).
(data Trap
  (TrapCall int)
  (TrapMissing int)
  (TrapFault int int)
  (TrapInterrupt int))

;; The trap the context c records, as a Trap, for the context user_run
;; returned. On aarch64 a system call is an svc, and a missing page is a
;; data or instruction abort from EL0 for a translation fault; on riscv64
;; a system call is an ecall from U-mode, and a missing page is a page
;; fault at an address the host says nothing is mapped at.
(def trap_of ((c (array int))) Trap
  (if (eq (array_get c 35) 1)
      (TrapInterrupt (array_get c 36))
      (if (eq (machine) 2)
          (trap_of_riscv64 (array_get c 36) (array_get c 37) (array_get c 34) (call_number c))
          (trap_of_aarch64 (array_get c 36) (array_get c 37) (call_number c)))))

(def trap_of_riscv64 ((cause int) (va int) (missing int) (n int)) Trap
  (if (eq cause 8)                                    ; an ecall from U-mode
      (TrapCall n)
      (if (if (any_eq cause (cons 12 (cons 13 (cons 15 (nil int))))) (eq missing 1) false)
          (TrapMissing va)                            ; a page fault, nothing there
          (TrapFault cause va))))

(def trap_of_aarch64 ((esr int) (far int) (n int)) Trap
  (let ec (bit_and (bit_shr esr 26) 63)
    (if (eq ec 21)                                    ; svc from aarch64
        (TrapCall n)
        (if (if (eq ec 36) true (eq ec 32))            ; a data or instruction abort
            (if (eq (bit_and esr 60) 4)                ; a translation fault
                (TrapMissing far)
                (TrapFault esr far))
            (TrapFault esr far)))))

;; The number of the system call the thread whose context is c made, from
;; the register its CPU keeps it in: x8 on aarch64, a7 on riscv64. What the
;; call asks is in its arguments, call_arg, and it is answered by
;; call_result.
(def call_number ((c (array int))) int
  (array_get c (call_number_word (machine))))

;; Argument k, 0 to 3, of the system call the thread whose context is c
;; made, from the register its CPU passes it in: x0 to x3 on aarch64, a0
;; to a3 on riscv64.
(def call_arg ((c (array int)) (k int)) int
  (array_get c (add (call_result_word (machine)) k)))

;; The context c with v as its system call's result, in the register its
;; CPU returns one in, x0 on aarch64 and a0 on riscv64, so that the thread,
;; run again with it, resumes after its call with that result.
(def call_result ((c (array int)) (v int)) (array int)
  (array_set c (call_result_word (machine)) v))

;; A context for user_run that starts a thread at pc with its stack pointer
;; at sp, every other register 0: an (array int) of the 104 words spec
;; section 10.3 gives for each CPU.
(def user_context ((pc int) (sp int)) (array int)
  (array_set (array_set (array_new 104 0) 32 pc) (sp_word (machine)) sp))

; Where each CPU keeps what the context helpers above read, by its number
; (spec sections 6.16 and 10.3): aarch64's x8, x0, and sp, words 8, 0, and
; 31, and riscv64's a7, a0, and sp, which are x17, x10, and x2.
(def call_number_word ((m int)) int (if (eq m 2) 17 8))
(def call_result_word ((m int)) int (if (eq m 2) 10 0))
(def sp_word ((m int)) int (if (eq m 2) 2 31))

; io.l0 -- lists and arrays of any type, Option and Result, then lines,
; strings, bytes, arguments, and files, over the I/O builtins of spec
; sections 6.2 to 6.4 and 6.6.
;
; tools/l0 links this into every program, in the prelude group alongside
; lib/prelude.l0, so a program may define its own read_line, or its own Ok,
; and keep using it (spec section 7.1). It is a separate file because the
; compiler is built from lib/prelude.l0, and the stage-0 interpreter that ran
; the compiler for tools/l0check knows neither the I/O builtins nor type
; parameters; that, not I/O, decided which definitions are here. Nothing
; runs the compiler under stage 0 now. lib/prelude.l0 calls rev and append,
; which it finds here in the prelude group, and in compiler/lex.l0 when it is
; built into the compiler.
; ;; comments are what l0 doc shows, as in lib/prelude.l0.

;;; Lists and arrays of any type, and Option and Result, for every type they
;;; hold; then reading and writing lines, strings, and bytes, command-line
;;; arguments, and files. The I/O is built on the builtins of spec sections
;;; 6.2 to 6.4 and 6.6, and like them happens in evaluation order: sequence
;;; it with let.

; ------------------------------------------------------------ lists, arrays

;; xs reversed, in front of acc, for a list of any type: (rev_onto "ab" "cd")
;; is "bacd".
(def (rev_onto T) ((xs (list T)) (acc (list T))) (list T)
  (if (is_empty xs)
      acc
      (rev_onto (tail xs) (cons (head xs) acc))))

;; xs reversed, for a list of any type.
(def (rev T) ((xs (list T))) (list T)
  (rev_onto xs (nil T)))

;; xs followed by ys, for lists of any type. It copies xs, so appending in a
;; loop is quadratic: build anything long with push and rev instead.
(def (append T) ((xs (list T)) (ys (list T))) (list T)
  (rev_onto (rev xs) ys))

;; The number of elements of xs, a list of any type.
(def (length T) ((xs (list T))) int
  (length_onto xs 0))

(def (length_onto T) ((xs (list T)) (n int)) int
  (if (is_empty xs) n (length_onto (tail xs) (add n 1))))

;; Whether x is one of xs, by eq, for a list of any type. With split_spaces it
;; tests a word against a table: (any_eq "if" (split_spaces "def if let")).
(def (any_eq T) ((x T) (xs (list T))) bool
  (if (is_empty xs)
      false
      (if (eq x (head xs)) true (any_eq x (tail xs)))))

;; The position of the first element of xs that is x, by eq, counting from 0,
;; or -1 if there is none, for a list of any type. With two word tables, maps
;; a name in one to the same position in the other.
(def (index_of T) ((x T) (xs (list T))) int
  (index_of_from x xs 0))

(def (index_of_from T) ((x T) (xs (list T)) (i int)) int
  (if (is_empty xs)
      -1
      (if (eq x (head xs)) i (index_of_from x (tail xs) (add i 1)))))

;; An array of n elements of any type: the first n of a, followed by copies
;; of fill if a has fewer. This is how an array grows, as in (array_resize a
;; (mul 2 (array_len a)) x); it costs n, and a negative n is a runtime error.
(def (array_resize T) ((a (array T)) (n int) (fill T)) (array T)
  (let m (array_len a)
    (array_copy_onto a (array_new n fill) 0 (if (lt m n) m n))))

; dst with elements i up to but not including n of src copied into it.
(def (array_copy_onto T) ((src (array T)) (dst (array T)) (i int) (n int))
    (array T)
  (if (ge i n)
      dst
      (array_copy_onto src (array_set dst i (array_get src i)) (add i 1) n)))

; ------------------------------------------------------------ option, result

;; A value that may be missing: (Some x), or (None). (Some x) takes its type
;; from x, but None says nothing of T, so it is written with its type as nil
;; is: ((None int)) is an (Option int).
(data (Option T)
  (None)
  (Some T))

;; The outcome of something that can fail: (Ok x), or (Err e) saying why.
;; Neither constructor determines both parameters, so both are written with
;; the type: ((Ok int (list int)) 5) and ((Err int (list int)) "bad") are
;; each a (Result int (list int)). A program that declares its own Ok or Err
;; uses its own, and cannot match on this type (spec section 7.1).
(data (Result T E)
  (Ok T)
  (Err E))

;; The next line of standard input, including its newline if it has one. The
;; empty list means end of input: a blank line is "\n", and a last line with
;; no newline comes back without one. A failed read also ends the line, and
;; looks like end of input; use next_line when that must be told apart.
(def read_line () (list int)
  (rev (read_line_onto (nil int))))

(def read_line_onto ((acc (list int))) (list int)
  (let b (read_byte)
    (if (lt b 0)
        acc
        (if (eq b 10)
            (cons b acc)
            (read_line_onto (cons b acc))))))

;; A line read by next_line or file_next_line. IoError carries the negative
;; code of spec section 6.3, which io_error puts into words; the bytes of the
;; line read before the failure are dropped.
(data IoLine
  (IoLine (list int))                   ; a line, with its newline if it had one
  (IoEnd)                               ; end of input, before any byte of a line
  (IoError int))

;; The next line of standard input as an IoLine: (IoLine s) with its newline
;; if it had one, (IoEnd) at end of input, or (IoError code) if a read failed.
(def next_line () IoLine
  (next_line_from 0 (nil int)))

(def next_line_from ((h int) (acc (list int))) IoLine
  (let b (read_from h)
    (if (eq b 10)
        (IoLine (rev (cons b acc)))
        (if (ge b 0)
            (next_line_from h (cons b acc))
            (if (lt b -1)
                (IoError b)
                (if (is_empty acc) (IoEnd) (IoLine (rev acc))))))))

;; Writes every byte of s to standard output, in order, and returns 0. A
;; failure to write shows only when (flush 1) returns -5; one never checked
;; is a runtime error when the program ends.
(def write_str ((s (list int))) int
  (if (is_empty s)
      0
      (let w (write_byte (head s))
        (write_str (tail s)))))

;; Writes s and then a newline to standard output, and returns 0.
(def write_line ((s (list int))) int
  (let w (write_str s)
    (write_byte 10)))

;; Writes every byte of s to standard error, and returns 0.
(def write_err ((s (list int))) int
  (write_to_handle 2 s))

(def write_to_handle ((h int) (s (list int))) int
  (if (is_empty s)
      0
      (let w (write_to h (head s))
        (write_to_handle h (tail s)))))

; ---------------------------------------------------------------------- bytes

;; The rest of an input, read at once by read_input or file_read_all. It is
;; (IoBytes b), or (IoReadFailed code) if a read failed, with the negative
;; code of spec section 6.3, which io_error puts into words; the bytes read
;; before the failure are dropped.
(data IoBytes
  (IoBytes bytes)
  (IoReadFailed int))

;; All of standard input that is left, as an IoBytes. bytes take about one
;; byte of memory per byte, where a list takes 24, so this is how to hold a
;; large input whole. A main that takes its input has read all of it already,
;; so there this gives empty bytes.
(def read_input () IoBytes
  (read_all_from 0))

; After read_bytes, read_from says why it stopped: -1 at the end, and any other
; code if reading failed or h was not open for reading (spec 6.6).
(def read_all_from ((h int)) IoBytes
  (let b (read_bytes h)
    (let e (read_from h)
      (if (eq e -1) (IoBytes b) (IoReadFailed e)))))

; ------------------------------------------------------------------ arguments

;; Every command-line argument, in order, not counting the program's name.
;; (arg i) and (arg_count) are the builtins beneath it, spec section 6.4.
(def args () (list (list int))
  (args_before (sub (arg_count) 1) (nil (list int))))

; Arguments 0 to i, consed on in front of acc from the last.
(def args_before ((i int) (acc (list (list int)))) (list (list int))
  (if (lt i 0)
      acc
      (args_before (sub i 1) (cons (arg i) acc))))

; ---------------------------------------------------------------------- files
;
; A file is an IoFile rather than a bare handle, so the checker can tell one
; from any other int. Opening returns IoOpened, whose IoFailed case a match
; has to handle, so a program cannot forget that opening can fail. This
; library's names begin with Io so a reader can tell them apart; a program
; that declares one of its own shadows it (spec section 7.1).

;; An open file. Get one from open_in or open_out, use it with the file_
;; functions, and close it with file_close.
(data IoFile
  (IoFile int))

;; The result of opening a file: (IoOpened f), or (IoFailed why), where why
;; says in words what went wrong, such as "no such file".
(data IoOpened
  (IoOpened IoFile)
  (IoFailed (list int)))

;; Opens the file at path for reading.
(def open_in ((path (list int))) IoOpened
  (opened (open_read path)))

;; Creates the file at path, or empties it if it exists, and opens it for
;; writing.
(def open_out ((path (list int))) IoOpened
  (opened (open_write path)))

;; Opens the file at path for writing at its end, creating it if it does not
;; exist; what it already holds is kept.
(def open_appending ((path (list int))) IoOpened
  (opened (open_append path)))

;; Gives the file at from the name to, replacing any file already there in
;; one step, and returns 0, or a negative code with neither name changed. To
;; update a file safely, write the new contents under another name, check
;; file_close, and rename that over the old.
(def rename_file ((from (list int)) (to (list int))) int
  (rename from to))

;; Opens a file that reads the bytes of s and then ends, held in memory. Code
;; that reads an IoFile cannot tell it from a file on disk, which is how to
;; test such code on a string.
(def open_in_bytes ((s (list int))) IoOpened
  (opened (open_bytes s)))

;; Opens a file in memory that keeps every byte written to it, for
;; buffer_contents to return. Code that writes an IoFile cannot tell it from
;; a file on disk, which is how to test such code's output as a string.
(def open_out_buffer () IoOpened
  (opened (open_buffer)))

;; Every byte written so far to f, a file from open_out_buffer, or the empty
;; list if f is not one. Close f with file_close when done with it.
(def buffer_contents ((f IoFile)) (list int)
  (match f ((IoFile h) (buffer_bytes h))))

(def opened ((h int)) IoOpened
  (if (lt h 0)
      (IoFailed (io_error h))
      (IoOpened (IoFile h))))

;; What a negative result from an I/O builtin means, in words: -1 "end of
;; input", -2 "not open in that direction", -3 "no such file", -4
;; "permission denied", and anything else "input or output failed". Spec
;; section 6.3.
(def io_error ((code int)) (list int)
  (if (eq code -1)
      "end of input"
      (if (eq code -2)
          "not open in that direction"
          (if (eq code -3)
              "no such file"
              (if (eq code -4)
                  "permission denied"
                  "input or output failed")))))

;; The next byte of f, or -1 at end of input, or another negative code if the
;; read failed. Test for -1 and for other negatives separately.
(def file_read_byte ((f IoFile)) int
  (match f ((IoFile h) (read_from h))))

;; Writes the byte b to f, and returns 0, or a negative code.
(def file_write_byte ((f IoFile) (b int)) int
  (match f ((IoFile h) (write_to h b))))

;; Writes every byte of s to f, and returns 0.
(def file_write_str ((f IoFile) (s (list int))) int
  (match f ((IoFile h) (write_to_handle h s))))

;; Writes bytes i up to but not including j of b to f, and returns 0, or a
;; negative code. Unless 0 <= i <= j <= (bytes_len b) it is a runtime error,
;; so write all of b with (file_write_bytes f b 0 (bytes_len b)).
(def file_write_bytes ((f IoFile) (b bytes) (i int) (j int)) int
  (match f ((IoFile h) (write_bytes h b i j))))

;; The rest of f as an IoBytes, as read_input reads standard input.
(def file_read_all ((f IoFile)) IoBytes
  (match f ((IoFile h) (read_all_from h))))

;; The next line of f, as read_line reads standard input, so a failed read
;; looks like end of input; file_next_line tells them apart.
(def file_read_line ((f IoFile)) (list int)
  (match f ((IoFile h) (rev (read_line_from h (nil int))))))

(def read_line_from ((h int) (acc (list int))) (list int)
  (let b (read_from h)
    (if (lt b 0)
        acc
        (if (eq b 10)
            (cons b acc)
            (read_line_from h (cons b acc))))))

;; The next line of f as an IoLine, as next_line reads standard input.
(def file_next_line ((f IoFile)) IoLine
  (match f ((IoFile h) (next_line_from h (nil int)))))

;; Delivers the bytes written to f so far, leaving it open, and returns 0, or
;; a negative code if any byte written to it could not be written. A failure
;; shows only here and in file_close, since writes are held back.
(def file_flush ((f IoFile)) int
  (match f ((IoFile h) (flush h))))

;; Closes f, and returns 0, or a negative code if any byte written to it
;; could not be written. Check it after writing: with file_flush, it is the
;; only place such a failure shows.
(def file_close ((f IoFile)) int
  (match f ((IoFile h) (close h))))

; prelude.l0 -- the part of the standard library that does no I/O: lists and
; arrays of any type, Option and Result, a map, and byte-string helpers.
;
; The compiler is built from this file and compiler/*.l0, so everything here
; is exercised by every build of it, and the compiler calls rev, any_eq, and
; the rest at the types it needs. lib/io.l0 holds the I/O, which the compiler
; does not link. This file checks on its own.
;
; Output is always built with the reversed-accumulator idiom from spec section
; 11.1: push chunks onto a backwards list, reverse exactly once at the end.
; Using append to build output would make the compiler quadratic in the size of
; its own output.
;
; A comment starting ;; documents the definition below it, and is what l0 doc
; shows; a definition without one is internal. ;;; describes the file.

;;; Lists and arrays of any type, Option, Result, Map, and lists of bytes:
;;; building output, comparing, decimal numbers, slicing lines and words, word
;;; tables, and character classes. A string is a (list int) of byte values, so
;;; the byte helpers work on strings.

; ------------------------------------------------------------ lists, arrays

;; xs reversed, in front of acc, for a list of any type: (rev_onto "ab" "cd")
;; is "bacd".
(def (rev_onto T) ((xs (list T)) (acc (list T))) (list T)
  (if (is_empty xs)
      acc
      (rev_onto (tail xs) (cons (head xs) acc))))

;; xs reversed, for a list of any type.
(def (rev T) ((xs (list T))) (list T)
  (rev_onto xs (nil T)))

;; xs followed by ys, for lists of any type. It copies xs, so appending in a
;; loop is quadratic: build anything long with push and rev instead.
(def (append T) ((xs (list T)) (ys (list T))) (list T)
  (rev_onto (rev xs) ys))

;; The number of elements of xs, a list of any type.
(def (length T) ((xs (list T))) int
  (length_onto xs 0))

(def (length_onto T) ((xs (list T)) (n int)) int
  (if (is_empty xs) n (length_onto (tail xs) (add n 1))))

;; Whether x is one of xs, by eq, for a list of any type. With split_spaces it
;; tests a word against a table: (any_eq "if" (split_spaces "def if let")).
(def (any_eq T) ((x T) (xs (list T))) bool
  (if (is_empty xs)
      false
      (if (eq x (head xs)) true (any_eq x (tail xs)))))

;; The position of the first element of xs that is x, by eq, counting from 0,
;; or -1 if there is none, for a list of any type. With two word tables, maps
;; a name in one to the same position in the other.
(def (index_of T) ((x T) (xs (list T))) int
  (index_of_from x xs 0))

(def (index_of_from T) ((x T) (xs (list T)) (i int)) int
  (if (is_empty xs)
      -1
      (if (eq x (head xs)) i (index_of_from x (tail xs) (add i 1)))))

;; An array of n elements of any type: the first n of a, followed by copies
;; of fill if a has fewer. This is how an array grows, as in (array_resize a
;; (mul 2 (array_len a)) x); it costs n, and a negative n is a runtime error.
(def (array_resize T) ((a (array T)) (n int) (fill T)) (array T)
  (let m (array_len a)
    (array_copy_onto a (array_new n fill) 0 (if (lt m n) m n))))

; dst with elements i up to but not including n of src copied into it.
(def (array_copy_onto T) ((src (array T)) (dst (array T)) (i int) (n int))
    (array T)
  (if (ge i n)
      dst
      (array_copy_onto src (array_set dst i (array_get src i)) (add i 1) n)))

; ------------------------------------------------------------ option, result

;; A value that may be missing: (Some x), or (None). (Some x) takes its type
;; from x, but None says nothing of T, so it is written with its type as nil
;; is: ((None int)) is an (Option int).
(data (Option T)
  (None)
  (Some T))

;; The outcome of something that can fail: (Ok x), or (Err e) saying why.
;; Neither constructor determines both parameters, so both are written with
;; the type: ((Ok int (list int)) 5) and ((Err int (list int)) "bad") are
;; each a (Result int (list int)). A program that declares its own Ok or Err
;; uses its own, and cannot match on this type (spec section 7.1).
(data (Result T E)
  (Ok T)
  (Err E))

; ---------------------------------------------------------------------- maps
;
; An open-addressing table in three arrays, at most half full, probed
; linearly from the slot (mod (hash k) capacity). marks holds 0 for an empty
; slot and (add (hash k) 1), which is never 0, for a full one, so most keys
; are told apart without eq, and a key's slot is always worked out from its
; mark, by map_slot alone. The empty map holds no arrays, since there is no
; value of an unknown type to fill them with until the first key arrives.
; Every update matches the map at its last use, so its arrays have one
; holder and change in place (spec section 6.5). Removal shifts the entries
; after the removed one back, so no slot is ever a tombstone; the slot it
; empties may keep the removed key and value until it is reused.

;; A map from keys of type K to values of type V, written once for every
;; type: keys are compared with eq and placed by hash, so any value can be a
;; key. The empty map is ((MapEmpty K V)), written with its types as
;; ((None int)) is; add to it with map_put and read it with map_get. A map is
;; changed in place unless something else still holds it, in which case it
;; is copied whole, as an array is (spec section 6.5): keep one name for it.
(data (Map K V)
  (MapEmpty)
  (MapTable (array int) (array K) (array V) int))   ; marks, keys, values, count

;; m with k mapped to v, replacing any value k had. Amortized constant time.
(def (map_put K V) ((m (Map K V)) (k K) (v V)) (Map K V)
  (map_put_marked m (add (hash k) 1) k v))

;; The value k maps to in m, or (None) if it has none.
(def (map_get K V) ((m (Map K V)) (k K)) (Option V)
  (match m
    ((MapEmpty) ((None V)))
    ((MapTable ms ks vs n)
      (let mk (add (hash k) 1)
        (map_probe_get ms ks vs mk (map_slot mk (array_len ms)) k)))))

;; Whether k has a value in m.
(def (map_has K V) ((m (Map K V)) (k K)) bool
  (match (map_get m k)
    ((None) false)
    ((Some v) true)))

;; How many keys m maps to values.
(def (map_size K V) ((m (Map K V))) int
  (match m
    ((MapEmpty) 0)
    ((MapTable ms ks vs n) n)))

;; m without k, or m as it was if k has no value. Amortized constant time.
(def (map_remove K V) ((m (Map K V)) (k K)) (Map K V)
  (match m
    ((MapEmpty) m)
    ((MapTable ms ks vs n)
      (let mk (add (hash k) 1)
        (map_find_remove ms ks vs n mk (map_slot mk (array_len ms)) k)))))

;; Every key m has, each once. The order is the table's, which hash decides,
;; so it is the same on every run but is not the order of insertion; sort
;; the keys if the order matters.
(def (map_keys K V) ((m (Map K V))) (list K)
  (match m
    ((MapEmpty) (nil K))
    ((MapTable ms ks vs n) (map_live_from ms ks (sub (array_len ms) 1) (nil K)))))

;; Every value m has, in the same order as map_keys gives their keys.
(def (map_values K V) ((m (Map K V))) (list V)
  (match m
    ((MapEmpty) (nil V))
    ((MapTable ms ks vs n) (map_live_from ms vs (sub (array_len ms) 1) (nil V)))))

; The slot a key marked mk goes in, of cap.
(def map_slot ((mk int) (cap int)) int
  (mod (sub mk 1) cap))

(def (map_next T) ((i int) (ms (array T))) int
  (mod (add i 1) (array_len ms)))

(def (map_put_marked K V) ((m (Map K V)) (mk int) (k K) (v V)) (Map K V)
  (match m
    ((MapEmpty)
      (map_put_marked (MapTable (array_new 8 0) (array_new 8 k) (array_new 8 v) 0)
                      mk k v))
    ((MapTable ms ks vs n)
      (if (gt (mul 2 (add n 1)) (array_len ms))
          (map_put_marked (map_grown ms ks vs k v) mk k v)
          (map_probe_put ms ks vs n mk (map_slot mk (array_len ms)) k v)))))

(def (map_probe_put K V) ((ms (array int)) (ks (array K)) (vs (array V)) (n int)
                          (mk int) (i int) (k K) (v V)) (Map K V)
  (let here (array_get ms i)
    (if (eq here 0)
        (MapTable (array_set ms i mk) (array_set ks i k) (array_set vs i v) (add n 1))
        (if (if (eq here mk) (eq (array_get ks i) k) false)
            (MapTable ms ks (array_set vs i v) n)
            (map_probe_put ms ks vs n mk (map_next i ms) k v)))))

(def (map_probe_get K V) ((ms (array int)) (ks (array K)) (vs (array V)) (mk int)
                          (i int) (k K)) (Option V)
  (let here (array_get ms i)
    (if (eq here 0)
        ((None V))
        (if (if (eq here mk) (eq (array_get ks i) k) false)
            (Some (array_get vs i))
            (map_probe_get ms ks vs mk (map_next i ms) k)))))

; Twice the slots, with every entry moved over; k and v fill the new arrays,
; and are written over as entries arrive.
(def (map_grown K V) ((ms (array int)) (ks (array K)) (vs (array V)) (k K) (v V))
    (Map K V)
  (let cap (mul 2 (array_len ms))
    (map_move_all ms ks vs 0
      (MapTable (array_new cap 0) (array_new cap k) (array_new cap v) 0))))

(def (map_move_all K V) ((ms (array int)) (ks (array K)) (vs (array V)) (i int)
                         (into (Map K V))) (Map K V)
  (if (ge i (array_len ms))
      into
      (map_move_all ms ks vs (add i 1)
        (if (eq (array_get ms i) 0)
            into
            (map_put_marked into (array_get ms i) (array_get ks i) (array_get vs i))))))

(def (map_find_remove K V) ((ms (array int)) (ks (array K)) (vs (array V)) (n int)
                            (mk int) (i int) (k K)) (Map K V)
  (let here (array_get ms i)
    (if (eq here 0)
        (MapTable ms ks vs n)
        (if (if (eq here mk) (eq (array_get ks i) k) false)
            (if (eq n 1)
                ((MapEmpty K V))
                (map_shift ms ks vs (sub n 1) i (map_next i ms)))
            (map_find_remove ms ks vs n mk (map_next i ms) k)))))

; Slot i is empty; the entry at j, and each after it up to an empty slot,
; moves back to i unless that would put it before its own slot. The next
; slot is worked out before ms is updated, since reading ms in a later
; operand would make the update copy it (spec section 6.5).
(def (map_shift K V) ((ms (array int)) (ks (array K)) (vs (array V)) (n int)
                      (i int) (j int)) (Map K V)
  (let mj (array_get ms j)
    (if (eq mj 0)
        (MapTable (array_set ms i 0) ks vs n)
        (let nj (map_next j ms)
          (if (map_stays (map_slot mj (array_len ms)) i j)
              (map_shift ms ks vs n i nj)
              (map_shift (array_set ms i mj) (array_set ks i (array_get ks j))
                         (array_set vs i (array_get vs j)) n j nj))))))

; Whether an entry whose own slot is s, found at j, stays when i, before it,
; empties: it does when s is after i and no later than j, going round.
(def map_stays ((s int) (i int) (j int)) bool
  (if (le i j)
      (if (lt i s) (le s j) false)
      (if (lt i s) true (le s j))))

(def (map_live_from T) ((ms (array int)) (xs (array T)) (i int) (acc (list T)))
    (list T)
  (if (lt i 0)
      acc
      (map_live_from ms xs (sub i 1)
        (if (eq (array_get ms i) 0) acc (cons (array_get xs i) acc)))))

; ------------------------------------------------------------ byte strings

;; Pushes chunk onto a reversed accumulator: acc with chunk's bytes in front,
;; last byte first. Costs the length of the chunk, never of the accumulator.
;; Build output by pushing each piece and calling rev once at the end; see
;; spec section 11.1.
(def push ((chunk (list int)) (acc (list int))) (list int)
  (if (is_empty chunk)
      acc
      (push (tail chunk) (cons (head chunk) acc))))

;; Whether xs and ys hold the same bytes in the same order, as (eq xs ys)
;; says. It is from before eq compared lists, and stays for the programs that
;; call it; new code can write eq.
(def list_eq ((xs (list int)) (ys (list int))) bool
  (if (is_empty xs)
      (is_empty ys)
      (if (is_empty ys)
          false
          (if (eq (head xs) (head ys))
              (list_eq (tail xs) (tail ys))
              false))))

(def int_min ((ignored int)) int -9223372036854775808)

; n is known non-negative here.
(def digits_onto ((n int) (acc (list int))) (list int)
  (if (lt n 10)
      (cons (add 48 n) acc)
      (digits_onto (div n 10) (cons (add 48 (mod n 10)) acc))))

;; n in decimal, with a leading - if negative: (digits -42) is "-42". The only
;; way to print a number.
(def digits ((n int)) (list int)
  (if (eq n (int_min 0))
      "-9223372036854775808"
      (if (lt n 0)
          (cons 45 (digits_onto (neg n) (nil int)))
          (digits_onto n (nil int)))))

; ------------------------------------------------------------------ slicing

;; xs without its first n elements, or empty if it has fewer.
(def drop_n ((xs (list int)) (n int)) (list int)
  (if (le n 0)
      xs
      (if (is_empty xs) xs (drop_n (tail xs) (sub n 1)))))

;; Whether s begins with prefix. Every string starts with "".
(def starts_with ((s (list int)) (prefix (list int))) bool
  (if (is_empty prefix)
      true
      (if (is_empty s)
          false
          (if (eq (head s) (head prefix))
              (starts_with (tail s) (tail prefix))
              false))))

(def take_line_onto ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s)
      (rev acc)
      (if (eq (head s) 10)
          (rev acc)
          (take_line_onto (tail s) (cons (head s) acc)))))

;; s up to but not including its first newline, or all of s if it has none.
;; Strips the newline read_line keeps.
(def take_line ((s (list int))) (list int)
  (take_line_onto s (nil int)))

;; Everything after the first newline of s, or empty if it has none.
(def drop_line ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (eq (head s) 10)
          (tail s)
          (drop_line (tail s)))))

;; s without its leading decimal digits.
(def skip_digits ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (is_digit (head s)) (skip_digits (tail s)) s)))

;; s without its leading spaces, byte 32 only, not tabs or newlines.
(def skip_spaces ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (eq (head s) 32) (skip_spaces (tail s)) s)))

;; The number s starts with, in decimal, added to acc times ten per digit, so
;; (int_prefix "42x" 0) is 42 and (int_prefix "x" 0) is 0. There is no sign:
;; "-5" gives 0. Pass 0 for acc.
(def int_prefix ((s (list int)) (acc int)) int
  (if (is_empty s)
      acc
      (if (is_digit (head s))
          (int_prefix (tail s) (add (mul acc 10) (sub (head s) 48)))
          acc)))

; ------------------------------------------------------------ word tables
;
; Membership tests against a fixed set of names are common in a compiler.
; Written as a chain of or, they nest ten deep and are a reliable source of
; miscounted parentheses. Splitting one space-separated literal keeps the
; table flat and readable, and any_eq and index_of, above, look a name up in
; it.

(def split_spaces_onto ((s (list int)) (cur (list int))
                        (acc (list (list int)))) (list (list int))
  (if (is_empty s)
      (if (is_empty cur) acc (cons (rev cur) acc))
      (if (eq (head s) 32)
          (split_spaces_onto (tail s) (nil int)
            (if (is_empty cur) acc (cons (rev cur) acc)))
          (split_spaces_onto (tail s) (cons (head s) cur) acc))))

;; The words of s, split at spaces, in order. Runs of spaces count as one, so
;; no word is empty. Makes a word table from one literal:
;; (split_spaces "def data if").
(def split_spaces ((s (list int))) (list (list int))
  (rev (split_spaces_onto s (nil int) (nil (list int)))))

; ---------------------------------------------------------------- character
; classes, by byte value

;; Whether c is a space, tab, newline, or carriage return.
(def is_space ((c int)) bool
  (or (eq c 32)
      (or (eq c 9)
          (or (eq c 10) (eq c 13)))))

;; Whether c is one of the digits 0 to 9.
(def is_digit ((c int)) bool
  (and (ge c 48) (le c 57)))

;; Whether c is a lowercase letter a to z, or _: what may start a lowercase
;; L0 name.
(def is_lower ((c int)) bool
  (or (and (ge c 97) (le c 122)) (eq c 95)))

;; Whether c is an uppercase letter A to Z.
(def is_upper ((c int)) bool
  (and (ge c 65) (le c 90)))

(def is_name_start ((c int)) bool
  (or (is_lower c) (is_upper c)))

(def is_name_rest ((c int)) bool
  (or (is_name_start c) (is_digit c)))

;; The value of c as a hexadecimal digit, 0 to 15, in either case, or -1 if it
;; is not one.
(def hex_val ((c int)) int
  (if (is_digit c)
      (sub c 48)
      (if (and (ge c 97) (le c 102))
          (add 10 (sub c 97))
          (if (and (ge c 65) (le c 70))
              (add 10 (sub c 65))
              -1))))

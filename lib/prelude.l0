; prelude.l0 -- list and byte-string helpers shared across the compiler.
;
; Everything here operates on (list int), because stage 0 runs this file as
; part of the compiler and knows no type parameters. rev, rev_onto, append,
; and length, which a list of any type wants, are not here: programs get them
; from lib/io.l0 at every element type, and the compiler defines (list int)
; copies of its own in compiler/lex.l0. So this file checks only beside one
; of those two.
;
; Output is always built with the reversed-accumulator idiom from spec section
; 11.1: push chunks onto a backwards list, reverse exactly once at the end.
; Using append to build output would make the compiler quadratic in the size of
; its own output.
;
; A comment starting ;; documents the definition below it, and is what l0 doc
; shows; a definition without one is internal. ;;; describes the file.

;;; Lists of bytes: building output, comparing, decimal numbers, slicing
;;; lines and words, word tables, and character classes. A string is a (list
;;; int) of byte values, so all of these work on strings.

;; Pushes chunk onto a reversed accumulator: acc with chunk's bytes in front,
;; last byte first. Costs the length of the chunk, never of the accumulator.
;; Build output by pushing each piece and calling rev once at the end; see
;; spec section 11.1.
(def push ((chunk (list int)) (acc (list int))) (list int)
  (if (is_empty chunk)
      acc
      (push (tail chunk) (cons (head chunk) acc))))

;; Whether xs and ys hold the same bytes in the same order, as (eq xs ys)
;; says. It is here for the compiler, which stage 0 runs, and stage 0's eq
;; takes only integers; a program can write eq.
(def list_eq ((xs (list int)) (ys (list int))) bool
  (if (is_empty xs)
      (is_empty ys)
      (if (is_empty ys)
          false
          (if (eq (head xs) (head ys))
              (list_eq (tail xs) (tail ys))
              false))))

(def int_min ((ignored int)) int -9223372036854775808)

; n is known non-negative here.
(def digits_onto ((n int) (acc (list int))) (list int)
  (if (lt n 10)
      (cons (add 48 n) acc)
      (digits_onto (div n 10) (cons (add 48 (mod n 10)) acc))))

;; n in decimal, with a leading - if negative: (digits -42) is "-42". The only
;; way to print a number.
(def digits ((n int)) (list int)
  (if (eq n (int_min 0))
      "-9223372036854775808"
      (if (lt n 0)
          (cons 45 (digits_onto (neg n) (nil int)))
          (digits_onto n (nil int)))))

; ------------------------------------------------------------------ slicing

;; xs without its first n elements, or empty if it has fewer.
(def drop_n ((xs (list int)) (n int)) (list int)
  (if (le n 0)
      xs
      (if (is_empty xs) xs (drop_n (tail xs) (sub n 1)))))

;; Whether s begins with prefix. Every string starts with "".
(def starts_with ((s (list int)) (prefix (list int))) bool
  (if (is_empty prefix)
      true
      (if (is_empty s)
          false
          (if (eq (head s) (head prefix))
              (starts_with (tail s) (tail prefix))
              false))))

(def take_line_onto ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s)
      (rev acc)
      (if (eq (head s) 10)
          (rev acc)
          (take_line_onto (tail s) (cons (head s) acc)))))

;; s up to but not including its first newline, or all of s if it has none.
;; Strips the newline read_line keeps.
(def take_line ((s (list int))) (list int)
  (take_line_onto s (nil int)))

;; Everything after the first newline of s, or empty if it has none.
(def drop_line ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (eq (head s) 10)
          (tail s)
          (drop_line (tail s)))))

;; s without its leading decimal digits.
(def skip_digits ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (is_digit (head s)) (skip_digits (tail s)) s)))

;; s without its leading spaces, byte 32 only, not tabs or newlines.
(def skip_spaces ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (eq (head s) 32) (skip_spaces (tail s)) s)))

;; The number s starts with, in decimal, added to acc times ten per digit, so
;; (int_prefix "42x" 0) is 42 and (int_prefix "x" 0) is 0. There is no sign:
;; "-5" gives 0. Pass 0 for acc.
(def int_prefix ((s (list int)) (acc int)) int
  (if (is_empty s)
      acc
      (if (is_digit (head s))
          (int_prefix (tail s) (add (mul acc 10) (sub (head s) 48)))
          acc)))

; ------------------------------------------------------------ word tables
;
; Membership tests against a fixed set of names are common in a compiler.
; Written as a chain of or, they nest ten deep and are a reliable source of
; miscounted parentheses. Splitting one space-separated literal keeps the
; table flat and readable.

; rev_onto for (list (list int)), which split_spaces needs and stage 0 cannot
; get from the generic rev_onto in lib/io.l0.
(def rev_strs_onto ((xs (list (list int))) (acc (list (list int))))
    (list (list int))
  (if (is_empty xs)
      acc
      (rev_strs_onto (tail xs) (cons (head xs) acc))))

(def split_spaces_onto ((s (list int)) (cur (list int))
                        (acc (list (list int)))) (list (list int))
  (if (is_empty s)
      (if (is_empty cur) acc (cons (rev cur) acc))
      (if (eq (head s) 32)
          (split_spaces_onto (tail s) (nil int)
            (if (is_empty cur) acc (cons (rev cur) acc)))
          (split_spaces_onto (tail s) (cons (head s) cur) acc))))

;; The words of s, split at spaces, in order. Runs of spaces count as one, so
;; no word is empty. Makes a word table from one literal:
;; (split_spaces "def data if").
(def split_spaces ((s (list int))) (list (list int))
  (rev_strs_onto (split_spaces_onto s (nil int) (nil (list int)))
                 (nil (list int))))

;; Whether n is one of candidates.
(def any_eq ((n (list int)) (candidates (list (list int)))) bool
  (if (is_empty candidates)
      false
      (if (list_eq n (head candidates))
          true
          (any_eq n (tail candidates)))))

(def index_of_from ((n (list int)) (candidates (list (list int))) (i int)) int
  (if (is_empty candidates)
      -1
      (if (list_eq n (head candidates))
          i
          (index_of_from n (tail candidates) (add i 1)))))

;; The position of n in candidates, counting from 0, or -1 if it is not
;; there. With two word tables, maps a name in one to the same position in
;; the other.
(def index_of ((n (list int)) (candidates (list (list int)))) int
  (index_of_from n candidates 0))

; ---------------------------------------------------------------- character
; classes, by byte value

;; Whether c is a space, tab, newline, or carriage return.
(def is_space ((c int)) bool
  (or (eq c 32)
      (or (eq c 9)
          (or (eq c 10) (eq c 13)))))

;; Whether c is one of the digits 0 to 9.
(def is_digit ((c int)) bool
  (and (ge c 48) (le c 57)))

;; Whether c is a lowercase letter a to z, or _: what may start a lowercase
;; L0 name.
(def is_lower ((c int)) bool
  (or (and (ge c 97) (le c 122)) (eq c 95)))

;; Whether c is an uppercase letter A to Z.
(def is_upper ((c int)) bool
  (and (ge c 65) (le c 90)))

(def is_name_start ((c int)) bool
  (or (is_lower c) (is_upper c)))

(def is_name_rest ((c int)) bool
  (or (is_name_start c) (is_digit c)))

;; The value of c as a hexadecimal digit, 0 to 15, in either case, or -1 if it
;; is not one.
(def hex_val ((c int)) int
  (if (is_digit c)
      (sub c 48)
      (if (and (ge c 97) (le c 102))
          (add 10 (sub c 97))
          (if (and (ge c 65) (le c 70))
              (add 10 (sub c 65))
              -1))))

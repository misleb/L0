; prelude.l0 -- list and byte-string helpers shared across the compiler.
;
; Everything here operates on (list int). L0's data types are monomorphic and
; list is its only parametric type constructor, so helpers for lists of
; tokens, declarations, and so on live next to those types instead.
;
; Output is always built with the reversed-accumulator idiom from spec section
; 11.1: push chunks onto a backwards list, reverse exactly once at the end.
; Using append to build output would make the compiler quadratic in the size of
; its own output.

(def rev_onto ((xs (list int)) (acc (list int))) (list int)
  (if (is_empty xs)
      acc
      (rev_onto (tail xs) (cons (head xs) acc))))

(def rev ((xs (list int))) (list int)
  (rev_onto xs (nil int)))

; Pushes a chunk onto a reversed accumulator. Costs the length of the chunk,
; never the length of the accumulator.
(def push ((chunk (list int)) (acc (list int))) (list int)
  (if (is_empty chunk)
      acc
      (push (tail chunk) (cons (head chunk) acc))))

; Ordinary concatenation. Only for short strings such as diagnostics, never
; for building compiler output. It copies xs twice, reversing it and then
; reversing it onto ys, so that neither pass takes a stack frame per byte.
(def append ((xs (list int)) (ys (list int))) (list int)
  (rev_onto (rev xs) ys))

(def length ((xs (list int))) int
  (length_onto xs 0))

(def length_onto ((xs (list int)) (n int)) int
  (if (is_empty xs) n (length_onto (tail xs) (add n 1))))

(def list_eq ((xs (list int)) (ys (list int))) bool
  (if (is_empty xs)
      (is_empty ys)
      (if (is_empty ys)
          false
          (if (eq (head xs) (head ys))
              (list_eq (tail xs) (tail ys))
              false))))

(def int_min ((ignored int)) int -9223372036854775808)

; n is known non-negative here.
(def digits_onto ((n int) (acc (list int))) (list int)
  (if (lt n 10)
      (cons (add 48 n) acc)
      (digits_onto (div n 10) (cons (add 48 (mod n 10)) acc))))

; Decimal rendering. The most negative integer is special-cased because
; negating it wraps back to itself, per spec section 6.1.
(def digits ((n int)) (list int)
  (if (eq n (int_min 0))
      "-9223372036854775808"
      (if (lt n 0)
          (cons 45 (digits_onto (neg n) (nil int)))
          (digits_onto n (nil int)))))

; ------------------------------------------------------------------ slicing

(def drop_n ((xs (list int)) (n int)) (list int)
  (if (le n 0)
      xs
      (if (is_empty xs) xs (drop_n (tail xs) (sub n 1)))))

(def starts_with ((s (list int)) (prefix (list int))) bool
  (if (is_empty prefix)
      true
      (if (is_empty s)
          false
          (if (eq (head s) (head prefix))
              (starts_with (tail s) (tail prefix))
              false))))

; Up to but not including the next newline.
(def take_line_onto ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s)
      (rev acc)
      (if (eq (head s) 10)
          (rev acc)
          (take_line_onto (tail s) (cons (head s) acc)))))

(def take_line ((s (list int))) (list int)
  (take_line_onto s (nil int)))

; Everything after the next newline.
(def drop_line ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (eq (head s) 10)
          (tail s)
          (drop_line (tail s)))))

(def skip_digits ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (is_digit (head s)) (skip_digits (tail s)) s)))

(def skip_spaces ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (eq (head s) 32) (skip_spaces (tail s)) s)))

; Leading decimal digits as a number; 0 if there are none.
(def int_prefix ((s (list int)) (acc int)) int
  (if (is_empty s)
      acc
      (if (is_digit (head s))
          (int_prefix (tail s) (add (mul acc 10) (sub (head s) 48)))
          acc)))

; ------------------------------------------------------------ word tables
;
; Membership tests against a fixed set of names are common in a compiler.
; Written as a chain of or, they nest ten deep and are a reliable source of
; miscounted parentheses. Splitting one space-separated literal keeps the
; table flat and readable.

(def rev_strs_onto ((xs (list (list int))) (acc (list (list int))))
    (list (list int))
  (if (is_empty xs)
      acc
      (rev_strs_onto (tail xs) (cons (head xs) acc))))

(def split_spaces_onto ((s (list int)) (cur (list int))
                        (acc (list (list int)))) (list (list int))
  (if (is_empty s)
      (if (is_empty cur) acc (cons (rev cur) acc))
      (if (eq (head s) 32)
          (split_spaces_onto (tail s) (nil int)
            (if (is_empty cur) acc (cons (rev cur) acc)))
          (split_spaces_onto (tail s) (cons (head s) cur) acc))))

(def split_spaces ((s (list int))) (list (list int))
  (rev_strs_onto (split_spaces_onto s (nil int) (nil (list int)))
                 (nil (list int))))

(def any_eq ((n (list int)) (candidates (list (list int)))) bool
  (if (is_empty candidates)
      false
      (if (list_eq n (head candidates))
          true
          (any_eq n (tail candidates)))))

; Position of n in candidates, or -1. Used for builtin dispatch tables.
(def index_of_from ((n (list int)) (candidates (list (list int))) (i int)) int
  (if (is_empty candidates)
      -1
      (if (list_eq n (head candidates))
          i
          (index_of_from n (tail candidates) (add i 1)))))

(def index_of ((n (list int)) (candidates (list (list int)))) int
  (index_of_from n candidates 0))

; ---------------------------------------------------------------- character
; classes, by byte value

(def is_space ((c int)) bool
  (or (eq c 32)
      (or (eq c 9)
          (or (eq c 10) (eq c 13)))))

(def is_digit ((c int)) bool
  (and (ge c 48) (le c 57)))

(def is_lower ((c int)) bool
  (or (and (ge c 97) (le c 122)) (eq c 95)))

(def is_upper ((c int)) bool
  (and (ge c 65) (le c 90)))

(def is_name_start ((c int)) bool
  (or (is_lower c) (is_upper c)))

(def is_name_rest ((c int)) bool
  (or (is_name_start c) (is_digit c)))

(def hex_val ((c int)) int
  (if (is_digit c)
      (sub c 48)
      (if (and (ge c 97) (le c 102))
          (add 10 (sub c 97))
          (if (and (ge c 65) (le c 70))
              (add 10 (sub c 65))
              -1))))

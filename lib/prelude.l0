; prelude.l0 -- the part of the standard library that does no I/O: lists and
; arrays of any type, Option and Result, a map, and byte-string helpers.
;
; The compiler is built from this file and compiler/*.l0, so everything here
; is exercised by every build of it, and the compiler calls rev, any_eq, and
; the rest at the types it needs. lib/io.l0 holds the I/O, which the compiler
; does not link. This file checks on its own.
;
; Output is always built with the reversed-accumulator idiom from spec section
; 11.1: push chunks onto a backwards list, reverse exactly once at the end.
; Using append to build output would make the compiler quadratic in the size of
; its own output.
;
; A comment starting ;; documents the definition below it, and is what l0 doc
; shows; a definition without one is internal. ;;; describes the file.

;;; Lists and arrays of any type, Option, Result, Map, and lists of bytes:
;;; building output, comparing and sorting, decimal and hexadecimal numbers,
;;; slicing lines and words, word tables, and character classes. A string is a (list int) of byte values, so
;;; the byte helpers work on strings.

; ------------------------------------------------------------ lists, arrays

;; xs reversed, in front of acc, for a list of any type: (rev_onto "ab" "cd")
;; is "bacd".
(def (rev_onto T) ((xs (list T)) (acc (list T))) (list T)
  (if (is_empty xs)
      acc
      (rev_onto (tail xs) (cons (head xs) acc))))

;; xs reversed, for a list of any type.
(def (rev T) ((xs (list T))) (list T)
  (rev_onto xs (nil T)))

;; xs followed by ys, for lists of any type. It copies xs, so appending in a
;; loop is quadratic: build anything long with push and rev instead.
(def (append T) ((xs (list T)) (ys (list T))) (list T)
  (rev_onto (rev xs) ys))

;; The number of elements of xs, a list of any type.
(def (length T) ((xs (list T))) int
  (length_onto xs 0))

(def (length_onto T) ((xs (list T)) (n int)) int
  (if (is_empty xs) n (length_onto (tail xs) (add n 1))))

;; Whether x is one of xs, by eq, for a list of any type. With split_spaces it
;; tests a word against a table: (any_eq "if" (split_spaces "def if let")).
(def (any_eq T) ((x T) (xs (list T))) bool
  (if (is_empty xs)
      false
      (if (eq x (head xs)) true (any_eq x (tail xs)))))

;; The position of the first element of xs that is x, by eq, counting from 0,
;; or -1 if there is none, for a list of any type. With two word tables, maps
;; a name in one to the same position in the other.
(def (index_of T) ((x T) (xs (list T))) int
  (index_of_from x xs 0))

(def (index_of_from T) ((x T) (xs (list T)) (i int)) int
  (if (is_empty xs)
      -1
      (if (eq x (head xs)) i (index_of_from x (tail xs) (add i 1)))))

;; The lesser of a and b by compare, for values of any type, and a when they
;; are the same.
(def (min T) ((a T) (b T)) T
  (if (gt (compare a b) 0) b a))

;; The greater of a and b by compare, for values of any type, and a when they
;; are the same.
(def (max T) ((a T) (b T)) T
  (if (lt (compare a b) 0) b a))

;; xs in the order compare gives, ascending, for a list of any type: (sort
;; "cab") is "abc". It takes time proportional to n log n, and no stack
;; however long xs is. To sort by an order of your own, sort keys built for
;; it, such as (Rank (neg count) word) for count highest first and then word.
(def (sort T) ((xs (list T))) (list T)
  (sort_passes (sort_runs xs (nil (list T)))))

; Each element of xs as a run of one, in order.
(def (sort_runs T) ((xs (list T)) (acc (list (list T)))) (list (list T))
  (if (is_empty xs)
      (rev acc)
      (sort_runs (tail xs) (cons (cons (head xs) (nil T)) acc))))

; Merges neighbouring runs until one is left.
(def (sort_passes T) ((runs (list (list T)))) (list T)
  (if (is_empty runs)
      (nil T)
      (if (is_empty (tail runs))
          (head runs)
          (sort_passes (sort_pairs runs (nil (list T)))))))

; One pass: each pair of neighbouring runs merged into one, in order.
(def (sort_pairs T) ((runs (list (list T))) (acc (list (list T))))
    (list (list T))
  (if (is_empty runs)
      (rev acc)
      (if (is_empty (tail runs))
          (rev (cons (head runs) acc))
          (sort_pairs (tail (tail runs))
            (cons (sort_merge (head runs) (head (tail runs)) (nil T)) acc)))))

; a and b, each in order, merged; on a tie a's element goes first.
(def (sort_merge T) ((a (list T)) (b (list T)) (acc (list T))) (list T)
  (if (is_empty a)
      (rev_onto acc b)
      (if (is_empty b)
          (rev_onto acc a)
          (if (gt (compare (head a) (head b)) 0)
              (sort_merge a (tail b) (cons (head b) acc))
              (sort_merge (tail a) b (cons (head a) acc))))))

;; An array of n elements of any type: the first n of a, followed by copies
;; of fill if a has fewer. This is how an array grows, as in (array_resize a
;; (mul 2 (array_len a)) x); it costs n, and a negative n is a runtime error.
(def (array_resize T) ((a (array T)) (n int) (fill T)) (array T)
  (let m (array_len a)
    (array_copy_onto a (array_new n fill) 0 (if (lt m n) m n))))

; dst with elements i up to but not including n of src copied into it.
(def (array_copy_onto T) ((src (array T)) (dst (array T)) (i int) (n int))
    (array T)
  (if (ge i n)
      dst
      (array_copy_onto src (array_set dst i (array_get src i)) (add i 1) n)))

; ------------------------------------------------------------ option, result

;; A value that may be missing: (Some x), or (None). (Some x) takes its type
;; from x, but None says nothing of T, so it is written with its type as nil
;; is: ((None int)) is an (Option int).
(data (Option T)
  (None)
  (Some T))

;; The outcome of something that can fail: (Ok x), or (Err e) saying why.
;; Neither constructor determines both parameters, so both are written with
;; the type: ((Ok int (list int)) 5) and ((Err int (list int)) "bad") are
;; each a (Result int (list int)). A program that declares its own Ok or Err
;; uses its own, and cannot match on this type (spec section 7.1).
(data (Result T E)
  (Ok T)
  (Err E))

; ---------------------------------------------------------------------- maps
;
; An open-addressing table in two arrays, at most half full, probed
; linearly from the slot (mod (hash k) capacity). marks holds 0 for an empty
; slot and (add (hash k) 1), which is never 0, for a full one, so most keys
; are told apart without eq, and a key's slot is always worked out from its
; mark, by map_slot alone; slots holds (MapFree), or a key and its value.
; The empty map holds no arrays, and a map that loses its last key is
; ((MapEmpty K V)) again.
;
; The table is a function of its entries alone, since eq, hash, and compare
; see its fields (spec section 6.8). An empty slot keeps nothing of what was
; in it. The capacity is map_cap of the count, so a remove that takes the
; count below a size halves the table, as a put past it doubles it. And
; entries are placed by Robin Hood probing: an entry nearer its own slot
; gives way to one farther from its own, and of two as far, the one first
; by mark, and for one mark by compare on the key, takes the slot. That
; order is total, so each run of full slots holds its entries in that order
; whatever order they arrived in (Blelloch and Golovin, 2007). Removal
; shifts the entries after the removed one back a slot each, up to one in
; its own slot, which keeps it so; no slot is ever a tombstone.
;
; Every update matches the map at its last use, so its arrays have one
; holder and change in place (spec section 6.5).

;; A map from keys of type K to values of type V, written once for every
;; type: keys are compared with eq and placed by hash, so any value can be a
;; key. The empty map is ((MapEmpty K V)), written with its types as
;; ((None int)) is; add to it with map_put and read it with map_get. Two
;; maps holding the same keys, each mapped to the same value, are the same
;; value however they were built: eq, hash, and compare see only what a map
;; holds, so a map can be a key, be sorted, or be a field of a value
;; compared with eq. A map is changed in place unless something else still
;; holds it, in which case it is copied whole, as an array is (spec section
;; 6.5): keep one name for it.
(data (Map K V)
  (MapEmpty)
  (MapTable (array int) (array (MapSlot K V)) int))   ; marks, slots, count

; A slot of a table: empty, or a key and its value.
(data (MapSlot K V)
  (MapFree)
  (MapUsed K V))

;; m with k mapped to v, replacing any value k had. Amortized constant time:
;; a put that takes the count past 4, 8, 16, or any larger power of two
;; doubles the table, and a remove that takes it back halves it, each in
;; time proportional to the count, so a key put and removed over and over
;; at one of those counts takes that time every time.
(def (map_put K V) ((m (Map K V)) (k K) (v V)) (Map K V)
  (match m
    ((MapEmpty)
      (map_put (MapTable (array_new 8 0) (array_new 8 ((MapFree K V))) 0) k v))
    ((MapTable ms es n)
      (let mk (add (hash k) 1)
        (map_sized
          (map_place ms es n mk (MapUsed k v) (map_slot mk (array_len ms)) true))))))

;; The value k maps to in m, or (None) if it has none.
(def (map_get K V) ((m (Map K V)) (k K)) (Option V)
  (match m
    ((MapEmpty) ((None V)))
    ((MapTable ms es n)
      (let mk (add (hash k) 1)
        (map_probe_get ms es mk (map_slot mk (array_len ms)) k)))))

;; Whether k has a value in m.
(def (map_has K V) ((m (Map K V)) (k K)) bool
  (match (map_get m k)
    ((None) false)
    ((Some v) true)))

;; How many keys m maps to values.
(def (map_size K V) ((m (Map K V))) int
  (match m
    ((MapEmpty) 0)
    ((MapTable ms es n) n)))

;; m without k, or m as it was if k has no value. Amortized constant time,
;; as map_put says.
(def (map_remove K V) ((m (Map K V)) (k K)) (Map K V)
  (match m
    ((MapEmpty) m)
    ((MapTable ms es n)
      (let mk (add (hash k) 1)
        (map_find_remove ms es n mk (map_slot mk (array_len ms)) k)))))

;; Every key m has, each once. The order is the table's, which the keys
;; alone decide, by hash, so it is the same on every run and for every map
;; holding the same keys, but is not the order of insertion. If the order
;; matters, (sort (map_keys m)) gives them in compare's order, for keys of
;; any type, and map_pairs gives each with its value.
(def (map_keys K V) ((m (Map K V))) (list K)
  (match m
    ((MapEmpty) (nil K))
    ((MapTable ms es n) (map_keys_from es (sub (array_len es) 1) (nil K)))))

;; Every value m has, in the same order as map_keys gives their keys.
(def (map_values K V) ((m (Map K V))) (list V)
  (match m
    ((MapEmpty) (nil V))
    ((MapTable ms es n) (map_values_from es (sub (array_len es) 1) (nil V)))))

;; A key and the value a map gives it, as map_pairs lists them.
(data (MapPair K V)
  (MapPair K V))

;; Every key m has, each with its value, sorted by key in compare's order.
(def (map_pairs K V) ((m (Map K V))) (list (MapPair K V))
  (match m
    ((MapEmpty) (nil (MapPair K V)))
    ((MapTable ms es n)
      (sort (map_pairs_from es (sub (array_len es) 1) (nil (MapPair K V)))))))

;; Whether a and b hold the same keys, each mapped to the same value. That
;; is always (eq a b), since a map's table depends only on its entries;
;; map_eq looks each key of a up in b instead of comparing the tables.
(def (map_eq K V) ((a (Map K V)) (b (Map K V))) bool
  (if (eq (map_size a) (map_size b))
      (map_all_in (map_keys a) (map_values a) b)
      false))

(def (map_all_in K V) ((ks (list K)) (vs (list V)) (b (Map K V))) bool
  (if (is_empty ks)
      true
      (match (map_get b (head ks))
        ((None) false)
        ((Some w) (if (eq w (head vs)) (map_all_in (tail ks) (tail vs) b) false)))))

; The slot a key marked mk goes in, of cap.
(def map_slot ((mk int) (cap int)) int
  (mod (sub mk 1) cap))

; How far slot i is past the slot of a key marked mk, of cap, going round.
(def map_dist ((mk int) (i int) (cap int)) int
  (mod (add (sub i (map_slot mk cap)) cap) cap))

(def (map_next T) ((i int) (ms (array T))) int
  (mod (add i 1) (array_len ms)))

; The capacity of a table of n keys: the least of c, twice c, four times c,
; and so on, that is at least twice n.
(def map_cap ((n int) (c int)) int
  (if (lt c (mul 2 n)) (map_cap n (mul 2 c)) c))

; Robin Hood probing: e, an entry marked mk, goes in at slot i or after it.
; An entry e finds that is nearer its own slot than e is to e's, or as near
; and ordered after e by map_before, gives e its slot and goes on in e's
; place, so every entry ends where the entries alone decide. While same is
; true, e may be a new value for a key the table has, which it replaces;
; an entry that has given way is never one, since the key would have been
; met first. The next slot is worked out before the arrays are updated
; (spec section 6.5).
(def (map_place K V) ((ms (array int)) (es (array (MapSlot K V))) (n int)
                      (mk int) (e (MapSlot K V)) (i int) (same bool)) (Map K V)
  (let here (array_get ms i)
    (if (eq here 0)
        (MapTable (array_set ms i mk) (array_set es i e) (add n 1))
        (let r (array_get es i)
          (if (if same (if (eq here mk) (eq (map_order r e) 0) false) false)
              (MapTable ms (array_set es i e) n)
              (let j (map_next i ms)
                (if (map_takes mk e here r i (array_len ms))
                    (map_place (array_set ms i mk) (array_set es i e) n here r j false)
                    (map_place ms es n mk e j same))))))))

; Whether e, marked mk, takes slot i of cap from r, marked here: it does
; when it is farther from its own slot, or as far and before r.
(def (map_takes K V) ((mk int) (e (MapSlot K V)) (here int) (r (MapSlot K V))
                      (i int) (cap int)) bool
  (let de (map_dist mk i cap)
    (let dr (map_dist here i cap)
      (if (eq de dr) (map_before mk e here r) (gt de dr)))))

; Whether e, marked mk, comes before r, marked mr: by mark, and for one
; mark by compare on their keys.
(def (map_before K V) ((mk int) (e (MapSlot K V)) (mr int) (r (MapSlot K V))) bool
  (if (eq mk mr) (lt (map_order e r) 0) (lt mk mr)))

; compare on the keys of two full slots.
(def (map_order K V) ((a (MapSlot K V)) (b (MapSlot K V))) int
  (match a
    ((MapFree) 0)
    ((MapUsed ka va)
      (match b
        ((MapFree) 0)
        ((MapUsed kb vb) (compare ka kb))))))

; Whether the slot e holds the key k.
(def (map_key_is K V) ((e (MapSlot K V)) (k K)) bool
  (match e
    ((MapFree) false)
    ((MapUsed ke ve) (eq ke k))))

(def (map_probe_get K V) ((ms (array int)) (es (array (MapSlot K V))) (mk int)
                          (i int) (k K)) (Option V)
  (let here (array_get ms i)
    (if (eq here 0)
        ((None V))
        (if (eq here mk)
            (match (array_get es i)
              ((MapFree) ((None V)))
              ((MapUsed ke v)
                (if (eq ke k) (Some v) (map_probe_get ms es mk (map_next i ms) k))))
            (map_probe_get ms es mk (map_next i ms) k)))))

; m with map_cap of its count as its capacity, its entries moved to a table
; of that size if it has another.
(def (map_sized K V) ((m (Map K V))) (Map K V)
  (match m
    ((MapEmpty) m)
    ((MapTable ms es n)
      (let cap (map_cap n 8)
        (if (eq cap (array_len ms))
            (MapTable ms es n)
            (map_move_all ms es 0
              (MapTable (array_new cap 0) (array_new cap ((MapFree K V))) 0)))))))

(def (map_move_all K V) ((ms (array int)) (es (array (MapSlot K V))) (i int)
                         (into (Map K V))) (Map K V)
  (if (ge i (array_len ms))
      into
      (map_move_all ms es (add i 1)
        (let mk (array_get ms i)
          (if (eq mk 0) into (map_moved into mk (array_get es i)))))))

(def (map_moved K V) ((m (Map K V)) (mk int) (e (MapSlot K V))) (Map K V)
  (match m
    ((MapEmpty) m)
    ((MapTable ms es n) (map_place ms es n mk e (map_slot mk (array_len ms)) false))))

(def (map_find_remove K V) ((ms (array int)) (es (array (MapSlot K V))) (n int)
                            (mk int) (i int) (k K)) (Map K V)
  (let here (array_get ms i)
    (if (eq here 0)
        (MapTable ms es n)
        (if (if (eq here mk) (map_key_is (array_get es i) k) false)
            (if (eq n 1)
                ((MapEmpty K V))
                (map_sized (map_shift ms es (sub n 1) i (map_next i ms))))
            (map_find_remove ms es n mk (map_next i ms) k)))))

; Slot i is to be emptied: the entry at j moves back to i, and so on from
; j, up to an empty slot or an entry in its own slot, where the last slot
; moved from is emptied. The next slot is worked out before the arrays are
; updated, since reading one in a later operand would make the update copy
; it (spec section 6.5).
(def (map_shift K V) ((ms (array int)) (es (array (MapSlot K V))) (n int)
                      (i int) (j int)) (Map K V)
  (let mj (array_get ms j)
    (if (if (eq mj 0) true (eq (map_slot mj (array_len ms)) j))
        (MapTable (array_set ms i 0) (array_set es i ((MapFree K V))) n)
        (let nj (map_next j ms)
          (let ej (array_get es j)
            (map_shift (array_set ms i mj) (array_set es i ej) n j nj))))))

(def (map_keys_from K V) ((es (array (MapSlot K V))) (i int) (acc (list K))) (list K)
  (if (lt i 0)
      acc
      (map_keys_from es (sub i 1)
        (match (array_get es i)
          ((MapFree) acc)
          ((MapUsed k v) (cons k acc))))))

(def (map_values_from K V) ((es (array (MapSlot K V))) (i int) (acc (list V)))
    (list V)
  (if (lt i 0)
      acc
      (map_values_from es (sub i 1)
        (match (array_get es i)
          ((MapFree) acc)
          ((MapUsed k v) (cons v acc))))))

(def (map_pairs_from K V) ((es (array (MapSlot K V))) (i int)
                           (acc (list (MapPair K V)))) (list (MapPair K V))
  (if (lt i 0)
      acc
      (map_pairs_from es (sub i 1)
        (match (array_get es i)
          ((MapFree) acc)
          ((MapUsed k v) (cons (MapPair k v) acc))))))

; ------------------------------------------------------------ byte strings

;; Pushes chunk onto a reversed accumulator: acc with chunk's bytes in front,
;; last byte first. Costs the length of the chunk, never of the accumulator.
;; Build output by pushing each piece and calling rev once at the end; see
;; spec section 11.1.
(def push ((chunk (list int)) (acc (list int))) (list int)
  (if (is_empty chunk)
      acc
      (push (tail chunk) (cons (head chunk) acc))))

;; Whether xs and ys hold the same bytes in the same order, as (eq xs ys)
;; says. It is from before eq compared lists, and stays for the programs that
;; call it; new code can write eq.
(def list_eq ((xs (list int)) (ys (list int))) bool
  (if (is_empty xs)
      (is_empty ys)
      (if (is_empty ys)
          false
          (if (eq (head xs) (head ys))
              (list_eq (tail xs) (tail ys))
              false))))

(def int_min ((ignored int)) int -9223372036854775808)

; n is known non-negative here.
(def digits_onto ((n int) (acc (list int))) (list int)
  (if (lt n 10)
      (cons (add 48 n) acc)
      (digits_onto (div n 10) (cons (add 48 (mod n 10)) acc))))

;; n in decimal, with a leading - if negative: (digits -42) is "-42". The way
;; to print a number; hex_digits prints one in hexadecimal.
(def digits ((n int)) (list int)
  (if (eq n (int_min 0))
      "-9223372036854775808"
      (if (lt n 0)
          (cons 45 (digits_onto (neg n) (nil int)))
          (digits_onto n (nil int)))))

;; n in lowercase hexadecimal, padded with zeros to at least width digits:
;; (hex_digits 255 4) is "00ff", and (hex_digits 0 0) is "0". The 64 bits of
;; n are read as unsigned, so (hex_digits -1 0) is "ffffffffffffffff". The
;; inverse of a digit is hex_val.
(def hex_digits ((n int) (width int)) (list int)
  (hex_onto n width (nil int)))

(def hex_onto ((n int) (width int) (acc (list int))) (list int)
  (let d (bit_and n 15)
    (let rest (bit_shr n 4)
      (let more (cons (if (lt d 10) (add 48 d) (add 87 d)) acc)
        (if (and (eq rest 0) (le width 1))
            more
            (hex_onto rest (sub width 1) more))))))

; ------------------------------------------------------------------ slicing

;; xs without its first n elements, or empty if it has fewer.
(def drop_n ((xs (list int)) (n int)) (list int)
  (if (le n 0)
      xs
      (if (is_empty xs) xs (drop_n (tail xs) (sub n 1)))))

;; Whether s begins with prefix. Every string starts with "".
(def starts_with ((s (list int)) (prefix (list int))) bool
  (if (is_empty prefix)
      true
      (if (is_empty s)
          false
          (if (eq (head s) (head prefix))
              (starts_with (tail s) (tail prefix))
              false))))

(def take_line_onto ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s)
      (rev acc)
      (if (eq (head s) 10)
          (rev acc)
          (take_line_onto (tail s) (cons (head s) acc)))))

;; s up to but not including its first newline, or all of s if it has none.
;; Strips the newline read_line keeps.
(def take_line ((s (list int))) (list int)
  (take_line_onto s (nil int)))

;; Everything after the first newline of s, or empty if it has none.
(def drop_line ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (eq (head s) 10)
          (tail s)
          (drop_line (tail s)))))

;; s without its leading decimal digits.
(def skip_digits ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (is_digit (head s)) (skip_digits (tail s)) s)))

;; s without its leading spaces, byte 32 only, not tabs or newlines.
(def skip_spaces ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (eq (head s) 32) (skip_spaces (tail s)) s)))

;; The number s starts with, in decimal, added to acc times ten per digit, so
;; (int_prefix "42x" 0) is 42 and (int_prefix "x" 0) is 0. There is no sign:
;; "-5" gives 0. Pass 0 for acc.
(def int_prefix ((s (list int)) (acc int)) int
  (if (is_empty s)
      acc
      (if (is_digit (head s))
          (int_prefix (tail s) (add (mul acc 10) (sub (head s) 48)))
          acc)))

; ------------------------------------------------------------ word tables
;
; Membership tests against a fixed set of names are common in a compiler.
; Written as a chain of or, they nest ten deep and are a reliable source of
; miscounted parentheses. Splitting one space-separated literal keeps the
; table flat and readable, and any_eq and index_of, above, look a name up in
; it.

(def split_spaces_onto ((s (list int)) (cur (list int))
                        (acc (list (list int)))) (list (list int))
  (if (is_empty s)
      (if (is_empty cur) acc (cons (rev cur) acc))
      (if (eq (head s) 32)
          (split_spaces_onto (tail s) (nil int)
            (if (is_empty cur) acc (cons (rev cur) acc)))
          (split_spaces_onto (tail s) (cons (head s) cur) acc))))

;; The words of s, split at spaces, in order. Runs of spaces count as one, so
;; no word is empty. Makes a word table from one literal:
;; (split_spaces "def data if").
(def split_spaces ((s (list int))) (list (list int))
  (rev (split_spaces_onto s (nil int) (nil (list int)))))

; ---------------------------------------------------------------- character
; classes, by byte value

;; Whether c is a space, tab, newline, or carriage return.
(def is_space ((c int)) bool
  (or (eq c 32)
      (or (eq c 9)
          (or (eq c 10) (eq c 13)))))

;; Whether c is one of the digits 0 to 9.
(def is_digit ((c int)) bool
  (and (ge c 48) (le c 57)))

;; Whether c is a lowercase letter a to z, or _: what may start a lowercase
;; L0 name.
(def is_lower ((c int)) bool
  (or (and (ge c 97) (le c 122)) (eq c 95)))

;; Whether c is an uppercase letter A to Z.
(def is_upper ((c int)) bool
  (and (ge c 65) (le c 90)))

(def is_name_start ((c int)) bool
  (or (is_lower c) (is_upper c)))

(def is_name_rest ((c int)) bool
  (or (is_name_start c) (is_digit c)))

;; The value of c as a hexadecimal digit, 0 to 15, in either case, or -1 if it
;; is not one.
(def hex_val ((c int)) int
  (if (is_digit c)
      (sub c 48)
      (if (and (ge c 97) (le c 102))
          (add 10 (sub c 97))
          (if (and (ge c 65) (le c 70))
              (add 10 (sub c 65))
              -1))))

;; The sine of x, x in radians, within 1 ulp for |x| below 1647099, which is
;; 2^20 times pi/2, and the one NaN past it, for an infinity, and for a NaN.
;; (float_sin -0.0) is -0.0. Written as fdlibm does it (musl's sin.c): x is
;; reduced by a multiple of pi/2 held in three parts, then a polynomial on
;; [-pi/4, pi/4] gives the sine or the cosine of what is left, by the
;; quadrant. Past 2^20 times pi/2 three parts of pi/2 are not enough, and a
;; reduction of any argument would need pi's bits to the exponent's size, as
;; fdlibm's Payne-Hanek does; add it when a program passes one.
(def float_sin ((x float)) float
  (let ax (float_abs_of x)
    (if (float_lt ax 0.00000001)
        x
        (if (float_lt ax 0.7853981633974483)
            (float_sin_kernel x 0.0)
            (if (float_lt ax 1647099.0)
                (match (float_reduce x)
                  ((FloatReduced n y0 y1) (float_sin_quadrant (bit_and n 3) y0 y1)))
                (float_div 0.0 0.0))))))

;; The cosine of x, x in radians, within 1 ulp for |x| below 1647099 and the
;; one NaN past it, for an infinity, and for a NaN; see float_sin.
(def float_cos ((x float)) float
  (let ax (float_abs_of x)
    (if (float_lt ax 0.7853981633974483)
        (float_cos_kernel x 0.0)
        (if (float_lt ax 1647099.0)
            (match (float_reduce x)
              ((FloatReduced n y0 y1) (float_cos_quadrant (bit_and n 3) y0 y1)))
            (float_div 0.0 0.0)))))

; x after a reduction by n times pi/2: n, and the rest as a sum y0 + y1.
(data FloatReduced
  (FloatReduced int float float))

(def float_abs_of ((x float)) float
  (if (float_lt x 0.0) (float_neg x) x))

(def float_sin_quadrant ((q int) (y0 float) (y1 float)) float
  (if (eq q 0)
      (float_sin_kernel y0 y1)
      (if (eq q 1)
          (float_cos_kernel y0 y1)
          (if (eq q 2)
              (float_neg (float_sin_kernel y0 y1))
              (float_neg (float_cos_kernel y0 y1))))))

(def float_cos_quadrant ((q int) (y0 float) (y1 float)) float
  (if (eq q 0)
      (float_cos_kernel y0 y1)
      (if (eq q 1)
          (float_neg (float_sin_kernel y0 y1))
          (if (eq q 2)
              (float_neg (float_cos_kernel y0 y1))
              (float_sin_kernel y0 y1)))))

; The biased exponent of x's IEEE bits, as fdlibm compares them.
(def float_exponent ((x float)) int
  (bit_and (bit_shr (float_bits x) 52) 2047))

; The sine of x + y, for x in [-pi/4, pi/4] and y the tail of x, from fdlibm's
; __sin. The polynomial's coefficients S1 to S6 are written as the bits of
; fdlibm's doubles, whose decimal is past a literal's 22 digits.
(def float_sin_kernel ((x float) (y float)) float
  (let z (float_mul x x)
    (let w (float_mul z z)
      (let r (float_add
               (float_add (float_from_bits 4575957461383575718)            ; S2
                 (float_mul z (float_add (float_from_bits -4671919876304969259)   ; S3
                                         (float_mul z (float_from_bits 4523617212983017085)))))   ; S4
               (float_mul (float_mul z w)
                 (float_add (float_from_bits -4730215680275931925)         ; S5
                            (float_mul z (float_from_bits 4460209850635244924)))))   ; S6
        (let v (float_mul z x)
          (let s1 (float_from_bits -4628199217061079735)                   ; S1
            (if (eq y 0.0)
                (float_add x (float_mul v (float_add s1 (float_mul z r))))
                (float_sub x
                  (float_sub
                    (float_sub (float_mul z (float_sub (float_mul 0.5 y) (float_mul v r))) y)
                    (float_mul v s1))))))))))

; The cosine of x + y, from fdlibm's __cos, C1 to C6 as bits.
(def float_cos_kernel ((x float) (y float)) float
  (let z (float_mul x x)
    (let w (float_mul z z)
      (let r (float_add
               (float_mul z
                 (float_add (float_from_bits 4586165620538955084)          ; C1
                   (float_mul z
                     (float_add (float_from_bits -4659324094485802633)     ; C2
                                (float_mul z (float_from_bits 4537941361668330896))))))   ; C3
               (float_mul (float_mul w w)
                 (float_add (float_from_bits -4714566979978243411)         ; C4
                   (float_mul z
                     (float_add (float_from_bits 4477121870137962948)      ; C5
                                (float_mul z (float_from_bits -4780295122622859052)))))))   ; C6
        (let hz (float_mul 0.5 z)
          (let w1 (float_sub 1.0 hz)
            (float_add w1
              (float_add (float_sub (float_sub 1.0 w1) hz)
                         (float_sub (float_mul z r) (float_mul x y))))))))))

; x, with |x| from pi/4 to 2^20 times pi/2, reduced by the multiple n of
; pi/2 nearest it. pi/2 is held as pio2_1 (33 bits) with pio2_1t its tail, and
; when the cancellation leaves too few bits, as pio2_2 and pio2_2t, and then
; pio2_3 and pio2_3t, the steps of fdlibm's __rem_pio2.
(def float_reduce ((x float)) FloatReduced
  (let n (float_to_int (float_add (float_mul x (float_from_bits 4603909380684499075))   ; 2/pi
                                  (if (float_lt x 0.0) -0.5 0.5)))
    (let fn (float_from_int n)
      (let r (float_sub x (float_mul fn (float_from_bits 4609753056924401664)))   ; pio2_1
        (let w (float_mul fn (float_from_bits 4454258360616903473))               ; pio2_1t
          (float_reduce_2 n (float_exponent x) fn r w (float_sub r w)))))))

(def float_reduce_2 ((n int) (ex int) (fn float) (r float) (w float) (y0 float))
    FloatReduced
  (if (gt (sub ex (float_exponent y0)) 16)
      (let w2 (float_mul fn (float_from_bits 4454258360616747008))                 ; pio2_2
        (let r2 (float_sub r w2)
          (let w3 (float_sub (float_mul fn (float_from_bits 4297306550709743731))  ; pio2_2t
                             (float_sub (float_sub r r2) w2))
            (float_reduce_3 n ex fn r2 w3 (float_sub r2 w3)))))
      (float_reduced n r w y0)))

(def float_reduce_3 ((n int) (ex int) (fn float) (r float) (w float) (y0 float))
    FloatReduced
  (if (gt (sub ex (float_exponent y0)) 49)
      (let w2 (float_mul fn (float_from_bits 4297306550709518336))                 ; pio2_3
        (let r2 (float_sub r w2)
          (let w3 (float_sub (float_mul fn (float_from_bits 4142048980368378305))  ; pio2_3t
                             (float_sub (float_sub r r2) w2))
            (float_reduced n r2 w3 (float_sub r2 w3)))))
      (float_reduced n r w y0)))

(def float_reduced ((n int) (r float) (w float) (y0 float)) FloatReduced
  (FloatReduced n y0 (float_sub (float_sub r y0) w)))

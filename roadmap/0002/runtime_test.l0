; runtime_test.l0 -- checks the expressible parts of runtime.l0 against what
; runtime/l0core.c does. One character per assertion, y or n.
;
; Run with:
;   build/l0i run lib/prelude.l0 programs/runtime/runtime.l0 \
;     programs/runtime/runtime_test.l0 < /dev/null

(def yn ((ok bool) (rest (list int))) (list int)
  (cons (if ok 121 110) rest))

(def layout_tests ((rest (list int))) (list int)
  (yn (eq (cons_cell_bytes) 16)
  (yn (eq (cons_tail_offset) 8)
  (yn (eq (data_block_bytes 0) 8)
  (yn (eq (data_block_bytes 2) 24)
  (yn (eq (data_field_offset 0) 8)
  (yn (eq (data_field_offset 1) 16)
  rest)))))))

(def error_tests ((rest (list int))) (list int)
  (yn (list_eq (runtime_error_line "head of empty list")
               "l0: runtime error: head of empty list\n")
  (yn (list_eq (runtime_error_line (msg_heap_exhausted))
               "l0: runtime error: heap exhausted\n")
  (yn (is_empty_word 0)
  (yn (not (is_empty_word 4096))
  (yn (is_zero_divisor 0)
  (yn (not (is_zero_divisor -1))
  (yn (is_overflowing_division (int_min_word) -1)
  (yn (not (is_overflowing_division (int_min_word) 1))
  (yn (not (is_overflowing_division 7 -1))
  (yn (eq (div_overflow_result) (div (int_min_word) -1))
  (yn (eq (mod_overflow_result) (mod (int_min_word) -1))
  rest))))))))))))

(def arena_tests ((rest (list int))) (list int)
  (yn (eq (align16 0) 0)
  (yn (eq (align16 1) 16)
  (yn (eq (align16 16) 16)
  (yn (eq (align16 17) 32)
  (yn (eq (align16 24) 32)
  (yn (not (arena_fits 0 0 16))
  (yn (arena_fits 4096 67112960 32)
  (yn (not (arena_fits 67112944 67112960 32))
  (yn (arena_fits 67112944 67112960 16)
  (yn (eq (arena_grow_bytes 16) 67108864)
  (yn (eq (arena_grow_bytes (align16 100000001)) 100000016)
  rest))))))))))))

(def write_tests ((rest (list int))) (list int)
  (yn (eq (byte_of -1) 255)
  (yn (eq (byte_of 256) 0)
  (yn (eq (byte_of -255) 1)
  (yn (eq (byte_of (int_min_word)) 0)
  (yn (list_eq (render_list (cons -1 (cons 321 "A"))) "\xffAA")
  (yn (list_eq (render_int 0) "0\n")
  (yn (list_eq (render_int -42) "-42\n")
  (yn (list_eq (render_int (int_min_word)) "-9223372036854775808\n")
  (yn (list_eq (render_int (int_max_word)) "9223372036854775807\n")
  (yn (list_eq (render_bool true) "true\n")
  (yn (list_eq (render_bool false) "false\n")
  rest))))))))))))

(def stack_tests ((rest (list int))) (list int)
  (yn (eq (stack_mb_from_text "") 512)
  (yn (eq (stack_mb_from_text "1024") 1024)
  (yn (eq (stack_mb_from_text "  64") 64)
  (yn (eq (stack_mb_from_text "\t\x0b7") 7)
  (yn (eq (stack_mb_from_text "+8") 8)
  (yn (eq (stack_mb_from_text "-8") 512)
  (yn (eq (stack_mb_from_text "0") 512)
  (yn (eq (stack_mb_from_text "abc") 512)
  (yn (eq (stack_mb_from_text "12abc") 12)
  (yn (eq (stack_mb_from_text "99999999999999999999") (int_max_word))
  (yn (eq (stack_bytes 512) 536870912)
  (yn (list_eq (stack_exhausted_line) "l0: runtime error: stack exhausted\n")
  rest)))))))))))))

(def main ((input (list int))) (list int)
  (layout_tests (error_tests (arena_tests (write_tests (stack_tests "\n"))))))

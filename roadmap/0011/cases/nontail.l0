; Baseline: recursion NOT in tail position. No implementation can make this
; constant-stack; it shows the per-frame cost that sets the depth limit.
(def count ((n int)) int
  (if (eq n 0) 0 (add 1 (count (sub n 1)))))

(def main () int
  (let r (write_line (digits (count (int_prefix (arg 0) 0))))
    0))

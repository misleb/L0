; json_test.l0 -- tests of json.l0.
;
;   tools/l0 test programs/json/json.l0 programs/json/json_test.l0
;
; Run from the repository root, since the golden file paths are relative.

; The pretty-printed text, or the error as main reports it.
(def pretty ((s (list int))) (list int)
  (match (parse_json s)
    ((PJErr at msg) (error_text s at msg))
    ((PJOk v rest) (render v))))

; ------------------------------------------------------------------ scalars

(def test_literals () int
  (add (check_str "true" (pretty "true") "true\n")
       (add (check_str "false" (pretty " false ") "false\n")
            (check_str "null" (pretty "\n\tnull\r\n") "null\n"))))

(def test_integers () int
  (add (check_str "zero" (pretty "0") "0\n")
       (add (check_str "minus zero" (pretty "-0") "0\n")
            (check_str "negative" (pretty "-120") "-120\n"))))

(def test_int_limits () int
  (add (check_str "max" (pretty "9223372036854775807") "9223372036854775807\n")
       (check_str "min" (pretty "-9223372036854775808")
                  "-9223372036854775808\n")))

(def test_int_overflow () int
  (add (check_str "max + 1" (pretty "9223372036854775808")
                  "1:1: error: number does not fit in 64 bits\n")
       (check_str "min - 1" (pretty "[-9223372036854775809]")
                  "1:2: error: number does not fit in 64 bits\n")))

(def test_fraction_rejected () int
  (add (check_str "fraction" (pretty "1.5")
                  "1:2: error: only integers are supported\n")
       (check_str "exponent" (pretty "1e3")
                  "1:2: error: only integers are supported\n")))

(def test_leading_zero () int
  (check_str "01" (pretty "01") "1:1: error: leading zeros are not allowed\n"))

(def test_bare_minus () int
  (check_str "-x" (pretty "-x") "1:2: error: expected a digit after -\n"))

; ------------------------------------------------------------------ strings

(def test_simple_escapes () int
  (check_str "escapes" (pretty "\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"")
             "\"\\\"\\\\/\\b\\f\\n\\r\\t\"\n"))

(def test_control_escape_out () int
  (check_str "u0001" (pretty "\"a\\u0001b\"") "\"a\\u0001b\"\n"))

(def test_unicode_two_byte () int
  (check_str "e acute" (pretty "\"\\u00e9\"") "\"\xc3\xa9\"\n"))

(def test_unicode_three_byte () int
  (check_str "euro" (pretty "\"\\u20AC\"") "\"\xe2\x82\xac\"\n"))

(def test_unicode_surrogate_pair () int
  (check_str "grinning face" (pretty "\"\\ud83d\\ude00\"")
             "\"\xf0\x9f\x98\x80\"\n"))

(def test_lone_surrogates () int
  (add (check_str "high" (pretty "\"\\ud800\"")
         "1:8: error: high surrogate is not followed by a low surrogate\n")
       (check_str "low" (pretty "\"\\udc00\"")
         "1:4: error: \\u escape is a lone low surrogate\n")))

(def test_bad_escape () int
  (add (check_str "\\q" (pretty "\"\\q\"") "1:3: error: invalid escape \\q\n")
       (check_str "short \\u" (pretty "\"\\u12\"")
         "1:4: error: \\u must be followed by four hex digits\n")))

(def test_raw_control_char () int
  (check_str "tab" (pretty "\"a\tb\"")
             "1:3: error: control character in string; use an escape\n"))

(def test_unterminated_string () int
  (check_str "eof" (pretty "[\"abc") "1:6: error: unterminated string\n"))

; ------------------------------------------------------------- containers

(def test_empty_containers () int
  (add (check_str "array" (pretty "[ ]") "[]\n")
       (check_str "object" (pretty "{\n}") "{}\n")))

(def test_nested () int
  (check_str "nested" (pretty "{\"a\":[1,{\"b\":null}],\"c\":{}}")
    "{\n  \"a\": [\n    1,\n    {\n      \"b\": null\n    }\n  ],\n  \"c\": {}\n}\n"))

(def test_member_order_kept () int
  (check_str "order" (pretty "{\"z\":1,\"a\":2,\"z\":3}")
    "{\n  \"z\": 1,\n  \"a\": 2,\n  \"z\": 3\n}\n"))

(def test_array_errors () int
  (add (check_str "double comma" (pretty "[1,\n  2,, 3]")
         "2:5: error: expected a value, found ','\n")
       (add (check_str "trailing comma" (pretty "[1,]")
              "1:4: error: expected a value, found ']'\n")
            (check_str "missing comma" (pretty "[1 2]")
              "1:4: error: expected , or ] in array, found '2'\n"))))

(def test_object_errors () int
  (add (check_str "bare key" (pretty "{a:1}")
         "1:2: error: expected a string key in object\n")
       (add (check_str "no colon" (pretty "{\"a\" 1}")
              "1:6: error: expected : after object key\n")
            (check_str "unclosed" (pretty "{\"a\":1")
              "1:7: error: expected , or } in object, found end of input\n"))))

(def test_trailing_text () int
  (add (check_str "second value" (pretty "[1] 2")
         "1:5: error: unexpected '2' after the value\n")
       (check_str "empty" (pretty "  ")
         "1:3: error: expected a value, found end of input\n")))

(def test_bad_word () int
  (add (check_str "tru" (pretty "tru") "1:1: error: expected a value, found 't'\n")
       (check_str "nonprintable" (pretty "\x01")
         "1:1: error: expected a value, found byte 1\n")))

; 100000 levels of nesting parse without exhausting the stack.
(def test_deep_nesting_parses () int
  (let s (brackets 100000 (brackets_close 100000 (nil int)))
    (match (parse_json s)
      ((PJErr at msg) (check_str "should parse" msg ""))
      ((PJOk v rest) (check_true "parsed" (is_empty rest))))))

; Indented output of d nested arrays is quadratic in d, so print fewer. Level
; i of d holding one array is "[\n", 2(i+1) spaces, the child, "\n", 2i
; spaces, "]"; the innermost is "[]"; render adds a newline.
(def test_deep_nesting_prints () int
  (let d 500
    (match (parse_json (brackets d (brackets_close d (nil int))))
      ((PJErr at msg) (check_str "should parse" msg ""))
      ((PJOk v rest)
        (check_int "rendered length" (length (render v))
          (add 3 (add (mul 2 (mul (sub d 1) (sub d 2)))
                      (mul 6 (sub d 1)))))))))

(def brackets ((n int) (acc (list int))) (list int)
  (if (eq n 0) acc (brackets (sub n 1) (cons 91 acc))))

(def brackets_close ((n int) (acc (list int))) (list int)
  (if (eq n 0) acc (brackets_close (sub n 1) (cons 93 acc))))

; ------------------------------------------------------------- golden file

(def test_sample_file () int
  (match (open_in "programs/json/testdata/sample.json")
    ((IoFailed why) (check_str "open sample.json" why ""))
    ((IoOpened f)
      (let s (read_all f (nil int))
        (let c (file_close f)
          (check_file "sample" (pretty s)
                      "programs/json/testdata/sample.expected"))))))

; ---------------------------------------------------------------- property
;
; Printing any value and parsing the result gives back text that prints the
; same, so the printer only ever writes JSON the parser accepts, and the
; parser loses nothing the printer wrote.

(data Gen
  (Gen Json int))

(data GenList
  (GenList (list Json) int))

(data GenMembers
  (GenMembers (list Member) int))

(data GenStr
  (GenStr (list int) int))

(def gen_json ((s int) (depth int)) Gen
  (let s1 (rand_next s)
    (let k (rand_below s1 (if (le depth 0) 4 6))
      (if (eq k 0)
          (Gen (JNull) s1)
          (if (eq k 1)
              (Gen (JBool (eq (rand_below (rand_next s1) 2) 0)) (rand_next s1))
              (if (eq k 2)
                  (Gen (JNum (rand_next s1)) (rand_next s1))
                  (gen_compound k s1 depth)))))))

(def gen_compound ((k int) (s int) (depth int)) Gen
  (if (eq k 3)
      (match (gen_str s)
        ((GenStr bytes s2) (Gen (JStr bytes) s2)))
      (if (eq k 4)
          (match (gen_items (rand_next s) (rand_below s 4) (sub depth 1)
                            (nil Json))
            ((GenList xs s2) (Gen (JArr xs) s2)))
          (match (gen_members (rand_next s) (rand_below s 4) (sub depth 1)
                              (nil Member))
            ((GenMembers ms s2) (Gen (JObj ms) s2))))))

(def gen_items ((s int) (n int) (depth int) (acc (list Json))) GenList
  (if (eq n 0)
      (GenList acc s)
      (match (gen_json s depth)
        ((Gen v s2) (gen_items s2 (sub n 1) depth (cons v acc))))))

(def gen_members ((s int) (n int) (depth int) (acc (list Member))) GenMembers
  (if (eq n 0)
      (GenMembers acc s)
      (match (gen_str s)
        ((GenStr key s2)
          (match (gen_json s2 depth)
            ((Gen v s3)
              (gen_members s3 (sub n 1) depth (cons (Member key v) acc))))))))

(def gen_str ((s int)) GenStr
  (let s1 (rand_next s)
    (GenStr (rand_bytes s1 (rand_below s1 8)) (rand_next s1))))

(def round_trips ((s int) (runs int)) int
  (if (eq runs 0)
      0
      (match (gen_json s 4)
        ((Gen v s2)
          (let text (render v)
            (if (list_eq (pretty text) text)
                (round_trips s2 (sub runs 1))
                (check_str "reprinted" (pretty text) text)))))))

(def test_round_trip () int
  (round_trips 7 300))

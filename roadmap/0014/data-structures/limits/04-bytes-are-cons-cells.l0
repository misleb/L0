; LIMIT 04: the only way to hold bytes is (list int), one cons cell per byte.
;
; Costly in programs/json, which has to hold its whole input to report an
; error's line and column and to parse at all without lookahead state, and
; holds its whole output to build it with push and rev. A cons cell is a
; header and two words, 24 bytes, so text in memory costs 24 times its size
; before the allocator's own overhead.
;
; This program holds standard input as a list and writes how long it is:
;
;   tools/l0 build programs/limits/04-bytes-are-cons-cells.l0 -o hold
;   /usr/bin/time -l ./hold < input
;
; Measured maximum resident set size (Apple Silicon):
;   1 MB of input      26 MB    26x
;   10 MB of input    242 MB    24x
;   100 MB of input  2.4 GB     24x
; A streaming count of the same input, which holds nothing, stays at 1.5 MB.
; programs/json on an 11.5 MB document peaks at 873 MB, 76 times its input:
; the input list, the parsed tree, and the 17 MB output list, all at once.

; The prelude's length is not tail recursive, and counting 10 MB with it
; adds 10 million stack frames to what is measured, so count here instead.
(def main () int
  (let bytes (read_stdin (nil int))
    (let w (write_line (digits (count bytes 0)))
      0)))

(def count ((xs (list int)) (n int)) int
  (if (is_empty xs) n (count (tail xs) (add n 1))))

(def read_stdin ((acc (list int))) (list int)
  (let b (read_byte)
    (if (lt b 0) (rev acc) (read_stdin (cons b acc)))))

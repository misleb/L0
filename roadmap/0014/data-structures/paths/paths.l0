; paths.l0 -- a weighted directed graph and Dijkstra's shortest paths.
;
; L0 has no arrays and no hash tables, so everything indexed is a persistent
; binary trie keyed by a non-negative int: key 0 is the node itself, and any
; other key k goes to child k mod 2 with key k div 2. A key's path is its
; binary digits, least significant first, so a lookup or update costs about
; log2(k) steps and needs no balancing. Node ids are dense, from 0.
;
; L0 data types take no type parameters, so the trie is written three times,
; once per value type: IntMap for distances, EdgeMap for adjacency lists, and
; NameMap for the name table, which is keyed by a hash of the name.

; ------------------------------------------------------------- int -> int

(data IntMap
  (IEmpty)
  (INode bool int IntMap IntMap))       ; has a value, the value, even, odd

(def im_get ((m IntMap) (k int) (missing int)) int
  (match m
    ((IEmpty) missing)
    ((INode has v e o)
      (if (eq k 0)
          (if has v missing)
          (if (eq (mod k 2) 0)
              (im_get e (div k 2) missing)
              (im_get o (div k 2) missing))))))

(def im_set ((m IntMap) (k int) (x int)) IntMap
  (match m
    ((IEmpty) (im_set (INode false 0 (IEmpty) (IEmpty)) k x))
    ((INode has v e o)
      (if (eq k 0)
          (INode true x e o)
          (if (eq (mod k 2) 0)
              (INode has v (im_set e (div k 2) x) o)
              (INode has v e (im_set o (div k 2) x)))))))

; ------------------------------------------------------ int -> (list Edge)

(data Edge
  (Edge int int))                       ; to, weight

(data EdgeMap
  (EEmpty)
  (ENode (list Edge) EdgeMap EdgeMap))

(def em_get ((m EdgeMap) (k int)) (list Edge)
  (match m
    ((EEmpty) (nil Edge))
    ((ENode v e o)
      (if (eq k 0)
          v
          (if (eq (mod k 2) 0)
              (em_get e (div k 2))
              (em_get o (div k 2)))))))

(def em_add ((m EdgeMap) (k int) (x Edge)) EdgeMap
  (match m
    ((EEmpty) (em_add (ENode (nil Edge) (EEmpty) (EEmpty)) k x))
    ((ENode v e o)
      (if (eq k 0)
          (ENode (cons x v) e o)
          (if (eq (mod k 2) 0)
              (ENode v (em_add e (div k 2) x) o)
              (ENode v e (em_add o (div k 2) x)))))))

; -------------------------------------------------------- name -> node id

(data Named
  (Named (list int) int))

(data NameMap
  (NEmpty)
  (NNode (list Named) NameMap NameMap))

(def name_hash ((s (list int)) (h int)) int
  (if (is_empty s)
      (mod h 1048573)
      (name_hash (tail s) (mod (add (mul h 31) (head s)) 1000000007))))

(def nm_get ((m NameMap) (k int) (name (list int))) int
  (match m
    ((NEmpty) -1)
    ((NNode bucket e o)
      (if (eq k 0)
          (bucket_find bucket name)
          (if (eq (mod k 2) 0)
              (nm_get e (div k 2) name)
              (nm_get o (div k 2) name))))))

(def bucket_find ((b (list Named)) (name (list int))) int
  (if (is_empty b)
      -1
      (match (head b)
        ((Named n id) (if (list_eq n name) id (bucket_find (tail b) name))))))

(def nm_add ((m NameMap) (k int) (x Named)) NameMap
  (match m
    ((NEmpty) (nm_add (NNode (nil Named) (NEmpty) (NEmpty)) k x))
    ((NNode bucket e o)
      (if (eq k 0)
          (NNode (cons x bucket) e o)
          (if (eq (mod k 2) 0)
              (NNode bucket (nm_add e (div k 2) x) o)
              (NNode bucket e (nm_add o (div k 2) x)))))))

; ------------------------------------------------------------------- graph

(data Graph
  (Graph NameMap int EdgeMap))          ; names, how many nodes, out-edges

(def empty_graph ((ignored int)) Graph
  (Graph (NEmpty) 0 (EEmpty)))

(def node_id ((g Graph) (name (list int))) int
  (match g
    ((Graph names n edges) (nm_get names (name_hash name 0) name))))

; A graph that has name, and its id there.
(data Interned
  (Interned Graph int))

(def intern ((g Graph) (name (list int))) Interned
  (let id (node_id g name)
    (if (ge id 0)
        (Interned g id)
        (match g
          ((Graph names n edges)
            (Interned (Graph (nm_add names (name_hash name 0) (Named name n))
                             (add n 1) edges)
                      n))))))

(def add_edge ((g Graph) (from (list int)) (to (list int)) (w int)) Graph
  (match (intern g from)
    ((Interned g1 a)
      (match (intern g1 to)
        ((Interned g2 b)
          (match g2
            ((Graph names n edges)
              (Graph names n (em_add edges a (Edge b w))))))))))

; -------------------------------------------------------------- the heap
;
; A leftist heap of (distance, node). Dijkstra pushes a node again whenever
; its distance improves and skips the stale entries as they surface, since a
; persistent heap has no decrease-key.

(data Heap
  (HEmpty)
  (HNode int int int Heap Heap))        ; rank, distance, node, left, right

(def rank ((h Heap)) int
  (match h
    ((HEmpty) 0)
    ((HNode r d u l x) r)))

(def make_node ((d int) (u int) (a Heap) (b Heap)) Heap
  (if (ge (rank a) (rank b))
      (HNode (add (rank b) 1) d u a b)
      (HNode (add (rank a) 1) d u b a)))

(def merge ((a Heap) (b Heap)) Heap
  (match a
    ((HEmpty) b)
    ((HNode ra da ua la xa)
      (match b
        ((HEmpty) a)
        ((HNode rb db ub lb xb)
          (if (le da db)
              (make_node da ua la (merge xa b))
              (make_node db ub lb (merge a xb))))))))

(def push_heap ((h Heap) (d int) (u int)) Heap
  (merge h (HNode 1 d u (HEmpty) (HEmpty))))

; -------------------------------------------------------------- Dijkstra

(def infinity ((ignored int)) int 9223372036854775807)

; The shortest distance from one name to another, or -1 if there is no path.
(def shortest ((g Graph) (from (list int)) (to (list int))) int
  (if (list_eq from to)
      0
      (let a (node_id g from)
        (let b (node_id g to)
          (if (if (lt a 0) true (lt b 0))
              -1
              (match g
                ((Graph names n edges)
                  (dijkstra edges (push_heap (HEmpty) 0 a) (im_set (IEmpty) a 0)
                            b))))))))

(def dijkstra ((edges EdgeMap) (heap Heap) (dist IntMap) (target int)) int
  (match heap
    ((HEmpty) -1)
    ((HNode r d u l x)
      (if (eq u target)
          d
          (if (gt d (im_get dist u (infinity 0)))
              (dijkstra edges (merge l x) dist target)
              (relax edges (em_get edges u) d (merge l x) dist target))))))

(def relax ((edges EdgeMap) (out (list Edge)) (d int) (heap Heap) (dist IntMap)
            (target int)) int
  (if (is_empty out)
      (dijkstra edges heap dist target)
      (match (head out)
        ((Edge v w)
          (let nd (add d w)
            (if (lt nd (im_get dist v (infinity 0)))
                (relax edges (tail out) d (push_heap heap nd v) (im_set dist v nd)
                       target)
                (relax edges (tail out) d heap dist target)))))))

; ----------------------------------------------------------------- input
;
; A line with three fields is an edge FROM TO WEIGHT, and one with two is a
; query FROM TO, answered from the edges read before it. Blank lines are
; skipped. Fields are separated by spaces or tabs.

(def fields ((s (list int))) (list (list int))
  (rev_strs_onto (fields_onto s (nil int) (nil (list int))) (nil (list int))))

(def fields_onto ((s (list int)) (cur (list int)) (acc (list (list int))))
    (list (list int))
  (if (is_empty s)
      (field_done cur acc)
      (if (is_space (head s))
          (fields_onto (tail s) (nil int) (field_done cur acc))
          (fields_onto (tail s) (cons (head s) cur) acc))))

(def field_done ((cur (list int)) (acc (list (list int)))) (list (list int))
  (if (is_empty cur) acc (cons (rev cur) acc)))

; A weight: at most 12 decimal digits, so that a path through 100000 edges
; still fits in an int. -1 if s is not one.
(def weight_of ((s (list int))) int
  (if (if (is_empty s) true (gt (length s) 12))
      -1
      (if (all_digits s) (int_prefix s 0) -1)))

(def all_digits ((s (list int))) bool
  (if (is_empty s)
      true
      (if (is_digit (head s)) (all_digits (tail s)) false)))

(def answer ((d int)) (list int)
  (if (lt d 0) "unreachable\n" (append (digits d) "\n")))

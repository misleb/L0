; main.l0 -- wordfreq's entry point: stream stdin, then print the report.
;
; Kept apart from wordfreq.l0 because l0 test supplies its own main.

(data Scanned
  (Scanned Tree)
  (ScanFailed int))

(def scan ((t Tree) (cur (list int))) Scanned
  (let b (read_byte)
    (if (eq b -1)
        (Scanned (flush t cur))
        (if (lt b 0)
            (ScanFailed b)
            (if (is_word_byte b)
                (scan t (cons (fold_case b) cur))
                (scan (flush t cur) (nil int)))))))

(def write_all ((xs (list WC))) int
  (if (is_empty xs)
      0
      (let w (write_str (line_of (head xs)))
        (write_all (tail xs)))))

(def main () int
  (match (scan (Tip) (nil int))
    ((ScanFailed code)
      (let w (write_err (append "wordfreq: reading input: "
                          (append (io_error code) "\n")))
        1))
    ((Scanned t) (write_all (ranked t)))))

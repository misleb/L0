; Limit 01 again, with the two input builtins prototyped for 0026. Modes,
; chosen by argument 0:
;   array   (read_array 0), an (array int) of exactly the input's length
;   bytes   (read_bytes 0), one byte per byte
; Each then sums every byte it holds, as 01-input-into-array.l0 does.

(def main () int
  (if (list_eq (arg 0) "array")
      (let a (read_array 0)
        (mod (sum_array a 0 0) 256))
      (let b (read_bytes 0)
        (mod (sum_bytes b 0 0) 256))))

(def sum_array ((a (array int)) (i int) (acc int)) int
  (if (ge i (array_len a)) acc (sum_array a (add i 1) (add acc (array_get a i)))))

(def sum_bytes ((b bytes) (i int) (acc int)) int
  (if (ge i (bytes_len b)) acc (sum_bytes b (add i 1) (add acc (byte_at b i)))))

; Limit 02: a word kept as a key costs 24 bytes per byte as a list, and
; there is no compact way to hold many short strings.
;
; wordfreq keeps each distinct word as a (list int) in its table's keys. On
; the wide 10 MB input (195,412 distinct words, 1,533,971 letters) its peak
; is 54 MB, of which the keys as cons cells are 36.8 MB. This reads one word
; per line and holds them all, in an array of lists or an array of arrays,
; so the difference is only the representation of the words.
;
;   02-word-keys list  < words     every word as a (list int)
;   02-word-keys array < words     every word as an (array int), built from
;                                  the list read, of exactly its length
;   02-word-keys bytes < words     every word as bytes, from the list read
;                                  (added for 0026)
;   02-word-keys none  < words     read the words and keep none
;
; Measured on the 195,412 words of wide10 (cut -d' ' -f1 of wordfreq's
; output), peak RSS:
;   none     1.5 MB
;   list    40.2 MB   (25 bytes a letter, with the 2 MB array of slots)
;   array   20.7 MB   (12 bytes a letter: an array block is a malloc of
;                      8 bytes a letter plus a length word and a header,
;                      about 80 bytes for the average 7.8-letter word)
; so an (array int) per word would halve wordfreq's keys, at the cost of
; converting each new word and comparing a list with an array. A packed
; byte string would hold the letters in 1.5 MB.

(def main () int
  (let mode (arg 0)
    (if (list_eq mode "list")
        (mod (keep_lists (array_new 262144 (nil int)) 0) 256)
        (if (list_eq mode "array")
            (mod (keep_arrays (array_new 262144 (array_new 0 0)) 0) 256)
            (if (list_eq mode "bytes")
                (mod (keep_bytes (array_new 262144 (bytes_from_list (nil int))) 0) 256)
                (mod (keep_none 0) 256))))))

(def keep_bytes ((ws (array bytes)) (k int)) int
  (let w (take_line (read_line))
    (if (is_empty w)
        (add k (bytes_len (array_get ws (sub k 1))))
        (keep_bytes (array_set ws k (bytes_from_list w)) (add k 1)))))

(def keep_lists ((ws (array (list int))) (k int)) int
  (let w (take_line (read_line))
    (if (is_empty w)
        (add k (length (array_get ws (sub k 1))))
        (keep_lists (array_set ws k w) (add k 1)))))

(def keep_arrays ((ws (array (array int))) (k int)) int
  (let w (take_line (read_line))
    (if (is_empty w)
        (add k (array_len (array_get ws (sub k 1))))
        (keep_arrays (array_set ws k (to_array w (array_new (length w) 0) 0))
                     (add k 1)))))

(def to_array ((s (list int)) (a (array int)) (i int)) (array int)
  (if (is_empty s) a (to_array (tail s) (array_set a i (head s)) (add i 1))))

(def keep_none ((k int)) int
  (let w (take_line (read_line))
    (if (is_empty w) k (keep_none (add k 1)))))

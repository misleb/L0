; main.l0 -- wordfreq's entry point.
;
;   wordfreq [N] < text
;
; Prints the N most frequent words of standard input with their counts, or
; every word without N. Exits 2 on a bad argument, 1 if reading or writing
; failed.

(def main () int
  (let limit (if (eq (arg_count) 0) -2 (parse_limit (arg 0)))
    (if (eq limit -1)
        (let w (write_err "usage: wordfreq [N] < text\n") 2)
        (match (count_file (IoFile 0))
          ((ScanFailed code)
            (let w (write_err (append "wordfreq: reading input: "
                                (append (io_error code) "\n")))
              1))
          ((Scanned t)
            (let w (write_top (IoFile 1) (ranked t) limit)
              (if (lt (flush 1) 0)
                  (let e (write_err "wordfreq: write error\n") 1)
                  0)))))))

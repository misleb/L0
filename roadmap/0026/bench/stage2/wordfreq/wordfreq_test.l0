; wordfreq_test.l0 -- tests of wordfreq.l0.

(def test_report_ranks_by_count () int
  (check_str "b a b c b a" (report "b a b c b a" -1) "b 3\na 2\nc 1\n"))

(def test_ties_are_bytewise () int
  (check_str "ties" (report "pear apple fig apple pear fig zoo" -1)
    "apple 2\nfig 2\npear 2\nzoo 1\n"))

(def test_case_folds () int
  (check_str "case" (report "The THE the tHe" -1) "the 4\n"))

(def test_only_letters_make_words () int
  (check_str "separators" (report "it's a-b,c9d\ne\x80f" -1)
    "a 1\nb 1\nc 1\nd 1\ne 1\nf 1\nit 1\ns 1\n"))

(def test_empty_input () int
  (add (check_str "nothing" (report "" -1) "")
       (check_str "no letters" (report " 12 ,. \n" -1) "")))

(def test_limit () int
  (add (check_str "two" (report "c c c b b a d" 2) "c 3\nb 2\n")
       (check_str "zero" (report "a b" 0) "")))

(def test_limit_beyond_words () int
  (check_str "more than there are" (report "x y x" 10) "x 2\ny 1\n"))

(def test_word_at_end () int
  (check_str "no trailing separator" (report "go go" -1) "go 2\n"))

(def test_parse_limit () int
  (add (check_int "10" (parse_limit "10") 10)
       (add (check_int "0" (parse_limit "0") 0)
            (check_int "too long" (parse_limit "1234567890123456789") -1))))

(def test_parse_limit_rejects () int
  (add (check_int "letters" (parse_limit "x") -1)
       (add (check_int "empty" (parse_limit "") -1)
            (check_int "trailing" (parse_limit "3x") -1))))

(def test_cmp_str () int
  (add (check_true "prefix first" (lt (cmp_bytes (bytes_from_list "ab") (bytes_from_list "abc")) 0))
       (add (check_true "bytewise" (gt (cmp_bytes (bytes_from_list "b") (bytes_from_list "abc")) 0))
            (check_int "equal" (cmp_bytes (bytes_from_list "ab") (bytes_from_list "ab")) 0))))

; "w0 w1 ... w(n-1)" with each word i repeated (i mod 7) + 1 times, pushed
; onto acc reversed.
(def many_words_onto ((i int) (n int) (acc (list int))) (list int)
  (if (ge i n)
      acc
      (many_words_onto (add i 1) n (repeat_word i (add (mod i 7) 1) acc))))

(def repeat_word ((i int) (k int) (acc (list int))) (list int)
  (if (eq k 0)
      acc
      (repeat_word i (sub k 1) (push (word_of i) acc))))

; Word i spelled in letters, since digits separate words: "w" then i in base
; 26 as a to z, then a space.
(def word_of ((i int)) (list int)
  (cons 119 (letters_onto i (cons 32 (nil int)))))

(def letters_onto ((i int) (acc (list int))) (list int)
  (if (lt i 26)
      (cons (add 97 i) acc)
      (letters_onto (div i 26) (cons (add 97 (mod i 26)) acc))))

(def count_string ((s (list int))) Table
  (match (open_in_bytes s)
    ((IoFailed why) (new_table 1))
    ((IoOpened f)
      (let r (count_file f)
        (let c (file_close f)
          (match r
            ((ScanFailed code) (new_table 1))
            ((Scanned t) t)))))))

; 5,000 distinct words grow the table from 1,024 slots to 16,384.
(def test_growth_keeps_counts () int
  (let t (count_string (rev (many_words_onto 0 5000 (nil int))))
    (add (check_int "distinct" (table_size t) 5000)
         (add (check_int "w0" (lookup t (rev_word 0)) 1)
              (check_int "w4999" (lookup t (rev_word 4999)) (add (mod 4999 7) 1))))))

(def rev_word ((i int)) (list int)
  (tail (rev (word_of i))))

(def test_growth_counts_every_word () int
  (let t (count_string (rev (many_words_onto 0 3000 (nil int))))
    (check_int "wrong counts" (bad_counts t 0 3000 0) 0)))

(def bad_counts ((t Table) (i int) (n int) (bad int)) int
  (if (ge i n)
      bad
      (bad_counts t (add i 1) n
        (if (eq (lookup t (rev_word i)) (add (mod i 7) 1)) bad (add bad 1)))))

(def test_top_of_many () int
  (check_str "top 3"
    (report (rev (many_words_onto 0 40 (nil int))) 3)
    "wbb 7\nwbi 7\nwg 7\n"))

; ------------------------------------------------------------ property
;
; On random texts over a few letters, the table agrees with a count kept in
; an association list, for every word, and has as many entries.

(data Assoc
  (Assoc (list int) int))

(def assoc_add ((xs (list Assoc)) (w (list int)) (acc (list Assoc)))
    (list Assoc)
  (if (is_empty xs)
      (cons (Assoc w 1) acc)
      (match (head xs)
        ((Assoc k c)
          (if (list_eq k w)
              (assoc_onto (tail xs) (cons (Assoc k (add c 1)) acc))
              (assoc_add (tail xs) w (cons (Assoc k c) acc)))))))

(def assoc_onto ((xs (list Assoc)) (acc (list Assoc))) (list Assoc)
  (if (is_empty xs) acc (assoc_onto (tail xs) (cons (head xs) acc))))

; Words of s, reversed as the scanner holds them, counted naively.
(def naive ((s (list int)) (cur (list int)) (acc (list Assoc))) (list Assoc)
  (if (is_empty s)
      (if (is_empty cur) acc (assoc_add acc cur (nil Assoc)))
      (if (is_letter (head s))
          (naive (tail s) (cons (fold_case (head s)) cur) acc)
          (naive (tail s) (nil int)
            (if (is_empty cur) acc (assoc_add acc cur (nil Assoc)))))))

(def disagreements ((t Table) (xs (list Assoc)) (n int) (bad int)) int
  (if (is_empty xs)
      (if (eq n (table_size t)) bad (add bad 1))
      (match (head xs)
        ((Assoc k c)
          (disagreements t (tail xs) (add n 1)
            (if (eq (lookup t k) c) bad (add bad 1)))))))

(def text_of ((bytes (list int)) (acc (list int))) (list int)
  (if (is_empty bytes)
      (rev acc)
      (text_of (tail bytes) (cons (pick_char (mod (head bytes) 6)) acc))))

(def pick_char ((k int)) int
  (if (eq k 0) 32 (if (eq k 1) 65 (add 96 k))))

(def property ((seed int) (left int) (bad int)) int
  (if (eq left 0)
      bad
      (let s (text_of (rand_bytes seed (add 1 (rand_below seed 3000))) (nil int))
        (property (rand_next seed) (sub left 1)
          (add bad (disagreements (count_string s) (naive s (nil int) (nil Assoc))
                     0 0))))))

(def test_agrees_with_naive_count () int
  (check_int "disagreements over 200 texts" (property 7 200 0) 0))

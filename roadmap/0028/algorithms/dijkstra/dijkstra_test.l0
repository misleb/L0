; dijkstra_test.l0 -- tests of dijkstra.l0: l0 test dijkstra.l0 dijkstra_test.l0

(def test_diamond () int
  (check_str "shorter of two ways"
             (run_text "a b 1\na c 5\nb d 1\nc d 1\na d\nd a\n")
             "2\nunreachable\n"))

(def test_same_and_unknown () int
  (check_str "self is 0, unknown unreachable"
             (run_text "x y 3\nq q\nx zz\nzz x\n")
             "0\nunreachable\nunreachable\n"))

(def test_edges_after_query () int
  (check_str "a query sees only earlier edges, rows rebuilt"
             (run_text "a b 10\na c\nb c 1\na c\na b 2\na c\n")
             "unreachable\n11\n3\n"))

(def test_zero_weights_and_cycles () int
  (check_str "zero-weight cycle"
             (run_text "a b 0\nb a 0\nb c 0\nc a 7\na c\nc b\n")
             "0\n7\n"))

(def test_parallel_edges () int
  (check_str "lighter parallel edge" (run_text "a b 9\na b 4\na b 6\na b\n") "4\n"))

(def test_malformed () int
  (add (check_str "one field" (run_text "a b 1\nlonely\n")
                  "dijkstra: line 2: expected FROM TO WEIGHT or FROM TO\n")
       (check_str "bad weight" (run_text "a b x1\n")
                  "dijkstra: line 1: weight must be a whole number of at most 12 digits\n")))

(def test_blank_and_tabs () int
  (check_str "blank lines skipped" (run_text "\na\tb\t5\r\n\na b\n") "5\n"))

; ------------------------------------------------------------ the heap

; Pops every entry, returning the distances in the order they come out.
(def drain ((h (array int)) (size int) (acc (list int))) (list int)
  (if (eq size 0)
      (rev acc)
      (let d (array_get h 0)
        (drain (heap_pop h size) (sub size 1) (cons d acc)))))

(def fill_heap ((h (array int)) (size int) (s int) (n int)) (array int)
  (if (eq size n)
      h
      (fill_heap (heap_push h size (rand_below s 1000) size) (add size 1)
                 (rand_next s) n)))

(def ascending ((xs (list int))) bool
  (if (is_empty xs)
      true
      (if (is_empty (tail xs))
          true
          (if (gt (head xs) (head (tail xs))) false (ascending (tail xs))))))

(def test_heap_order () int
  (let out (drain (fill_heap (array_new 2 0) 0 7 3000) 3000 (nil int))
    (add (check_int "all out" (length out) 3000)
         (check_true "ascending" (ascending out)))))

; ------------------------------------------------------------ the names

(def intern_many ((t Names) (i int) (n int)) Names
  (if (ge i n)
      t
      (match (intern t (append "node" (digits i)))
        ((Interned t2 id) (intern_many t2 (add i 1) n)))))

(def ids_right ((t Names) (i int) (n int)) int
  (if (ge i n)
      0
      (if (eq (name_id t (append "node" (digits i))) i)
          (ids_right t (add i 1) n)
          (add 1 (ids_right t (add i 1) n)))))

(def test_names_grow () int
  (let t (intern_many (names_new 2) 0 5000)
    (add (check_int "count" (names_count t) 5000)
         (add (check_int "wrong ids" (ids_right t 0 5000) 0)
              (check_int "absent" (name_id t "node5000") -1)))))

(def test_intern_twice () int
  (match (intern (names_new 4) "a")
    ((Interned t1 a)
      (match (intern t1 "a")
        ((Interned t2 a2)
          (add (check_int "same id" a2 a) (check_int "one name" (names_count t2) 1)))))))

; ------------------------------------------------------------ property

; Random graphs of up to 8 nodes named by one letter, every pair queried,
; against Bellman-Ford over the same edges, written separately.
(data Wedge
  (Wedge int int int))

(def random_edges ((n int) (m int) (s int) (acc (list Wedge))) (list Wedge)
  (if (eq m 0)
      acc
      (let s1 (rand_next s)
        (let s2 (rand_next s1)
          (random_edges n (sub m 1) (rand_next s2)
            (cons (Wedge (rand_below s n) (rand_below s1 n) (rand_below s2 20)) acc))))))

(def edges_text ((es (list Wedge)) (acc (list int))) (list int)
  (if (is_empty es)
      acc
      (match (head es)
        ((Wedge a b w)
          (edges_text (tail es)
            (push "\n" (push (digits w) (push " " (push (cons (add 97 b) (nil int))
              (push " " (push (cons (add 97 a) (nil int)) acc)))))))))))

(def queries_text ((n int) (i int) (acc (list int))) (list int)
  (if (ge i (mul n n))
      acc
      (queries_text n (add i 1)
        (push "\n" (push (cons (add 97 (mod i n)) (nil int))
                     (push " " (push (cons (add 97 (div i n)) (nil int)) acc)))))))

; Distances from src after n rounds of relaxing every edge; -1 unreachable.
(def bellman ((es (list Wedge)) (dist (array int)) (rounds int)) (array int)
  (if (eq rounds 0) dist (bellman es (relax_all es dist) (sub rounds 1))))

(def relax_all ((es (list Wedge)) (dist (array int))) (array int)
  (if (is_empty es)
      dist
      (match (head es)
        ((Wedge a b w)
          (let da (array_get dist a)
            (let db (array_get dist b)
              (if (if (ge da 0) (if (lt db 0) true (lt (add da w) db)) false)
                  (relax_all (tail es) (array_set dist b (add da w)))
                  (relax_all (tail es) dist))))))))

(def mentioned ((es (list Wedge)) (u int)) bool
  (if (is_empty es)
      false
      (match (head es)
        ((Wedge a b w) (if (if (eq a u) true (eq b u)) true (mentioned (tail es) u))))))

(def expected ((es (list Wedge)) (n int) (i int) (acc (list int))) (list int)
  (if (ge i (mul n n))
      acc
      (let a (div i n)
        (let b (mod i n)
          (let d (if (eq a b)
                     0
                     (array_get (bellman es (array_set (array_new n -1) a 0) n) b))
            (expected es n (add i 1) (push (answer (if (eq a b) 0 d)) acc)))))))

(def agree ((trials int) (s int) (fails int)) int
  (if (eq trials 0)
      fails
      (let n (add 1 (rand_below s 8))
        (let es (random_edges n (rand_below (rand_next s) 20) (rand_next (rand_next s)) (nil Wedge))
          (let text (rev (queries_text n 0 (edges_text es (nil int))))
            (agree (sub trials 1) (rand_next (rand_next (rand_next s)))
                   (add fails (if (list_eq (run_text text)
                                           (rev (expected es n 0 (nil int))))
                                  0 1))))))))

(def test_agrees_with_bellman_ford () int
  (check_int "disagreements in 150 random graphs" (agree 150 42 0) 0))

; A long chain, to check nothing on the path is quadratic or deep.
(def chain_text ((i int) (n int) (acc (list int))) (list int)
  (if (ge i n)
      acc
      (chain_text (add i 1) n
        (push " 1\n" (push (digits (add i 1)) (push " " (push (digits i) acc)))))))

(def test_long_chain () int
  (check_str "20,000 edges" (run_text (rev (push "0 20000\n" (chain_text 0 20000 (nil int)))))
             "20000\n"))

; main.l0 -- dijkstra: shortest distances in a weighted directed graph.
;
;   dijkstra < input
;
; Each line is an edge "FROM TO WEIGHT" or a query "FROM TO"; a query writes
; the shortest distance over the edges read so far, or "unreachable". A
; malformed line is reported with its number, and exits with status 1.

(def main () int
  (next (empty_graph) 1))

(def next ((g Graph) (lineno int)) int
  (let line (read_line)
    (if (is_empty line)
        0
        (match (step g (take_line line))
          ((Stepped g2 out) (let w (write_str out) (next g2 (add lineno 1))))
          ((Bad msg) (let w (write_err (error_text lineno msg)) 1))))))

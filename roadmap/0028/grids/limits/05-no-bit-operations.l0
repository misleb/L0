; 05: there are no bitwise operations, so a set of digits is not an int.
;
; The usual Sudoku solver keeps, per row, column, and box, a 9-bit mask of
; the digits used, and gets a cell's candidates as
; not (row | col | box) & 0x1FF, their count by popcount, and the first by
; the lowest set bit. L0 has add, sub, mul, div, and mod on ints, and and/or
; on bools only (spec 6). sudoku/ uses flag arrays instead: element
; unit * 10 + d is 1 when the unit has d, 270 words where 27 would do, and
; counting candidates is a loop of 9 lookups of 3 arrays each.
;
; A mask can be emulated with div and mod, as below: bit d of m is
; (mod (div m (pow2 d)) 2), and the union of three masks has no cheap form
; at all, so each bit is tested in each mask. This program counts the
; candidates of 10M random cells both ways:
;
;   ./05 flags    three flag arrays                       (measured below)
;   ./05 divmod   three int masks, bits by div and mod    (measured below)
;
; Measured, both counting the same 10,260,686 candidates: flags 0.13 s,
; divmod 2.2 s. So the emulation is not a workaround worth having, and flag
; arrays are: sudoku/ uses them. With bit operations the count would be two
; ors, an and, and a popcount, rather than 27 lookups. Flag arrays cost
; memory (10x the words) and code, not time, so this ranks low; it is
; recorded because every bitset (visited sets, candidate sets, small-set
; dynamic programming) meets it.

(def pow2 ((d int)) int
  (if (eq d 0) 1 (mul 2 (pow2 (sub d 1)))))

(def bit ((m int) (d int)) int
  (mod (div m (pow2 d)) 2))

(def count_divmod ((r int) (c int) (x int) (d int) (n int)) int
  (if (gt d 9)
      n
      (count_divmod r c x (add d 1)
        (if (eq (add (bit r d) (add (bit c d) (bit x d))) 0) (add n 1) n))))

; One tail-recursive loop over cells k and digits d, so the arrays are
; handed from call to call and never counted (limits/02).
(def run_flags ((rf (array int)) (cf (array int)) (xf (array int)) (k int) (d int)
                (acc int)) int
  (if (eq k 0)
      acc
      (if (gt d 9)
          (run_flags rf cf xf (sub k 1) 1 acc)
          (run_flags rf cf xf k (add d 1)
            (if (eq (add (array_get rf (add (mul (mod k 9) 10) d))
                         (add (array_get cf (add (mul (mod (div k 9) 9) 10) d))
                              (array_get xf (add (mul (mod (div k 81) 9) 10) d)))) 0)
                (add acc 1) acc)))))

; Masks and flag arrays holding the same random sets, 9 units each.
(def masks ((s int) (u int) (m (array int))) (array int)
  (if (ge u 9) m (masks (rand_next s) (add u 1) (array_set m u (mul 2 (rand_below s 512))))))

(def flags_of ((m (array int)) (i int) (f (array int))) (array int)
  (if (ge i 90) f (flags_of m (add i 1) (array_set f i (bit (array_get m (div i 10)) (mod i 10))))))

(def run_divmod ((r (array int)) (c (array int)) (x (array int)) (k int) (acc int)) int
  (if (eq k 0)
      acc
      (run_divmod r c x (sub k 1)
        (add acc (count_divmod (array_get r (mod k 9)) (array_get c (mod (div k 9) 9))
                               (array_get x (mod (div k 81) 9)) 1 0)))))

(def rand_next ((s int)) int (mod (add (mul s 1103515245) 12345) 2147483648))
(def rand_below ((s int) (n int)) int (mod (div s 65536) n))

(def main () int
  (let r (masks 1 0 (array_new 9 0))
    (let c (masks 2 0 (array_new 9 0))
      (let x (masks 3 0 (array_new 9 0))
        (write_line (digits
          (if (list_eq (arg 0) "divmod")
              (run_divmod r c x 10000000 0)
              (run_flags (flags_of r 0 (array_new 90 0)) (flags_of c 0 (array_new 90 0))
                         (flags_of x 0 (array_new 90 0)) 10000000 1 0))))))))

; sudoku FILE [undo|copy]    FILE - reads standard input
(def main () int
  (if (lt (arg_count) 1)
      (let w (write_err "usage: sudoku FILE [undo|copy]\n") 2)
      (if (list_eq (arg 0) "-")
          (finish (solve_all (IoFile 0) (IoFile 1) (arg 1) 0))
          (match (open_in (arg 0))
            ((IoFailed why) (let w (write_err (append (arg 0) (append ": " (append why "\n")))) 1))
            ((IoOpened f)
              (let bad (solve_all f (IoFile 1) (arg 1) 0)
                (let c (file_close f)
                  (finish bad))))))))

(def finish ((bad int)) int
  (if (lt (flush 1) 0)
      (let e (write_err "sudoku: write error\n") 1)
      (if (lt bad 0)
          (let e (write_err "sudoku: cannot read the puzzles\n") 1)
          (if (gt bad 0) 1 0))))

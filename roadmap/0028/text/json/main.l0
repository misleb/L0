; main.l0 -- json: validate and pretty-print JSON from standard input.
;
;   json < file.json
;
; Valid input is written back pretty-printed, with exit status 0. Invalid
; input writes "stdin:LINE:COL: error: MESSAGE" to standard error, nothing to
; standard output, and exits 1.

(def main () int
  (match (read_input)
    ((IoReadFailed code)
      (let w (write_err (append "json: reading input: " (append (io_error code) "\n")))
        1))
    ((IoBytes s)
      (match (pretty s (bytes_len s) (IoFile 1))
        ((Bad at msg)
          (let w (write_err (append "stdin:" (error_text s at msg))) 1))
        ((Ok k)
          (if (lt (flush 1) 0)
              (let w (write_err "json: write error\n") 1)
              0))))))

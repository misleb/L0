; main.l0 -- sort: the lines of standard input in bytewise order.
;
;   sort < text

(def main () int
  (match (read_input (IoFile 0))
    ((InputFailed code)
      (let w (write_err (append "sort: reading input: " (append (io_error code) "\n")))
        1))
    ((Input b n)
      (let w (sort_onto (IoFile 1) b n)
        (if (lt (flush 1) 0)
            (let e (write_err "sort: write error\n") 1)
            0)))))

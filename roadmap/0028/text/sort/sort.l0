; sort.l0 -- the lines of a text in bytewise order, as LC_ALL=C sort
; prints them.
;
; The input is held once, as bytes, one per byte, and a line is its
; index: starts holds where each line begins, and one more entry past the
; last, so line i is bytes starts[i] up to starts[i + 1] - 1, the newline
; excluded. A last line with no newline is treated as if it had one, which
; is what sort does. Sorting moves line indices, one int each, never bytes.
;
; The sort is a bottom-up merge sort: stable, n log n comparisons whatever
; the input, and every pass is one loop writing a fresh array in place.

; ------------------------------------------------------------------ lines

; The start of every line of b, then the sentinel. There are
; (array_len starts) - 1 lines.
(def line_starts ((b bytes)) (array int)
  (let n (bytes_len b)
    (if (eq n 0)
        (array_new 1 0)
        (find_lines b n 0 (array_set (array_new 1024 0) 0 0) 1))))

; st holds k starts; i is the next byte to look at.
(def find_lines ((b bytes) (n int) (i int) (st (array int)) (k int))
    (array int)
  (if (ge i n)
      (if (eq (bytes_get b (sub n 1)) 10)
          (shrink st k)
          (shrink (add_start st k (add n 1)) (add k 1)))
      (if (eq (bytes_get b i) 10)
          (if (eq (add i 1) n)
              (find_lines b n (add i 1) (add_start st k n) (add k 1))
              (find_lines b n (add i 1) (add_start st k (add i 1)) (add k 1)))
          (find_lines b n (add i 1) st k))))

(def add_start ((st (array int)) (k int) (x int)) (array int)
  (if (lt k (array_len st))
      (array_set st k x)
      (array_set (grow st (mul 2 (array_len st))) k x)))

; a copied into a new array of length len, at least as long, padded with 0.
(def grow ((a (array int)) (len int)) (array int)
  (copy_into a (array_new len 0) 0))

(def copy_into ((src (array int)) (dst (array int)) (i int)) (array int)
  (if (ge i (array_len src))
      dst
      (copy_into src (array_set dst i (array_get src i)) (add i 1))))

; The first k elements of a.
(def shrink ((a (array int)) (k int)) (array int)
  (copy_prefix a (array_new k 0) 0))

(def copy_prefix ((src (array int)) (dst (array int)) (i int)) (array int)
  (if (ge i (array_len dst))
      dst
      (copy_prefix src (array_set dst i (array_get src i)) (add i 1))))

; ---------------------------------------------------------------- compare

; Whether line y sorts strictly before line x, bytewise, a proper prefix
; first.
(def line_lt ((b bytes) (st (array int)) (y int) (x int)) bool
  (bytes_lt b (array_get st y) (sub (array_get st (add y 1)) 1)
              (array_get st x) (sub (array_get st (add x 1)) 1)))

(def bytes_lt ((b bytes) (i int) (ie int) (j int) (je int)) bool
  (if (ge j je)
      false
      (if (ge i ie)
          true
          (let c (bytes_get b i)
            (let d (bytes_get b j)
              (if (eq c d)
                  (bytes_lt b (add i 1) ie (add j 1) je)
                  (lt c d)))))))

; ------------------------------------------------------------------ sort

(def identity ((a (array int)) (i int)) (array int)
  (if (ge i (array_len a)) a (identity (array_set a i i) (add i 1))))

; The line indices 0 to m - 1 in sorted order, where m is the line count.
(def sorted ((b bytes) (st (array int))) (array int)
  (let m (sub (array_len st) 1)
    (passes b st (identity (array_new m 0) 0) 1)))

(def passes ((b bytes) (st (array int)) (src (array int)) (w int))
    (array int)
  (if (ge w (array_len src))
      src
      (passes b st (merge_pass b st src (array_new (array_len src) 0) w 0)
        (mul w 2))))

; Merges each pair of runs of width w in src, from lo on, into dst.
(def merge_pass ((b bytes) (st (array int)) (src (array int))
                 (dst (array int)) (w int) (lo int)) (array int)
  (let m (array_len src)
    (if (ge lo m)
        dst
        (let mid (imin (add lo w) m)
          (let hi (imin (add mid w) m)
            (merge_pass b st src (merge b st src dst lo mid mid hi lo) w hi))))))

(def imin ((a int) (b int)) int
  (if (lt a b) a b))

; src[i..ie) and src[j..je) merged into dst from k. Equal lines keep their
; order, the left run's first.
(def merge ((b bytes) (st (array int)) (src (array int)) (dst (array int))
            (i int) (ie int) (j int) (je int) (k int)) (array int)
  (if (ge i ie)
      (copy_run src dst j je k)
      (if (ge j je)
          (copy_run src dst i ie k)
          (let x (array_get src i)
            (let y (array_get src j)
              (if (line_lt b st y x)
                  (merge b st src (array_set dst k y) i ie (add j 1) je (add k 1))
                  (merge b st src (array_set dst k x) (add i 1) ie j je (add k 1))))))))

(def copy_run ((src (array int)) (dst (array int)) (i int) (ie int) (k int))
    (array int)
  (if (ge i ie)
      dst
      (copy_run src (array_set dst k (array_get src i)) (add i 1) ie (add k 1))))

; ----------------------------------------------------------------- output

; Writes the lines in the order given, from the kth, each with a newline, to
; out, straight from b.
(def write_lines ((out IoFile) (b bytes) (st (array int)) (order (array int))
                  (k int)) int
  (if (ge k (array_len order))
      0
      (let x (array_get order k)
        (let w (file_write_bytes out b (array_get st x) (sub (array_get st (add x 1)) 1))
          (let e (file_write_byte out 10)
            (write_lines out b st order (add k 1)))))))

; Sorts the lines of b onto out.
(def sort_onto ((out IoFile) (b bytes)) int
  (let st (line_starts b)
    (write_lines out b st (sorted b st) 0)))

; The sorted text of t, for tests.
(def sort_string ((t (list int))) (list int)
  (match (open_out_buffer)
    ((IoFailed why) why)
    ((IoOpened out)
      (let w (sort_onto out (bytes_from_list t))
        (let s (buffer_contents out)
          (let c (file_close out) s))))))

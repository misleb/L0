; sort_test.l0 -- tests of sort.l0.

(def test_empty () int
  (check_str "nothing" (sort_string "") ""))

(def test_last_line_gets_newline () int
  (add (check_str "one" (sort_string "a") "a\n")
       (check_str "two" (sort_string "b\na") "a\nb\n")))

(def test_empty_lines () int
  (add (check_str "only" (sort_string "\n") "\n")
       (check_str "among" (sort_string "b\n\na\n\n") "\n\na\nb\n")))

(def test_prefix_first () int
  (check_str "prefix" (sort_string "abc\nab\nabd\na\n") "a\nab\nabc\nabd\n"))

(def test_bytewise () int
  (check_str "bytes"
    (sort_string "a\n\xe9\nB\n\tx\n x\n~\n\x7f\nZ\n")
    "\tx\n x\nB\nZ\na\n~\n\x7f\n\xe9\n"))

(def test_duplicates_kept () int
  (check_str "dups" (sort_string "x\ny\nx\nx\n") "x\nx\nx\ny\n"))

(def test_carriage_return_is_a_byte () int
  (check_str "cr" (sort_string "a\r\na\n") "a\na\r\n"))

(def test_line_starts () int
  (let b (bytes_from_list "ab\n\ncd")
    (let st (line_starts b)
      (add (check_int "lines" (sub (array_len st) 1) 3)
           (add (check_int "second" (array_get st 1) 3)
                (check_int "sentinel" (array_get st 3) 7))))))


; 30,000 lines of 5 bytes: the input grows past 65,536 bytes, and starts
; past 1,024 lines, several times.
(def test_many_lines () int
  (let out (sort_string (numbered 30000 (nil int)))
    (add (check_int "length" (length out) 150000)
         (add (check_str "first" (take_line out) "0000")
              (check_true "sorted" (is_sorted_text out))))))

; Lines 0000 to 29999 in base 10, four digits, mod 10000, backwards.
(def numbered ((k int) (acc (list int))) (list int)
  (if (eq k 0)
      acc
      (numbered (sub k 1) (push (four (mod k 10000)) acc))))

(def four ((x int)) (list int)
  (cons 10 (rev (pad4 (digits x)))))

(def pad4 ((s (list int))) (list int)
  (if (lt (length s) 4) (pad4 (cons 48 s)) s))

(def is_sorted_text ((s (list int))) bool
  (sorted_lines (take_line s) (drop_line s)))

(def sorted_lines ((prev (list int)) (rest (list int))) bool
  (if (is_empty rest)
      true
      (let line (take_line rest)
        (if (gt (cmp_str prev line) 0)
            false
            (sorted_lines line (drop_line rest))))))

(def cmp_str ((a (list int)) (b (list int))) int
  (if (is_empty a)
      (if (is_empty b) 0 -1)
      (if (is_empty b)
          1
          (if (eq (head a) (head b))
              (cmp_str (tail a) (tail b))
              (sub (head a) (head b))))))

; ------------------------------------------------------------ property
;
; On random texts, the output is what an insertion sort of the lines, held
; as lists, gives.

(def split_lines ((s (list int)) (cur (list int)) (acc (list (list int))))
    (list (list int))
  (if (is_empty s)
      (if (is_empty cur) acc (cons (rev cur) acc))
      (if (eq (head s) 10)
          (split_lines (tail s) (nil int) (cons (rev cur) acc))
          (split_lines (tail s) (cons (head s) cur) acc))))

(def insert ((x (list int)) (xs (list (list int)))) (list (list int))
  (if (is_empty xs)
      (cons x xs)
      (if (le (cmp_str x (head xs)) 0)
          (cons x xs)
          (cons (head xs) (insert x (tail xs))))))

(def insertion ((xs (list (list int))) (acc (list (list int)))) (list (list int))
  (if (is_empty xs) acc (insertion (tail xs) (insert (head xs) acc))))

(def join_onto ((xs (list (list int))) (acc (list int))) (list int)
  (if (is_empty xs)
      (rev acc)
      (join_onto (tail xs) (cons 10 (push (head xs) acc)))))

(def naive_sort ((s (list int))) (list int)
  (join_onto (insertion (split_lines s (nil int) (nil (list int))) (nil (list int)))
             (nil int)))

(def text_of ((bytes (list int)) (acc (list int))) (list int)
  (if (is_empty bytes)
      (rev acc)
      (text_of (tail bytes) (cons (pick_byte (mod (head bytes) 8)) acc))))

(def pick_byte ((k int)) int
  (if (lt k 2) 10 (if (eq k 2) 200 (if (eq k 3) 32 (add 94 k)))))

(def agree ((seed int) (left int) (bad int)) int
  (if (eq left 0)
      bad
      (let s (text_of (rand_bytes seed (rand_below seed 400)) (nil int))
        (agree (rand_next seed) (sub left 1)
          (if (list_eq (sort_string s) (naive_sort s)) bad (add bad 1))))))

(def test_agrees_with_insertion_sort () int
  (check_int "disagreements over 300 texts" (agree 5 300 0) 0))

; wordfreq.l0 -- the most frequent words of a text, with their counts.
;
; A word is a maximal run of ASCII letters, folded to lower case. Every other
; byte separates words. Words are ranked by count, highest first, and then
; bytewise, so the order is total.
;
; Counts live in a hash table of two arrays, keys and counts, with linear
; probing. It doubles when more than half full. A key is held as the list of
; its bytes in the order the scanner consed them, which is reversed, so a word
; is never reversed while counting, only once per distinct word at the end.
; An empty slot has count 0, since every word is counted at least once.

; ------------------------------------------------------------------ words

(def is_letter ((b int)) bool
  (if (ge b 97) (le b 122) (and (ge b 65) (le b 90))))

(def fold_case ((b int)) int
  (if (lt b 97) (add b 32) b))

; ------------------------------------------------------------ the table

; keys, counts, and how many slots are full.
(data Table
  (Table (array (list int)) (array int) int))

(def new_table ((cap int)) Table
  (Table (array_new cap (nil int)) (array_new cap 0) 0))

(def table_size ((t Table)) int
  (match t ((Table keys counts size) size)))

; A polynomial hash, wrapping, with the high half folded in so the low bits
; used by a power-of-two table depend on every byte.
(def hash_onto ((s (list int)) (h int)) int
  (if (is_empty s)
      (add h (div h 4294967296))
      (hash_onto (tail s) (mul (add h (head s)) 1099511628211))))

(def slot_of ((h int) (cap int)) int
  (let m (mod h cap)
    (if (lt m 0) (add m cap) m)))

(def next_slot ((i int) (cap int)) int
  (if (eq (add i 1) cap) 0 (add i 1)))

; Counts one more occurrence of key, a nonempty word.
(def count_word ((t Table) (key (list int))) Table
  (match t
    ((Table keys counts size)
      (let cap (array_len keys)
        (probe keys counts size key (slot_of (hash_onto key 0) cap))))))

(def probe ((keys (array (list int))) (counts (array int)) (size int)
            (key (list int)) (i int)) Table
  (let c (array_get counts i)
    (if (eq c 0)
        (grow_if_full
          (Table (array_set keys i key) (array_set counts i 1) (add size 1)))
        (if (list_eq (array_get keys i) key)
            (Table keys (array_set counts i (add c 1)) size)
            (probe keys counts size key (next_slot i (array_len keys)))))))

(def grow_if_full ((t Table)) Table
  (match t
    ((Table keys counts size)
      (if (gt (mul size 2) (array_len keys))
          (rehash keys counts 0 (new_table (mul 2 (array_len keys))))
          (Table keys counts size)))))

; Every full slot of keys and counts from i on, placed into t.
(def rehash ((keys (array (list int))) (counts (array int)) (i int) (t Table))
    Table
  (if (ge i (array_len keys))
      t
      (let c (array_get counts i)
        (if (eq c 0)
            (rehash keys counts (add i 1) t)
            (rehash keys counts (add i 1) (place t (array_get keys i) c))))))

; Puts key, known not to be in t, into t with count c.
(def place ((t Table) (key (list int)) (c int)) Table
  (match t
    ((Table keys counts size)
      (place_at keys counts size key c
        (slot_of (hash_onto key 0) (array_len keys))))))

(def place_at ((keys (array (list int))) (counts (array int)) (size int)
               (key (list int)) (c int) (i int)) Table
  (if (eq (array_get counts i) 0)
      (Table (array_set keys i key) (array_set counts i c) (add size 1))
      (place_at keys counts size key c (next_slot i (array_len keys)))))

; How many times t has counted key, given reversed as the table holds it.
(def lookup ((t Table) (key (list int))) int
  (match t
    ((Table keys counts size)
      (lookup_at keys counts key (slot_of (hash_onto key 0) (array_len keys))))))

(def lookup_at ((keys (array (list int))) (counts (array int)) (key (list int))
                (i int)) int
  (let c (array_get counts i)
    (if (eq c 0)
        0
        (if (list_eq (array_get keys i) key)
            c
            (lookup_at keys counts key (next_slot i (array_len keys)))))))

; ------------------------------------------------------------ scanning

(data Scanned
  (Scanned Table)
  (ScanFailed int))

; The word being read is cur, reversed. Counts it if there is one.
(def flush_word ((t Table) (cur (list int))) Table
  (if (is_empty cur) t (count_word t cur)))

; Every word of f counted into t, or the code of a failed read.
(def scan ((f IoFile) (t Table) (cur (list int))) Scanned
  (let b (file_read_byte f)
    (if (lt b 0)
        (if (eq b -1) (Scanned (flush_word t cur)) (ScanFailed b))
        (if (is_letter b)
            (scan f t (cons (fold_case b) cur))
            (scan f (flush_word t cur) (nil int))))))

(def count_file ((f IoFile)) Scanned
  (scan f (new_table 1024) (nil int)))

; ------------------------------------------------------------ ranking
;
; The distinct words are copied out forwards into words and counts, indexed
; 0 to n - 1, and a binary max-heap of those indices, by `before`, yields
; them best first. Building the heap is linear, so the top N of n distinct
; words costs n + N log n comparisons.

(data Ranked
  (Ranked (array (list int)) (array int)))

(def ranked ((t Table)) Ranked
  (match t
    ((Table keys counts size)
      (collect keys counts 0 (array_new size (nil int)) (array_new size 0) 0))))

(def collect ((keys (array (list int))) (counts (array int)) (i int)
              (ws (array (list int))) (cs (array int)) (j int)) Ranked
  (if (ge i (array_len keys))
      (Ranked ws cs)
      (let c (array_get counts i)
        (if (eq c 0)
            (collect keys counts (add i 1) ws cs j)
            (let k (array_get keys i)
              (collect (array_set keys i (nil int)) counts (add i 1)
                (array_set ws j (rev k))
                (array_set cs j c)
                (add j 1)))))))

; Byte-wise comparison: negative, zero, or positive. A proper prefix is first.
(def cmp_str ((a (list int)) (b (list int))) int
  (if (is_empty a)
      (if (is_empty b) 0 -1)
      (if (is_empty b)
          1
          (if (eq (head a) (head b))
              (cmp_str (tail a) (tail b))
              (sub (head a) (head b))))))

; Whether entry x ranks strictly before entry y.
(def before ((ws (array (list int))) (cs (array int)) (x int) (y int)) bool
  (let cx (array_get cs x)
    (let cy (array_get cs y)
      (if (eq cx cy)
          (lt (cmp_str (array_get ws x) (array_get ws y)) 0)
          (gt cx cy)))))

(def identity ((h (array int)) (i int)) (array int)
  (if (ge i (array_len h)) h (identity (array_set h i i) (add i 1))))

; Moves the entry at i down the first n elements of the heap h until
; neither child ranks before it.
(def sift ((ws (array (list int))) (cs (array int)) (h (array int)) (n int)
           (i int)) (array int)
  (let l (add (mul 2 i) 1)
    (if (ge l n)
        h
        (let r (add l 1)
          (let c (if (lt r n)
                     (if (before ws cs (array_get h r) (array_get h l)) r l)
                     l)
            (if (before ws cs (array_get h c) (array_get h i))
                (sift ws cs (swap h i c) n c)
                h))))))

(def swap ((h (array int)) (i int) (j int)) (array int)
  (let x (array_get h i)
    (let y (array_get h j)
      (array_set (array_set h i y) j x))))

(def heapify ((ws (array (list int))) (cs (array int)) (h (array int)) (i int))
    (array int)
  (if (lt i 0)
      h
      (heapify ws cs (sift ws cs h (array_len h) i) (sub i 1))))

; Writes "word count\n" to out for the best `limit` entries, or for all of
; them if limit is negative, and returns 0.
(def write_top ((out IoFile) (r Ranked) (limit int)) int
  (match r
    ((Ranked ws cs)
      (let n (array_len cs)
        (let h (heapify ws cs (identity (array_new n 0) 0) (sub (div n 2) 1))
          (pop_onto out ws cs h n (if (lt limit 0) n limit)))))))

; Writes the heap's best entry, among its first n, then the next, until
; `left` have been written or the heap is empty.
(def pop_onto ((out IoFile) (ws (array (list int))) (cs (array int))
               (h (array int)) (n int) (left int)) int
  (if (if (eq n 0) true (le left 0))
      0
      (let top (array_get h 0)
        (let w (write_entry out (array_get ws top) (array_get cs top))
          (pop_onto out ws cs
            (sift ws cs (swap h 0 (sub n 1)) (sub n 1) 0)
            (sub n 1) (sub left 1))))))

(def write_entry ((out IoFile) (w (list int)) (c int)) int
  (let a (file_write_str out w)
    (let b (file_write_byte out 32)
      (let d (file_write_str out (digits c))
        (file_write_byte out 10)))))

; ------------------------------------------------------------ arguments

; The count a command-line argument asks for: its value if it is all decimal
; digits, and at most 18 of them so it fits, or -1 if it is not.
(def parse_limit ((s (list int))) int
  (if (is_empty s)
      -1
      (if (gt (length s) 18) -1 (digits_value s 0))))

(def digits_value ((s (list int)) (acc int)) int
  (if (is_empty s)
      acc
      (if (is_digit (head s))
          (digits_value (tail s) (add (mul acc 10) (sub (head s) 48)))
          -1)))

; The whole report for a string, for tests: every word, or the best limit.
(def report ((s (list int)) (limit int)) (list int)
  (match (open_in_bytes s)
    ((IoFailed why) why)
    ((IoOpened f)
      (let r (count_file f)
        (let c (file_close f)
          (match r
            ((ScanFailed code) (io_error code))
            ((Scanned t) (render t limit))))))))

(def render ((t Table) (limit int)) (list int)
  (match (open_out_buffer)
    ((IoFailed why) why)
    ((IoOpened out)
      (let w (write_top out (ranked t) limit)
        (let s (buffer_contents out)
          (let c (file_close out) s))))))

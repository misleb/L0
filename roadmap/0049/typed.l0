; 0049's prototype of failures typed per operation, declared by the program,
; so it shadows nothing it does not name. A failure carries its case, for
; code to test with eq or match, and its words, for a message.
;
; Written with (eq f (OpenMissing)) in main, the mistake 0048 made, it does
; not compile:
;   error: the second argument of eq must be CreateFault, but this is OpenFault
; As below, it checks, and run where no/such/dir is missing it writes
; "input or output failed" and exits 2.
(data OpenFault (OpenMissing) (OpenDenied) (OpenFailed))
(data CreateFault (CreateDenied) (CreateFailed))

(data (Opened E)
  (Got IoFile)
  (Fail E (list int)))

(def create ((path (list int))) (Opened CreateFault)
  (let h (open_write path)
    (if (ge h 0)
        ((Got CreateFault) (IoFile h))
        (if (eq h -4)
            (Fail (CreateDenied) "permission denied")
            (Fail (CreateFailed) (io_error h))))))

(def open_for_reading ((path (list int))) (Opened OpenFault)
  (let h (open_read path)
    (if (ge h 0)
        ((Got OpenFault) (IoFile h))
        (if (eq h -3)
            (Fail (OpenMissing) "no such file")
            (if (eq h -4)
                (Fail (OpenDenied) "permission denied")
                (Fail (OpenFailed) (io_error h)))))))

; A missing store is an empty one; any other failure is reported.
(def store_size ((path (list int))) int
  (match (open_for_reading path)
    ((Fail f why) (if (eq f (OpenMissing)) 0 -1))
    ((Got file) (let c (file_close file) 1))))

; Exits 2 for the failure creating a file in a missing directory is, and
; writes the words beside it; then 0 for a store that does not exist.
(def main () int
  (match (create "no/such/dir/notes")
    ((Fail f why)
      (let w (write_line why)
        (if (eq f (CreateFailed)) (if (eq (store_size "absent") 0) 2 3) 1)))
    ((Got file) (file_close file))))

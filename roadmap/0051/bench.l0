; Times 0051's two prototypes on n distinct string keys: n puts, then n gets.
; tools/l0 build roadmap/0051/map.l0 roadmap/0051/bench.l0 -o tmp/bench, then
; tmp/bench 1000000.

(def str_hash ((s (list int)) (h int)) int
  (if (is_empty s) h (str_hash (tail s) (add (mul h 31) (head s)))))

(def key ((i int)) (list int) (append "key" (digits i)))

(def keys_onto ((i int) (acc (list (list int)))) (list (list int))
  (if (lt i 0) acc (keys_onto (sub i 1) (cons (key i) acc))))

(def fill_map ((m (Map (list int) int)) (ks (list (list int))) (i int))
    (Map (list int) int)
  (if (is_empty ks)
      m
      (fill_map (map_put m (str_hash (head ks) 7) (head ks) i) (tail ks) (add i 1))))

(def found_in_map ((m (Map (list int) int)) (ks (list (list int))) (n int)) int
  (if (is_empty ks)
      n
      (found_in_map m (tail ks)
        (match (map_get m (str_hash (head ks) 7) (head ks))
          ((None) n)
          ((Some v) (add n 1))))))

(def fill_trie ((t (Trie (list int) int)) (ks (list (list int))) (i int))
    (Trie (list int) int)
  (if (is_empty ks)
      t
      (fill_trie (trie_put t (path_of (str_hash (head ks) 7)) 16 (head ks) i)
                 (tail ks) (add i 1))))

(def found_in_trie ((t (Trie (list int) int)) (ks (list (list int))) (n int)) int
  (if (is_empty ks)
      n
      (found_in_trie t (tail ks)
        (match (trie_get t (path_of (str_hash (head ks) 7)) 16 (head ks))
          ((None) n)
          ((Some v) (add n 1))))))

(def ms ((t0 int) (t1 int)) (list int) (digits (div (sub t1 t0) 1000000)))

(def report ((what (list int)) (put (list int)) (get (list int)) (found int)) int
  (write_line (append what (append ": put " (append put (append " ms, get "
    (append get (append " ms, found " (digits found)))))))))

(def main () int
  (let n (int_prefix (arg 0) 0)
    (let ks (keys_onto (sub n 1) (nil (list int)))
      (let t0 (clock_ns)
        (let m (fill_map ((MapEmpty (list int) int)) ks 0)
          (let t1 (clock_ns)
            (let a (found_in_map m ks 0)
              (let t2 (clock_ns)
                (let r1 (report "table in arrays" (ms t0 t1) (ms t1 t2) a)
                  (let t3 (clock_ns)
                    (let t (fill_trie ((TLeaf (list int) int)) ks 0)
                      (let t4 (clock_ns)
                        (let b (found_in_trie t ks 0)
                          (let t5 (clock_ns)
                            (let r2 (report "persistent trie" (ms t3 t4) (ms t4 t5) b)
                              0)))))))))))))))

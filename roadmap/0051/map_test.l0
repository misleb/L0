; Tests of 0051's prototypes, at string and data keys and int values.

(def str_hash ((s (list int)) (h int)) int
  (if (is_empty s) h (str_hash (tail s) (add (mul h 31) (head s)))))

(def hs ((s (list int))) int (str_hash s 7))

(def get_or ((o (Option int)) (d int)) int
  (match o ((None) d) ((Some x) x)))

(def test_map_strings () int
  (let m (map_put (map_put (map_put ((MapEmpty (list int) int)) (hs "a") "a" 1)
                   (hs "b") "b" 2) (hs "a") "a" 3)
    (add (check_int "a replaced" (get_or (map_get m (hs "a") "a") -1) 3)
      (add (check_int "b" (get_or (map_get m (hs "b") "b") -1) 2)
        (add (check_int "missing" (get_or (map_get m (hs "c") "c") -1) -1)
             (check_int "size" (map_size m) 2))))))

; Every key hashed alike, so every lookup must compare keys with eq.
(def test_map_collisions () int
  (let m (map_put (map_put (map_put ((MapEmpty (list int) int)) 5 "x" 1) 5 "y" 2) 5 "z" 3)
    (add (check_int "x" (get_or (map_get m 5 "x") -1) 1)
      (add (check_int "z" (get_or (map_get m 5 "z") -1) 3)
           (check_int "w" (get_or (map_get m 5 "w") -1) -1)))))

(def fill_map ((m (Map int int)) (i int) (n int)) (Map int int)
  (if (ge i n) m (fill_map (map_put m (mul i 7919) i (mul i i)) (add i 1) n)))

(def check_all ((m (Map int int)) (i int) (n int) (bad int)) int
  (if (ge i n)
      bad
      (check_all m (add i 1) n
        (if (eq (get_or (map_get m (mul i 7919) i) -1) (mul i i)) bad (add bad 1)))))

; Many keys, so the table grows several times and moves every entry; key 0
; hashes to 0, which caught a slot computed from the hash rather than its mark.
(def test_map_grows () int
  (let m (fill_map ((MapEmpty int int)) 0 10000)
    (add (check_int "size" (map_size m) 10000)
         (check_int "all found" (check_all m 0 10000 0) 0))))

(def test_map_data_keys () int
  (let m (map_put (map_put ((MapEmpty (Option (list int)) int)) 1 (Some "a") 10)
                  1 ((None (list int))) 20)
    (add (check_int "some" (get_or (map_get m 1 (Some "a")) -1) 10)
         (check_int "none" (get_or (map_get m 1 ((None (list int)))) -1) 20))))

(def test_trie () int
  (let t (trie_put (trie_put (trie_put ((TLeaf (list int) int)) (path_of (hs "a")) 16 "a" 1)
                     (path_of (hs "b")) 16 "b" 2) (path_of (hs "a")) 16 "a" 3)
    (add (check_int "a replaced" (get_or (trie_get t (path_of (hs "a")) 16 "a") -1) 3)
      (add (check_int "b" (get_or (trie_get t (path_of (hs "b")) 16 "b") -1) 2)
           (check_int "missing" (get_or (trie_get t (path_of (hs "c")) 16 "c") -1) -1)))))

; Limit 06c: after standard output's flush has failed on a broken pipe, go
; on writing to a file, as tee does for its other outputs, and say on
; standard error how far it got. Run as
;
;   06c-sigpipe-then-file OUT | head -c 10
;
; It should write 1,000,000 bytes to OUT and exit 3.

(def to_stdout ((n int)) int
  (let w (write_byte 121)
    (if (eq (mod (add n 1) 65536) 0)
        (if (lt (file_flush (IoFile 1)) 0) (add n 1) (to_stdout (add n 1)))
        (to_stdout (add n 1)))))

(def to_file ((f IoFile) (n int)) int
  (if (eq n 1000000)
      n
      (let w (file_write_byte f 120)
        (if (eq (mod (add n 1) 65536) 0)
            (let r (file_flush f)
              (let e (write_err (append "file flushed at " (append (digits (add n 1)) "\n")))
                (to_file f (add n 1))))
            (to_file f (add n 1))))))

(def main () int
  (let k (to_stdout 0)
    (let e (write_err (append "standard output failed after " (append (digits k) " bytes\n")))
      (match (open_out (arg 0))
        ((IoFailed fault why) 1)
        ((IoOpened f)
          (let n (to_file f 0)
            (let c (file_close f)
              (let e2 (write_err (append "file done: " (append (digits n) "\n")))
                3))))))))

; big_test.l0 -- tests of big.l0, and of the calculator past 64 bits.
; Expected values are from Python (../ref/pycalc.py without --int64).

(def nat ((s (list int))) (list int) (nat_of_digits s (nil int)))

(def test_nat_round_trip () int
  (add (check_str "zero" (nat_digits (nat "0")) "0")
    (add (check_str "padded limb" (nat_digits (nat "1000000000000000001")) "1000000000000000001")
         (check_str "leading zeros" (nat_digits (nat "000042")) "42"))))

(def test_nat_add_carry () int
  (check_str "carry" (nat_digits (nat_add (nat "999999999999999999") (nat "1")))
    "1000000000000000000"))

(def test_nat_sub_borrow () int
  (add (check_str "borrow" (nat_digits (nat_sub (nat "1000000000000000000") (nat "1")))
         "999999999999999999")
       (check_str "to zero" (nat_digits (nat_sub (nat "123456789123") (nat "123456789123"))) "0")))

(def test_nat_mul () int
  (check_str "2^64 squared"
    (nat_digits (nat_mul (nat "18446744073709551616") (nat "18446744073709551616")))
    "340282366920938463463374607431768211456"))

(def test_nat_divmod () int
  (match (nat_divmod (nat "340282366920938463463374607431768211457") (nat "18446744073709551616"))
    ((NatQR q r)
      (add (check_str "quotient" (nat_digits q) "18446744073709551616")
           (check_str "remainder" (nat_digits r) "1")))))

(def test_nat_cmp () int
  (add (check_int "less" (nat_cmp (nat "999999999") (nat "1000000000")) -1)
    (add (check_int "equal" (nat_cmp (nat "1000000000") (nat "1000000000")) 0)
         (check_int "greater" (nat_cmp (nat "1000000001") (nat "1000000000")) 1))))

(def test_nat_gcd () int
  (check_str "gcd" (nat_digits (nat_gcd (nat "36893488147419103232") (nat "1180591620717411303424")))
    "36893488147419103232"))

(def test_brat_lowest_terms () int
  (check_str "6/4" (show_brat (brat_make (big_of_int 6) (big_of_int -4))) "-3/2"))

(def test_brat_decimal () int
  (check_str "1/3" (big_decimal (brat_make (big_of_int 1) (big_of_int 3)) 20)
    "0.33333333333333333333"))

; ---------------------------------------------------- the calculator, exact

(def test_exact_literal () int
  (check_str "2^63" (calc_line true "9223372036854775808")
    "9223372036854775808 = 9223372036854775808.00000000000000000000"))

(def test_exact_add () int
  (check_str "max+1" (calc_line true "9223372036854775807 + 1")
    "9223372036854775808 = 9223372036854775808.00000000000000000000"))

(def test_exact_most_negative () int
  (check_str "-2^62*2" (calc_line true "-4611686018427387904 * 2")
    "-9223372036854775808 = -9223372036854775808.00000000000000000000"))

(def test_exact_mul () int
  (check_str "square" (calc_line true "3037000500 * 3037000500")
    "9223372037000250000 = 9223372037000250000.00000000000000000000"))

(def test_exact_tiny () int
  (add (check_str "2^-64" (calc_line true "1/4294967296 * 1/4294967296")
         "1/18446744073709551616 = 0.00000000000000000005")
       (check_str "difference" (calc_line true "1/4294967295 - 1/4294967296")
         "1/18446744069414584320 = 0.00000000000000000005")))

; Past 64 bits and back: the big result is made small again.
(def test_exact_comes_back () int
  (check_str "back" (calc_line true "9223372036854775807 * 4 / 8")
    "9223372036854775807/2 = 4611686018427387903.50000000000000000000"))

(def test_exact_division_by_zero () int
  (check_str "big/0" (calc_line true "99999999999999999999 / (1 - 1)")
    "error: division by zero"))

(def test_exact_long () int
  (check_str "2^100"
    (calc_line true "1024*1024*1024*1024*1024*1024*1024*1024*1024*1024 / 3")
    "1267650600228229401496703205376/3 = 422550200076076467165567735125.33333333333333333333"))

; What the board's host gives: the clock, arguments, and a file open.
(def line ((xs (list int))) (list int)
  (append xs (cons 10 (nil int))))

(def spin ((n int)) int
  (if (eq n 0) 0 (spin (sub n 1))))

(def main ((input (list int))) (list int)
  (let t0 (clock_ns)
    (let s (spin 10000000)
      (let t1 (clock_ns)
        (append (line (digits (sub t1 t0)))
          (append (line (digits (arg_count)))
            (line (digits (open_read (cons 120 (nil int)))))))))))

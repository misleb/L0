; The shape of an L0 kernel's loop, today, with user_run simulated: a table
; of three threads' contexts, 102 words each as kernel.ll's are, and one
; trap per iteration. sim_run stands for the proposed builtin: it consumes a
; context and returns it, updated, with the trap's ESR in word 35.
;
; tools/l0 run roadmap/0074/progs/kloop.l0 -- MODE N, with L0_ARRAY_STATS=1
; to see whether the table copies. MODE is
;   natural  (array_set g t (sim_run (array_get g t) k)), as written plainly
;   take     the context taken out of the table first, a placeholder left in
;            its place, so the table no longer holds it while it runs
;   trap     take, and the ESR decoded into a Trap value, as a library would
; Writes N and the nanoseconds per iteration.

(data Trap
  (Syscall int)
  (Fault int int)
  (Interrupt)
  (Unknown int))

(def sim_run ((c (array int)) (k int)) (array int)
  (let pc (array_get c 32)
    (array_set (array_set c 32 (add pc 4)) 35 (bit_or (bit_shl 21 26) (mod k 4)))))

(def trap_of ((c (array int))) Trap
  (let esr (array_get c 35)
    (let ec (bit_and (bit_shr esr 26) 63)
      (if (eq ec 21)
          (Syscall (array_get c 8))
          (if (eq ec 36)
              (Fault esr (array_get c 32))
              (if (lt esr 0) (Interrupt) (Unknown esr)))))))

(def cost ((t Trap)) int
  (match t
    ((Syscall n) 1)
    ((Fault e pc) 2)
    ((Interrupt) 3)
    ((Unknown e) 4)))

(def natural ((g (array (array int))) (k int) (n int)) (array (array int))
  (if (ge k n)
      g
      (let t (mod k 3)
        (natural (array_set g t (sim_run (array_get g t) k)) (add k 1) n))))

(def take ((g (array (array int))) (hole (array int)) (k int) (n int)) (array (array int))
  (if (ge k n)
      g
      (let t (mod k 3)
        (let c (array_get g t)
          (let g1 (array_set g t hole)
            (take (array_set g1 t (sim_run c k)) hole (add k 1) n))))))

(def trap ((g (array (array int))) (hole (array int)) (k int) (n int) (acc int)) int
  (if (ge k n)
      (add acc (array_get (array_get g 0) 32))
      (let t (mod k 3)
        (let c (array_get g t)
          (let g1 (array_set g t hole)
            (let c1 (sim_run c k)
              (let a (add acc (cost (trap_of c1)))
                (trap (array_set g1 t c1) hole (add k 1) n a))))))))

(def table () (array (array int))
  (array_new 3 (array_new 102 0)))

(def parse ((s (list int)) (acc int)) int
  (if (is_empty s)
      acc
      (parse (tail s) (add (mul acc 10) (sub (head s) 48)))))

(def run ((mode (list int)) (n int)) int
  (if (eq mode "natural")
      (array_len (natural (table) 0 n))
      (if (eq mode "take")
          (array_len (take (table) (array_new 0 0) 0 n))
          (trap (table) (array_new 0 0) 0 n 0))))

(def main () int
  (let mode (arg 0)
    (let n (parse (arg 1) 0)
      (let t0 (clock_ns)
        (let r (run mode n)
          (let t1 (clock_ns)
            (let w (write_line (digits n))
              (let v (write_line (digits (div (sub t1 t0) n)))
                (mod r 2)))))))))

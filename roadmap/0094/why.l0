; What L0S's font tool would write, if L0 had floating point: the point on a
; circle at any angle, where shape.l0 can only take a multiple of 5 degrees
; from a table of sines in 1/65536 (L0S, tools/mkfont/shape.l0:144).

(def radians ((deg int)) float
  (float_div (float_mul (float_from_int deg) 3.141592653589793) 180.0))

(def on_circle_x ((cx int) (r int) (deg int)) int
  (add cx (float_to_int (float_mul (float_from_int r) (float_cos (radians deg))))))

(def on_circle_y ((cy int) (r int) (deg int)) int
  (add cy (float_to_int (float_mul (float_from_int r) (float_sin (radians deg))))))

(def main () int
  (on_circle_x 0 1000 37))

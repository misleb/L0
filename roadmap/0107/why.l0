; What L0S would write, if L0 could slice and join bytes (L0S,
; probes/bytes/want.l0, cut down to stand alone): a received message's
; payload split off as bytes of its own, and a text header joined to a
; body, neither through a list.

(def msg_payload ((b bytes)) bytes
  (bytes_slice b 4 (bytes_len b)))

(def write_request ((h (list int)) (written bytes)) bytes
  (bytes_concat (cons (bytes_from_list (append "write " (append h " ")))
                      (cons written (nil bytes)))))

(def main () int
  (let r (write_request "3" (msg_payload (bytes_from_list "pid!hello")))
    (write_bytes 1 r 0 (bytes_len r))))

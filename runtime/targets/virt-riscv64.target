# QEMU's riscv64 virt board, with no operating system, entered by its
# default firmware, OpenSBI: l0 build --target virt --arch riscv64.
# tools/targets.sh says what each variable means. OpenSBI prints a banner
# on QEMU's own standard output at every boot, so the serial line has a
# descriptor of its own (T_SERIAL=fd3).
T_KIND=board
T_ARCH=riscv64
T_TRIPLE=riscv64-unknown-elf
T_CFLAGS="-march=rv64gc -mabi=lp64d -mcmodel=medany -mno-relax"
T_TAIL_WORDS=13
T_PARTS="bare/board.ll bare/semihost.ll dev/plic.ll dev/ns16550.ll board/virt-riscv64.ll arch/riscv64/boot.ll"
T_LAYOUT=board/virt-riscv64.ld
T_LDFLAGS="--oformat binary"
T_MAGIC=52534305
T_QEMU=qemu-system-riscv64
T_QEMU_ARGS="-M virt,aia=none -m 3G -semihosting -global virtio-mmio.force-legacy=false"
T_SERIAL=fd3
T_INPUT_LEN_AT=0x83FFFFF8
T_INPUT_AT=0x84000000
T_INPUT_MAX=134217720

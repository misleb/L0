; Type errors. Each snippet is a whole program, so main is always present
; except where its absence is the case under test.
;
; The checker reports at most one error per declaration and keeps going, so a
; snippet with several bad declarations yields several lines.

; Wraps an expression as the body of a valid main.
(def m ((body (list int))) (list int)
  (append "(def main ((input (list int))) int " (append body ")")))

; Appends a trivial main, so a snippet under test can be a non-main
; declaration without also tripping the missing-main check.
(def both ((decl (list int))) (list int)
  (append decl " (def main ((input (list int))) int 0)"))

(def main ((input (list int))) (list int)
  (let a (push (check_source (m "(if 1 2 3)")) (nil int))
  (let b (push (check_source (m "(if true 1 false)")) a)
  (let c (push (check_source (m "(add 1 true)")) b)
  (let d (push (check_source (m "(add 1)")) c)
  (let e (push (check_source (m "(add 1 2 3)")) d)
  (let f (push (check_source (m "(neg true)")) e)
  (let g (push (check_source (m "(not 1)")) f)
  (let h (push (check_source (m "(lt true false)")) g)
  (let i (push (check_source (m "(cons true (nil int))")) h)
  (let j (push (check_source (m "(cons 1 2)")) i)
  (let k (push (check_source (m "(head 1)")) j)
  (let l (push (check_source (m "(head (nil bool))")) k)
  (let n (push (check_source (m "nope")) l)
  (let o (push (check_source (m "(nope 1)")) n)
  (let p (push (check_source (m "(input 1)")) o)
  (let q (push (check_source (m "input")) p)
  (let r (push (check_source (m "true")) q)
  (let s (push (check_source (both "(def f ((a int) (a int)) int a)")) r)
  (let t (push (check_source (append "(def f ((a int)) int a) "
                              (both "(def f ((a int)) int a)"))) s)
  (let u (push (check_source "(def f ((a int)) int a)") t)
  (let v (push (check_source "(def main ((a int)) int 0)") u)
  (let w (push (check_source "(def main ((input (list int))) bool 0)") v)
  (let x (push (check_source
            "(def main ((input (list int))) (list bool) (nil bool))") w)
  (let y (push (check_source (append "(def f ((a int)) int (g a)) "
                              (both "(def g ((a bool)) int 0)"))) x)
  (let z (push (check_source (both "(def f ((a int)) int (f a a))")) y)
  (let aa (push (check_source_lib
             "(def f ((a int)) int a) (def main ((a int) (b int)) int 0)") z)
  (let ab (push (check_source_lib
             "(def main ((input (list int))) (list bool) (nil bool))") aa)
  (let ac (push (check_source (m "(write_byte true)")) ab)
  (let ad (push (check_source (m "(read_byte 1)")) ac)
  (let ae (push (check_source "(def main () bool true)") ad)
  ; Io names are not reserved (spec 7.1), so these check.
  (let af (push (check_source (both "(data IoThing (Thing int))")) ae)
  (let ag (push (check_source (both "(data Iota (IoB int))")) af)
  (let ah (push (check_source_pre
             "(data IoOk (IoYes int)) (def main ((input (list int))) int 0)"
             true 24) ag)
  (let ai (push (check_source (m "(open_read 1)")) ah)
  (let aj (push (check_source (both (wide_data 32))) ai)
  (let ak (push (check_source (m "(flush true)")) aj)
  (let al (push (check_source (m "(open_append 1)")) ak)
  (let an (push (check_source (m "(rename \"a\" 2)")) al)
  (let ao (push (check_source (m "(rename \"a\")")) an)
  (let ap (push (check_source (m "(open_bytes 1)")) ao)
  (let aq (push (check_source (m "(open_buffer 1)")) ap)
  (let ar (push (check_source (m "(buffer_bytes 1)")) aq)
  (let as (push (check_source (m "(array_len (array_new true 1))")) ar)
  (let at (push (check_source (m "(array_get 1 0)")) as)
  (let au (push (check_source (m "(array_get (array_new 2 0) true)")) at)
  (let av (push (check_source (m "(array_len (array_set (array_new 2 0) 0 true))")) au)
  (let aw (push (check_source (m "(array_len (array_new 2 0) 1)")) av)
  (let ax (push (check_source (m "(let array 1 array)")) aw)
  (let ay (push (check_source (both "(def f ((a (vec int))) int 0)")) ax)
  (let az (push (check_source (m "(bytes_get \"abc\" 0)")) ay)
  (let ba (push (check_source (m "(bytes_len (bytes_from_list \"a\") 1)")) az)
  (let bb (push (check_source (m "(if (eq (bytes_from_list \"a\") \"a\") 1 0)")) ba)
  (let bc (push (check_source (m "(write_bytes 1 (bytes_from_list \"a\") 0 true)")) bb)
  (let bd (push (check_source (m "(bytes_len (read_bytes true))")) bc)
  (let be (push (check_source (both "(def f ((bytes bytes)) int (bytes_len bytes))")) bd)
  (let bf (push (check_source "(def main () bytes (read_bytes 0))") be)
  (let bg (push (check_source (m "(clock_ns 1)")) bf)
  (let bh (push (check_source (m "(head (clock_ns))")) bg)
  (let bi (push (check_source (m "(sub (clock_ns) (clock_ns))")) bh)
  (let bj (push (check_source (m "(hash)")) bi)
  (let bk (push (check_source (m "(hash 1 2)")) bj)
  (let bl (push (check_source (m "(head (hash \"a\"))")) bk)
  (let bm (push (check_source (m "(bit_and true 1)")) bl)
  (let bn (push (check_source (m "(bit_xor 1 \"a\")")) bm)
  (let bo (push (check_source (m "(bit_shl 1)")) bn)
  (let bp (push (check_source (m "(bit_count 1 2)")) bo)
  (let bq (push (check_source (m "(head (bit_count 1))")) bp)
  (let br (push (check_source (m "(remove 1)")) bq)
  (let bs (push (check_source (m "(remove \"a\" \"b\")")) br)
  (let bt (push (check_source (m "(compare 1 true)")) bs)
  (let bu (push (check_source (m "(compare \"a\" 1)")) bt)
  (let bv (push (check_source (m "(compare 1)")) bu)
  (let bw (push (check_source (m "(head (compare 1 2))")) bv)
  (let bx (push (check_source (m "(bytes_len (read_some 0))")) bw)
  (let by (push (check_source (m "(bytes_len (read_some 0 true))")) bx)
  (let bz (push (check_source (m "(region_open 1)")) by)
  (let ca (push (check_source (m "(region_read32 1 true)")) bz)
  (let cb (push (check_source (m "(region_write8 1 2)")) ca)
  (let cc (push (check_source (m "(barrier 1)")) cb)
  (let cd (push (check_source (m "(head (region_read64 1 2))")) cc)
  (let ce (push (check_source (m "(space_new 1)")) cd)
  (let cf (push (check_source (m "(space_map 1 2 3)")) ce)
  (let cg (push (check_source (m "(space_map 1 2 3 true)")) cf)
  (let ch (push (check_source (m "(space_map_device 1 2 3)")) cg)
  (let ci (push (check_source (m "(bytes_len (space_read 1 2 true))")) ch)
  (let cj (push (check_source (m "(space_write 1 2 \"a\" 0 1)")) ci)
  (let ck (push (check_source (m "(array_len (user_run 1 (array_new 104 true)))")) cj)
  (let cl (push (check_source (m "(head (user_run 1 (array_new 104 0)))")) ck)
  (let cm (push (check_source (m "(timer_at)")) cl)
  (let cn (push (check_source (m "(interrupt_wait 1)")) cm)
  (let co (push (check_source (m "(interrupt_enable true)")) cn)
  (let cp (push (check_source (m "(head (interrupt_done 0))")) co)
    (rev cp))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))

; A data declaration whose one constructor has n int fields.
(def wide_data ((n int)) (list int)
  (append "(data Wide (W" (append (int_fields n) "))")))

(def int_fields ((n int)) (list int)
  (if (le n 0) "" (append " int" (int_fields (sub n 1)))))

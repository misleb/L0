(def ping ((n int) (a int) (b int)) int
  (if (eq n 0) (add a b) (pong (sub n 1) a)))
(def pong ((n int) (a int)) int
  (let m (if (lt n 5) n 5)
    (ping n a m)))
(data Box (Full int) (Empty))
(def open ((b Box)) int
  (match b ((Full x) (lone x)) ((Empty) 0)))
(def lone ((x int)) int (add x 1))
(def main ((input (list int))) int
  (add (lone 1) (add (pong 3 0) (open (Full 2)))))

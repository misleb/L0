; prelude.l0 -- list and byte-string helpers shared across the compiler.
;
; Everything here operates on (list int). L0's data types are monomorphic and
; list is its only parametric type constructor, so helpers for lists of
; tokens, declarations, and so on live next to those types instead.
;
; Output is always built with the reversed-accumulator idiom from spec section
; 11.1: push chunks onto a backwards list, reverse exactly once at the end.
; Using append to build output would make the compiler quadratic in the size of
; its own output.

(def rev_onto ((xs (list int)) (acc (list int))) (list int)
  (if (is_empty xs)
      acc
      (rev_onto (tail xs) (cons (head xs) acc))))

(def rev ((xs (list int))) (list int)
  (rev_onto xs (nil int)))

; Pushes a chunk onto a reversed accumulator. Costs the length of the chunk,
; never the length of the accumulator.
(def push ((chunk (list int)) (acc (list int))) (list int)
  (if (is_empty chunk)
      acc
      (push (tail chunk) (cons (head chunk) acc))))

; Ordinary concatenation. Only for short strings such as diagnostics, never
; for building compiler output.
(def append ((xs (list int)) (ys (list int))) (list int)
  (if (is_empty xs)
      ys
      (cons (head xs) (append (tail xs) ys))))

(def length ((xs (list int))) int
  (if (is_empty xs)
      0
      (add 1 (length (tail xs)))))

(def list_eq ((xs (list int)) (ys (list int))) bool
  (if (is_empty xs)
      (is_empty ys)
      (if (is_empty ys)
          false
          (if (eq (head xs) (head ys))
              (list_eq (tail xs) (tail ys))
              false))))

(def int_min ((ignored int)) int -9223372036854775808)

; n is known non-negative here.
(def digits_onto ((n int) (acc (list int))) (list int)
  (if (lt n 10)
      (cons (add 48 n) acc)
      (digits_onto (div n 10) (cons (add 48 (mod n 10)) acc))))

; Decimal rendering. The most negative integer is special-cased because
; negating it wraps back to itself, per spec section 6.1.
(def digits ((n int)) (list int)
  (if (eq n (int_min 0))
      "-9223372036854775808"
      (if (lt n 0)
          (cons 45 (digits_onto (neg n) (nil int)))
          (digits_onto n (nil int)))))

; ------------------------------------------------------------------ slicing

(def drop_n ((xs (list int)) (n int)) (list int)
  (if (le n 0)
      xs
      (if (is_empty xs) xs (drop_n (tail xs) (sub n 1)))))

(def starts_with ((s (list int)) (prefix (list int))) bool
  (if (is_empty prefix)
      true
      (if (is_empty s)
          false
          (if (eq (head s) (head prefix))
              (starts_with (tail s) (tail prefix))
              false))))

; Up to but not including the next newline.
(def take_line_onto ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s)
      (rev acc)
      (if (eq (head s) 10)
          (rev acc)
          (take_line_onto (tail s) (cons (head s) acc)))))

(def take_line ((s (list int))) (list int)
  (take_line_onto s (nil int)))

; Everything after the next newline.
(def drop_line ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (eq (head s) 10)
          (tail s)
          (drop_line (tail s)))))

(def skip_digits ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (is_digit (head s)) (skip_digits (tail s)) s)))

(def skip_spaces ((s (list int))) (list int)
  (if (is_empty s)
      s
      (if (eq (head s) 32) (skip_spaces (tail s)) s)))

; Leading decimal digits as a number; 0 if there are none.
(def int_prefix ((s (list int)) (acc int)) int
  (if (is_empty s)
      acc
      (if (is_digit (head s))
          (int_prefix (tail s) (add (mul acc 10) (sub (head s) 48)))
          acc)))

; ------------------------------------------------------------ word tables
;
; Membership tests against a fixed set of names are common in a compiler.
; Written as a chain of or, they nest ten deep and are a reliable source of
; miscounted parentheses. Splitting one space-separated literal keeps the
; table flat and readable.

(def rev_strs_onto ((xs (list (list int))) (acc (list (list int))))
    (list (list int))
  (if (is_empty xs)
      acc
      (rev_strs_onto (tail xs) (cons (head xs) acc))))

(def split_spaces_onto ((s (list int)) (cur (list int))
                        (acc (list (list int)))) (list (list int))
  (if (is_empty s)
      (if (is_empty cur) acc (cons (rev cur) acc))
      (if (eq (head s) 32)
          (split_spaces_onto (tail s) (nil int)
            (if (is_empty cur) acc (cons (rev cur) acc)))
          (split_spaces_onto (tail s) (cons (head s) cur) acc))))

(def split_spaces ((s (list int))) (list (list int))
  (rev_strs_onto (split_spaces_onto s (nil int) (nil (list int)))
                 (nil (list int))))

(def any_eq ((n (list int)) (candidates (list (list int)))) bool
  (if (is_empty candidates)
      false
      (if (list_eq n (head candidates))
          true
          (any_eq n (tail candidates)))))

; Position of n in candidates, or -1. Used for builtin dispatch tables.
(def index_of_from ((n (list int)) (candidates (list (list int))) (i int)) int
  (if (is_empty candidates)
      -1
      (if (list_eq n (head candidates))
          i
          (index_of_from n (tail candidates) (add i 1)))))

(def index_of ((n (list int)) (candidates (list (list int)))) int
  (index_of_from n candidates 0))

; ---------------------------------------------------------------- character
; classes, by byte value

(def is_space ((c int)) bool
  (or (eq c 32)
      (or (eq c 9)
          (or (eq c 10) (eq c 13)))))

(def is_digit ((c int)) bool
  (and (ge c 48) (le c 57)))

(def is_lower ((c int)) bool
  (or (and (ge c 97) (le c 122)) (eq c 95)))

(def is_upper ((c int)) bool
  (and (ge c 65) (le c 90)))

(def is_name_start ((c int)) bool
  (or (is_lower c) (is_upper c)))

(def is_name_rest ((c int)) bool
  (or (is_name_start c) (is_digit c)))

(def hex_val ((c int)) int
  (if (is_digit c)
      (sub c 48)
      (if (and (ge c 97) (le c 102))
          (add 10 (sub c 97))
          (if (and (ge c 65) (le c 70))
              (add 10 (sub c 65))
              -1))))
; io.l0 -- lines, strings, arguments, and files, over the I/O builtins of
; spec sections 6.2 to 6.4.
;
; tools/l0 links this into every program, in the prelude group alongside
; lib/prelude.l0, so a program may define its own read_line and keep calling
; it. It is a separate file because the compiler is built from
; lib/prelude.l0, and the stage-0 interpreter that runs the compiler for
; tools/l0check does not know the I/O builtins.

; The next line of standard input, including its newline if it has one. The
; empty list means end of input, and nothing else does: a blank line is "\n",
; and a last line with no newline comes back without one.
(def read_line () (list int)
  (rev (read_line_onto (nil int))))

(def read_line_onto ((acc (list int))) (list int)
  (let b (read_byte)
    (if (lt b 0)
        acc
        (if (eq b 10)
            (cons b acc)
            (read_line_onto (cons b acc))))))

; Writes every byte of s, in order, and returns 0.
(def write_str ((s (list int))) int
  (if (is_empty s)
      0
      (let w (write_byte (head s))
        (write_str (tail s)))))

; Writes s followed by a newline, and returns 0.
(def write_line ((s (list int))) int
  (let w (write_str s)
    (write_byte 10)))

; Writes every byte of s to standard error, and returns 0.
(def write_err ((s (list int))) int
  (write_to_handle 2 s))

(def write_to_handle ((h int) (s (list int))) int
  (if (is_empty s)
      0
      (let w (write_to h (head s))
        (write_to_handle h (tail s)))))

; ------------------------------------------------------------------ arguments

; Every command-line argument, in order, not counting the program's name.
(def args () (list (list int))
  (args_from 0 (arg_count)))

(def args_from ((i int) (n int)) (list (list int))
  (if (ge i n)
      (nil (list int))
      (cons (arg i) (args_from (add i 1) n))))

; ---------------------------------------------------------------------- files
;
; A file is an IoFile rather than a bare handle, so the checker can tell one
; from any other int. Opening returns IoOpened, whose IoFailed case a match
; has to handle, so a program cannot forget that opening can fail. Names
; beginning with Io are reserved for this library; spec section 7.1.

(data IoFile
  (IoFile int))

(data IoOpened
  (IoOpened IoFile)
  (IoFailed (list int)))

; Opens a file for reading.
(def open_in ((path (list int))) IoOpened
  (opened (open_read path)))

; Creates a file, or empties it if it exists, and opens it for writing.
(def open_out ((path (list int))) IoOpened
  (opened (open_write path)))

(def opened ((h int)) IoOpened
  (if (lt h 0)
      (IoFailed (io_error h))
      (IoOpened (IoFile h))))

; What a negative result from an I/O builtin means. Spec section 6.3.
(def io_error ((code int)) (list int)
  (if (eq code -1)
      "end of input"
      (if (eq code -2)
          "not open in that direction"
          (if (eq code -3)
              "no such file"
              (if (eq code -4)
                  "permission denied"
                  "input or output failed")))))

; The next byte of f, or -1 at end of input, or another negative code.
(def file_read_byte ((f IoFile)) int
  (match f ((IoFile h) (read_from h))))

; Writes one byte to f, and returns 0, or a negative code.
(def file_write_byte ((f IoFile) (b int)) int
  (match f ((IoFile h) (write_to h b))))

; Writes every byte of s to f, and returns 0.
(def file_write_str ((f IoFile) (s (list int))) int
  (match f ((IoFile h) (write_to_handle h s))))

; The next line of f, as read_line reads standard input.
(def file_read_line ((f IoFile)) (list int)
  (match f ((IoFile h) (rev (read_line_from h (nil int))))))

(def read_line_from ((h int) (acc (list int))) (list int)
  (let b (read_from h)
    (if (lt b 0)
        acc
        (if (eq b 10)
            (cons b acc)
            (read_line_from h (cons b acc))))))

; Closes f. Returns 0, or a negative code if bytes written to it were lost.
(def file_close ((f IoFile)) int
  (match f ((IoFile h) (close h))))
; examples.l0 -- worked L0 programs, for reading.
;
; Every declaration here compiles. This file is checked by the L0 project's
; own test suite, so nothing in it can quietly rot into something that no
; longer works.
;
; It is meant to be read rather than linked. The names would collide with
; your own, and the standard library it uses is already linked for you.
;
; Nothing here defines main, so it is not a program on its own. Compile it
; with `l0 check l0/examples.l0` to confirm it still type checks.

; --------------------------------------------------------------- the basics

(def max2 ((a int) (b int)) int
  (if (gt a b) a b))

; There are no loops. Iteration is recursion.
(def count_up_to ((n int) (acc int)) int
  (if (gt acc n) acc (count_up_to n (add acc 1))))

; Prefer an accumulator when the list may be long: this version holds one
; stack frame regardless of length, because the recursive call is the last
; thing it does.
(def sum_tail ((xs (list int)) (acc int)) int
  (if (is_empty xs) acc (sum_tail (tail xs) (add acc (head xs)))))

; The same thing without an accumulator. Correct, and holds one frame per
; element. Fine for short lists, and the runtime allows very deep recursion,
; but the version above is the habit worth having.
(def sum_naive ((xs (list int))) int
  (if (is_empty xs) 0 (add (head xs) (sum_naive (tail xs)))))

; ------------------------------------------------------- strings are lists

; A string literal is a (list int) of byte values, so string handling is
; just list handling. There is no separate string type.
(def shout ((ignored int)) (list int)
  "HELLO\n")

(def is_vowel ((c int)) bool
  (or (eq c 97) (or (eq c 101) (or (eq c 105)
      (or (eq c 111) (eq c 117))))))

(def count_vowels ((xs (list int)) (acc int)) int
  (if (is_empty xs)
      acc
      (count_vowels (tail xs) (if (is_vowel (head xs)) (add acc 1) acc))))

; ------------------------------------------------------- building output

; Appending to the end of a list copies the whole list, so building output
; with repeated appends is quadratic and will appear to hang on large
; inputs. Push chunks onto a reversed accumulator and reverse once at the
; end. push, rev, and digits are all in the standard library.
(def report ((n int) (total int)) (list int)
  (let a (push "count=" (nil int))
    (let b (push (digits n) a)
      (let c (push " total=" b)
        (let d (push (digits total) c)
          (rev (push "\n" d)))))))

; -------------------------------------------------------------- data types

(data Shape
  (Circle int)
  (Rect int int)
  (Dot))

; match has no wildcard and no default: every constructor must appear
; exactly once. That is deliberate, so that adding a constructor becomes a
; compile error at every site that has to handle it.
(def area ((s Shape)) int
  (match s
    ((Circle r) (mul 3 (mul r r)))
    ((Rect w h) (mul w h))
    ((Dot) 0)))

; Data types may be recursive, which is how trees are built.
(data Tree
  (Leaf int)
  (Branch Tree Tree))

(def sum_tree ((t Tree)) int
  (match t
    ((Leaf n) n)
    ((Branch l r) (add (sum_tree l) (sum_tree r)))))

(def depth ((t Tree)) int
  (match t
    ((Leaf n) 1)
    ((Branch l r)
      (let dl (depth l)
        (let dr (depth r)
          (add 1 (max2 dl dr)))))))

; Lists may hold any type, including data values and other lists.
(def total_area ((ss (list Shape))) int
  (if (is_empty ss)
      0
      (add (area (head ss)) (total_area (tail ss)))))

(def two_shapes ((ignored int)) (list Shape)
  (cons (Circle 2) (cons (Rect 3 4) (nil Shape))))

; ------------------------------------------- returning more than one value

; L0 has no tuples. A small data type does the same job, and is how any
; function that must thread state through a computation returns its result.
(data Split
  (Sp (list int) (list int)))           ; taken, remaining

(def split_at_nl ((xs (list int)) (acc (list int))) Split
  (if (is_empty xs)
      (Sp (rev acc) (nil int))
      (if (eq (head xs) 10)
          (Sp (rev acc) (tail xs))
          (split_at_nl (tail xs) (cons (head xs) acc)))))

(def first_line ((xs (list int))) (list int)
  (match (split_at_nl xs (nil int))
    ((Sp taken rest) taken)))

; ------------------------------------------------------- reporting failure

; There are no exceptions. A function that can fail returns a data type with
; a case for each outcome, and callers match on it.
(data Parsed
  (Ok int (list int))                   ; value, remaining input
  (Bad (list int)))                     ; message

(def parse_digits ((xs (list int)) (acc int) (seen bool)) Parsed
  (if (is_empty xs)
      (if seen (Ok acc xs) (Bad "expected a digit"))
      (if (is_digit (head xs))
          (parse_digits (tail xs) (add (mul acc 10) (sub (head xs) 48)) true)
          (if seen (Ok acc xs) (Bad "expected a digit")))))

(def parse_or_zero ((xs (list int))) int
  (match (parse_digits xs 0 false)
    ((Ok v rest) v)
    ((Bad msg) 0)))

; ------------------------------------------------ reading and writing as you go

; read_line and write_str are in the standard library (l0/io.l0), built on the
; read_byte and write_byte builtins. They are effects, and effects happen in
; evaluation order, so let is how to put one before another: its value is
; evaluated before its body, even when the name is never used.
(def ask ((question (list int))) (list int)
  (let w (write_str question)
    (take_line (read_line))))

; read_line returns the empty list only at end of input; a blank line is "\n".
(def count_lines ((n int)) int
  (if (is_empty (read_line)) n (count_lines (add n 1))))

; ------------------------------------------------------- files and arguments

; Opening a file returns IoOpened, and match makes you handle IoFailed, whose
; field says why. write_err writes to standard error. A main with no
; parameters returns its exit status, so 1 reports failure to the shell.
(def first_line_of ((path (list int))) int
  (match (open_in path)
    ((IoFailed why)
      (let w (write_err (append path (append ": " (append why "\n"))))
        1))
    ((IoOpened f)
      (let w (write_str (file_read_line f))
        (let c (file_close f)
          0)))))

; (arg_count) and (arg i) are the command-line arguments, not counting the
; program's name, and (args) is all of them as a list.
(def first_line_of_first_arg ((ignored int)) int
  (if (lt (arg_count) 1)
      (let w (write_err "usage: first FILE\n") 2)
      (first_line_of (arg 0))))

; --------------------------------------------------------- the entry point

; A program defines main in one of two forms. The first takes stdin as a list
; of bytes and returns the output. The return type may be (list int) for raw
; bytes, or int or bool, which are printed as a decimal or as true/false.
;
;   (def main ((input (list int))) (list int)
;     (report (count_vowels input 0) (sum_tail input 0)))
;
; The second takes nothing, reads and writes as it goes, and returns the exit
; status. Use it whenever a program must write before its input has ended, or
; must not hold all of its input at once.
;
;   (def main () int
;     (let name (ask "What is your name? ")
;       (let w (write_str (append "Hello, " (append name "!\n")))
;         0)))
;
; Both are commented out because this file is a reference rather than a
; program, and two definitions of main could not coexist with yours.

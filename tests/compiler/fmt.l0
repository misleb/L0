; fmt.l0 -- test support: renders compiler intermediate values as text.
;
; Not part of the compiler. Stage tests use this so their golden files show
; the actual token or AST structure, which makes a failure diagnosable by
; reading the diff instead of by guessing.

(def fmt_token ((t Token)) (list int)
  (match t
    ((TLParen o) (append (digits o) ":LPAREN"))
    ((TRParen o) (append (digits o) ":RPAREN"))
    ((TInt o v) (append (digits o) (append ":INT " (digits v))))
    ((TFloat o m p g)
      (append (digits o) (append ":FLOAT " (append (digits m)
        (append " " (append (digits p) (if g " neg" "")))))))
    ((TStr o s) (append (digits o) (append ":STR " (fmt_quoted s))))
    ((TName o s) (append (digits o) (append ":NAME " s)))
    ((TErr o m) (append (digits o) (append ":ERR " m)))))

; Renders bytes with non-printable characters escaped, so a golden file stays
; a single readable line.
(def fmt_quoted ((s (list int))) (list int)
  (cons 34 (rev (cons 34 (fmt_quoted_onto s (nil int))))))

(def fmt_quoted_onto ((s (list int)) (acc (list int))) (list int)
  (if (is_empty s)
      acc
      (fmt_quoted_onto (tail s) (push (fmt_byte (head s)) acc))))

(def fmt_byte ((b int)) (list int)
  (if (eq b 10)
      "\\n"
      (if (eq b 9)
          "\\t"
          (if (eq b 13)
              "\\r"
              (if (eq b 92)
                  "\\\\"
                  (if (eq b 34)
                      "\\\""
                      (if (or (lt b 32) (gt b 126))
                          (append "\\x" (digits b))
                          (cons b (nil int)))))))))

(def fmt_tokens_onto ((ts (list Token)) (acc (list int))) (list int)
  (if (is_empty ts)
      acc
      (fmt_tokens_onto (tail ts)
        (push "\n" (push (fmt_token (head ts)) acc)))))

(def fmt_tokens ((ts (list Token))) (list int)
  (rev (fmt_tokens_onto ts (nil int))))

; --------------------------------------------------------------------- AST
;
; Rendered as S-expressions so a golden file reads like the source it came
; from, and a structural mistake shows up as a visibly wrong shape.

; ty_str lives in parse.l0 next to the Ty definition, since the checker
; needs it for diagnostics too.
(def fmt_ty ((t Ty)) (list int) (ty_str t))

(def fmt_expr ((e Expr)) (list int)
  (match e
    ((EInt o v) (digits v))
    ((EFloat o m p g)
      (append "(float " (append (digits m) (append " " (append (digits p)
        (append (if g " neg" "") ")"))))))
    ((EBool o v) (if v "true" "false"))
    ((EStr o s) (fmt_quoted s))
    ((EVar o n) n)
    ((EIf o c a b)
      (append "(if " (append (fmt_expr c)
        (append " " (append (fmt_expr a)
          (append " " (append (fmt_expr b) ")")))))))
    ((ELet o n v body)
      (append "(let " (append n
        (append " " (append (fmt_expr v)
          (append " " (append (fmt_expr body) ")")))))))
    ((ENil o elem) (append "(nil " (append (fmt_ty elem) ")")))
    ((ECtor o n tys args)
      (if (is_empty tys)
          (append "(" (append n (append (fmt_args args) ")")))
          (append "((" (append n (append (fmt_field_tys tys)
            (append ")" (append (fmt_args args) ")")))))))
    ((EMatch o subject arms)
      (append "(match " (append (fmt_expr subject)
        (append (fmt_arms arms) ")"))))
    ((ECall o n args)
      (append "(" (append n (append (fmt_args args) ")"))))))

(def fmt_arms ((arms (list Arm))) (list int)
  (if (is_empty arms)
      ""
      (match (head arms)
        ((A o cname names body)
          (append " ((" (append cname (append (fmt_names names)
            (append ") " (append (fmt_expr body)
              (append ")" (fmt_arms (tail arms))))))))))))

(def fmt_names ((ns (list (list int)))) (list int)
  (if (is_empty ns)
      ""
      (append " " (append (head ns) (fmt_names (tail ns))))))

(def fmt_field_tys ((ts (list Ty))) (list int)
  (if (is_empty ts)
      ""
      (append " " (append (fmt_ty (head ts)) (fmt_field_tys (tail ts))))))

(def fmt_ctors ((cs (list Ctor))) (list int)
  (if (is_empty cs)
      ""
      (match (head cs)
        ((C o n fts)
          (append " (" (append n (append (fmt_field_tys fts)
            (append ")" (fmt_ctors (tail cs))))))))))

(def fmt_args ((args (list Expr))) (list int)
  (if (is_empty args)
      ""
      (append " " (append (fmt_expr (head args)) (fmt_args (tail args))))))

(def fmt_params ((ps (list Param))) (list int)
  (if (is_empty ps)
      ""
      (match (head ps)
        ((P n t)
          (append "(" (append n (append " " (append (fmt_ty t)
            (append ")" (if (is_empty (tail ps))
                            ""
                            (append " " (fmt_params (tail ps)))))))))))))

(def fmt_decl ((d Decl)) (list int)
  (match d
    ((DData o n tps cs)
      (append "(data "
        (append (if (is_empty tps) n (append "(" (append n (append (fmt_names tps) ")"))))
          (append (fmt_ctors cs) ")"))))
    ((DDef o n fps ps ret body)
      (append "(def " (append (if (is_empty fps) n (append "(" (append n (append (fmt_names fps) ")"))))
        (append " (" (append (fmt_params ps)
          (append ") " (append (fmt_ty ret)
            (append " " (append (fmt_expr body) ")")))))))))))

(def fmt_decls_onto ((ds (list Decl)) (acc (list int))) (list int)
  (if (is_empty ds)
      acc
      (fmt_decls_onto (tail ds) (push "\n" (push (fmt_decl (head ds)) acc)))))

(def fmt_parse_errs ((ds (list Diag)) (acc (list int))) (list int)
  (if (is_empty ds)
      acc
      (match (head ds)
        ((D o m)
          (fmt_parse_errs (tail ds)
            (push "\n" (push (append "parse error at offset "
              (append (digits o) (append ": " m))) acc)))))))

(def fmt_program ((p PProg)) (list int)
  (match p
    ((PP ds errs bad)
      (if (is_empty errs)
          (rev (fmt_decls_onto ds (nil int)))
          (rev (fmt_parse_errs errs (nil int)))))))

; ------------------------------------------------------------- diagnostics

(def fmt_diag ((d Diag)) (list int)
  (match d
    ((D o m) (append (digits o) (append ": " m)))))

(def fmt_diags_onto ((ds (list Diag)) (acc (list int))) (list int)
  (if (is_empty ds)
      acc
      (fmt_diags_onto (tail ds) (push "\n" (push (fmt_diag (head ds)) acc)))))

(def fmt_diags ((ds (list Diag))) (list int)
  (if (is_empty ds)
      "ok\n"
      (rev (fmt_diags_onto ds (nil int)))))

; Splits input into lines, dropping empty ones. Lets a test drive many
; snippets from a .in file instead of nesting one let per case.
(def split_lines_onto ((s (list int)) (cur (list int))
                       (acc (list (list int)))) (list (list int))
  (if (is_empty s)
      (if (is_empty cur) acc (cons (rev cur) acc))
      (if (eq (head s) 10)
          (split_lines_onto (tail s) (nil int)
            (if (is_empty cur) acc (cons (rev cur) acc)))
          (split_lines_onto (tail s) (cons (head s) cur) acc))))

(def split_lines ((s (list int))) (list (list int))
  (rev (split_lines_onto s (nil int) (nil (list int)))))

(def check_lines ((ls (list (list int))) (acc (list int))) (list int)
  (if (is_empty ls)
      (rev acc)
      (check_lines (tail ls) (push (check_source (head ls)) acc))))

; Runs the front end over one source string and renders whatever comes back.
(def check_source ((src (list int))) (list int)
  (check_source_as src true))

; Checks a fragment, without requiring it to be a whole program.
(def check_source_lib ((src (list int))) (list int)
  (check_source_as src false))

(def check_source_as ((src (list int)) (want_main bool)) (list int)
  (check_source_pre src want_main 0))

; Checks a source string that is already a two-group program: pre is the byte
; offset where the prelude ends, as spec 9.1 defines it.
(def check_source_pre ((src (list int)) (want_main bool) (pre int))
    (list int)
  (match (parse_program (lex src))
    ((PP ds errs bad)
      (if (is_empty errs)
          (fmt_diags (check_program ds want_main pre))
          (rev (fmt_parse_errs errs (nil int)))))))

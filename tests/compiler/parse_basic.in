(def count ((xs (list int))) int
  (if (is_empty xs) 0 (add 1 (count (tail xs)))))

(def nullary () bool true)

(def many ((a int) (b bool) (c (list (list int)))) int
  (let x 1
    (let y (add x 2)
      (if (lt x y) (neg y) 0))))

(def strs ((s (list int))) (list int)
  (cons 65 (nil int)))

(def lits ((a int)) (list int) "hi\n")

(def count ((xs (list int))) int (if (is_empty xs) 0 (add 1 (count (tail xs)))))
(def nullary () bool true)
(def many ((a int) (b bool) (c (list (list int)))) int (let x 1 (let y (add x 2) (if (lt x y) (neg y) 0))))
(def strs ((s (list int))) (list int) (cons 65 (nil int)))
(def lits ((a int)) (list int) "hi\n")
(data Shape (Circle int) (Rect int int) (Dot))
(data Tree (Leaf int) (Branch Tree Tree))
(def area ((s Shape)) int (match s ((Circle r) (mul 3 (mul r r))) ((Rect w h) (mul w h)) ((Dot) 0)))
(def sum_tree ((t Tree)) int (match t ((Leaf n) n) ((Branch l r) (add (sum_tree l) (sum_tree r)))))
(def build ((n int)) Tree (Branch (Leaf n) (Leaf 0)))
(def shapes ((i int)) (list Shape) (cons (Dot) (nil Shape)))
(data (Result T E) (Ok T) (Err E))
(def parsed ((r (Result (list int) (Pair int bool)))) (Option (list int)) (match r ((Ok s) (Some s)) ((Err e) ((None (list int))))))
(def fail ((i int)) (Result int (list int)) ((Err int (list int)) "no"))

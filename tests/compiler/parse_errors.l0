; Parsing stops at the first error, so each snippet is parsed separately to
; get one diagnostic per case. Snippets are embedded rather than read from
; stdin because there is one input stream and many cases.

(def try_parse ((src (list int))) (list int)
  (fmt_program (parse_program (lex src))))

(def main ((input (list int))) (list int)
  (let a (push (try_parse "(def f ((x int)) int (if 1 2))") (nil int))
  (let b (push (try_parse "(def f ((x int)) int)") a)
  (let c (push (try_parse "(def f (x int) int 1)") b)
  (let d (push (try_parse "(def F ((x int)) int 1)") c)
  (let e (push (try_parse "(def let ((x int)) int 1)") d)
  (let f (push (try_parse "(def f ((x int)) int (nil))") e)
  (let g (push (try_parse "(def f ((x int)) int (nil int extra))") f)
  (let h (push (try_parse "(def f ((x int)) nope 1)") g)
  (let i (push (try_parse "(def f ((x int)) (list) 1)") h)
  (let j (push (try_parse "(data Foo (Bar))") i)
  (let k (push (try_parse "(def f ((x int)) int (match x))") j)
  (let l (push (try_parse "(def f ((x int)) int (let 1 2 3))") k)
  (let m (push (try_parse "(def f ((x int)) int ())") l)
  (let n (push (try_parse "notadecl") m)
  (let o (push (try_parse "(def f ((x int)) int (Foo))") n)
  (let p (push (try_parse "(def f ((x int)) int x") o)
  (let q (push (try_parse "(def f ((x int)) int true false)") p)
  (let r (push (try_parse "(def f ((let int)) int 1)") q)
  (let s (push (try_parse "") r)
  ; data and match parse error paths
  (let t (push (try_parse "(data foo (Bar))") s)
  (let u (push (try_parse "(data Foo)") t)
  (let v (push (try_parse "(data Foo (bar))") u)
  (let w (push (try_parse "(data Foo (Bar nope))") v)
  (let x (push (try_parse "(def f ((x Foo)) int (match x (Bar 1)))") w)
  (let y (push (try_parse "(def f ((x Foo)) int (match x ((Bar 1) 2)))") x)
  (let z (push (try_parse "(def f ((x Foo)) int (match x ((bar) 1)))") y)
  (let aa (push (try_parse "(def f ((x Foo)) int (match x ((Bar) 1 2)))") z)
  (let ab (push (try_parse "(def f ((x array)) int 0)") aa)
  ; a def's type parameters, spec 4.1
  (let ac (push (try_parse "(def () ((x int)) int 1)") ab)
  (let ad (push (try_parse "(def (f) ((x int)) int 1)") ac)
  (let ae (push (try_parse "(def (f t) ((x t)) int 1)") ad)
  (let af (push (try_parse "(def (F T) ((x T)) int 1)") ae)
  (let ag (push (try_parse "(def (f T") af)
    (rev ag)))))))))))))))))))))))))))))))))))

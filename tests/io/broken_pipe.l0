; broken_pipe MODE FILE, with standard output a pipe whose reader leaves.
; told: writes lines, flushing each, until a flush fails; then writes "after"
; to FILE, as a tee goes on to its other outputs, and returns 3 if the flush
; said the reader had gone (WriteBrokenPipe, spec 6.3's -7) and 4 if it said
; anything else. quiet: writes 200,000 lines without a flush and returns 0,
; so the failure is never reported to it. broken_pipe.sh checks that neither
; is stopped by the host (spec 6.3): told exits 3 with FILE written, quiet
; exits 70.

(def told () WriteFault
  (let w (write_str "y\n")
    (match (file_flush (IoFile 1))
      ((NotDone fault why) fault)
      ((Done) (told)))))

(def quiet ((n int)) int
  (if (eq n 0)
      0
      (let w (write_str "y\n") (quiet (sub n 1)))))

(def note ((path (list int))) bool
  (match (open_out path)
    ((IoFailed fault why) false)
    ((IoOpened f)
      (let w (file_write_str f "after\n")
        (is_done (file_close f))))))

(def main () int
  (if (eq (arg 0) "told")
      (let fault (told)
        (if (note (arg 1))
            (if (eq fault (WriteBrokenPipe)) 3 4)
            1))
      (quiet 200000)))

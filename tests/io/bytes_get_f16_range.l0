; A narrow read needs all its bytes: a binary16 at the last byte is a
; runtime error, after the one before it is read. The binary16 "bc",
; 0x6362, is 945.0.

(def main () int
  (let (b (bytes_from_list "abc")
        w (write_byte (if (eq (bytes_get_f16 b 1) 945.0) 65 66)))
    (float_to_int (bytes_get_f16 b 2))))

; A slice past the end is a runtime error, as write_bytes's range is: what
; was written before it is delivered, and the program stops there.

(def main () int
  (let b (bytes_from_list "abc")
    (let s (bytes_slice b 1 3)
      (let w (write_bytes 1 s 0 (bytes_len s))
        (bytes_len (bytes_slice b 2 4))))))

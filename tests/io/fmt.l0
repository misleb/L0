; l0 fmt over this repository's own L0: fmt.sh runs the formatter, built
; from tools/fmt.l0 with this main, over every .l0 file under compiler/,
; lib/, and tests/virt/user/, which must come back byte-identical, since
; their closers already match their indentation. That is the proof that
; the rule matches how L0 is written here.

(def main () int
  (let b (read_bytes 0)
    (let outb (bytes_from_list (fmt_source (bytes_to_list b)))
      (let w (write_bytes 1 outb 0 (bytes_len outb))
        0))))

; open_faults MODE PATH: opens PATH to read (r), to write (w), or to append
; (a), and writes which failure it was, by its case, or "opened" if it
; opened; or renames PATH to PATH.moved (m), or to the second argument (mv
; PATH TO), and writes the result's case. open_faults.sh makes each failure
; happen.

(def open_fault_name ((f OpenFault)) (list int)
  (match f
    ((OpenMissing) "OpenMissing")
    ((OpenDenied) "OpenDenied")
    ((OpenIsDirectory) "OpenIsDirectory")
    ((OpenFailed) "OpenFailed")))

(def create_fault_name ((f CreateFault)) (list int)
  (match f
    ((CreateDenied) "CreateDenied")
    ((CreateNoDirectory) "CreateNoDirectory")
    ((CreateIsDirectory) "CreateIsDirectory")
    ((CreateFailed) "CreateFailed")))

(def rename_fault_name ((f RenameFault)) (list int)
  (match f
    ((RenameMissing) "RenameMissing")
    ((RenameDenied) "RenameDenied")
    ((RenameIsDirectory) "RenameIsDirectory")
    ((RenameNoDirectory) "RenameNoDirectory")
    ((RenameCrossDevice) "RenameCrossDevice")
    ((RenameFailed) "RenameFailed")))

(def reading ((path (list int))) (list int)
  (match (open_in path)
    ((IoFailed fault why) (append (open_fault_name fault) (append ": " why)))
    ((IoOpened f) (let c (file_close f) "opened"))))

; A program writes the kind of open in the type when it holds the result.
(def writing ((r (IoOpened CreateFault))) (list int)
  (match r
    ((IoFailed fault why) (append (create_fault_name fault) (append ": " why)))
    ((IoOpened f) (let c (file_close f) "opened"))))

(def renaming ((from (list int)) (to (list int))) (list int)
  (match (rename_file from to)
    ((Done) "Done")
    ((NotDone fault why) (append (rename_fault_name fault) (append ": " why)))))

(def main () int
  (let mode (arg 0)
    (let path (arg 1)
      (let w (write_line
               (if (eq mode "r")
                   (reading path)
                   (if (eq mode "w")
                       (writing (open_out path))
                       (if (eq mode "m")
                           (renaming path (append path ".moved"))
                           (if (eq mode "mv")
                               (renaming path (arg 2))
                               (writing (open_appending path)))))))
        0))))

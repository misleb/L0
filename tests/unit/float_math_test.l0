;; What a sine or cosine is not given a value for, and the signs of zero.
(def test_specials () int
  (add (check_int "sin -0.0" (float_bits (float_sin -0.0)) (float_bits -0.0))
  (add (check_int "sin 0.0" (float_bits (float_sin 0.0)) 0)
  (add (check_int "cos 0.0" (float_bits (float_cos 0.0)) (float_bits 1.0))
  (add (check_int "sin inf" (float_bits (float_sin (float_div 1.0 0.0))) 9221120237041090560)
  (add (check_int "cos -inf" (float_bits (float_cos (float_div -1.0 0.0))) 9221120237041090560)
  (add (check_int "sin nan" (float_bits (float_sin (float_div 0.0 0.0))) 9221120237041090560)
  (add (check_int "cos nan" (float_bits (float_cos (float_div 0.0 0.0))) 9221120237041090560)
  (add (check_int "sin past 2^20 pi/2" (float_bits (float_sin 1700000.0)) 9221120237041090560)
       (check_int "cos past 2^20 pi/2" (float_bits (float_cos -1700000.0)) 9221120237041090560))))))))))

; sin^2 + cos^2 is 1 to within rounding, over a spread of arguments.
(def sum_of_squares_ok ((i int)) bool
  (if (gt i 2000)
      true
      (let x (float_mul (float_from_int (sub i 1000)) 0.37)
        (let s (float_sin x)
          (let c (float_cos x)
            (let d (float_sub (float_add (float_mul s s) (float_mul c c)) 1.0)
              (if (and (float_lt d 0.000000000000001) (float_gt d -0.000000000000001))
                  (sum_of_squares_ok (add i 1))
                  false)))))))

(def test_pythagoras () int
  (check_true "sin^2 + cos^2" (sum_of_squares_ok 0)))


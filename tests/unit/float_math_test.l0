; Unit tests for float_sin and float_cos, roadmap 0095. The rows were
; computed with Python's math.sin and math.cos: each is an argument, its
; sine, and its cosine, as IEEE bits. A result must be within 1 ulp.

; The distance in ulps between two floats of the same sign.
(def ulps ((a float) (b float)) int
  (let d (sub (float_bits a) (float_bits b))
    (if (lt d 0) (neg d) d)))

(def row ((x int) (s int) (c int)) int
  (let a (float_from_bits x)
    (add (check_true (append "sin " (digits x)) (le (ulps (float_sin a) (float_from_bits s)) 1))
         (check_true (append "cos " (digits x)) (le (ulps (float_cos a) (float_from_bits c)) 1)))))

(def test_rows_0 () int
  (add (row 0 0 4607182418800017408)
  (add (row 4590952631998301319 4590944653792149762 4607148143687505314)
  (add (row 4595456231625671815 4595424355236410249 4607045579204271127)
  (add (row 4598387778419258213 4598334089338226320 4606875505927962389)
  (add (row 4599959831253042311 4599832907078044661 4606639218218904860)

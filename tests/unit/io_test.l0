; Unit tests for lib/io.l0 and the I/O builtins beneath it, spec sections 6.3
; and 6.4. tools/test.sh --compiled runs this with l0 test, in a scratch
; directory, so the files these tests write do not land in the repository.

(def contents ((path (list int))) (list int)
  (match (open_in path)
    ((IoFailed why) (append "cannot read: " why))
    ((IoOpened f)
      (let s (read_all f (nil int))
        (let c (file_close f)
          s)))))

; ------------------------------------------------------------ error codes

(def test_io_error_messages () int
  (add (check_str "-1" (io_error -1) "end of input")
    (add (check_str "-2" (io_error -2) "not open in that direction")
      (add (check_str "-3" (io_error -3) "no such file")
        (add (check_str "-4" (io_error -4) "permission denied")
             (check_str "-5" (io_error -5) "input or output failed"))))))

(def test_wrong_direction () int
  (add (check_int "write to standard input" (write_to 0 65) -2)
    (add (check_int "read from standard output" (read_from 1) -2)
         (check_int "read from standard error" (read_from 2) -2))))

(def test_not_a_handle () int
  (add (check_int "write to 99" (write_to 99 65) -2)
    (add (check_int "read from -1" (read_from -1) -2)
         (check_int "close 7" (close 7) -2))))

(def test_standard_streams_stay_open () int
  (add (check_int "close 0" (close 0) -2)
    (add (check_int "close 1" (close 1) -2)
         (check_int "close 2" (close 2) -2))))

; ------------------------------------------------------------------ opening

(def test_open_missing_file () int
  (match (open_in "/nonexistent/l0/file")
    ((IoFailed why) (check_str "reason" why "no such file"))
    ((IoOpened f) (check_true "should not have opened" false))))

(def test_open_missing_file_raw () int
  (check_int "open_read" (open_read "/nonexistent/l0/file") -3))

(def test_create_in_missing_directory () int
  (match (open_out "no/such/directory/file.txt")
    ((IoFailed why) (check_str "reason" why "input or output failed"))
    ((IoOpened f) (check_true "should not have opened" false))))

; A path holding a zero byte cannot name a file.
(def test_zero_byte_in_path () int
  (check_int "open_read" (open_read (cons 97 (cons 0 (nil int)))) -5))

; A directory cannot be read, so it does not open, and a program never
; mistakes it for an empty file.
(def test_read_a_directory () int
  (match (open_in ".")
    ((IoFailed why) (check_str "reason" why "input or output failed"))
    ((IoOpened f)
      (let c (file_close f)
        (check_true "a directory should not open" false)))))

(def test_directories_do_not_open () int
  (add (check_int "open_read" (open_read ".") -5)
    (add (check_int "open_write" (open_write ".") -5)
         (check_int "open_append" (open_append ".") -5))))

; --------------------------------------------------- writing and reading back

(def write_lines_file ((path (list int))) int
  (match (open_out path)
    ((IoFailed why) 1)
    ((IoOpened f)
      (let w (file_write_str f "one\n\nthree")
        (file_close f)))))

(def test_write_then_read () int
  (add (check_int "close after writing" (write_lines_file "lines.txt") 0)
       (check_str "contents" (contents "lines.txt") "one\n\nthree")))

; file_read_line keeps each newline, returns "\n" for a blank line, a last
; line without its newline, and the empty list only at the end.
(def read_four ((f IoFile)) (list (list int))
  (let a (file_read_line f)
    (let b (file_read_line f)
      (let c (file_read_line f)
        (let d (file_read_line f)
          (cons a (cons b (cons c (cons d (nil (list int)))))))))))

(def want_lines () (list (list int))
  (cons "one\n" (cons "\n" (cons "three" (cons "" (nil (list int)))))))

(def test_file_read_line () int
  (let w (write_lines_file "lines2.txt")
    (match (open_in "lines2.txt")
      ((IoFailed why) (check_str "open" why ""))
      ((IoOpened f)
        (let lines (read_four f)
          (let c (file_close f)
            (check_strs "lines" lines (want_lines))))))))

; file_next_line reads the same lines as IoLine, then IoEnd every time after.
(def line_text ((l IoLine)) (list int)
  (match l
    ((IoLine s) s)
    ((IoEnd) "<end>")
    ((IoError code) (append "<error " (append (digits code) ">")))))

(def next_five ((f IoFile)) (list (list int))
  (let a (line_text (file_next_line f))
    (let b (line_text (file_next_line f))
      (let c (line_text (file_next_line f))
        (let d (line_text (file_next_line f))
          (let e (line_text (file_next_line f))
            (cons a (cons b (cons c (cons d (cons e (nil (list int)))))))))))))

(def test_file_next_line () int
  (let w (write_lines_file "lines3.txt")
    (match (open_in "lines3.txt")
      ((IoFailed why) (check_str "open" why ""))
      ((IoOpened f)
        (let lines (next_five f)
          (let c (file_close f)
            (check_strs "lines" lines
              (cons "one\n" (cons "\n" (cons "three"
                (cons "<end>" (cons "<end>" (nil (list int))))))))))))))

; A failed read is IoError, where file_read_line would have seen an end.
(def test_next_line_of_a_file_being_written () int
  (match (open_out "written.txt")
    ((IoFailed why) (check_str "open" why ""))
    ((IoOpened f)
      (let l (line_text (file_next_line f))
        (let c (file_close f)
          (check_str "line" l "<error -2>"))))))

; End of input is -1 on every read after it, not only the first.
(def test_end_of_input_sticks () int
  (let w (write_lines_file "short.txt")
    (match (open_in "short.txt")
      ((IoFailed why) (check_str "open" why ""))
      ((IoOpened f)
        (let all (read_all f (nil int))
          (let again (file_read_byte f)
            (let c (file_close f)
              (add (check_int "after the end" again -1)
                   (check_int "length" (length all) 10)))))))))

; Opening for writing empties a file that exists.
(def test_open_out_truncates () int
  (let w1 (write_lines_file "trunc.txt")
    (match (open_out "trunc.txt")
      ((IoFailed why) (check_str "open" why ""))
      ((IoOpened f)
        (let w (file_write_str f "x")
          (let c (file_close f)
            (check_str "contents" (contents "trunc.txt") "x")))))))

; A closed handle is closed in both directions, and its number is reused.
(def test_closed_handle () int
  (let w (write_lines_file "closed.txt")
    (match (open_in "closed.txt")
      ((IoFailed why) (check_str "open" why ""))
      ((IoOpened f)
        (match f
          ((IoFile h)
            (let c (close h)
              (add (check_int "close" c 0)
                (add (check_int "read after close" (read_from h) -2)
                  (add (check_int "close again" (close h) -2)
                       (check_int "number reused" (open_read "closed.txt") h)))))))))))

; More than a 64 KB buffer, so writing and reading both cross a refill.
(def write_n ((f IoFile) (n int)) int
  (if (le n 0)
      0
      (let w (file_write_byte f (mod n 251))
        (write_n f (sub n 1)))))

(def test_large_file () int
  (match (open_out "large.bin")
    ((IoFailed why) (check_str "open" why ""))
    ((IoOpened f)
      (let w (write_n f 200000)
        (let c (file_close f)
          (check_int "bytes read back" (length (contents "large.bin")) 200000))))))

; ---------------------------------------------------- appending and renaming

(def append_str ((path (list int)) (s (list int))) int
  (match (open_appending path)
    ((IoFailed why) 1)
    ((IoOpened f)
      (let w (file_write_str f s)
        (file_close f)))))

(def test_append_creates () int
  (add (check_int "close" (append_str "appended.txt" "a") 0)
       (check_str "contents" (contents "appended.txt") "a")))

(def test_append_keeps_what_was_there () int
  (let w (write_lines_file "kept.txt")
    (let a (append_str "kept.txt" "!")
      (let b (append_str "kept.txt" "?")
        (check_str "contents" (contents "kept.txt") "one\n\nthree!?")))))

(def test_append_in_missing_directory () int
  (match (open_appending "no/such/directory/file.txt")
    ((IoFailed why) (check_str "reason" why "input or output failed"))
    ((IoOpened f) (check_true "should not have opened" false))))

; Two handles appending to one file: each delivery goes at the end as the
; file is then, so neither overwrites the other.
(def test_two_appenders () int
  (let h1 (open_append "shared.txt")
    (let h2 (open_append "shared.txt")
      (let a (write_to h1 65)
        (let fa (flush h1)
          (let b (write_to h2 66)
            (let fb (flush h2)
              (let c (write_to h1 67)
                (let x (close h1)
                  (let y (close h2)
                    (check_str "contents" (contents "shared.txt") "ABC")))))))))))

(def write_file ((path (list int)) (s (list int))) int
  (match (open_out path)
    ((IoFailed why) 1)
    ((IoOpened f)
      (let w (file_write_str f s)
        (file_close f)))))

(def test_rename_replaces () int
  (let a (write_file "new.txt" "new")
    (let b (write_file "old.txt" "old")
      (let r (rename_file "new.txt" "old.txt")
        (add (check_int "rename" r 0)
          (add (check_str "contents" (contents "old.txt") "new")
               (check_int "old name gone" (open_read "new.txt") -3)))))))

(def test_rename_to_a_new_name () int
  (let a (write_file "before.txt" "x")
    (let r (rename_file "before.txt" "after.txt")
      (add (check_int "rename" r 0)
           (check_str "contents" (contents "after.txt") "x")))))

(def test_rename_missing_source () int
  (check_int "rename" (rename_file "no_such_source.txt" "target.txt") -3))

; A failed rename changes neither name.
(def test_rename_into_missing_directory () int
  (let a (write_file "stays.txt" "here")
    (let r (rename_file "stays.txt" "no/such/directory/x.txt")
      (add (check_int "rename" r -5)
           (check_str "source kept" (contents "stays.txt") "here")))))

(def test_rename_zero_byte_in_path () int
  (let a (write_file "zero.txt" "z")
    (check_int "rename" (rename "zero.txt" (cons 97 (cons 0 (nil int)))) -5)))

; ---------------------------------------------------------- handles in memory

(def read_all_of ((h int) (acc (list int))) (list int)
  (let b (read_from h)
    (if (lt b 0) (rev acc) (read_all_of h (cons b acc)))))

(def test_bytes_read_then_end () int
  (let h (open_bytes "abc")
    (let s (read_all_of h (nil int))
      (let again (read_from h)
        (let c (close h)
          (add (check_str "bytes" s "abc")
            (add (check_int "end sticks" again -1)
                 (check_int "close" c 0))))))))

(def test_bytes_of_empty_list () int
  (let h (open_bytes "")
    (let b (read_from h)
      (let c (close h)
        (check_int "first read" b -1)))))

; Elements are reduced modulo 256, as write_to reduces what it writes.
(def test_bytes_reduced () int
  (let h (open_bytes (cons 321 (cons -1 (nil int))))
    (let a (read_from h)
      (let b (read_from h)
        (let c (close h)
          (add (check_int "321" a 65) (check_int "-1" b 255)))))))

; The handle keeps the list alive after the caller's reference is gone.
(def fresh_bytes ((n int) (acc (list int))) (list int)
  (if (eq n 0) acc (fresh_bytes (sub n 1) (cons (add 96 n) acc))))

(def test_bytes_outlive_their_list () int
  (let h (open_bytes (fresh_bytes 3 (nil int)))
    (let s (read_all_of h (nil int))
      (let c (close h)
        (check_str "bytes" s "abc")))))

(def test_memory_handles_have_a_direction () int
  (let r (open_bytes "x")
    (let w (open_buffer)
      (add (check_int "write to bytes" (write_to r 65) -2)
        (add (check_int "read from a buffer" (read_from w) -2)
          (add (check_int "flush bytes" (flush r) -2)
            (add (check_int "close bytes" (close r) 0)
                 (check_int "close buffer" (close w) 0))))))))

(def write_n_to ((h int) (n int)) int
  (if (le n 0) 0 (let w (write_to h (mod n 251)) (write_n_to h (sub n 1)))))

(def test_buffer_keeps_writes () int
  (let h (open_buffer)
    (let a (write_to h 104)
      (let b (write_to h 105)
        (let first (buffer_bytes h)
          (let f (flush h)
            (let c (write_to h 33)
              (let second (buffer_bytes h)
                (let x (close h)
                  (add (check_str "so far" first "hi")
                    (add (check_int "flush" f 0)
                      (add (check_str "after more" second "hi!")
                           (check_int "close" x 0)))))))))))))

; More than the buffer's first allocation, so it grows.
(def test_large_buffer () int
  (let h (open_buffer)
    (let w (write_n_to h 200000)
      (let s (buffer_bytes h)
        (let c (close h)
          (add (check_int "length" (length s) 200000)
               (check_int "first" (head s) (mod 200000 251))))))))

(def test_buffer_bytes_of_other_handles () int
  (let r (open_bytes "x")
    (let w (open_buffer)
      (let c (close w)
        (let s1 (buffer_bytes r)
          (let s2 (buffer_bytes w)
            (let x (close r)
              (add (check_str "bytes handle" s1 "")
                (add (check_str "closed buffer" s2 "")
                  (add (check_str "standard output" (buffer_bytes 1) "")
                       (check_str "not a handle" (buffer_bytes 99) "")))))))))))

; The wrappers, with the file_ functions, as a program's code would use them.
(def test_file_functions_on_memory () int
  (match (open_in_bytes "one\ntwo\n")
    ((IoFailed why) (check_str "open" why ""))
    ((IoOpened in)
      (match (open_out_buffer)
        ((IoFailed why) (check_str "open" why ""))
        ((IoOpened out)
          (let a (file_write_str out (take_line (file_read_line in)))
            (let b (file_write_str out (take_line (file_read_line in)))
              (let s (buffer_contents out)
                (let c (file_close in)
                  (let d (file_close out)
                    (check_str "contents" s "onetwo")))))))))))

; A handle left open at the end is closed then: this test leaves one open
; over a list, and l0 test would fail it if the list were never released.
(def test_bytes_left_open () int
  (let h (open_bytes "left open")
    (check_int "first byte" (read_from h) 108)))

; ---------------------------------------------------------------- arguments

; Under l0 test, the program's argument is the test's name.
(def test_args_under_l0_test () int
  (add (check_int "count" (arg_count) 1)
    (add (check_strs "args" (args) (cons "test_args_under_l0_test" (nil (list int))))
      (add (check_str "past the end" (arg 1) "")
           (check_str "negative" (arg -1) "")))))

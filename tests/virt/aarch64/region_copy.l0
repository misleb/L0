; Spec section 6.12 on the aarch64 board: a region over memory, which PCIe
; configuration space reads and writes as, at any width and offset, is
; copied out and into more than a byte at a time. Bus 0's first function
; is QEMU's host bridge: its first 4 bytes are vendor 0x1b36 and device
; 0x0008, lowest address first, and its interrupt line, the byte at 0x3C,
; is the one byte here every function lets software write, so 42 written
; there from the middle of longer bytes is read back, through lib/io.l0's
; region_set_bytes and region_get_bytes.

(def show ((b bytes)) int
  (write_line (join_with " " (map_digits (bytes_to_list b)))))

(def map_digits ((xs (list int))) (list (list int))
  (if (is_empty xs) (nil (list int)) (cons (digits (head xs)) (map_digits (tail xs)))))

(def join_with ((sep (list int)) (xs (list (list int)))) (list int)
  (if (is_empty xs)
      (nil int)
      (if (is_empty (tail xs))
          (head xs)
          (append (head xs) (append sep (join_with sep (tail xs)))))))

(def main () int
  (let e (region_open 275146342400 4096)            ; 0x4010000000, bus 0
    (let a (show (region_read_bytes e 0 4))
      (let d (IoRegion e)
        (let w (region_set_bytes d 60 (bytes_from_list (cons 7 (cons 42 (cons 9 (nil int))))) 1 2)
          (show (region_get_bytes d 60 1)))))))

; QEMU's riscv64 virt board, for the tests that drive its devices: what
; spec section 10.3 says it has and where, and what its CPU's code is, as
; tests/virt/board/virt-aarch64.l0 says for the aarch64 board, by the same
; names. Each device's base and length are in virt-riscv64-devices.l0,
; which tools/boards.l0 writes from runtime/board/virt-riscv64.devices.

; The serial port, a 16550, its registers a byte apart: a part of it, and
; its interrupt.
(def board_uart_part () int 268435520)            ; 0x10000040
(def board_uart_irq () int 10)

; The 16550's transmit interrupt: on, in the interrupt enable register;
; its cause cleared, by reading the interrupt identification register;
; and off.
(def board_uart_tx_on ((u int)) int (region_write8 u 1 2))      ; IER: ETBEI
(def board_uart_tx_clear ((u int)) int (region_read8 u 2))      ; IIR
(def board_uart_tx_off ((u int)) int (region_write8 u 1 0))

; What is no region: an address past the last transport, RAM, and the
; interrupt controller, which the host drives (spec section 6.14).
(def board_no_device () int 268472320)            ; 0x10009000
(def board_ram () int 2147483648)                 ; 0x80000000
(def board_intc () int 201326592)                 ; 0x0C000000, the PLIC

; An interrupt number the host gives no interrupt.
(def board_no_irq () int 9)

; A system call, ecall, as the CPU encodes it, and a load of the word at
; the address in the register a context's word board_load_word holds into
; the call number's register, then a system call: ld a7, 0(a1); ecall.
(def board_call_code () bytes
  (bytes_from_list (cons 115 (cons 0 (cons 0 (cons 0 (nil int)))))))

(def board_load_call_code () bytes
  (bytes_from_list (append (cons 131 (cons 184 (cons 5 (cons 0 (nil int)))))
                           (cons 115 (cons 0 (cons 0 (cons 0 (nil int))))))))

(def board_load_word () int 11)                   ; a1, x11
(def board_call_word () int 17)                   ; a7, x17

; Spec section 10.3 on the board: a heap of 8 MB is all the program gets.
; A million cells take more than that, which the default heap holds.
(def build ((n int) (acc (list int))) (list int)
  (if (eq n 0) acc (build (sub n 1) (cons n acc))))

(def main () int
  (let a (write_line "building")
    (write_line (digits (length (build 1000000 (nil int)))))))

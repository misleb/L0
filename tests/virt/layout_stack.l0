; Spec section 10.3 on the board: a stack of 1 MB is all the program gets.
; Recursion 100,000 deep that is not through tail calls needs more than
; that, which the default stack holds.
(def build ((n int)) (list int)
  (if (eq n 0) (nil int) (cons n (build (sub n 1)))))

(def main () int
  (let a (write_line "building")
    (write_line (digits (length (build 100000))))))

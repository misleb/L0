; Spec section 10.3 on the Raspberry Pi 5: RP1's peripherals are a region,
; as L0S's probes/usb asked, and so are its BAR2 and BAR0 after them, which
; hold its MSI-X table. This is built by tools/test.sh --virt and not
; run, since no emulator has this board; on a Pi 5 whose serial line is
; read, its output is rp1.out. Both of RP1's USB controllers, DWC3s at
; 0x1F00200000 and 0x1F00300000, open over their first 64 KB, and so do
; the window's first page, BAR1's last, and BAR0 whole; a range past the
; region's end, and one before it, are no region. Nothing is read, since
; what RP1's registers hold is not the host's to promise.

(def code ((r int)) int
  (write_line (digits (if (ge r 0) 0 r))))

(def inside () int
  (let a (code (region_open 133146083328 65536))    ; 0x1F00200000, USB 0
    (let b (code (region_open 133147131904 65536))  ; 0x1F00300000, USB 1
      (let c (code (region_open 133143986176 4096)) ; 0x1F00000000
        (let d (code (region_open 133148176384 4096)) ; 0x1F003FF000
          (code (region_open 133148246016 16384)))))))  ; 0x1F00410000, BAR0

(def outside () int
  (let a (code (region_open 133148258304 8192))     ; 0x1F00413000, past the end
    (code (region_open 133143982080 8192))))        ; before it

(def main () int
  (let a (inside)
    (outside)))

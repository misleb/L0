; A kernel, in L0, for QEMU's virt board: it runs one L0 program, built
; with l0 build --target proc, as a process at EL0 in an address space of
; its own, through the user-mode builtins of spec section 6.13, and answers
; the system calls spec section 10.3 fixes for it. tools/test.sh --virt
; runs the tests/virt programs under it against the board's expectations,
; and tools/bootstrap.sh --virt the compiler. It is
; tests/virt/proc/harness/kernel.ll's loop in L0, for one process and
; without a timer.
;
; Its standard input is the process image's length in decimal and a
; newline, then the image's bytes, as llvm-objcopy -O binary writes them,
; to be mapped from 0xC0000000, then what the process reads as its own
; standard input. The process's standard output and error are the
; kernel's. It gives no files and no arguments, as the board does, and
; maps the board's devices for the region call. Its heap and stack, and
; the image's bss, are mapped a page at a time as they are first touched.
; When the process exits, the kernel does, with its status; when the
; process faults, the kernel says so on standard error and exits with 99.

(def user_lo () int 3221225472)                   ; 0xC0000000, the image
(def user_top () int 3892314112)                  ; 0xE8000000, the stack's top
(def window () int 3892314112)                    ; regions from 0xE8000000
(def window_pages () int 512)

; ----------------------------------------------------------------- memory

; Which pages from user_lo to user_top are mapped: 1 for a page with a
; frame, as an array indexed by page.
(def page_count () int (bit_shr (sub (user_top) (user_lo)) 12))

(def page_of ((va int)) int (bit_shr (sub va (user_lo)) 12))

(data Mem
  (Mem (array int))
  (NoFrames (array int)))

; Maps a fresh frame at each page from p, page-aligned, below end that has
; none yet, readable, writable, and executable.
(def ensure ((s int) (m (array int)) (p int) (end int)) Mem
  (if (ge p end)
      (Mem m)
      (let i (page_of p)
        (if (eq (array_get m i) 0)
            (let f (frame_new)
              (if (lt f 0)
                  (NoFrames m)
                  (let r (space_map s p f 3)
                    (if (lt r 0)
                        (NoFrames m)
                        (ensure s (array_set m i 1) (add p 4096) end)))))
            (ensure s m (add p 4096) end)))))

; Whether the n bytes from va are all between user_lo and user_top.
(def user_ok ((va int) (n int)) bool
  (if (lt n 0)
      false
      (if (gt n 1073741824)
          false
          (if (eq n 0)
              true
              (if (lt va (user_lo))
                  false
                  (if (gt va (user_top)) false (le (add va n) (user_top))))))))

(def page_floor ((va int)) int (bit_and va -4096))

; --------------------------------------------------------------- the image

(def read_size ((acc int)) int
  (let b (read_byte)
    (if (if (ge b 48) (le b 57) false)
        (read_size (add (mul acc 10) (sub b 48)))
        acc)))

; Copies the next left bytes of standard input into the space from va.
(def load ((s int) (m (array int)) (va int) (left int)) Mem
  (if (le left 0)
      (Mem m)
      (let b (read_some 0 (if (lt left 65536) left 65536))
        (let n (bytes_len b)
          (if (eq n 0)
              (Mem m)
              (match (ensure s m (page_floor va) (add va n))
                ((Mem m1)
                  (let w (space_write s va b 0 n)
                    (load s m1 (add va n) (sub left n))))
                ((NoFrames m1) (NoFrames m1))))))))

; ---------------------------------------------------------------- the loop

; Runs the process until its next trap, and answers it.
(def step ((s int) (m (array int)) (w int) (c (array int))) int
  (let r (user_run s c)
    (match (trap_of r)
      ((TrapCall n) (syscall s m w r n))
      ((TrapMissing va) (demand s m w r va))
      ((TrapFault esr far) (killed r))
      ((TrapInterrupt) (step s m w r)))))

; Gives the process v as its system call's result, and runs it on.
(def answer ((s int) (m (array int)) (w int) (c (array int)) (v int)) int
  (step s m w (array_set c 0 v)))

(def demand ((s int) (m (array int)) (w int) (c (array int)) (va int)) int
  (if (if (ge va (user_lo)) (lt va (user_top)) false)
      (match (ensure s m (page_floor va) (add va 1))
        ((Mem m1) (step s m1 w c))
        ((NoFrames m1) (out_of_memory 0)))
      (killed c)))

(def killed ((c (array int))) int
  (let a (write_err "kernel: process 0 killed: fault esr = 0x")
    (let b (write_err (hex_digits (array_get c 36) 16))
      (let d (write_err " elr = 0x")
        (let e (write_err (hex_digits (array_get c 32) 16))
          (let f (write_err " far = 0x")
            (let g (write_err (hex_digits (array_get c 37) 16))
              (let h (write_err "\n") 99))))))))

(def out_of_memory ((i int)) int
  (let a (write_err "kernel: process 0 killed: out of memory\n") 99))

; ------------------------------------------------------------ system calls

; Spec section 10.3's numbers. Arguments are x0 to x3, words 0 to 3.
(def syscall ((s int) (m (array int)) (w int) (c (array int)) (n int)) int
  (let a (array_get c 0)
    (let b (array_get c 1)
      (let d (array_get c 2)
        (if (eq n 1)
            (sys_read s m w c a b d)
            (if (eq n 2)
                (sys_write s m w c a b d)
                (if (eq n 3)
                    (bit_and a 255)
                    (sys_rest s m w c n a b d))))))))

(def sys_rest ((s int) (m (array int)) (w int) (c (array int)) (n int)
               (a int) (b int) (d int)) int
  (if (eq n 4)
      (answer s m w c (if (user_ok a b) (if (eq d 1) -3 -9) -5))
      (if (eq n 6)
          (answer s m w c (if (if (user_ok a b) (user_ok d (array_get c 3)) false) -3 -5))
          (if (eq n 7)
              (answer s m w c (if (user_ok a b) -3 -5))
              (if (eq n 8)
                  (answer s m w c 0)
                  (if (eq n 10)
                      (sys_region s m w c a b)
                      (answer s m w c -5)))))))   ; close, arg, and any other

; read(stream, buf, len): standard input, into the process, at most 64 KB.
(def sys_read ((s int) (m (array int)) (w int) (c (array int))
               (h int) (buf int) (len int)) int
  (if (if (eq h 0) (user_ok buf len) false)
      (if (eq len 0)
          (answer s m w c 0)
          (let k (if (lt len 65536) len 65536)
            (match (ensure s m (page_floor buf) (add buf k))
              ((Mem m1)
                (let bs (read_some 0 k)
                  (let got (bytes_len bs)
                    (let r (space_write s buf bs 0 got)
                      (answer s m1 w c got)))))
              ((NoFrames m1) (out_of_memory 0)))))
      (answer s m w c -5)))

; write(stream, buf, len): standard output or error, out of the process.
(def sys_write ((s int) (m (array int)) (w int) (c (array int))
                (h int) (buf int) (len int)) int
  (if (if (if (eq h 1) true (eq h 2)) (user_ok buf len) false)
      (if (eq len 0)
          (answer s m w c 0)
          (match (ensure s m (page_floor buf) (add buf len))
            ((Mem m1)
              (let r (write_bytes h (space_read s buf len) 0 len)
                (answer s m1 w c (if (lt r 0) r len))))
            ((NoFrames m1) (out_of_memory 0))))
      (answer s m w c -5)))

; region(base, len): the device's pages at the next pages of the window
; above the stack. The host decides what is a device; a range too long for
; what is left of the window is -5, before the host is asked.
(def sys_region ((s int) (m (array int)) (w int) (c (array int))
                 (base int) (len int)) int
  (if (if (lt len 1) true (lt base 0))
      (answer s m w c -3)
      (let first (page_floor base)
        (let pages (add (bit_shr (sub (page_floor (sub (add base len) 1)) first) 12) 1)
          (if (gt pages (sub (window_pages) w))
              (answer s m w c -5)
              (let va (add (window) (mul w 4096))
                (let r (space_map_device s va base len)
                  (if (lt r 0)
                      (answer s m w c r)
                      (answer s m (add w pages) c
                        (add va (sub base first)))))))))))

(def main () int
  (let s (space_new)
    (if (lt s 0)
        (let e (write_err "kernel: no user mode here\n") 99)
        (let size (read_size 0)
          (match (load s (array_new (page_count) 0) (user_lo) size)
            ((Mem m) (step s m 0 (user_context (user_lo) (user_top))))
            ((NoFrames m) (out_of_memory 0)))))))

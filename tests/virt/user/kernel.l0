; A kernel, in L0, for QEMU's virt board: it runs L0 programs, built with
; l0 build --target proc, as processes at user level, each in an address space of
; its own, through the user-mode builtins of spec section 6.13, and answers
; the system calls spec section 10.3 fixes for them, and calls of its own
; (spec section 6.15), below. tools/test.sh --virt runs the tests/virt
; programs under it against the board's expectations, and
; tools/bootstrap.sh --virt the compiler. It began as
; tests/virt/proc/harness/kernel.ll's loop in L0.
;
; Its standard input is the number of processes in decimal and a newline;
; then for each, its image's length in decimal and a newline, and the
; image's bytes, as tools/l0 build --target proc writes them; then what the
; processes read as their standard input, which they share. An image is an
; ELF, as spec section 10.3 lists it, whose segments the kernel maps each
; with its flags' permissions, so a process that writes its code or runs
; its data is killed by the fault; or, until every image is an ELF, raw,
; its bytes mapped from 0xC0000000 readable, writable, and executable. One
; that is neither, or is for another CPU, is not started. Their standard output and error are the kernel's. It gives
; no files, as the board does, and maps the board's devices for the region
; call. Its own arguments, its boot arguments, are the processes': each
; "N:VALUE" gives process N the argument VALUE, in their order, so it is
; told at boot which process is the serial driver and where its device is.
; A process's heap and stack, and a raw image's bss, are mapped a page at a
; time as they are first touched, readable and writable.
;
; A process runs for a slice of 10 ms, the timer's deadline set as its turn
; starts (spec section 6.14), or until it exits, faults, or makes one of the
; kernel's own calls, and then the next runnable one after it runs, the
; first of them first, so that one beside it runs before it does. When none
; can run, the kernel waits for an interrupt. The run ends when process 0
; ends, with its status, or 99 if the kernel killed it, which it says on
; standard error.
;
; The kernel's own calls, which a process makes with spec section 6.15's
; builtins; any other number from 256 is -5:
;   256  send(_, bytes): queue the bytes for whichever process receives,
;        and give back how many
;   257  receive(_, room): wait until bytes are queued, and give at most
;        room of them, the oldest first
;   258  sync(): wait until every byte queued has been received and its
;        receiver is waiting to receive again, so has done with them
;   259  wait(n): enable device interrupt n, wait until it is taken, and
;        give n back; -3 for one the host has not, or the timer's
;   260  end(n): end interrupt n, given by wait; -5 if it was not given
;   261  sleep(t): wait until the clock reads t
;   262  listen(n): enable device interrupt n, and give 0 back at once, or
;        -3 for one the host has not, or the timer's: so that a driver can
;        have its interrupt enabled before its device raises it, which on
;        QEMU's riscv64 board is lost if the PLIC's source is not enabled
; So a serial driver receives what its clients send and writes it, waiting
; for its device's interrupt, and a client sends and then syncs.

(def user_lo () int 3221225472)                   ; 0xC0000000, the image
(def user_top () int 3892314112)                  ; 0xE8000000, the stack's top
(def window () int 3892314112)                    ; regions from 0xE8000000
(def window_pages () int 512)
(def slice_ns () int 10000000)

; ---------------------------------------------------------------- the state

; A process: its space, its context, which pages from user_lo to user_top
; have a frame, how many pages of its region window are used, and its
; state: -1 runnable; -2 receiving, -3 syncing, -5 waiting for an
; interrupt, -7 asleep, with the call's arguments still in its context; -4
; just made a call of the kernel's own, and -6 just interrupted by a
; device, for the scheduler to answer; or the status it ended with.
(data Proc
  (Proc int (array int) (array int) int int))

(def proc_state ((p Proc)) int
  (match p ((Proc s c m w st) st)))

(def proc_word ((p Proc) (k int)) int
  (match p ((Proc s c m w st) (array_get c k))))

(def proc_space ((p Proc)) int
  (match p ((Proc s c m w st) s)))

(def set_state ((p Proc) (st1 int)) Proc
  (match p ((Proc s c m w st) (Proc s c m w st1))))

; p, runnable, with v as its call's result.
(def resume ((p Proc) (v int)) Proc
  (match p ((Proc s c m w st) (Proc s (call_result c v) m w -1))))

; Argument a of the system call p made.
(def proc_arg ((p Proc) (a int)) int
  (match p ((Proc s c m w st) (call_arg c a))))

; The kernel: its processes; the bytes sent and not yet all received, and
; how many of them have been; the device interrupts taken that no process
; was waiting for; those given to a process and not yet ended; and each
; process's arguments, from the kernel's own.
(data Kern
  (Kern (array Proc) bytes int (list int) (list int) (array (list (list int)))))

(def kstate ((k Kern) (i int)) int
  (match k ((Kern ps q qo arr held pa) (proc_state (array_get ps i)))))

(def kword ((k Kern) (i int) (n int)) int
  (match k ((Kern ps q qo arr held pa) (proc_word (array_get ps i) n))))

; Argument a of process i's system call, and the call's number.
(def karg ((k Kern) (i int) (a int)) int
  (match k ((Kern ps q qo arr held pa) (proc_arg (array_get ps i) a))))

(def kcall_number ((k Kern) (i int)) int
  (match k ((Kern ps q qo arr held pa) (proc_call_number (array_get ps i)))))

(def proc_call_number ((p Proc)) int
  (match p ((Proc s c m w st) (call_number c))))

(def kcount ((k Kern)) int
  (match k ((Kern ps q qo arr held pa) (array_len ps))))

(def kunread ((k Kern)) int
  (match k ((Kern ps q qo arr held pa) (sub (bytes_len q) qo))))

(def kset ((k Kern) (i int) (st int)) Kern
  (match k
    ((Kern ps q qo arr held pa)
      (Kern (array_set ps i (set_state (array_get ps i) st)) q qo arr held pa))))

(def kresume ((k Kern) (i int) (v int)) Kern
  (match k
    ((Kern ps q qo arr held pa)
      (Kern (array_set ps i (resume (array_get ps i) v)) q qo arr held pa))))

; The first process from i in the state st, or -1.
(def find_state ((k Kern) (st int) (i int)) int
  (if (ge i (kcount k))
      -1
      (if (eq (kstate k i) st) i (find_state k st (add i 1)))))

; ----------------------------------------------------------------- memory

(def page_count () int (bit_shr (sub (user_top) (user_lo)) 12))

(def page_of ((va int)) int (bit_shr (sub va (user_lo)) 12))

(data Mem
  (Mem (array int))
  (NoFrames (array int)))

; Maps a fresh frame at each page from p, page-aligned, below end that has
; none yet, with perm, as space_map takes it. A page's entry in m is 0 while
; it has no frame, and then its perm plus 1.
(def ensure ((s int) (m (array int)) (p int) (end int) (perm int)) Mem
  (if (ge p end)
      (Mem m)
      (let i (page_of p)
        (if (eq (array_get m i) 0)
            (let f (frame_new)
              (if (lt f 0)
                  (NoFrames m)
                  (let r (space_map s p f perm)
                    (if (lt r 0)
                        (NoFrames m)
                        (ensure s (array_set m i (add perm 1)) (add p 4096) end perm)))))
            (ensure s m (add p 4096) end perm)))))

; Whether a process whose pages m holds may write the n bytes from va,
; which user_ok has passed: each page has no frame yet, and is mapped
; writable when touched, or is mapped writable.
(def writable ((m (array int)) (va int) (n int)) bool
  (if (le n 0) true (writable_from m (page_floor va) (add va n))))

(def writable_from ((m (array int)) (p int) (end int)) bool
  (if (ge p end)
      true
      (let st (array_get m (page_of p))
        (if (if (eq st 0) true (eq (bit_and (sub st 1) 1) 1))
            (writable_from m (add p 4096) end)
            false))))

; Whether the n bytes from va are all between user_lo and user_top.
(def user_ok ((va int) (n int)) bool
  (if (lt n 0)
      false
      (if (gt n 1073741824)
          false
          (if (eq n 0)
              true
              (if (lt va (user_lo))
                  false
                  (if (gt va (user_top)) false (le (add va n) (user_top))))))))

(def page_floor ((va int)) int (bit_and va -4096))

; Process i, with the n bytes from va mapped, or ended if no frame is left.
(def map_range ((i int) (p Proc) (va int) (n int)) Proc
  (match p
    ((Proc s c m w st)
      (match (ensure s m (page_floor va) (add va n) 1)
        ((Mem m1) (Proc s c m1 w st))
        ((NoFrames m1) (Proc s c m1 w (out_of_memory i)))))))

(def kmapped ((k Kern) (i int) (va int) (n int)) Kern
  (match k
    ((Kern ps q qo arr held pa)
      (Kern (array_set ps i (map_range i (array_get ps i) va n)) q qo arr held pa))))

; -------------------------------------------------------------- the images

(def read_number ((acc int)) int
  (let b (read_byte)
    (if (if (ge b 48) (le b 57) false)
        (read_number (add (mul acc 10) (sub b 48)))
        acc)))

; Copies the next left bytes of standard input into the space from va,
; mapping pages readable, writable, and executable as it goes: a raw
; image's.
(def load ((s int) (m (array int)) (va int) (left int)) Mem
  (if (le left 0)
      (Mem m)
      (let b (read_some 0 (if (lt left 65536) left 65536))
        (let n (bytes_len b)
          (if (eq n 0)
              (Mem m)
              (match (ensure s m (page_floor va) (add va n) 3)
                ((Mem m1)
                  (let w (space_write s va b 0 n)
                    (load s m1 (add va n) (sub left n))))
                ((NoFrames m1) (NoFrames m1))))))))

; Copies the next left bytes of standard input into the space from va,
; whose pages are mapped.
(def copy_in ((s int) (va int) (left int)) int
  (if (le left 0)
      0
      (let b (read_some 0 (if (lt left 65536) left 65536))
        (let n (bytes_len b)
          (if (eq n 0)
              0
              (let w (space_write s va b 0 n)
                (copy_in s (add va n) (sub left n))))))))

; Reads and drops the next n bytes of standard input.
(def skip ((n int)) int
  (if (le n 0)
      0
      (let b (read_some 0 (if (lt n 65536) n 65536))
        (if (eq (bytes_len b) 0) 0 (skip (sub n (bytes_len b)))))))

; The next n bytes of standard input, or fewer if it ends first.
(def read_exact ((n int)) bytes
  (bytes_from_list (rev (read_onto n (nil int)))))

(def read_onto ((n int) (acc (list int))) (list int)
  (if (le n 0)
      acc
      (let b (read_some 0 (if (lt n 65536) n 65536))
        (if (eq (bytes_len b) 0)
            acc
            (read_onto (sub n (bytes_len b)) (push_bytes b 0 acc))))))

(def push_bytes ((b bytes) (i int) (acc (list int))) (list int)
  (if (ge i (bytes_len b)) acc (push_bytes b (add i 1) (cons (bytes_get b i) acc))))

; The next process, read from standard input: its length, then its image,
; in a space of its own. One the kernel cannot give memory to has ended,
; and one it cannot load was not started.
(def new_proc ((i int)) Proc
  (let size (read_number 0)
    (let hd (read_exact (if (lt size 64) size 64))
      (let s (space_new)
        (if (lt s 0)
            (let k (skip (sub size (bytes_len hd)))
              (Proc s (array_new 0 0) (array_new 0 0) 0 (no_user_mode i)))
            (if (is_elf hd)
                (new_elf i s size hd)
                (new_raw i s size hd)))))))

; A raw image, whose first bytes, hd, are read: its bytes from 0xC0000000,
; and its entry there.
(def new_raw ((i int) (s int) (size int) (hd bytes)) Proc
  (let n (bytes_len hd)
    (match (ensure s (array_new (page_count) 0) (user_lo) (add (user_lo) n) 3)
      ((Mem m)
        (let w (space_write s (user_lo) hd 0 n)
          (match (load s m (add (user_lo) n) (sub size n))
            ((Mem m1) (Proc s (user_context (user_lo) (user_top)) m1 0 -1))
            ((NoFrames m1) (Proc s (array_new 0 0) m1 0 (out_of_memory i))))))
      ((NoFrames m) (Proc s (array_new 0 0) m 0 (out_of_memory i))))))

; ---------------------------------------------------------------- the ELF

(def image_top () int 3489660928)                 ; 0xD0000000, the image's end

; The n bytes of b from i, as a little-endian number.
(def le_at ((b bytes) (i int) (n int)) int
  (if (eq n 0)
      0
      (bit_or (bytes_get b i) (bit_shl (le_at b (add i 1) (sub n 1)) 8))))

(def is_elf ((hd bytes)) bool
  (if (lt (bytes_len hd) 64) false (eq (le_at hd 0 4) 1179403647)))   ; "\x7FELF"

; The ELF machine of the CPU the kernel runs on: EM_RISCV or EM_AARCH64.
(def elf_machine () int (if (eq (machine) 2) 243 183))

; Whether the ELF header hd is spec section 10.3's, for this CPU, with its
; program headers, of which there are at most 16, within the image's size.
(def header_ok ((hd bytes) (size int)) bool
  (let phoff (le_at hd 32 8)
    (let phnum (le_at hd 56 2)
      (let entry (le_at hd 24 8)
        (if (eq (le_at hd 4 2) 258)                          ; ELFCLASS64, little endian
            (if (eq (le_at hd 16 4) (bit_or 2 (bit_shl (elf_machine) 16)))  ; ET_EXEC
                (if (eq (le_at hd 54 4) (bit_or 56 (bit_shl phnum 16)))     ; 56 bytes each
                    (if (if (le phnum 16) (ge phoff 64) false)
                        (if (le phoff size)
                            (if (le (add phoff (mul phnum 56)) size)
                                (if (ge entry (user_lo)) (lt entry (image_top)) false)
                                false)
                            false)
                        false)
                    false)
                false)
            false)))))

; A PT_LOAD: its offset in the file, its address, its bytes in the file and
; in memory, and the perm space_map takes for its flags.
(data Seg
  (Seg int int int int int))

(data Segs
  (Segs (list Seg))
  (BadSegs))

(def seg_at ((ph bytes) (at int)) Seg
  (let f (le_at ph (add at 4) 4)
    (Seg (le_at ph (add at 8) 8) (le_at ph (add at 16) 8) (le_at ph (add at 32) 8)
         (le_at ph (add at 40) 8)
         (add (if (eq (bit_and f 2) 0) 0 1) (if (eq (bit_and f 1) 0) 0 2)))))  ; PF_W, PF_X

; Whether a number read from the image is one no sum of two overflows.
(def small ((v int)) bool (if (ge v 0) (lt v 4294967296) false))

; Whether sg may be the image's next segment, after one whose file bytes
; ended at po and whose memory ended at pe: not writable and executable,
; page-aligned, after it in both, within the file, and below image_top.
(def seg_ok ((sg Seg) (po int) (pe int) (size int)) bool
  (match sg
    ((Seg off va fsz msz perm)
      (if (if (small off) (if (small va) (if (small fsz) (small msz) false) false) false)
          (if (if (lt perm 3) (eq (bit_and (bit_or off va) 4095) 0) false)
              (if (if (ge off po) (ge va pe) false)
                  (if (le fsz msz)
                      (if (le (add off fsz) size) (le (add va msz) (image_top)) false)
                      false)
                  false)
              false)
          false))))

; The PT_LOADs among the n program headers in ph from header j, checked,
; in order, at most three: the first after the program headers, which end
; at po in the file, and at or above user_lo.
(def segments ((ph bytes) (j int) (n int) (po int) (pe int) (size int) (acc (list Seg))) Segs
  (if (ge j n)
      (Segs (rev acc))
      (let at (mul j 56)
        (if (eq (le_at ph at 4) 1)                            ; PT_LOAD
            (let sg (seg_at ph at)
              (if (if (seg_ok sg po pe size) (lt (length acc) 3) false)
                  (match sg
                    ((Seg off va fsz msz perm)
                      (segments ph (add j 1) n (add off fsz) (add va msz) size (cons sg acc))))
                  (BadSegs)))
            (segments ph (add j 1) n po pe size acc)))))

; The pages of the image's segments as mapped, how many of its bytes were
; read, and whether every segment was mapped.
(data Load
  (Load (array int) int bool))

; Maps each of segs with its perm, from the file position pos, reading
; its file bytes into it; the rest of its pages are a fresh frame's zeros.
(def load_segs ((s int) (m (array int)) (segs (list Seg)) (pos int)) Load
  (if (is_empty segs)
      (Load m pos true)
      (match (head segs)
        ((Seg off va fsz msz perm)
          (let k (skip (sub off pos))
            (match (ensure s m va (add va msz) perm)
              ((Mem m1)
                (let c (copy_in s va fsz)
                  (load_segs s m1 (tail segs) (add off fsz))))
              ((NoFrames m1) (Load m1 off false))))))))

; An ELF image, whose first 64 bytes, hd, are read: its segments mapped,
; and its entry e_entry.
(def new_elf ((i int) (s int) (size int) (hd bytes)) Proc
  (if (header_ok hd size)
      (let phoff (le_at hd 32 8)
        (let phnum (le_at hd 56 2)
          (let k (skip (sub phoff 64))
            (let ph (read_exact (mul phnum 56))
              (let pos (add phoff (mul phnum 56))
                (match (segments ph 0 phnum pos (user_lo) size (nil Seg))
                  ((Segs segs) (new_loaded i s size hd segs pos))
                  ((BadSegs) (refused i s (skip (sub size pos))))))))))
      (refused i s (skip (sub size (bytes_len hd))))))

(def new_loaded ((i int) (s int) (size int) (hd bytes) (segs (list Seg)) (pos int)) Proc
  (match (load_segs s (array_new (page_count) 0) segs pos)
    ((Load m ended ok)
      (let k (skip (sub size ended))
        (if ok
            (Proc s (user_context (le_at hd 24 8) (user_top)) m 0 -1)
            (Proc s (array_new 0 0) m 0 (out_of_memory i)))))))

; A process whose image the kernel cannot load, in space s, which nothing
; is mapped in yet, once its bytes are read.
(def refused ((i int) (s int) (skipped int)) Proc
  (let f (space_free s)
    (let a (say_proc i)
      (let b (write_err " not started: not an image it loads\n")
        (Proc -1 (array_new 0 0) (array_new 0 0) 0 99)))))

(def new_procs ((ps (array Proc)) (i int) (n int)) (array Proc)
  (if (ge i n)
      ps
      (new_procs (array_set ps i (new_proc i)) (add i 1) n)))

; ---------------------------------------------------------------- the loop

; The next process after cur, in turn, that can run, or -1.
(def pick ((k Kern) (cur int) (j int)) int
  (let n (kcount k)
    (if (gt j n)
        -1
        (let i (mod (add cur j) n)
          (if (eq (kstate k i) -1) i (pick k cur (add j 1)))))))

; The earliest time a sleeping process wakes, or -1 if none sleeps.
(def earliest ((k Kern) (i int) (t int)) int
  (if (ge i (kcount k))
      t
      (if (eq (kstate k i) -7)
          (let w (karg k i 0)
            (earliest k (add i 1) (if (if (lt t 0) true (lt w t)) w t)))
          (earliest k (add i 1) t))))

; Every sleeping process whose time has come, woken.
(def wake_sleepers ((k Kern) (i int) (now int)) Kern
  (if (ge i (kcount k))
      k
      (if (if (eq (kstate k i) -7) (le (karg k i 0) now) false)
          (wake_sleepers (kresume k i 0) (add i 1) now)
          (wake_sleepers k (add i 1) now))))

; The timer's next deadline: the end of a slice from now, or a sleeper's
; time if that is sooner.
(def deadline ((k Kern) (now int)) int
  (let e (earliest k 0 -1)
    (let s (add now (slice_ns))
      (if (if (ge e 0) (lt e s) false) e s))))

(def schedule ((k Kern) (cur int)) int
  (let k1 (wake_sleepers k 0 (clock_ns))
    (let i (pick k1 cur 1)
      (if (lt i 0)
          (idle k1 cur)
          (let t (timer_at (deadline k1 (clock_ns)))
            (after (run k1 i) i))))))

(def run ((k Kern) (i int)) Kern
  (match k
    ((Kern ps q qo arr held pa)
      (Kern (array_set ps i (run_proc i (array_get ps i))) q qo arr held pa))))

(def run_proc ((i int) (p Proc)) Proc
  (match p ((Proc s c m w st) (step i s m w c))))

; What process i's turn ended in, answered.
(def after ((k Kern) (i int)) int
  (let st0 (kstate k 0)
    (if (ge st0 0)
        st0
        (let st (kstate k i)
          (if (eq st -4)
              (kcall k i)
              (if (eq st -6)
                  (let n (kword k i 36)
                    (arrive (kset k i -1) i n))
                  (schedule k i)))))))

; With no process able to run, waits for an interrupt: the timer's, set for
; the next sleeper or a slice, or a device's.
(def idle ((k Kern) (cur int)) int
  (let st0 (kstate k 0)
    (if (ge st0 0)
        st0
        (let t (timer_at (deadline k (clock_ns)))
          (let n (interrupt_wait)
            (if (eq n 0)
                (let d (quiet 0) (schedule k cur))
                (arrive k cur n)))))))

; Device interrupt n, taken: given to the process waiting for it, or kept.
(def arrive ((k Kern) (cur int) (n int)) int
  (let w (waiter k n 0)
    (if (lt w 0)
        (schedule (karrived k n) cur)
        (schedule (kresume (kheld k n) w n) cur))))

(def waiter ((k Kern) (n int) (i int)) int
  (if (ge i (kcount k))
      -1
      (if (if (eq (kstate k i) -5) (eq (karg k i 0) n) false)
          i
          (waiter k n (add i 1)))))

(def karrived ((k Kern) (n int)) Kern
  (match k ((Kern ps q qo arr held pa) (Kern ps q qo (cons n arr) held pa))))

(def kheld ((k Kern) (n int)) Kern
  (match k ((Kern ps q qo arr held pa) (Kern ps q qo arr (cons n held) pa))))

; Ends interrupt n, taken while a process ran: the timer's after disarming
; it, so it does not come again before the next turn sets a deadline.
(def quiet ((n int)) int
  (if (eq n 0)
      (let d (timer_at -1) (interrupt_done 0))
      (interrupt_done n)))

; Runs process i until its next trap, and answers it: a host call or a
; missing page in place, and anything else by ending its turn.
(def step ((i int) (s int) (m (array int)) (w int) (c (array int))) Proc
  (let r (user_run s c)
    (match (trap_of r)
      ((TrapCall n) (syscall i s m w r n))
      ((TrapMissing va) (demand i s m w r va))
      ((TrapFault esr far) (Proc s r m w (killed i r)))
      ((TrapInterrupt n)
        (if (eq n 0)
            (let q (quiet 0) (Proc s r m w -1))
            (Proc s r m w -6))))))

; Gives process i v as its system call's result, and runs it on.
(def answer ((i int) (s int) (m (array int)) (w int) (c (array int)) (v int)) Proc
  (step i s m w (call_result c v)))

(def demand ((i int) (s int) (m (array int)) (w int) (c (array int)) (va int)) Proc
  (if (if (ge va (user_lo)) (lt va (user_top)) false)
      (match (ensure s m (page_floor va) (add va 1) 1)
        ((Mem m1) (step i s m1 w c))
        ((NoFrames m1) (Proc s c m1 w (out_of_memory i))))
      (Proc s c m w (killed i c))))

(def say_proc ((i int)) int
  (let a (write_err "kernel: process ")
    (write_err (digits i))))

(def killed ((i int) (c (array int))) int
  (let a (say_proc i)
    (let b (write_err (append " killed: fault " (append (fault_word 0) " = 0x")))
      (let d (write_err (hex_digits (array_get c 36) 16))
        (let e (write_err (append " " (append (fault_word 1) " = 0x")))
          (let f (write_err (hex_digits (array_get c 32) 16))
            (let g (write_err (append " " (append (fault_word 2) " = 0x")))
              (let h (write_err (hex_digits (array_get c 37) 16))
                (let j (write_err "\n") 99)))))))))

; The names the CPU gives a fault's cause, where it was, and its address,
; words 36, 32, and 37 of a context, as the harness kernels print them.
(def fault_word ((k int)) (list int)
  (if (eq (machine) 2)
      (if (eq k 0) "scause" (if (eq k 1) "sepc" "stval"))
      (if (eq k 0) "esr" (if (eq k 1) "elr" "far"))))

(def out_of_memory ((i int)) int
  (let a (say_proc i)
    (let b (write_err " killed: out of memory\n") 99)))

(def no_user_mode ((i int)) int
  (let a (say_proc i)
    (let b (write_err " not started: no user mode here\n") 99)))

; ------------------------------------------------------ the kernel's calls

(def kcall ((k Kern) (i int)) int
  (let n (kcall_number k i)
    (if (eq n 8)
        (k_arg_count k i)
        (if (eq n 9)
            (k_arg k i)
            (if (eq n 256)
                (k_send k i)
                (if (eq n 257)
                    (k_receive k i)
                    (if (eq n 258)
                        (k_sync k i)
                        (k_calls_rest k i n))))))))

(def k_calls_rest ((k Kern) (i int) (n int)) int
  (if (eq n 259)
      (k_wait k i)
      (if (eq n 260)
          (k_end k i)
          (if (eq n 261)
              (schedule (kset k i -7) i)                ; asleep until its argument
              (if (eq n 262)
                  (k_listen k i)
                  (schedule (kresume k i -5) i))))))

; listen(n)
(def k_listen ((k Kern) (i int)) int
  (let n (karg k i 0)
    (if (eq n 0)
        (schedule (kresume k i -3) i)
        (schedule (kresume k i (if (lt (interrupt_enable n) 0) -3 0)) i))))

; The unread bytes of q from qo, then those of b, as one.
(def join ((q bytes) (qo int) (b bytes)) bytes
  (if (ge qo (bytes_len q))
      b
      (bytes_from_list (append (drop_bytes q qo) (bytes_to_list b)))))

(def drop_bytes ((q bytes) (i int)) (list int)
  (drop_onto q (sub (bytes_len q) 1) i (nil int)))

(def drop_onto ((q bytes) (j int) (i int) (acc (list int))) (list int)
  (if (lt j i) acc (drop_onto q (sub j 1) i (cons (bytes_get q j) acc))))

(def kqueue ((k Kern) (b bytes)) Kern
  (match k ((Kern ps q qo arr held pa) (Kern ps (join q qo b) 0 arr held pa))))

(def kread ((k Kern) (i int) (va int) (n int)) bytes
  (match k ((Kern ps q qo arr held pa) (space_read (proc_space (array_get ps i)) va n))))

; send(_, bytes)
(def k_send ((k Kern) (i int)) int
  (let buf (karg k i 1)
    (let len (karg k i 2)
      (if (user_ok buf len)
          (let k1 (kmapped k i buf len)
            (if (ge (kstate k1 i) 0)
                (after k1 i)
                (let b (kread k1 i buf len)
                  (schedule (deliver (kresume (kqueue k1 b) i len)) i))))
          (schedule (kresume k i -5) i)))))

; Gives the first receiving process as many queued bytes as it has room for.
(def deliver ((k Kern)) Kern
  (let r (find_state k -2 0)
    (if (if (lt r 0) true (eq (kunread k) 0))
        k
        (let room (karg k r 2)
          (let buf (karg k r 1)
            (let n (if (lt (kunread k) room) (kunread k) room)
              (if (kwritable k r buf n)
                  (let k1 (kmapped k r buf n)
                    (if (ge (kstate k1 r) 0) k1 (give k1 r buf n)))
                  (kresume k r -5))))))))

; Whether process i may write the n bytes from va, as writable says.
(def kwritable ((k Kern) (i int) (va int) (n int)) bool
  (match k
    ((Kern ps q qo arr held pa)
      (match (array_get ps i) ((Proc s c m w st) (writable m va n))))))

(def give ((k Kern) (r int) (buf int) (n int)) Kern
  (match k
    ((Kern ps q qo arr held pa)
      (let w (space_write (proc_space (array_get ps r)) buf q qo (add qo n))
        (Kern (array_set ps r (resume (array_get ps r) n)) q (add qo n) arr held pa)))))

; receive(_, room)
(def k_receive ((k Kern) (i int)) int
  (let buf (karg k i 1)
    (let room (karg k i 2)
      (if (if (user_ok buf room) (gt room 0) false)
          (let k1 (kset k i -2)
            (if (gt (kunread k1) 0)
                (schedule (deliver k1) i)
                (schedule (wake_syncers k1 0) i)))
          (schedule (kresume k i (if (eq room 0) 0 -5)) i)))))

; Every syncing process, done, now that nothing is queued and a receiver
; waits again.
(def wake_syncers ((k Kern) (i int)) Kern
  (if (ge i (kcount k))
      k
      (if (eq (kstate k i) -3)
          (wake_syncers (kresume k i 0) (add i 1))
          (wake_syncers k (add i 1)))))

; sync()
(def k_sync ((k Kern) (i int)) int
  (if (if (eq (kunread k) 0) (ge (find_state k -2 0) 0) false)
      (schedule (kresume k i 0) i)
      (schedule (kset k i -3) i)))

; wait(n)
(def k_wait ((k Kern) (i int)) int
  (let n (karg k i 0)
    (if (eq n 0)
        (schedule (kresume k i -3) i)
        (if (lt (interrupt_enable n) 0)
            (schedule (kresume k i -3) i)
            (match k
              ((Kern ps q qo arr held pa)
                (if (any_eq n arr)
                    (schedule (kresume (Kern ps q qo (remove_one n arr) (cons n held) pa) i n) i)
                    (schedule (kset (Kern ps q qo arr held pa) i -5) i))))))))

; end(n)
(def k_end ((k Kern) (i int)) int
  (let n (karg k i 0)
    (match k
      ((Kern ps q qo arr held pa)
        (if (any_eq n held)
            (let d (interrupt_done n)
              (schedule (kresume (Kern ps q qo arr (remove_one n held) pa) i 0) i))
            (schedule (kresume (Kern ps q qo arr held pa) i -5) i))))))

(def remove_one ((n int) (xs (list int))) (list int)
  (if (is_empty xs)
      xs
      (if (eq (head xs) n) (tail xs) (cons (head xs) (remove_one n (tail xs))))))

; ------------------------------------------------------------ system calls

; Spec section 10.3's numbers. Arguments are the library's call_arg, in
; the registers the CPU passes them in. A number from 256 is the kernel's
; own, and 8 and 9 ask for the arguments, which the kernel holds: the
; scheduler answers those.
(def syscall ((i int) (s int) (m (array int)) (w int) (c (array int)) (n int)) Proc
  (if (if (ge n 256) true (if (eq n 8) true (eq n 9)))
      (Proc s c m w -4)
      (let a (call_arg c 0)
        (let b (call_arg c 1)
          (let d (call_arg c 2)
            (if (eq n 1)
                (sys_read i s m w c a b d)
                (if (eq n 2)
                    (sys_write i s m w c a b d)
                    (if (eq n 3)
                        (Proc s c m w (bit_and a 255))
                        (sys_rest i s m w c n a b d)))))))))

(def sys_rest ((i int) (s int) (m (array int)) (w int) (c (array int)) (n int)
               (a int) (b int) (d int)) Proc
  (if (eq n 4)
      (answer i s m w c (if (user_ok a b) (if (eq d 1) -3 -9) -5))
      (if (eq n 6)
          (answer i s m w c (if (if (user_ok a b) (user_ok d (call_arg c 3)) false) -3 -5))
          (if (eq n 7)
              (answer i s m w c (if (user_ok a b) -3 -5))
              (if (eq n 10)
                  (sys_region i s m w c a b)
                  (if (eq n 11)
                      (answer i s m w c (clock_ns))    ; the clock
                      (answer i s m w c -5)))))))      ; close, and any other

; read(stream, buf, len): standard input, into the process, at most 64 KB,
; and only where it may write.
(def sys_read ((i int) (s int) (m (array int)) (w int) (c (array int))
               (h int) (buf int) (len int)) Proc
  (if (if (eq h 0) (user_ok buf len) false)
      (if (eq len 0)
          (answer i s m w c 0)
          (let k (if (lt len 65536) len 65536)
            (if (writable m buf k)
                (match (ensure s m (page_floor buf) (add buf k) 1)
                  ((Mem m1)
                    (let bs (read_some 0 k)
                      (let got (bytes_len bs)
                        (let r (space_write s buf bs 0 got)
                          (answer i s m1 w c got)))))
                  ((NoFrames m1) (Proc s c m1 w (out_of_memory i))))
                (answer i s m w c -5))))
      (answer i s m w c -5)))

; write(stream, buf, len): standard output or error, out of the process.
(def sys_write ((i int) (s int) (m (array int)) (w int) (c (array int))
                (h int) (buf int) (len int)) Proc
  (if (if (if (eq h 1) true (eq h 2)) (user_ok buf len) false)
      (if (eq len 0)
          (answer i s m w c 0)
          (match (ensure s m (page_floor buf) (add buf len) 1)
            ((Mem m1)
              (let r (write_bytes h (space_read s buf len) 0 len)
                (answer i s m1 w c (if (lt r 0) r len))))
            ((NoFrames m1) (Proc s c m1 w (out_of_memory i)))))
      (answer i s m w c -5)))

; region(base, len): the device's pages at the next pages of the window
; above the stack. The host decides what is a device; a range too long for
; what is left of the window is -5, before the host is asked.
(def sys_region ((i int) (s int) (m (array int)) (w int) (c (array int))
                 (base int) (len int)) Proc
  (if (if (lt len 1) true (lt base 0))
      (answer i s m w c -3)
      (let first (page_floor base)
        (let pages (add (bit_shr (sub (page_floor (sub (add base len) 1)) first) 12) 1)
          (if (gt pages (sub (window_pages) w))
              (answer i s m w c -5)
              (let va (add (window) (mul w 4096))
                (let r (space_map_device s va base len)
                  (if (lt r 0)
                      (answer i s m w c r)
                      (answer i s m (add w pages) c
                        (add va (sub base first)))))))))))

; ------------------------------------------------- the processes' arguments

; The kernel's own arguments, its boot arguments, each "N:VALUE", give
; process N the argument VALUE, in their order; any other is ignored.
(def proc_args ((pa (array (list (list int)))) (k int)) (array (list (list int)))
  (if (ge k (arg_count))
      (rev_each pa 0)
      (let a (arg k)
        (let i (arg_slot a 0)
          (if (if (ge i 0) (lt i (array_len pa)) false)
              (proc_args (array_set pa i (cons (after_colon a) (array_get pa i))) (add k 1))
              (proc_args pa (add k 1)))))))

; Each process's arguments, gathered last first, put in order.
(def rev_each ((pa (array (list (list int)))) (i int)) (array (list (list int)))
  (if (ge i (array_len pa))
      pa
      (rev_each (array_set pa i (rev (array_get pa i))) (add i 1))))

; The process number before a's colon, or -1 if a is not "N:VALUE".
(def arg_slot ((a (list int)) (n int)) int
  (if (is_empty a)
      -1
      (let c (head a)
        (if (eq c 58)
            n
            (if (if (ge c 48) (le c 57) false)
                (arg_slot (tail a) (add (mul n 10) (sub c 48)))
                -1)))))

(def after_colon ((a (list int))) (list int)
  (if (is_empty a)
      a
      (if (eq (head a) 58) (tail a) (after_colon (tail a)))))

; Argument n of as, which has more than n.
(def arg_of ((as (list (list int))) (n int)) (list int)
  (if (eq n 0) (head as) (arg_of (tail as) (sub n 1))))

(def kargs ((k Kern) (i int)) (list (list int))
  (match k ((Kern ps q qo arr held pa) (array_get pa i))))

; arg_count() and arg(n, buf, room), spec section 10.3's calls 8 and 9,
; which the kernel answers here, since the arguments are its.
(def k_arg_count ((k Kern) (i int)) int
  (schedule (kresume k i (length (kargs k i))) i))

(def k_arg ((k Kern) (i int)) int
  (let n (karg k i 0)
    (let buf (karg k i 1)
      (let room (karg k i 2)
        (let as (kargs k i)
          (if (if (lt n 0) true (ge n (length as)))
              (schedule (kresume k i -5) i)
              (let a (bytes_from_list (arg_of as n))
                (let len (bytes_len a)
                  (let w (if (lt room len) room len)
                    (if (if (user_ok buf w) (kwritable k i buf w) false)
                        (k_arg_copy (kmapped k i buf w) i buf a w len)
                        (schedule (kresume k i -5) i)))))))))))

(def k_arg_copy ((k Kern) (i int) (buf int) (a bytes) (w int) (len int)) int
  (if (ge (kstate k i) 0)
      (after k i)
      (let c (space_write (proc_space_of k i) buf a 0 w)
        (schedule (kresume k i len) i))))

(def proc_space_of ((k Kern) (i int)) int
  (match k ((Kern ps q qo arr held pa) (proc_space (array_get ps i)))))

(def main () int
  (let n (read_number 0)
    (if (lt n 1)
        (let e (write_err "kernel: no process to run\n") 99)
        (let ended (Proc -1 (array_new 0 0) (array_new 0 0) 0 99)
          (let e (interrupt_enable 0)                   ; the timer
            (let ps (new_procs (array_new n ended) 0 n)
              (let pa (proc_args (array_new n (nil (list int))) 0)
                (schedule (Kern ps (bytes_from_list (nil int)) 0 (nil int) (nil int) pa) 0))))))))

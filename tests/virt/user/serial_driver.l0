; A serial driver, run as a process of kernel.l0, for a PL011: it is given
; its device's base and interrupt as arguments, in decimal, by the kernel,
; which has them from its own boot arguments, so it names no board. It
; opens the device as a region, by the host's system call 10, unmasks its
; transmit interrupt, and then writes what other processes send it (the
; kernel's call 257), a byte at a time, waiting after each for the
; transmit interrupt (259), which says the byte has gone, and clearing it
; before ending it (260). It never ends: the kernel ends the run when
; process 0 does.
(def put ((u int) (irq int) (b int)) int
  (let w (region_write8 u 0 b)                          ; the data register
    (let n (supervisor_call 259 irq 0 0)                ; until it is sent
      (let c (region_write32 u 68 32)                   ; UARTICR: cleared
        (supervisor_call 260 irq 0 0)))))

(def put_all ((u int) (irq int) (b bytes) (i int)) int
  (if (ge i (bytes_len b))
      0
      (let w (put u irq (bytes_get b i)) (put_all u irq b (add i 1)))))

(def serve ((u int) (irq int)) int
  (let b (supervisor_receive 257 0 4096)
    (let w (put_all u irq b 0) (serve u irq))))

(def main () int
  (if (lt (arg_count) 2)
      (let e (write_err "serial driver: give it its device's base and interrupt\n") 2)
      (let u (region_open (int_prefix (arg 0) 0) 4096)
        (if (lt u 0)
            (let e (write_err "serial driver: no device there\n") 2)
            (let m (region_write32 u 56 32)               ; UARTIMSC: transmit
              (serve u (int_prefix (arg 1) 0)))))))

; Spec section 6.13: a page mapped once cannot be mapped again, even with
; another frame, and space_map_device's pages count as mapped.
(def main () int
  (let s (space_new)
    (let f (frame_new)
      (let a (write_line (digits (space_map_device s 3221225472 (board_uart) (board_uart_len))))
        (space_map s 3221225472 f 1)))))

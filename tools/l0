#!/bin/sh
# l0 -- the L0 toolchain driver.
#
# Usage:
#   l0 build FILE.l0 [MORE.l0 ...] [-o OUT]   compile and link an executable
#   l0 check FILE.l0 [MORE.l0 ...]            type check only
#   l0 run   FILE.l0 [MORE.l0 ...] [-- ARG ...]
#                                             build to a temporary file, and run
#                                             it with the arguments after --
#   l0 boot  IMAGE [ARG ...]                  boot an image built with
#                                             --target virt, on standard input
#   l0 card  IMAGE DIR [ARG ...]              write the files an image built with
#                                             --target pi5 needs on an SD card,
#                                             standard input among them
#   l0 emit  FILE.l0 [MORE.l0 ...]            write LLVM IR to stdout
#   l0 link  IR -o OUT                        link IR the compiler wrote, as
#                                             l0 build does, for any target
#   l0 test  FILE.l0 [MORE.l0 ...]            run every (def test_NAME () int ...)
#   l0 fmt   [--check] FILE.l0 ...            supply each line's closing parens
#                                             from its indentation, in place;
#                                             --check only shows what would change
#   l0 doc   [FILE | NAME | TEXT]             the standard library: an index, one
#                                             file (prelude, io, test) in full,
#                                             one definition, or a search
#   l0 spec  [--path | PART]                  the language specification; PART
#                                             runtime, virt-aarch64, virt-riscv64,
#                                             pi5, or process; --path every file
#   l0 examples [test] [--path]               worked examples, or their tests
#   l0 init  [DIR]                            scaffold a project for an agent
#   l0 version
#
# Options:
#   --no-prelude    do not include the standard library
#   --test          l0 check: check as l0 test builds, with test.l0 linked
#   --match TEXT    l0 test: run only tests whose names contain TEXT
#   --bless         l0 test: rewrite golden files instead of comparing
#   -j N            l0 test: run up to N tests at once, in place of
#                   L0_JOBS, or else one on this host and one for each CPU
#                   on the board
#   --target virt   l0 build, run, link, and test: for QEMU's virt board,
#                   with no operating system (spec section 9.2), rather
#                   than this host
#   --target proc   l0 build and link: a process for a kernel (spec
#                   sections 9.2 and 10.3), which only a kernel runs
#   --target pi5    l0 build and link: for the Raspberry Pi 5, with no
#                   operating system (spec section 10.3), which no emulator
#                   runs; l0 card writes what its SD card needs
#   --arch ARCH     with --target virt or proc, the CPU: aarch64, the
#                   default unless L0_ARCH names another, or riscv64; the
#                   Raspberry Pi 5's is aarch64
#   --heap-mb N     with --target virt or pi5, the program's heap and its
#   --stack-mb N    stack, in megabytes, in place of the board's, which
#                   leaves the rest of its RAM to frames (spec section
#                   10.3): a kernel needs little of either
#   --layout FILE   with --target virt or pi5, a linker script to lay the
#                   image out with, in place of the board's template, which
#                   must define what the template does (spec section 10.3)
#
# With --target virt, l0 build writes a raw image, as the CPU's boot
# protocol loads it, and l0 run boots it with QEMU, qemu-system-aarch64 for
# aarch64 or qemu-system-riscv64 for riscv64, whose firmware's banner goes
# nowhere, with all of standard input loaded as the program's, the
# arguments after -- as its boot arguments, which hold no space, its
# standard output on the board's serial line, and its standard error and
# exit status passed back as the program's own. l0 boot IMAGE ARG ... does
# the same for a built image, on the board its boot header names. The
# image is linked by L0_VIRT_LD, an ld.lld, if set, else by ld.lld on PATH,
# and otherwise by ld.lld in a container built from tools/virt/Dockerfile
# the first time; L0_QEMU
# names the emulator, and L0_RUNTIMES a directory of the targets'
# runtimes, one for each runtime/targets/NAME.target, which defaults to the
# installed ones. The board's virtio-mmio transports are modern, and
# L0_QEMU_ARGS, split at spaces, is added to QEMU's command line, to give
# the board devices beyond its own: L0_QEMU_ARGS="-device virtio-gpu-device"
# puts a display on a transport, and L0_QEMU_ARGS="-smp 4" gives it four
# CPUs to run threads on (spec section 6.18).
#
# With --target proc, l0 build writes a process's image as its kernel loads
# it: a static ELF whose segments, the code, the rodata, and the data, a
# kernel maps each by its own permissions from 0xC0000000, the virtual
# address spec section 10.3 fixes, with runtime/bare/proc.ll and the CPU's
# part as its host, which any kernel that answers that section's system
# calls runs. It is linked as --target virt's images are.
#
# l0 test runs every test with L0_RC_CHECK set, and a test that leaves
# memory it never freed fails, since that is a compiler or runtime bug.
# With --target virt it boots the program once a test, naming the test by
# its boot argument; there is no environment there, so no leak check, and
# no files, so check_file fails and --bless is refused. With -j N, or
# L0_JOBS=N, up to N tests run at once, and their TAP lines are written in
# the tests' order all the same. It is one at a time on this host unless
# asked, since tests there share the directory l0 test runs in and may
# write the same files, and one for each CPU on the board, which has none.
#
# Several files are compiled together, because L0 has no module system.
# The standard library, lib/prelude.l0 and lib/io.l0, is included
# automatically; pass --no-prelude to suppress it. A function, type, or
# constructor you define shadows the prelude's of the same name, so the
# prelude can gain them without breaking a program that already used the name.
#
# Paths are relative to wherever you are, so this works from anywhere.
#
# L0_COMPILER, L0_RUNTIME, and L0_HOST name a compiler, a runtime object,
# and the host object linked with it (spec section 10.3) to use instead of
# the installed ones; tools/test.sh --compiled points them at the ones it
# just built, so it tests the current compiler rather than the seed's.

set -eu

SELF=$(cd "$(dirname "$0")" && pwd)

# Installed layout is <prefix>/bin/l0 with <prefix>/lib/l0 beside it; the
# repository layout is tools/l0 with lib/ beside it. Support both so the same
# driver works before and after installation.
LIB=""
for d in "$SELF/../lib/l0" "$SELF/../lib"; do
    if [ -f "$d/prelude.l0" ]; then
        LIB=$(cd "$d" && pwd)
        break
    fi
done
if [ -z "$LIB" ]; then
    echo "l0: cannot find the L0 library next to $SELF" >&2
    exit 2
fi

find_cc() {
    if [ -n "${L0_CC:-}" ]; then
        echo "$L0_CC"
    elif [ -x /opt/homebrew/opt/llvm/bin/clang ]; then
        echo /opt/homebrew/opt/llvm/bin/clang
    elif command -v clang > /dev/null 2>&1; then
        echo clang
    else
        echo "l0: no clang found; set L0_CC" >&2
        exit 2
    fi
}

# In a source checkout the compiler and runtime may not be built yet, or may
# predate the checked-in seed and runtime. Build them from those, which needs
# clang but no existing L0.
ensure_toolchain() {
    root=$(cd "$LIB/.." && pwd)
    if [ -x "$LIB/l0c" ] && [ -f "$LIB/l0rt.o" ] && [ -f "$LIB/l0host.o" ]; then
        if [ ! -f "$root/bootstrap/stage2.ll" ]; then
            return 0
        fi
        if [ ! "$root/bootstrap/stage2.ll" -nt "$LIB/l0c" ] &&
            [ ! "$root/runtime/l0rt.ll" -nt "$LIB/l0rt.o" ] &&
            [ ! "$root/runtime/host-libc.ll" -nt "$LIB/l0host.o" ]; then
            return 0
        fi
    fi
    if [ ! -f "$root/bootstrap/stage2.ll" ]; then
        echo "l0: installation is incomplete (no compiler at $LIB/l0c)" >&2
        exit 2
    fi
    echo "l0: building the toolchain from bootstrap/stage2.ll" >&2
    rebuild_lib
}

# Several l0 commands may find the toolchain stale at once, as the test
# suite's parallel jobs do after a seed refresh, and two installs writing
# lib/l0c together leave a compiler neither wrote. One rebuilds while the
# others wait for it, by a directory as the lock, which every host has;
# a lock left by a build that died is taken over after five minutes.
rebuild_lib() {
    root=$(cd "$LIB/.." && pwd)
    lock="$LIB/.building"
    if mkdir "$lock" 2> /dev/null; then
        if ! "$root/tools/install.sh" --into "$LIB" > /dev/null; then
            rmdir "$lock" 2> /dev/null
            exit 2
        fi
        rmdir "$lock" 2> /dev/null
    else
        waited=0
        while [ -d "$lock" ] && [ "$waited" -lt 3000 ]; do
            sleep 0.1
            waited=$((waited + 1))
        done
        if [ -d "$lock" ]; then
            rmdir "$lock" 2> /dev/null
            rebuild_lib
        fi
    fi
}

# l0 fmt is an L0 program of its own, built by tools/install.sh beside the
# compiler. In a checkout it is rebuilt when its source is newer.
ensure_fmt() {
    root=$(cd "$LIB/.." && pwd)
    if [ -f "$root/tools/fmt.l0" ]; then
        if [ ! -x "$LIB/l0fmt" ] || [ "$root/tools/fmt.l0" -nt "$LIB/l0fmt" ] ||
            [ "$root/tools/fmt_main.l0" -nt "$LIB/l0fmt" ] ||
            [ "$LIB/l0c" -nt "$LIB/l0fmt" ]; then
            echo "l0: building l0 fmt from tools/fmt.l0" >&2
            rebuild_lib
        fi
    elif [ ! -x "$LIB/l0fmt" ]; then
        echo "l0: installation is incomplete (no formatter at $LIB/l0fmt)" >&2
        exit 2
    fi
}

usage() {
    sed -n '2,/^$/p' "$SELF/l0" | sed -e '/^$/d' -e 's/^# \{0,1\}//'
    exit 2
}

# ------------------------------------------------------------------ inputs

WANT_PRELUDE=1
WANT_TEST=0
OUT=""
FILES=""
MATCH=""
BLESS=""
TARGET=host
ARCH=${L0_ARCH:-aarch64}
HEAP_MB=""
STACK_MB=""
LAYOUT=""
JOBS=""

# megabytes OPTION N: N, if it is a whole number of megabytes from 1 to
# 9,999,999, written without a leading 0, or else the driver stops.
megabytes() {
    case "$2" in
        "" | 0* | *[!0-9]* | ????????*)
            echo "l0: $1 needs a number of megabytes from 1 to 9999999, not '$2'" >&2
            exit 2
            ;;
    esac
    echo "$2"
}

# job_count WHAT N: N, if it is a whole number of jobs from 1 to 9,999,
# written without a leading 0, or else the driver stops. WHAT is the
# option or variable it came from.
job_count() {
    case "$2" in
        "" | 0* | *[!0-9]* | ?????*)
            echo "l0: $1 needs a number of jobs from 1 to 9999, not '$2'" >&2
            exit 2
            ;;
    esac
    echo "$2"
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-prelude) WANT_PRELUDE=0 ;;
            --test) WANT_TEST=1 ;;
            --bless) BLESS="--bless" ;;
            --target)
                shift
                [ $# -gt 0 ] || { echo "l0: --target needs a name" >&2; exit 2; }
                case "$1" in
                    host | virt | proc | pi5) TARGET=$1 ;;
                    *)
                        echo "l0: unknown target $1; the targets are host, virt, proc, and pi5" >&2
                        exit 2
                        ;;
                esac
                ;;
            --arch)
                shift
                [ $# -gt 0 ] || { echo "l0: --arch needs a name" >&2; exit 2; }
                ARCH=$1
                ;;
            --heap-mb)
                shift
                HEAP_MB=$(megabytes --heap-mb "${1:-}") || exit 2
                ;;
            --stack-mb)
                shift
                STACK_MB=$(megabytes --stack-mb "${1:-}") || exit 2
                ;;
            --layout)
                shift
                [ $# -gt 0 ] || { echo "l0: --layout needs a linker script" >&2; exit 2; }
                if [ ! -f "$1" ]; then
                    echo "l0: cannot read $1" >&2
                    exit 1
                fi
                LAYOUT=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
                ;;
            --match)
                shift
                [ $# -gt 0 ] || { echo "l0: --match needs text" >&2; exit 2; }
                MATCH=$1
                ;;
            -j)
                shift
                JOBS=$(job_count -j "${1:-}") || exit 2
                ;;
            -o)
                shift
                [ $# -gt 0 ] || { echo "l0: -o needs a path" >&2; exit 2; }
                OUT=$1
                ;;
            -*)
                echo "l0: unknown option $1" >&2
                exit 2
                ;;
            *)
                if [ ! -f "$1" ]; then
                    echo "l0: cannot read $1" >&2
                    exit 1
                fi
                FILES="$FILES $1"
                ;;
        esac
        shift
    done
    if [ -z "$FILES" ]; then
        echo "l0: no source files given" >&2
        exit 2
    fi
    if [ -n "$JOBS" ] && [ "$cmd" != test ]; then
        echo "l0: -j is for l0 test, which runs tests side by side" >&2
        exit 2
    fi
    # A board's layout is its program's to size (spec section 10.3); a
    # process's is its kernel's, and an operating system's host has none.
    case $TARGET in
        virt | pi5) ;;
        *)
            for o in "--heap-mb:$HEAP_MB" "--stack-mb:$STACK_MB" "--layout:$LAYOUT"; do
                if [ -n "${o#*:}" ]; then
                    echo "l0: ${o%%:*} is for --target virt or pi5, whose layout the program sizes, not --target $TARGET" >&2
                    exit 2
                fi
            done
            ;;
    esac
}

# Writes an input bundle: a table of byte offsets and paths followed by the
# concatenated sources, so diagnostics can name the file a problem is in
# rather than a line in the concatenation.
write_bundle() {
    dest=$1
    set -- $SOURCES
    # Each file's offset in the concatenation, and where the standard
    # library, the first PRELUDE_FILES of them, ends: from one wc for every
    # file, which writes a line for each, in order, and a total after them
    # when there are several.
    sizes=$(wc -c "$@")
    table=""
    offset=0
    i=0
    prelude_end=0
    while read -r size f; do
        [ "$i" -lt $# ] || break
        table="$table$offset $f
"
        offset=$((offset + size))
        i=$((i + 1))
        if [ "$i" = "${PRELUDE_FILES:-0}" ]; then
            prelude_end=$offset
        fi
    done << EOF
$sizes
EOF
    {
        echo "#l0bundle"
        # Checking asks whether the code is well typed, not whether it is a
        # complete program, so a library file or a work in progress is not
        # nagged about a missing entry point.
        [ "${NOMAIN:-0}" = 1 ] && echo "#nomain"
        # Where the standard library ends. Everything after it is the program,
        # and a program definition shadows a prelude one of the same name, so
        # the prelude can gain functions without breaking existing code.
        [ "$prelude_end" != 0 ] && echo "#prelude $prelude_end"
        printf '%s' "$table"
        echo "#source"
        cat "$@"
    } > "$dest"
}

# Runs the compiler, leaving IR in $1 on success. Diagnostics go to stderr.
run_compiler() {
    irout=$1
    write_bundle "$TMP/in"
    if ! "$COMPILER" < "$TMP/in" > "$TMP/out"; then
        echo "l0: the compiler crashed" >&2
        exit 2
    fi
    case "$(head -n 1 "$TMP/out")" in
        O)
            # Warnings come first in the IR, as comments; shown, never fatal.
            sed -n '2,$ { /^; [^ ].*: warning: /!q; s/^; //p; }' "$TMP/out" >&2
            tail -n +2 "$TMP/out" > "$irout"
            ;;
        E)
            tail -n +2 "$TMP/out" >&2
            exit 1
            ;;
        *)
            echo "l0: compiler produced untagged output" >&2
            exit 2
            ;;
    esac
}

setup() {
    parse_args "$@"
    if [ -z "${L0_COMPILER:-}" ]; then
        ensure_toolchain
    fi
    COMPILER=${L0_COMPILER:-$LIB/l0c}
    RUNTIME=${L0_RUNTIME:-$LIB/l0rt.o}
    HOST=${L0_HOST:-$LIB/l0host.o}
    SOURCES=$FILES
    PRELUDE_FILES=0
    if [ "$WANT_TEST" = 1 ]; then
        # lib/test.l0 joins the standard library in the prelude group.
        SOURCES="$LIB/prelude.l0 $LIB/io.l0 $LIB/test.l0 $FILES"
        PRELUDE_FILES=3
    elif [ "$WANT_PRELUDE" = 1 ]; then
        SOURCES="$LIB/prelude.l0 $LIB/io.l0 $FILES"
        PRELUDE_FILES=2
    fi
    TMP=$(mktemp -d "$(scratch_base)/l0.XXXXXX")
    trap 'rm -rf "$TMP"' EXIT
}

# Where a build and its program live while the driver runs: in a source
# checkout its own tmp/, so nothing is built or run outside the checkout;
# once installed, the system's temporary directory.
scratch_base() {
    root=$(cd "$LIB/.." && pwd)
    if [ -f "$root/bootstrap/stage2.ll" ] && [ -d "$root/tmp" ]; then
        echo "$root/tmp"
    else
        echo "${TMPDIR:-/tmp}"
    fi
}

# ------------------------------------------------- l0 init's AGENTS.md

# l0 init owns the part of a project's AGENTS.md between two lines, and the
# rest is the project's, kept when l0 init runs again. The first line
# records the part's checksum as l0 init wrote it, so that a part edited
# since is never replaced: the new one is written beside it instead.
AGENTS_BEGIN='<!-- l0 init: begin'
AGENTS_END='<!-- l0 init: end -->'
AGENTS_HEADING='# Working with L0 in this project'

agents_sum() { cksum | awk '{ print $1 "-" $2 }'; }

# The part l0 init writes, on stdout.
agents_part() {
    body=$(awk 1 "$LIB/AGENTS.md" | agents_sum)
    echo "$AGENTS_BEGIN $body; l0 init replaces what is between these lines -->"
    awk 1 "$LIB/AGENTS.md"
    echo "$AGENTS_END"
}

# init_agents FILE: write l0 init's part into FILE, keeping the rest of it,
# and say on stdout what was done.
init_agents() {
    f=$1
    new=$(mktemp "$f.XXXXXX")
    agents_part > "$new"
    if [ ! -e "$f" ]; then
        mv "$new" "$f"
        echo "AGENTS.md: written"
        return
    fi
    # The line numbers of every begin line, and of every end line.
    begins=$(awk -v b="$AGENTS_BEGIN " 'index($0, b) == 1 { print NR }' "$f")
    ends=$(awk -v e="$AGENTS_END" '$0 == e { print NR }' "$f")
    if [ -z "$begins" ] && [ -z "$ends" ]; then
        if [ "$(sed -n 1p "$f")" = "$AGENTS_HEADING" ]; then
            # A copy from an l0 init that wrote the whole file, edited or
            # not: there is nothing to tell its lines from the project's.
            mv "$new" "$f.l0-new"
            echo "AGENTS.md: kept, as l0 init wrote it before it marked its part;"
            echo "  the new part is in AGENTS.md.l0-new: move what the project"
            echo "  added into it, outside its marker lines, and replace AGENTS.md"
            return
        fi
        # The project's own, from before L0: the part goes after it.
        { cat "$f"; echo; cat "$new"; } > "$new.all"
        rm -f "$new"
        mv "$new.all" "$f"
        echo "AGENTS.md: l0's part added after the project's own"
        return
    fi
    ok=no
    if [ "$(echo $begins $ends | wc -w)" -eq 2 ] && [ -n "$begins" ] &&
        [ -n "$ends" ] && [ "$begins" -lt "$ends" ]; then
        ok=yes
    fi
    if [ "$ok" = yes ]; then
        recorded=$(sed -n "${begins}s/^$AGENTS_BEGIN \([0-9-]*\);.*/\1/p" "$f")
        found=$(awk -v b="$begins" -v e="$ends" 'NR > b && NR < e' "$f" |
            agents_sum)
        [ "$recorded" = "$found" ] || ok=edited
    fi
    if [ "$ok" != yes ]; then
        mv "$new" "$f.l0-new"
        if [ "$ok" = edited ]; then
            echo "AGENTS.md: kept, since l0's part was edited since l0 init wrote it;"
        else
            echo "AGENTS.md: kept, since its marker lines are not one begin and one end;"
        fi
        echo "  the new part is in AGENTS.md.l0-new, to merge by hand"
        return
    fi
    awk -v b="$begins" -v e="$ends" -v part="$new" '
        NR == b { while ((getline line < part) > 0) print line; next }
        NR > b && NR <= e { next }
        { print }' "$f" > "$new.all"
    rm -f "$new"
    if cmp -s "$new.all" "$f"; then
        rm -f "$new.all"
        echo "AGENTS.md: already current"
    else
        mv "$new.all" "$f"
        echo "AGENTS.md: l0's part replaced, the rest kept"
    fi
}

# ------------------------------------------------- hosts without libc

# The targets without libc are described by manifests, runtime/targets/
# NAME.target in a source checkout (tools/targets.sh says what they hold),
# and each has its runtime in a directory of its own, NAME, under
# L0_RUNTIMES or the library: its parts as bitcode for its CPU, listed in
# its file parts, its layout, layout.ld, and its manifest, target. NAME is
# the target and the CPU, virt-aarch64 for --target virt --arch aarch64.

# load_target: the runtime of the target --target and --arch name, in
# tdir, with its manifest's T_ variables set. In a source checkout it is
# rebuilt from runtime/ first when it is missing or older than its
# sources, as ensure_toolchain rebuilds the host's.
load_target() {
    tname="$TARGET-$ARCH"
    tdir="${L0_RUNTIMES:-$LIB}/$tname"
    root=$(cd "$LIB/.." && pwd)
    if [ -z "${L0_RUNTIMES:-}" ] && [ -f "$root/tools/targets.sh" ]; then
        if [ ! -f "$root/runtime/targets/$tname.target" ]; then
            echo "l0: there is no --target $TARGET for --arch $ARCH" >&2
            exit 2
        fi
        (
            ROOT=$root
            CC=$(find_cc)
            # shellcheck source=/dev/null
            . "$root/tools/targets.sh"
            if target_stale "$tname" "$tdir"; then
                target_runtime "$tname" "$tdir"
            fi
        ) || true
    fi
    if [ ! -f "$tdir/parts" ]; then
        echo "l0: no runtime for --target $TARGET --arch $ARCH in $tdir; clang could not build one" >&2
        [ -f "$tdir.err" ] && sed 's/^/    /' "$tdir.err" >&2
        exit 2
    fi
    T_CFLAGS="" T_TAIL_WORDS="" T_LDFLAGS="" T_INPUT_AT="" T_INPUT_LEN_AT=""
    # shellcheck source=/dev/null
    . "$tdir/target"
}

# tail_words_ok IR: whether every tail call in IR passes at most
# T_TAIL_WORDS words, where the target sets that; spec section 10.3 says
# why a wider one is refused rather than built.
tail_words_ok() {
    [ -n "$T_TAIL_WORDS" ] || return 0
    widest=$(grep 'musttail call' "$1" | sed 's/^[^(]*(//' | awk -F, '{print NF}' |
        sort -n | tail -n 1)
    [ -z "$widest" ] && return 0
    if [ "$widest" -gt "$T_TAIL_WORDS" ]; then
        echo "l0: a tail call here passes $widest words, and --arch $ARCH takes at most $T_TAIL_WORDS, since LLVM gets more wrong there (spec section 10.3)" >&2
        return 1
    fi
}

# bare_link IR OUT: an image of IR for the target --target and --arch name,
# a board with no operating system or a process of a kernel. clang
# compiles the program with the target's parts linked into it, so all are
# optimized as one module, and only a linker that places sections is
# needed after. That is ld.lld: L0_VIRT_LD if it names one, or else the one
# on PATH, or else the one in a container. It never sees bitcode, so its
# LLVM may be older than clang's.
bare_link() {
    load_target
    tail_words_ok "$1" || exit 1
    write_layout "$TMP/layout.ld"
    parts=""
    for p in $(cat "$tdir/parts"); do
        parts="$parts -Xclang -mlink-bitcode-file -Xclang $tdir/$p"
    done
    # shellcheck disable=SC2086
    "$(find_cc)" --target="$T_TRIPLE" $T_CFLAGS -O2 -Wno-override-module -c "$1" \
        $parts -o "$TMP/bare.o"
    # Each image is as its loader loads it (spec section 10.3), by the
    # manifest's T_LDFLAGS: a board's raw, for its CPU's boot protocol, and
    # a process's an ELF, whose segments its kernel maps.
    ld=${L0_VIRT_LD:-$(command -v ld.lld || true)}
    if [ -n "$ld" ]; then
        # shellcheck disable=SC2086
        "$ld" -T "$TMP/layout.ld" $T_LDFLAGS "$TMP/bare.o" -o "$2"
        return
    fi
    if ! command -v docker > /dev/null 2>&1; then
        echo "l0: --target $TARGET links with ld.lld; put one on PATH, set L0_VIRT_LD to one, or install Docker" >&2
        exit 2
    fi
    if ! docker image inspect l0-virt-link > /dev/null 2>&1; then
        echo "l0: building the l0-virt-link image, once" >&2
        docker build -q -t l0-virt-link "$tdir" > /dev/null
    fi
    # shellcheck disable=SC2086
    docker run --rm -v "$TMP:/w" -w /w l0-virt-link \
        ld.lld -T layout.ld $T_LDFLAGS bare.o -o bare.out
    cp "$TMP/bare.out" "$2"
}

# write_layout OUT: the linker script the target's image is linked with,
# in OUT. A process's is its layout as it is. A board's is its template,
# or the --layout file, with the heap's and stack's sizes before it, the
# manifest's or the options', and after it the checks of what the runtime
# and l0 boot rely on (spec section 10.3).
write_layout() {
    if [ "$T_KIND" != board ]; then
        cp "$tdir/layout.ld" "$1"
        return
    fi
    heap=${HEAP_MB:-$T_HEAP_MB}
    stack=${STACK_MB:-$T_STACK_MB}
    if [ -z "$LAYOUT" ] && [ $((heap + stack)) -gt "$T_ROOM_MB" ]; then
        echo "l0: a heap of $heap MB and a stack of $stack MB take $((heap + stack)) MB, and --target $TARGET --arch $ARCH has room for $T_ROOM_MB MB of both (spec section 10.3)" >&2
        exit 2
    fi
    {
        echo "__l0_heap_size = $((heap * 1048576));"
        echo "__l0_stack_size = $((stack * 1048576));"
        cat "${LAYOUT:-$tdir/layout.ld}"
        echo 'ASSERT(__heap_start % 4096 == 0 && __heap_end % 4096 == 0 && __heap_end - __heap_start >= 4096, "l0: the heap is not whole pages, at least one")'
        echo 'ASSERT(__stack_bottom % 4096 == 0 && __stack_top % 4096 == 0 && __stack_top - __stack_bottom >= 4096, "l0: the stack is not whole pages, at least one")'
        echo 'ASSERT(__heap_end <= __stack_bottom || __stack_top <= __heap_start, "l0: the heap and the stack overlap")'
        [ -n "${T_INPUT_AT:-}" ] &&
            echo "ASSERT(__input_start == $T_INPUT_AT, \"l0: __input_start is not $T_INPUT_AT, where the board's standard input is loaded\")"
        [ -n "${T_INPUT_LEN_AT:-}" ] &&
            echo "ASSERT(__input_len == $T_INPUT_LEN_AT, \"l0: __input_len is not $T_INPUT_LEN_AT, where the board's standard input's length is loaded\")"
        :
    } > "$1"
}

# board_of IMAGE: the manifest's T_ variables of the board IMAGE is for,
# found by the four bytes at 0x38 that its CPU's boot protocol puts in its
# header, "ARM\x64" for arm64's, and for an arm64 image the word at 0x30,
# which is its board's tag (a manifest's T_BOARD_TAG, in hex, or 0).
board_of() {
    magic=$(od -An -tx1 -j56 -N4 "$1" | tr -d ' \n')
    tag=$(od -An -tu8 -j48 -N8 "$1" | tr -d ' \n')
    root=$(cd "$LIB/.." && pwd)
    for m in "$root"/runtime/targets/*.target "${L0_RUNTIMES:-$LIB}"/*/target; do
        [ -f "$m" ] || continue
        T_KIND="" T_ARCH="" T_MAGIC="" T_QEMU="" T_BOARD_TAG=""
        # shellcheck source=/dev/null
        . "$m"
        [ "$T_KIND" = board ] && [ "$T_MAGIC" = "$magic" ] || continue
        if [ "$T_ARCH" = aarch64 ] && [ "$((0x${T_BOARD_TAG:-0}))" != "$tag" ]; then
            continue
        fi
        return 0
    done
    echo "l0: $1 has no boot header of a board l0 knows; l0 build --target virt or pi5 writes one" >&2
    exit 2
}

# image_board IMAGE: board_of, for a board QEMU emulates.
image_board() {
    board_of "$1"
    if [ -z "$T_QEMU" ]; then
        echo "l0: $1 is for a board with no emulator, which l0 boot cannot run; l0 card writes what its SD card needs" >&2
        exit 2
    fi
}

# virt_boot IMAGE INPUT [ARG ...]: boots IMAGE on the board whose manifest's
# T_ variables are set, with the bytes of INPUT as its standard input,
# loaded where the board's layout reads them with their count in the word
# its manifest names, and the ARGs as its boot arguments, by QEMU's
# -append, and exits with the program's status. The board splits its boot
# arguments at spaces, so an ARG holding one, or none at all, is refused
# rather than split. QEMU's own standard input is not the program's, so it
# gets none.
virt_boot() {
    qemu=${L0_QEMU:-$T_QEMU}
    if ! command -v "$qemu" > /dev/null 2>&1; then
        echo "l0: the $T_ARCH virt board runs on $qemu, which is not installed" >&2
        exit 2
    fi
    image=$1
    input=$2
    shift 2
    len=0
    if [ -s "$input" ]; then
        len=$(wc -c < "$input" | tr -d ' ')
    fi
    if [ "$len" -gt "$T_INPUT_MAX" ]; then
        echo "l0: the virt board takes at most $T_INPUT_MAX bytes of standard input" >&2
        exit 2
    fi
    line=""
    for a in "$@"; do
        case $a in
            "" | *" "*)
                echo "l0: a boot argument on the virt board holds no space and is not empty: '$a'" >&2
                exit 2
                ;;
        esac
        line="${line:+$line }$a"
    done
    if [ "${#line}" -gt 65535 ]; then
        echo "l0: the virt board takes at most 65,535 bytes of boot arguments" >&2
        exit 2
    fi
    load="-device loader,addr=$T_INPUT_LEN_AT,data=$len,data-len=8"
    if [ "$len" -gt 0 ]; then
        load="$load -device loader,file=$input,addr=$T_INPUT_AT,force-raw=on"
    fi
    # The board as its manifest gives it, its virtio-mmio transports modern
    # (spec section 10.3), and the devices L0_QEMU_ARGS adds, split at
    # spaces. Where firmware writes on QEMU's standard output, the serial
    # line is a descriptor of its own, 3, which is ours, and QEMU's
    # standard output goes nowhere.
    case $T_SERIAL in
        fd3) serial="-chardev file,id=l0serial,path=/dev/fd/3,append=on -serial chardev:l0serial" ;;
        *) serial="-serial stdio" ;;
    esac
    board="$T_QEMU_ARGS -display none -monitor none $serial ${L0_QEMU_ARGS:-}"
    # shellcheck disable=SC2086
    set -- $board $load -kernel "$image"
    [ -n "$line" ] && set -- "$@" -append "$line"
    if [ "$T_SERIAL" = fd3 ]; then
        "$qemu" "$@" 3>&1 > /dev/null < /dev/null
    else
        "$qemu" "$@" < /dev/null
    fi
}

# ---------------------------------------------------------------- reference
#
# The standard library documents itself: a ;; comment block directly above a
# def or data is that definition's documentation, and a definition without
# one is internal. ;;; lines describe their file. l0 doc reads them from the
# library this driver links, so what it says cannot drift from what a
# program gets.

LIB_FILES="prelude io test"

# Every public definition, as an index, one file's entries, or one name,
# falling back to a search. mode is index, file, or name.
lib_doc() {
    mode=$1
    want=${2:-}
    set --
    for f in $LIB_FILES; do set -- "$@" "$LIB/$f.l0"; done
    awk -v mode="$mode" -v want="$want" '
    # Paren depth change over a line, outside strings and comments.
    function delta(s,    i, c, d, instr) {
        d = 0; instr = 0
        for (i = 1; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (instr) {
                if (c == "\\") i++
                else if (c == "\"") instr = 0
                continue
            }
            if (c == "\"") instr = 1
            else if (c == ";") break
            else if (c == "(") d++
            else if (c == ")") d--
        }
        return d
    }
    function uncomment(s,    i, c, instr) {
        instr = 0
        for (i = 1; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (instr) {
                if (c == "\\") i++
                else if (c == "\"") instr = 0
                continue
            }
            if (c == "\"") instr = 1
            else if (c == ";") return substr(s, 1, i - 1)
        }
        return s
    }
    function tidy(s) {
        gsub(/[ \t]+/, " ", s)
        gsub(/\( /, "(", s)
        gsub(/ \)/, ")", s)
        sub(/^ /, "", s)
        sub(/ $/, "", s)
        return s
    }
    # The index just past the group opening at i.
    function group_end(s, i,    d, c) {
        d = 0
        for (; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (c == "(") d++
            else if (c == ")") { d--; if (d == 0) return i + 1 }
        }
        return i
    }
    function skip_space(s, i) {
        while (i <= length(s) && substr(s, i, 1) == " ") i++
        return i
    }
    function word_end(s, i,    c) {
        for (; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (c == " " || c == "(" || c == ")") return i
        }
        return i
    }
    function summary(d,    p) {
        gsub(/\n/, " ", d)
        p = index(d, ". ")
        if (p > 0) d = substr(d, 1, p)
        sub(/ +$/, "", d)
        return d
    }
    # The name a def or data declares, its head starting at i: a bare name,
    # or the first word of (name T ...) when it takes type parameters. Sets
    # head_end to the index just past the head.
    function head_name(s, i,    j) {
        if (substr(s, i, 1) == "(") {
            j = word_end(s, i + 1)
            head_end = group_end(s, i)
            return substr(s, i + 1, j - i - 1)
        }
        head_end = word_end(s, i)
        return substr(s, i, head_end - i)
    }
    function finish(    flat, i, j, name, head, params, ret, ctors) {
        capturing = 0
        n++
        efile[n] = file; edoc[n] = pdoc; eform[n] = form
        flat = tidy(flat_form)
        if (substr(flat, 1, 5) == "(def ") {
            i = skip_space(flat, 6); name = head_name(flat, i); j = head_end
            head = substr(flat, i, j - i)
            i = skip_space(flat, j); j = group_end(flat, i)
            params = substr(flat, i, j - i)
            i = skip_space(flat, j)
            if (substr(flat, i, 1) == "(") j = group_end(flat, i)
            else j = word_end(flat, i)
            ret = substr(flat, i, j - i)
            ename[n] = name; esig[n] = head " " params " " ret; ekind[n] = "def"
        } else {
            i = skip_space(flat, 7); name = head_name(flat, i); j = head_end
            ename[n] = name; esig[n] = flat; ekind[n] = "data"
            ctors = " "
            i = skip_space(flat, j)
            while (substr(flat, i, 1) == "(") {
                j = word_end(flat, i + 1)
                ctors = ctors substr(flat, i + 1, j - i - 1) " "
                i = skip_space(flat, group_end(flat, i))
            }
            ector[n] = ctors
        }
    }
    FNR == 1 {
        file = FILENAME; sub(/.*\//, "", file); sub(/\.l0$/, "", file)
        nf++; forder[nf] = file; doc = ""; capturing = 0
    }
    capturing {
        form = form "\n" $0; flat_form = flat_form " " uncomment($0)
        depth += delta($0)
        if (depth <= 0) finish()
        next
    }
    /^;;;/ { l = $0; sub(/^;;; ?/, "", l); fdoc[file] = fdoc[file] l "\n"; next }
    /^;;/ { l = $0; sub(/^;; ?/, "", l); doc = doc l "\n"; next }
    /^\((def|data)[ \t]/ {
        if (doc != "") {
            capturing = 1; pdoc = doc; form = $0; flat_form = uncomment($0)
            depth = delta($0)
            if (depth <= 0) finish()
        }
        doc = ""
        next
    }
    { doc = "" }
    # Text indented by two, without trailing spaces or a final newline.
    function indented(t) {
        sub(/\n$/, "", t)
        t = "  " t
        gsub(/\n/, "\n  ", t)
        gsub(/ +\n/, "\n", t)
        sub(/ +$/, "", t)
        return t
    }
    function show_full(k) {
        print efile[k] ": " esig[k]
        print indented(edoc[k])
        if (ekind[k] == "data") print indented(eform[k])
        print ""
    }
    function show_brief(k) {
        print "  " esig[k]
        print "      " summary(edoc[k])
    }
    END {
        if (mode == "index") {
            for (f = 1; f <= nf; f++) {
                print "== " forder[f] ": " summary(fdoc[forder[f]])
                for (k = 1; k <= n; k++) if (efile[k] == forder[f]) show_brief(k)
                print ""
            }
            print "l0 doc FILE shows one of these in full, l0 doc NAME one definition,"
            print "and l0 doc TEXT searches. Builtins such as read_byte are in the spec,"
            print "section 6: l0 spec."
            exit 0
        }
        if (mode == "file") {
            print "== " want
            print indented(fdoc[want])
            print ""
            for (k = 1; k <= n; k++) if (efile[k] == want) show_full(k)
            exit 0
        }
        found = 0
        for (k = 1; k <= n; k++)
            if (ename[k] == want || index(ector[k], " " want " ") > 0) { show_full(k); found = 1 }
        if (found) exit 0
        w = tolower(want)
        for (k = 1; k <= n; k++)
            if (index(tolower(esig[k] " " edoc[k]), w) > 0) {
                if (!found) print "Nothing is named " want "; these mention it:"
                print "  " efile[k] ": " esig[k]
                print "      " summary(edoc[k])
                found = 1
            }
        if (!found) {
            print "l0 doc: nothing in the standard library is named or mentions " want > "/dev/stderr"
            exit 1
        }
    }' "$@"
}

# The directory of the spec this driver was installed with, or in a checkout
# spec/. It holds L0.md, the language; runtime.md, section 10; and boards/,
# each host's devices, interrupts, and layout.
spec_dir() {
    if [ -f "$LIB/../spec/L0.md" ] && [ -d "$LIB/../compiler" ]; then
        (cd "$LIB/../spec" && pwd)
    else
        echo "$LIB"
    fi
}

# Every file of the spec, one a line, the language first.
spec_path() {
    d=$(spec_dir)
    echo "$d/L0.md"
    echo "$d/runtime.md"
    for b in "$d"/boards/*.md; do
        [ -f "$b" ] && echo "$b"
    done
    return 0
}

# One file of the spec by name: runtime, or a board, virt-aarch64,
# virt-riscv64, pi5, or process.
spec_file() {
    d=$(spec_dir)
    if [ "$1" = runtime ]; then
        echo "$d/runtime.md"
    else
        echo "$d/boards/$1.md"
    fi
}

default_out() {
    first=$(echo "$FILES" | awk '{print $1}')
    basename "$first" .l0
}

# ---------------------------------------------------------------- commands

cmd=${1:-}
[ $# -gt 0 ] && shift || usage

case "$cmd" in
    emit)
        setup "$@"
        run_compiler "$TMP/out.ll"
        cat "$TMP/out.ll"
        ;;

    check)
        setup "$@"
        NOMAIN=1
        run_compiler "$TMP/out.ll"
        echo "ok"
        ;;

    boot)
        if [ $# -lt 1 ] || [ ! -f "$1" ]; then
            echo "usage: l0 boot IMAGE [ARG ...] < input, for an image l0 build --target virt wrote" >&2
            exit 2
        fi
        TMP=$(mktemp -d "$(scratch_base)/l0.XXXXXX")
        trap 'rm -rf "$TMP"' EXIT
        cat > "$TMP/stdin"
        image=$1
        shift
        image_board "$image"
        virt_boot "$image" "$TMP/stdin" "$@"
        ;;

    card)
        if [ $# -lt 2 ] || [ ! -f "$1" ]; then
            echo "usage: l0 card IMAGE DIR [ARG ...] < input, for an image l0 build --target pi5 wrote" >&2
            exit 2
        fi
        image=$1
        dir=$2
        shift 2
        board_of "$image"
        if [ -n "$T_QEMU" ]; then
            echo "l0 card: $image is for a board QEMU emulates; l0 boot runs it" >&2
            exit 2
        fi
        line=""
        for a in "$@"; do
            case $a in
                "" | *" "*)
                    echo "l0 card: a boot argument holds no space and is not empty: '$a'" >&2
                    exit 2
                    ;;
            esac
            line="${line:+$line }$a"
        done
        # The marker (spec 10.3) goes first, so the program's arguments are
        # told from the firmware's own, which the firmware puts before them.
        line="--l0-args${line:+ $line}"
        if [ "${#line}" -gt 65535 ]; then
            echo "l0 card: the board takes at most 65,535 bytes of boot arguments, the marker --l0-args among them" >&2
            exit 2
        fi
        if [ -f "$dir/config.txt" ] && [ "$(head -n 1 "$dir/config.txt")" != "# written by l0 card" ]; then
            echo "l0 card: $dir/config.txt is not one l0 card wrote; it is the card's own, and is left as it is" >&2
            exit 2
        fi
        mkdir -p "$dir"
        TMP=$(mktemp -d "$(scratch_base)/l0.XXXXXX")
        trap 'rm -rf "$TMP"' EXIT
        if [ -t 0 ]; then
            : > "$TMP/stdin"
        else
            cat > "$TMP/stdin"
        fi
        len=$(wc -c < "$TMP/stdin" | tr -d ' ')
        if [ "$len" -gt "$T_INPUT_MAX" ]; then
            echo "l0 card: the board takes at most $T_INPUT_MAX bytes of standard input" >&2
            exit 2
        fi
        cp "$image" "$dir/l0.img"
        printf '%s\n' "$line" > "$dir/cmdline.txt"
        {
            echo "# written by l0 card"
            echo "arm_64bit=1"
            echo "os_check=0"
            echo "kernel=l0.img"
            echo "kernel_address=0x80000"
            echo "device_tree_address=0x08000000"
            echo "pciex4_reset=0"
            echo "hdmi_force_hotplug=1"
        } > "$dir/config.txt"
        if [ "$len" -gt 0 ]; then
            cp "$TMP/stdin" "$dir/input.bin"
            echo "initramfs input.bin $T_INPUT_AT" >> "$dir/config.txt"
        else
            rm -f "$dir/input.bin"
        fi
        set -- "$dir"/bcm2712*.dtb
        if [ ! -f "$1" ]; then
            echo "l0 card: $dir holds no bcm2712 device tree; copy its files to a boot partition that has the firmware's own, from Raspberry Pi OS" >&2
        fi
        ;;

    link)
        setup "$@"
        # shellcheck disable=SC2086
        set -- $FILES
        if [ $# -ne 1 ] || [ -z "$OUT" ]; then
            echo "usage: l0 link IR -o OUT [--target virt | --target proc] [--arch ARCH]" >&2
            exit 2
        fi
        if [ "$TARGET" != host ]; then
            bare_link "$1" "$OUT"
        else
            "$(find_cc)" -O2 -flto -Wno-override-module "$1" "$RUNTIME" \
                "$HOST" -o "$OUT"
        fi
        ;;

    build)
        setup "$@"
        [ -n "$OUT" ] || OUT=$(default_out)
        run_compiler "$TMP/out.ll"
        if [ "$TARGET" != host ]; then
            bare_link "$TMP/out.ll" "$OUT"
        else
            "$(find_cc)" -O2 -flto -Wno-override-module "$TMP/out.ll" "$RUNTIME" \
                "$HOST" -o "$OUT"
        fi
        ;;

    run)
        # Everything before -- is for the driver, and everything after it
        # goes to the program, which may take arguments that look like files.
        n=0
        for a in "$@"; do
            [ "$a" = "--" ] && break
            n=$((n + 1))
        done
        own=""
        while [ "$n" -gt 0 ]; do
            own="$own $1"
            shift
            n=$((n - 1))
        done
        [ $# -gt 0 ] && shift
        # shellcheck disable=SC2086
        setup $own
        if [ "$TARGET" = proc ]; then
            echo "l0: a process runs under a kernel, and no kernel comes with the toolchain; l0 build --target proc writes its image" >&2
            exit 2
        elif [ "$TARGET" = pi5 ]; then
            echo "l0: the Raspberry Pi 5 has no emulator; l0 build --target pi5 writes its image, and l0 card what its SD card needs" >&2
            exit 2
        elif [ "$TARGET" = virt ]; then
            cat > "$TMP/stdin"
            run_compiler "$TMP/out.ll"
            bare_link "$TMP/out.ll" "$TMP/prog.img"
            virt_boot "$TMP/prog.img" "$TMP/stdin" "$@"
        else
            run_compiler "$TMP/out.ll"
            "$(find_cc)" -O2 -flto -Wno-override-module "$TMP/out.ll" "$RUNTIME" \
                "$HOST" -o "$TMP/prog"
            "$TMP/prog" "$@"
        fi
        ;;

    test)
        WANT_TEST=1
        setup "$@"
        if [ "$TARGET" = proc ]; then
            echo "l0 test: runs on this host or the virt board; a process runs under a kernel, and no kernel comes with the toolchain" >&2
            exit 2
        fi
        if [ "$TARGET" = pi5 ]; then
            echo "l0 test: runs on this host or the virt board; the Raspberry Pi 5 has no emulator" >&2
            exit 2
        fi
        if [ "$TARGET" = virt ] && [ -n "$BLESS" ]; then
            echo "l0 test: --bless writes golden files, and the virt board has no files" >&2
            exit 2
        fi

        # A program cannot list its own functions, even now that one can
        # be passed by name; the tests are found here instead. A test is
        # (def test_NAME () int ...), and expect_NAME, if defined, is the
        # runtime error test_NAME must die with. Each starts a line with its
        # name and empty parameter list.
        # shellcheck disable=SC2086
        tests=$(cat $FILES |
            sed -n 's/^(def[[:space:]]\{1,\}\(test_[A-Za-z0-9_]*\)[[:space:]]*().*/\1/p')
        # shellcheck disable=SC2086
        expects=$(cat $FILES |
            sed -n 's/^(def[[:space:]]\{1,\}expect_\([A-Za-z0-9_]*\)[[:space:]]*().*/\1/p' |
            tr '\n' ' ')
        if [ -z "$tests" ]; then
            echo "l0 test: no tests found; a test is (def test_NAME () int ...)" >&2
            exit 1
        fi

        # The generated main runs the test (arg 0) names, or writes the
        # runtime error a test expects when asked for "expect:NAME", on the
        # virt board as here, since it has boot arguments.
        gen="$TMP/l0test_main.l0"
        {
            echo "(def main () int"
            echo "  (let name (arg 0)"
            closes=""
            for t in $tests; do
                echo "  (if (list_eq name \"$t\") (test_status ($t))"
                closes="$closes)"
            done
            for e in $expects; do
                echo "  (if (list_eq name \"expect:$e\") (expect_status (expect_$e))"
                closes="$closes)"
            done
            echo "  (unknown_test name)$closes))"
        } > "$gen"
        SOURCES="$SOURCES $gen"
        run_compiler "$TMP/out.ll"
        if [ "$TARGET" = virt ]; then
            bare_link "$TMP/out.ll" "$TMP/prog.img"
        else
            "$(find_cc)" -O2 -flto -Wno-override-module "$TMP/out.ll" "$RUNTIME" \
                "$HOST" -o "$TMP/prog"
        fi

        # How many tests run at once: -j's number, or L0_JOBS's, or else
        # one on this host, where tests share the directory l0 test runs
        # in and may write the same files, and one for each CPU on the
        # board, which has no files and boots each test alone.
        if [ -z "$JOBS" ] && [ -n "${L0_JOBS:-}" ]; then
            JOBS=$(job_count L0_JOBS "$L0_JOBS") || exit 2
        fi
        if [ -z "$JOBS" ]; then
            JOBS=1
            if [ "$TARGET" = virt ]; then
                JOBS=$(job_count "the CPU count" \
                    "$(getconf _NPROCESSORS_ONLN 2> /dev/null || echo 1)") || exit 2
            fi
        fi

        # run_one NAME runs the test program for NAME, a test or
        # "expect:TEST", as its argument: here under L0_RC_CHECK, whose
        # leak check is section 10.3's; on the board, booted with NAME as
        # its boot argument, with no environment to check under, and no
        # standard input.
        : > "$TMP/t.in"
        run_one() {
            if [ "$TARGET" = virt ]; then
                virt_boot "$TMP/prog.img" "$TMP/t.in" "$1"
            else
                L0_RC_CHECK=1 "$TMP/prog" "$1" $BLESS < /dev/null
            fi
        }

        # run_test K NAME runs the test NAME, the Kth, leaving its standard
        # output and error in tK.out and tK.err, and then its exit status
        # in tK.st; and for a test that must die, the runtime error it must
        # die with in tK.want. It touches nothing another test's run reads,
        # so tests can run at once.
        run_test() {
            r_res="$TMP/t$1"
            r_st=0
            run_one "$2" > "$r_res.out" 2> "$r_res.err" || r_st=$?
            case " $expects " in
                *" ${2#test_} "*)
                    run_one "expect:${2#test_}" > "$r_res.want" 2> /dev/null || true
                    ;;
            esac
            echo "$r_st" > "$r_res.st"
        }

        # judge_next waits for the oldest test not yet judged, which run_test
        # runs as a job of its own, and writes its TAP lines. If the job
        # stopped before it could run the test, as when the board's
        # emulator is missing, the driver stops too, saying why.
        judge_next() {
            judged=$((judged + 1))
            j_n=$judged
            eval "j_pid=\$pid_$j_n j_t=\$name_$j_n"
            j_job=0
            wait "$j_pid" || j_job=$?
            j_res="$TMP/t$j_n"
            if [ ! -f "$j_res.st" ]; then
                cat "$j_res.err" >&2
                [ "$j_job" != 0 ] || j_job=2
                exit "$j_job"
            fi
            read -r j_st < "$j_res.st"
            # The runtime reports blocks still live at a normal exit, and
            # exits 0 all the same; spec section 10.3. A test that passes
            # writes nothing on standard error, so that is looked through
            # only when there is something.
            if [ "$j_st" = 0 ] && [ -s "$j_res.err" ] &&
                grep -q '^l0: blocks still live' "$j_res.err"; then
                echo "not ok $j_n - $j_t"
                echo "  # memory was never freed: a compiler or runtime bug"
                failed=$((failed + 1))
                sed 's/^/  # /' "$j_res.err"
                return 0
            fi
            j_want=""
            [ -f "$j_res.want" ] && j_want=$(cat "$j_res.want")
            if [ -n "$j_want" ]; then
                if [ "$j_st" = 70 ] &&
                    [ "$(cat "$j_res.err")" = "l0: runtime error: $j_want" ]; then
                    echo "ok $j_n - $j_t # expected runtime error: $j_want"
                    return 0
                fi
                echo "not ok $j_n - $j_t"
                echo "  # expected runtime error: $j_want"
                echo "  # exit status $j_st"
            elif [ "$j_st" = 0 ]; then
                echo "ok $j_n - $j_t"
                # Whatever --bless just declared correct is worth seeing,
                # and nothing but --bless declares anything.
                if [ -n "$BLESS" ]; then
                    grep ' (blessed ' "$j_res.out" | sed 's/^/  # /' || true
                fi
                return 0
            else
                echo "not ok $j_n - $j_t"
                [ "$j_st" = 1 ] || echo "  # exit status $j_st"
            fi
            failed=$((failed + 1))
            sed 's/^/  # /' "$j_res.out" "$j_res.err"
        }

        selected=""
        for t in $tests; do
            case "$t" in *"$MATCH"*) selected="$selected $t" ;; esac
        done
        # shellcheck disable=SC2086
        set -- $selected
        echo "TAP version 13"
        echo "1..$#"
        # Up to JOBS tests run at once, each a job of its own. Before
        # another starts, the oldest still running is waited for and
        # judged, so the TAP lines come out in the tests' order, each as
        # soon as every test before it is done.
        k=0
        judged=0
        failed=0
        for t in "$@"; do
            k=$((k + 1))
            if [ "$k" -gt "$JOBS" ]; then
                judge_next
            fi
            run_test "$k" "$t" &
            eval "pid_$k=\$! name_$k=\$t"
        done
        while [ "$judged" -lt "$k" ]; do
            judge_next
        done
        echo "# $((k - failed)) passed, $failed failed"
        [ "$failed" = 0 ]
        ;;

    fmt)
        check=0
        if [ "${1:-}" = --check ]; then
            check=1
            shift
        fi
        [ $# -ge 1 ] || usage
        ensure_toolchain
        ensure_fmt
        TMP=$(mktemp -d "$(scratch_base)/l0.XXXXXX")
        trap 'rm -rf "$TMP"' EXIT
        changed=0
        for f in "$@"; do
            if [ ! -f "$f" ]; then
                echo "l0 fmt: no such file: $f" >&2
                exit 2
            fi
            "$LIB/l0fmt" < "$f" > "$TMP/fmt"
            if ! cmp -s "$f" "$TMP/fmt"; then
                changed=1
                if [ "$check" = 1 ]; then
                    echo "l0 fmt: $f would change:"
                    diff -u "$f" "$TMP/fmt" | tail -n +3 || true
                else
                    cp "$TMP/fmt" "$f"
                    echo "l0 fmt: $f"
                fi
            fi
        done
        # --check exits 1 when a file would change, so a script can refuse.
        [ "$check" = 0 ] || [ "$changed" = 0 ]
        ;;

    doc)
        case "${1:-}" in
            "") lib_doc index ;;
            -*) usage ;;
            *)
                if [ -n "$(echo " $LIB_FILES " | grep " $1 ")" ]; then
                    lib_doc file "$1"
                else
                    lib_doc name "$1"
                fi
                ;;
        esac
        ;;

    spec)
        case "${1:-}" in
            --path) spec_path ;;
            "") cat "$(spec_dir)/L0.md" ;;
            *)
                f=$(spec_file "$1")
                if [ ! -f "$f" ]; then
                    echo "l0 spec: no part named $1; one of: runtime virt-aarch64 virt-riscv64 pi5 process" >&2
                    exit 2
                fi
                cat "$f"
                ;;
        esac
        ;;

    examples)
        case "${1:-}" in
            --path) echo "$LIB/examples.l0"; echo "$LIB/examples_test.l0" ;;
            "") cat "$LIB/examples.l0" ;;
            test) cat "$LIB/examples_test.l0" ;;
            *) usage ;;
        esac
        ;;

    init)
        dir=${1:-.}
        # Only what an agent's environment needs as files. The specification,
        # the examples, and the library are read from this installation, so
        # they always describe the compiler that builds the project.
        mkdir -p "$dir/.cursor/skills"
        cp -R "$LIB/skills/." "$dir/.cursor/skills/"
        init_agents "$dir/AGENTS.md"
        cat <<EOF
Scaffolded an L0 project in $dir:

  AGENTS.md                           always-on invariants, between the
                                      lines l0 init marks; the rest of the
                                      file is the project's, and kept
  .cursor/skills/l0-code/SKILL.md     how to read, write, and edit L0

The rest comes from the installed toolchain, so it matches the compiler:

  l0 spec [--path | PART]             the language specification, or a part of
                                      it: runtime (section 10), virt-aarch64,
                                      virt-riscv64, pi5, or process; --path
                                      names every file, the language first
  l0 doc [FILE | NAME | TEXT]         the standard library, from its source
  l0 examples [test] [--path]         worked examples, and tests of them

A program is prog.l0 with its tests beside it in prog_test.l0, and main
alone in main.l0, since l0 test supplies its own main:

  l0 check prog.l0 main.l0          type check
  l0 run   prog.l0 main.l0 -- ARGS  build and run, reading stdin
  l0 build prog.l0 main.l0          produce the executable ./prog
  l0 test  prog.l0 prog_test.l0     run every (def test_NAME () int ...)
EOF
        ;;

    version)
        echo "l0 (library at $LIB)"
        ;;

    *) usage ;;
esac

#!/bin/sh
# l0 -- the L0 toolchain driver.
#
# Usage:
#   l0 build FILE.l0 [MORE.l0 ...] [-o OUT]   compile and link an executable
#   l0 check FILE.l0 [MORE.l0 ...]            type check only
#   l0 run   FILE.l0 [MORE.l0 ...]            build to a temporary file, run
#   l0 emit  FILE.l0 [MORE.l0 ...]            write LLVM IR to stdout
#   l0 init  [DIR]                            scaffold a project for an agent
#   l0 request SLUG                           start a feature request
#   l0 request --skill SLUG                   start a skill note
#   l0 submit FILE [--open]                   send a finished request or skill note to L0
#   l0 version
#
# Options:
#   --no-prelude    do not include the standard library
#
# Several files are compiled together, because L0 has no module system.
# The standard library is included automatically; pass --no-prelude to
# suppress that, which is what the compiler's own bootstrap does. A function
# you define shadows a prelude function of the same name, so the prelude can
# gain functions without breaking a program that already used the name.
#
# Paths are relative to wherever you are, so this works from anywhere.

set -eu

SELF=$(cd "$(dirname "$0")" && pwd)

# Installed layout is <prefix>/bin/l0 with <prefix>/lib/l0 beside it; the
# repository layout is tools/l0 with lib/ beside it. Support both so the same
# driver works before and after installation.
LIB=""
for d in "$SELF/../lib/l0" "$SELF/../lib"; do
    if [ -f "$d/prelude.l0" ]; then
        LIB=$(cd "$d" && pwd)
        break
    fi
done
if [ -z "$LIB" ]; then
    echo "l0: cannot find the L0 library next to $SELF" >&2
    exit 2
fi

find_cc() {
    if [ -n "${L0_CC:-}" ]; then
        echo "$L0_CC"
    elif [ -x /opt/homebrew/opt/llvm/bin/clang ]; then
        echo /opt/homebrew/opt/llvm/bin/clang
    elif command -v clang > /dev/null 2>&1; then
        echo clang
    else
        echo "l0: no clang found; set L0_CC" >&2
        exit 2
    fi
}

# In a source checkout the compiler and runtime may not be built yet. Build
# them from the checked-in seed, which needs clang but no existing L0.
ensure_toolchain() {
    if [ -x "$LIB/l0c" ] && [ -f "$LIB/libl0rt.a" ]; then
        return 0
    fi
    root=$(cd "$LIB/.." && pwd)
    if [ ! -f "$root/bootstrap/stage2.ll" ]; then
        echo "l0: installation is incomplete (no compiler at $LIB/l0c)" >&2
        exit 2
    fi
    echo "l0: building the toolchain from bootstrap/stage2.ll" >&2
    "$root/tools/install.sh" --into "$LIB" > /dev/null
}

usage() {
    sed -n '2,24p' "$SELF/l0" | sed 's/^# \{0,1\}//'
    exit 2
}

# ------------------------------------------------------------------ inputs

WANT_PRELUDE=1
OUT=""
FILES=""

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-prelude) WANT_PRELUDE=0 ;;
            -o)
                shift
                [ $# -gt 0 ] || { echo "l0: -o needs a path" >&2; exit 2; }
                OUT=$1
                ;;
            -*)
                echo "l0: unknown option $1" >&2
                exit 2
                ;;
            *)
                if [ ! -f "$1" ]; then
                    echo "l0: cannot read $1" >&2
                    exit 1
                fi
                FILES="$FILES $1"
                ;;
        esac
        shift
    done
    if [ -z "$FILES" ]; then
        echo "l0: no source files given" >&2
        exit 2
    fi
}

# Writes an input bundle: a table of byte offsets and paths followed by the
# concatenated sources, so diagnostics can name the file a problem is in
# rather than a line in the concatenation.
write_bundle() {
    dest=$1
    set -- $SOURCES
    {
        echo "#l0bundle"
        # Checking asks whether the code is well typed, not whether it is a
        # complete program, so a library file or a work in progress is not
        # nagged about a missing entry point.
        [ "${NOMAIN:-0}" = 1 ] && echo "#nomain"
        # Where the standard library ends. Everything after it is the program,
        # and a program definition shadows a prelude one of the same name, so
        # the prelude can gain functions without breaking existing code.
        [ "${PRELUDE_END:-0}" != 0 ] && echo "#prelude $PRELUDE_END"
        offset=0
        for f in "$@"; do
            echo "$offset $f"
            size=$(wc -c < "$f" | tr -d ' ')
            offset=$((offset + size))
        done
        echo "#source"
        cat "$@"
    } > "$dest"
}

# Runs the compiler, leaving IR in $1 on success. Diagnostics go to stderr.
run_compiler() {
    irout=$1
    write_bundle "$TMP/in"
    if ! "$LIB/l0c" < "$TMP/in" > "$TMP/out"; then
        echo "l0: the compiler crashed" >&2
        exit 2
    fi
    case "$(head -n 1 "$TMP/out")" in
        O) tail -n +2 "$TMP/out" > "$irout" ;;
        E)
            tail -n +2 "$TMP/out" >&2
            exit 1
            ;;
        *)
            echo "l0: compiler produced untagged output" >&2
            exit 2
            ;;
    esac
}

setup() {
    parse_args "$@"
    ensure_toolchain
    SOURCES=$FILES
    PRELUDE_END=0
    if [ "$WANT_PRELUDE" = 1 ]; then
        SOURCES="$LIB/prelude.l0 $FILES"
        PRELUDE_END=$(wc -c < "$LIB/prelude.l0" | tr -d ' ')
    fi
    TMP=$(mktemp -d "${TMPDIR:-/tmp}/l0.XXXXXX")
    trap 'rm -rf "$TMP"' EXIT
}

default_out() {
    first=$(echo "$FILES" | awk '{print $1}')
    basename "$first" .l0
}

# ---------------------------------------------------------------- commands

cmd=${1:-}
[ $# -gt 0 ] && shift || usage

case "$cmd" in
    emit)
        setup "$@"
        run_compiler "$TMP/out.ll"
        cat "$TMP/out.ll"
        ;;

    check)
        setup "$@"
        NOMAIN=1
        run_compiler "$TMP/out.ll"
        echo "ok"
        ;;

    build)
        setup "$@"
        [ -n "$OUT" ] || OUT=$(default_out)
        run_compiler "$TMP/out.ll"
        "$(find_cc)" -O2 -Wno-override-module "$TMP/out.ll" "$LIB/libl0rt.a" \
            -o "$OUT"
        ;;

    run)
        setup "$@"
        run_compiler "$TMP/out.ll"
        "$(find_cc)" -O2 -Wno-override-module "$TMP/out.ll" "$LIB/libl0rt.a" \
            -o "$TMP/prog"
        "$TMP/prog"
        ;;

    init)
        dir=${1:-.}
        mkdir -p "$dir/.cursor/skills" "$dir/l0/requests"
        cp -R "$LIB/skills/." "$dir/.cursor/skills/"
        cp "$LIB/AGENTS.md" "$dir/AGENTS.md"
        cp "$LIB/L0.md" "$dir/l0/L0.md"
        cp "$LIB/examples.l0" "$dir/l0/examples.l0"
        cp "$LIB/prelude.l0" "$dir/l0/prelude.l0"
        cat <<EOF
Scaffolded an L0 project in $dir:

  AGENTS.md                           always-on invariants
  .cursor/skills/l0-code/SKILL.md     how to read, write, and edit L0
  .cursor/skills/l0-limits/SKILL.md   what to do when L0 cannot express
                                      something, and when that is worth
                                      reporting rather than working around
  l0/L0.md                            the language specification
  l0/examples.l0                      worked examples, all of them compiling
  l0/prelude.l0                       the standard library, for reference
  l0/requests/                        feature requests and skill notes,
                                      for the L0 maintainer

The prelude is linked automatically; the copy in l0/ is there to be read.

  l0 check prog.l0          type check
  l0 run   prog.l0          build and run, reading stdin
  l0 build prog.l0          produce an executable
  l0 request SLUG           start a feature request
  l0 request --skill SLUG   start a skill note
EOF
        ;;

    submit)
        file=${1:-}
        if [ -z "$file" ] || [ ! -f "$file" ]; then
            echo "l0: usage: l0 submit l0/requests/NNNN-slug.md" >&2
            exit 2
        fi

        # Enforce mechanically that code blocks are filled. For a language
        # request that is the workaround; for a skill note it is the old
        # text, the new text, and the project evidence.
        empty=$(awk 'prev=="```" && $0=="```" {c++} {prev=$0} END {print c+0}' \
            "$file")
        if [ "$empty" -gt 0 ]; then
            echo "l0: $file still has $empty empty code block(s)." >&2
            if grep -q '^Kind: skill$' "$file"; then
                echo "  A skill note has to quote the old text, the new text," >&2
                echo "  and the project code that proved it better. Fill those in first." >&2
            else
                echo "  A request is weighed against keeping L0 small, so it has" >&2
                echo "  to quote the code that could not be written and the" >&2
                echo "  workaround that shipped instead. Fill those in first." >&2
            fi
            exit 1
        fi

        abs=$(cd "$(dirname "$file")" && pwd)/$(basename "$file")
        project=$(basename "$PWD")

        # Copy into the L0 repository's inbox when it is on this machine.
        if [ -n "${L0_HOME:-}" ] && [ -d "$L0_HOME" ]; then
            mkdir -p "$L0_HOME/requests"
            dest="$L0_HOME/requests/$project-$(basename "$file")"
            cp "$file" "$dest"
            echo "copied to $dest"
            abs=$dest
        fi

        # Percent-encode for the deeplink. awk rather than python so the
        # driver keeps depending on nothing but a POSIX shell and clang.
        if grep -q '^Kind: skill$' "$file"; then
            prompt="A skill note for L0 arrived from the project at $PWD.

Read $abs. It is not a language request: it is a proposed change to a
shipped skill under lib/skills/. Triage it with the l0-evolve skill's
section on skill notes: merge what would help every L0 project into the
matching skill, and send back anything that is project-specific."
        else
            prompt="A feature request for L0 arrived from the project at $PWD.

Read $abs and triage it with the l0-evolve skill: judge it against
lib/skills/l0-limits/SKILL.md, then either send it back with the reason, or
accept it and quote its evidence into spec/changelog.md as the blocker."
        fi

        encoded=$(printf '%s\n' "$prompt" | LC_ALL=C awk '
            BEGIN { for (i = 0; i < 256; i++) ord[sprintf("%c", i)] = i }
            {
                s = $0; out = ""
                for (i = 1; i <= length(s); i++) {
                    c = substr(s, i, 1)
                    if (c ~ /[A-Za-z0-9._~-]/) out = out c
                    else out = out sprintf("%%%02X", ord[c])
                }
                printf "%s%%0A", out
            }')

        link="cursor://anysphere.cursor-deeplink/prompt?text=$encoded"
        if [ "${#link}" -gt 10000 ]; then
            echo "l0: deeplink exceeds Cursor's 10000 character limit" >&2
            exit 1
        fi

        if [ "${2:-}" = "--open" ] || [ "${L0_SUBMIT_OPEN:-0}" = 1 ]; then
            if command -v open > /dev/null 2>&1; then
                open "$link"
                echo "opened Cursor with a triage prompt; confirm it there"
                exit 0
            fi
            echo "l0: no 'open' command available; the link is below" >&2
        fi

        echo
        echo "$link"
        echo
        echo "Click that to pre-fill a triage prompt in Cursor. It will wait"
        echo "for you to confirm, and lands in whichever window is active, so"
        echo "open the L0 repository first."
        ;;

    request)
        kind=feature
        slug=""
        for arg in "$@"; do
            case "$arg" in
                --skill) kind=skill ;;
                -*)
                    echo "l0: usage: l0 request [--skill] SHORT-SLUG" >&2
                    exit 2
                    ;;
                *)
                    if [ -n "$slug" ]; then
                        echo "l0: usage: l0 request [--skill] SHORT-SLUG" >&2
                        exit 2
                    fi
                    slug=$arg
                    ;;
            esac
        done
        if [ -z "$slug" ]; then
            echo "l0: usage: l0 request [--skill] SHORT-SLUG" >&2
            exit 2
        fi
        mkdir -p l0/requests
        n=1
        for existing in l0/requests/[0-9]*.md; do
            [ -f "$existing" ] || continue
            num=$(basename "$existing" | sed 's/^\([0-9]*\).*/\1/')
            num=$(printf '%d' "$((10#$num))" 2>/dev/null || echo 0)
            [ "$num" -ge "$n" ] && n=$((num + 1))
        done
        out=$(printf 'l0/requests/%04d-%s.md' "$n" "$slug")
        if [ -e "$out" ]; then
            echo "l0: $out already exists" >&2
            exit 1
        fi
        if [ "$kind" = skill ]; then
            template="$LIB/skill-note-template.md"
            heading="# Skill note: $slug"
            heading_from='# Skill note: TITLE'
        else
            template="$LIB/request-template.md"
            heading="# Feature request: $slug"
            heading_from='# Feature request: TITLE'
        fi
        sed -e "s/^$heading_from/$heading/" \
            -e "s/^Project: PROJECT/Project: $(basename "$PWD")/" \
            "$template" > "$out"
        echo "$out"
        echo
        if [ "$kind" = skill ]; then
            echo "Fill in every section. Quote the old skill text, the replacement,"
            echo "and the project code that proved it better."
        else
            echo "Fill in every section. A request without the workaround and its"
            echo "cost cannot be acted on: it is weighed against keeping L0 small."
        fi
        ;;

    version)
        echo "l0 (library at $LIB)"
        ;;

    *) usage ;;
esac

#!/bin/sh
# Compiles L0 source to LLVM IR text on stdout.
#
# Usage: tools/l0c [FILE.l0 ...] > out.ll
#
# With no files, reads source on stdin. With several, they are compiled
# together, which is all that "linking" means in a language with no module
# system. Paths may be relative to wherever you are; this is usable from
# outside the L0 repository.
#
# Diagnostics go to stderr as path:line:column, and the exit status is 0 or 1,
# so this behaves like an ordinary unix compiler. Under the hood the compiler
# is a pure byte function with a single output channel that tags its result
# "O" or "E"; that tag is stripped here.
#
# It runs the compiler natively when build/l0c-native exists and under the
# stage-0 interpreter otherwise, so the interface does not change as the
# bootstrap progresses.

set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
. "$ROOT/tools/env.sh"

COMPILER_SOURCES="compiler/prelude.l0 compiler/lex.l0 compiler/parse.l0 compiler/check.l0 compiler/emit.l0 compiler/main.l0"

mkdir -p "$BUILD"
IN="$BUILD/l0c-in.$$"
OUT="$BUILD/l0c-out.$$"
trap 'rm -f "$IN" "$OUT"' EXIT

# Resolve inputs BEFORE changing directory, since they are relative to the
# caller's working directory and not to the repository.
if [ $# -gt 0 ]; then
    for f in "$@"; do
        if [ ! -f "$f" ]; then
            echo "l0c: cannot read $f" >&2
            exit 1
        fi
    done

    # An input bundle: a table of byte offsets and paths, so diagnostics can
    # name the file a problem is in rather than a line in the concatenation.
    {
        echo "#l0bundle"
        offset=0
        for f in "$@"; do
            echo "$offset $f"
            size=$(wc -c < "$f" | tr -d ' ')
            offset=$((offset + size))
        done
        echo "#source"
        cat "$@"
    } > "$IN"
else
    cat > "$IN"
fi

cd "$ROOT"

if [ -x "$BUILD/l0c-native" ]; then
    "$BUILD/l0c-native" < "$IN" > "$OUT"
else
    if [ ! -x "$BUILD/l0i" ]; then
        "$ROOT/tools/build.sh" > /dev/null
    fi
    # shellcheck disable=SC2086
    "$BUILD/l0i" run $COMPILER_SOURCES < "$IN" > "$OUT"
fi

case "$(head -n 1 "$OUT")" in
    O)
        tail -n +2 "$OUT"
        ;;
    E)
        tail -n +2 "$OUT" >&2
        exit 1
        ;;
    *)
        echo "l0c: compiler produced untagged output" >&2
        head -n 5 "$OUT" >&2
        exit 2
        ;;
esac

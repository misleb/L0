#!/bin/sh
# Type checks L0 source files. This is the feedback loop for writing L0:
# nothing should be called done until l0check passes on it.
#
# Usage: tools/l0check FILE.l0 [MORE.l0 ...]
#
# All files given are checked together as one program, since L0 has no module
# system and declaration order does not matter. A file that is only part of a
# program will report unknown names unless its companions are listed too. A
# main need not be present, but one that is must have the signature spec
# section 9 requires.
#
# Exit status is 0 when everything checks, 1 when it does not. Diagnostics are
# written to stderr as file:line:column: error: message.
#
# The checker is the compiler's own, built by the seed from the current
# lib/prelude.l0 and compiler/*.l0 whenever they change (tools/compiler.sh),
# so it knows every feature the compiler does and is never stale. Stage 0 is
# not used here: it is frozen, knows only the L0 of its day, and serves only
# as the differential oracle for programs in tools/test.sh.

set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
. "$ROOT/tools/env.sh"

if [ $# -eq 0 ]; then
    echo "usage: tools/l0check FILE.l0 [MORE.l0 ...]" >&2
    exit 2
fi

for f in "$@"; do
    if [ ! -f "$f" ]; then
        echo "l0check: cannot read $f" >&2
        exit 2
    fi
done

. "$ROOT/tools/compiler.sh"
COMPILER=$(current_compiler) || exit 2

mkdir -p "$ROOT/tmp"
IN=$(mktemp "$ROOT/tmp/l0check-in.XXXXXX")
OUT=$(mktemp "$ROOT/tmp/l0check-out.XXXXXX")
trap 'rm -f "$IN" "$OUT"' EXIT

# Paths are recorded as given, so diagnostics name files the way the caller
# named them.
write_bundle 1 "$@" > "$IN"

if ! "$COMPILER" < "$IN" > "$OUT"; then
    echo "l0check: the compiler crashed" >&2
    exit 2
fi

case "$(head -n 1 "$OUT")" in
    O)
        if [ $# -eq 1 ]; then
            echo "ok: $1 type checks"
        else
            echo "ok: $# files type check together"
        fi
        # Warnings come first in the IR, as comments; they never fail a check.
        sed -n '2,$ { /^; [^ ].*: warning: /!q; s/^; //p; }' "$OUT" >&2
        ;;
    E)
        tail -n +2 "$OUT" >&2
        exit 1
        ;;
    *)
        echo "l0check: the compiler produced untagged output" >&2
        head -n 5 "$OUT" >&2
        exit 2
        ;;
esac

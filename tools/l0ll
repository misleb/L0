#!/bin/sh
# Links an LLVM IR file against the L0 runtime, producing an executable.
#
# Usage: tools/l0ll input.ll output

set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
. "$ROOT/tools/env.sh"

if [ $# -ne 2 ]; then
    echo "usage: tools/l0ll input.ll output" >&2
    exit 2
fi

if [ ! -f "$BUILD/l0core.o" ] || [ ! -f "$BUILD/l0rt.o" ]; then
    echo "error: runtime not built; run tools/build.sh first" >&2
    exit 1
fi

# -Wno-override-module: L0 IR deliberately carries no target triple, so clang
# supplies the host's. See spec section 10.2.
exec "$CC" -O2 -Wno-override-module "$1" "$BUILD/l0rt.o" "$BUILD/l0core.o" \
    -o "$2"

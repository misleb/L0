#!/bin/sh
# Links an LLVM IR file against the L0 runtime, producing an executable.
#
# Usage: tools/l0ll input.ll output

set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
. "$ROOT/tools/env.sh"

if [ $# -ne 2 ]; then
    echo "usage: tools/l0ll input.ll output" >&2
    exit 2
fi

if [ ! -f "$BUILD/l0rt.o" ] || [ ! -f "$BUILD/l0host.o" ] ||
    [ "$ROOT/runtime/l0rt.ll" -nt "$BUILD/l0rt.o" ] ||
    [ "$ROOT/runtime/host-libc.ll" -nt "$BUILD/l0host.o" ]; then
    "$ROOT/tools/build.sh" > /dev/null
fi

if [ ! -f "$1" ]; then
    echo "l0ll: cannot read $1" >&2
    exit 1
fi

# -Wno-override-module: L0 IR deliberately carries no target triple, so clang
# supplies the host's. See spec section 10.2. -flto: the runtime is bitcode,
# and the program and runtime are optimized together (tools/build.sh).
exec "$CC" -O2 -flto -Wno-override-module "$1" "$BUILD/l0rt.o" \
    "$BUILD/l0host.o" -o "$2"
